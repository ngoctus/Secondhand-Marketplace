<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web2Hand</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Web2Hand</a>

            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>

                @if (User.IsInRole(AppRoles.Buyer))
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Buyer" asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Buyer" asp-controller="Orders" asp-action="Index">Đơn mua</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Buyer" asp-controller="Favorites" asp-action="Index">Yêu thích</a></li>
                }
                @if (User.IsInRole(AppRoles.Seller))
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Seller" asp-controller="Dashboard" asp-action="Index">Kênh người bán</a></li>
                }
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a></li>
                }
            </ul>

            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Chat" asp-action="Index">Tin nhắn</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Notifications" asp-action="Index">Thông báo</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Index">@User.Identity.Name</a></li>
                    <li class="nav-item">
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                }
            </ul>
        </div>
    </nav>

    <main class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @RenderBody()
    </main>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
