# Copy this file to .env and replace every placeholder on the deployment host.
DB_SERVER=your-sql-server-host
DB_NAME=SecondHandMarketplace
DB_USER=secondhand_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_TRUST_CERT=False
# In .env, single-quote DB_PASSWORD if it contains Compose-significant characters such as $ or #.
ALLOWED_HOSTS=market.example.com;www.market.example.com
SITE_PUBLIC_BASE_URL=https://market.example.com
JWT_KEY=replace-with-a-random-secret-at-least-32-bytes
DATA_PROTECTION_KEYS_PATH=/app/data-protection-keys
# Optional: shares catalog cache, registration OTP, authentication rate limits, and Data Protection keys between instances.
REDIS_CONNECTION_STRING=
STORAGE_PROVIDER=Local
# For S3, allow public reads only for products/ and banners/ objects; keep private/ blocked.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
# Leave credentials empty when the host supplies an IAM/task role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FORWARDED_HEADERS_KNOWN_PROXY=127.0.0.1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
AI_API_KEY=
AI_MODERATION_API_KEY=
AI_FALLBACK_API_KEY=
