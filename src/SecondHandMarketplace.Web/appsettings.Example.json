{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SecondHandMarketplace;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Storage": {
    "RootPath": "wwwroot/uploads"
  },
  "Auction": {
    "SweepSeconds": 60
  },
  "Jwt": {
    "Issuer": "SecondHandMarketplace",
    "Audience": "SecondHandMarketplace.Client",
    "Key": "set-via-user-secrets-or-environment-variable",
    "ExpiresMinutes": 60
  },
  "Ai": {
    "ApiKey": "set-via-user-secrets-or-Ai__ApiKey-environment-variable",
    "Endpoint": "https://api.anthropic.com/v1/messages",
    "AnthropicVersion": "2023-06-01",
    "DefaultModel": "claude-3-5-haiku-20241022",
    "DefaultEnabled": true,
    "MaxTokens": 1024,
    "TimeoutSeconds": 50,
    "MaxToolRounds": 3
  }
}