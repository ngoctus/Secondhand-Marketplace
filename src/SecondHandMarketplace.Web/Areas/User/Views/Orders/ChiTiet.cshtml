@model SecondHandMarketplace.Web.Models.ViewModels.Orders.DonHangChiTietViewModel
@inject SecondHandMarketplace.Web.Services.Reviews.IReviewService ReviewService

@{
    ViewData["Title"] = "Chi tiết đơn hàng " + Model.MaDon;
    var danhGiaHienTai = Model.TrangThai == "COMPLETED"
        ? await ReviewService.LayDanhGiaTheoDonHangAsync(Model.MaDonHang)
        : null;
}
<div class="container my-4" style="max-width: 950px;">

    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-receipt text-success"></i> Đơn hàng: <span class="font-monospace text-success">#@Model.MaDon</span>
            </h2>
            <div class="text-muted small">Cửa hàng: <strong class="text-dark">@Model.TenShop</strong>
                <a asp-area="User" asp-controller="Reports" asp-action="Tao" asp-route-loai="SHOP" asp-route-id="@Model.MaCuaHang" asp-route-ten="@Model.TenShop"
                   class="text-danger small ms-2 text-decoration-none" title="Báo cáo cửa hàng vi phạm">
                    🚩 Báo cáo shop
                </a>
                | Ngày đặt: @HienThi.NgayGio(Model.NgayTao)</div>
        </div>
        <a asp-area="User" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            &larr; Về danh sách đơn
        </a>
    </div>
    <partial name="_ThongBao" />

    @if (!string.IsNullOrWhiteSpace(Model.KhungGioNhan))
    {
        <div class="alert alert-light border rounded-3"><strong>Khung giờ nhận:</strong> @Model.KhungGioNhan</div>
    }

    <!-- Thanh trạng thái & Nút thao tác -->

    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="text-muted small me-2">Trạng thái đơn:</span>
                <span class="badge @(Model.TrangThai switch {
                    "PENDING" => "bg-warning text-dark",
                    "CONFIRMED" => "bg-info text-dark",
                    "SHIPPING" => "bg-primary",
                    "DELIVERED" => "bg-success-subtle text-success border border-success",
                    "COMPLETED" => "bg-success",
                    "CANCELLED" => "bg-secondary",
                    _ => "bg-secondary"
                }) px-3 py-1 rounded-pill small">
                    @HienThi.TrangThaiDon(Model.TrangThai, Model.HinhThucNhan)@(Model.TrangThai == "CANCELLED" && !string.IsNullOrEmpty(Model.NguoiHuy) ? $" ({HienThi.NguoiThucHien(Model.NguoiHuy)})" : "")
                </span>
                @if (!string.IsNullOrEmpty(Model.LyDoHuy))
                {
                    <div class="small text-danger mt-1">Lý do hủy: @Model.LyDoHuy</div>
                }
            </div>

            <!-- Các nút hành động phía người mua -->
            <div class="d-flex gap-2 flex-wrap">
                @if (Model.CoTheHuy)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold" onclick="toggleHuyDon()">
                        <i class="bi bi-x-circle me-1"></i> Hủy đơn hàng
                    </button>
                }
                @if (Model.CoTheXacNhanNhanHang)
                {
                    <form asp-area="User" asp-controller="Orders" asp-action="XacNhanDaNhanHang" method="post" class="d-inline"
                          onsubmit="return confirm('Bạn xác nhận đã nhận được hàng đúng như mô tả và hài lòng với sản phẩm?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDonHang" value="@Model.MaDonHang" />
                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold"
                                style="background-color: var(--green, #285b43); border-color: var(--green, #285b43);">
                            <i class="bi bi-check2-all me-1"></i> Đã nhận được hàng
                        </button>
                    </form>
                }
                @if (Model.MaTranhChap.HasValue)
                {
                    <a asp-area="User" asp-controller="Disputes" asp-action="ChiTiet" asp-route-id="@Model.MaTranhChap.Value"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> Xem tiến độ khiếu nại
                    </a>
                }
                else if (Model.CoTheMoTranhChap)
                {
                    <a asp-area="User" asp-controller="Disputes" asp-action="Tao" asp-route-maDonHang="@Model.MaDonHang"
                       class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3 fw-semibold">
                        <i class="bi bi-shield-exclamation me-1"></i> Khiếu nại / Tranh chấp
                    </a>
                }
                @if (Model.TrangThai == "COMPLETED")
                {
                    if (danhGiaHienTai == null)
                    {
                        <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold text-dark shadow-sm"
                                data-bs-toggle="modal" data-bs-target="#modalDanhGia">
                            <i class="bi bi-star-fill text-dark me-1"></i> Đánh giá người bán
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-dark border border-warning px-3 py-2 rounded-pill small">
                            <i class="bi bi-star-fill text-warning me-1"></i> Đã đánh giá (@danhGiaHienTai.SoSao ★)
                        </span>
                    }
                }
            </div>
        </div>

        <!-- Khung xác nhận hủy đơn inline -->
        <div id="boxHuyDon" class="mt-3 p-3 bg-light rounded-3 border border-danger-subtle" style="display: none;">

            <form asp-area="User" asp-controller="Orders" asp-action="HuyDon" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maDonHang" value="@Model.MaDonHang" />
                <h6 class="text-danger fw-bold mb-2"><i class="bi bi-exclamation-triangle"></i> Xác nhận hủy đơn hàng</h6>
                <p class="small text-secondary mb-2">Bạn có chắc chắn muốn hủy đơn hàng này không? Sản phẩm sẽ được đưa lại lên sàn để người khác có thể mua.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Lý do hủy đơn <span class="text-danger">*</span></label>
                    <textarea name="lyDo" rows="2" class="form-control form-control-sm rounded-2" required placeholder="Nhập lý do bạn muốn hủy đơn..."></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">Xác nhận hủy ngay</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="toggleHuyDon()">Đóng</button>
                </div>
            </form>
        </div>
    </div>

    @if (danhGiaHienTai != null)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 p-4 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="fw-bold text-dark">
                    <i class="bi bi-star-fill text-warning me-1"></i> Đánh giá của bạn dành cho shop @Model.TenShop
                </div>
                <div class="small text-muted">
                    Ngày gửi: @HienThi.NgayGio(danhGiaHienTai.NgayTao)
                </div>
            </div>
            <div class="d-flex align-items-center gap-1 mb-2">
                @for (byte s = 1; s <= 5; s++)
                {
                    if (s <= danhGiaHienTai.SoSao)
                    {
                        <i class="bi bi-star-fill text-warning fs-5"></i>
                    }
                    else
                    {
                        <i class="bi bi-star text-secondary fs-5 opacity-50"></i>
                    }
                }
                <span class="ms-2 fw-semibold text-dark small">(@danhGiaHienTai.SoSao / 5 sao)</span>
                @if (danhGiaHienTai.TrangThai == "VISIBLE")
                {
                    <span class="badge bg-success-subtle text-success rounded-pill ms-2" style="font-size: 11px;">Đang hiển thị</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger rounded-pill ms-2" style="font-size: 11px;" title="Đánh giá bị ẩn bởi quản trị viên">Đã bị ẩn</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(danhGiaHienTai.NoiDung))
            {
                <div class="p-3 bg-light rounded-3 text-dark small" style="white-space: pre-line;">@danhGiaHienTai.NoiDung</div>
            }
            else
            {
                <div class="text-muted fst-italic small bg-light p-2 rounded-2">Không có nhận xét kèm theo.</div>
            }
        </div>
    }

    <!-- Thông tin người nhận & Thanh toán -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">

            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-geo-alt text-danger me-1"></i> @(Model.HinhThucNhan == "GAP_TRUC_TIEP" ? "Thông tin điểm hẹn trực tiếp" : "Thông tin giao hàng")</h6>
                <div class="small mb-2"><span class="text-muted">Hình thức nhận:</span> <strong class="text-primary">@HienThi.TenHinhThucNhan(Model.HinhThucNhan)</strong></div>
                <div class="small mb-2"><span class="text-muted">@(Model.HinhThucNhan == "GAP_TRUC_TIEP" ? "Người hẹn:" : "Người nhận:")</span> <strong class="text-dark">@Model.TenNguoiNhan</strong></div>
                <div class="small mb-2"><span class="text-muted">Số điện thoại:</span> <strong class="text-dark">@Model.SoDienThoaiNhan</strong></div>
                <div class="small"><span class="text-muted">@(Model.HinhThucNhan == "GAP_TRUC_TIEP" ? "Địa điểm hẹn:" : "Địa chỉ nhận:")</span> <span class="text-dark">@Model.DiaChiNhan</span></div>
            </div>
        </div>
        <div class="col-md-6">

            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-credit-card text-success me-1"></i> Thanh toán</h6>
                <div class="small mb-2">
                    <span class="text-muted">Phương thức:</span>
                    <strong class="text-dark">
                        @(Model.PhuongThucThanhToan == "COD" ? "Thanh toán khi nhận hàng (COD)" : Model.PhuongThucThanhToan == "BANK_TRANSFER" ? "Chuyển khoản VietQR" : "Trực tuyến")
                    </strong>
                </div>
                <div class="small mb-2">
                    <span class="text-muted">Trạng thái thanh toán:</span>
                    <span class="badge @(Model.TrangThaiThanhToan == "PAID" ? "bg-success" : Model.TrangThaiThanhToan == "REFUNDED" ? "bg-info text-dark" : "bg-warning text-dark") rounded-pill px-2 py-1 small">
                        @HienThi.TrangThaiThanhToan(Model.TrangThaiThanhToan)
                    </span>
                </div>
                @if (Model.PhuongThucThanhToan == "BANK_TRANSFER" && Model.TrangThaiThanhToan != "PAID" && Model.TrangThai != "CANCELLED")
                {
                    <div class="mt-3 pt-2 border-top">
                        <a href="#vietqrSection" class="btn btn-outline-primary btn-sm rounded-pill px-3 w-100">
                            <i class="bi bi-qr-code-scan me-1"></i> Xem mã VietQR chuyển khoản
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    @if (Model.PhuongThucThanhToan == "BANK_TRANSFER" && Model.TrangThaiThanhToan != "PAID" && Model.TrangThai != "CANCELLED")
    {
        <div id="vietqrSection" class="mb-4">
            <partial name="_VietQRCard" model='new SecondHandMarketplace.Web.Models.ViewModels.Orders.VietQrViewModel {
                SoTien = Model.TongTien,
                NoiDung = "REMARKET " + Model.MaDon,
                NganHang = "MB Bank (Quân Đội)",
                SoTaiKhoan = "0987654321",
                ChuTaiKhoan = "SAN THUONG MAI RE:MARKET",
                MaDonHang = Model.MaDonHang,
                MaDon = Model.MaDon,
                ChoPhepXacNhan = true,
                ReturnUrl = Context.Request.Path
            }' />
        </div>
    }

    <!-- Danh sách món hàng trong đơn -->

    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 p-4">
        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">Sản phẩm trong đơn hàng</h6>
        @foreach (var sp in Model.DanhSachSanPham)
        {
            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                <img src="@(string.IsNullOrEmpty(sp.AnhDaiDien) ? "https://placehold.co/60x60?text=SP" : sp.AnhDaiDien)"
                     class="rounded-3 border" style="width: 60px; height: 60px; object-fit: cover;" alt="@sp.TenSanPham" />
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-semibold text-truncate text-dark">
                        <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@sp.MaSanPham" class="text-decoration-none text-dark">
                            @sp.TenSanPham
                        </a>
                    </div>
                    <div class="text-muted small" style="font-size: 11px;">Số lượng: 1 (đồ cũ duy nhất)</div>
                </div>
                <div class="fw-bold text-success text-nowrap">@sp.Gia.ToString("N0") ₫</div>
            </div>
        }

        <!-- Tổng kết tiền -->
        <div class="row justify-content-end pt-3">
            <div class="col-md-5">
                <div class="d-flex justify-content-between mb-1 small">
                    <span class="text-muted">Tiền hàng:</span>
                    <strong class="text-dark">@Model.TienHang.ToString("N0") ₫</strong>
                </div>
                <div class="d-flex justify-content-between mb-1 small">
                    <span class="text-muted">Phí vận chuyển:</span>
                    <strong class="text-success">@(Model.PhiVanChuyen == 0 ? "Miễn phí" : Model.PhiVanChuyen.ToString("N0") + " ₫")</strong>
                </div>
                <div class="d-flex justify-content-between align-items-baseline pt-2 border-top">
                    <span class="fw-bold text-dark">Tổng tiền:</span>
                    <span class="h5 fw-bold text-success mb-0">@Model.TongTien.ToString("N0") ₫</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Lịch sử trạng thái đơn hàng -->

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-clock-history text-secondary me-1"></i> Lịch sử trạng thái đơn hàng</h6>
        @if (!Model.LichSuTrangThai.Any())
        {
            <div class="text-muted small">Chưa có lịch sử cập nhật.</div>
        }
        else
        {
            <div class="timeline position-relative ps-3">
                @foreach (var ls in Model.LichSuTrangThai)
                {
                    <div class="border-start border-2 border-success ps-3 pb-3 position-relative">
                        <div class="small fw-bold text-dark">
                            @HienThi.TrangThaiDon(ls.TrangThaiMoi, Model.HinhThucNhan)
                            <span class="text-muted fw-normal ms-1">(@HienThi.NguoiThucHien(ls.LoaiNguoiThucHien))</span>
                        </div>
                        <div class="text-muted small" style="font-size: 11px;">@HienThi.NgayGioGiay(ls.ThoiGian)</div>
                        @if (!string.IsNullOrEmpty(ls.LyDo))
                        {
                            <div class="text-secondary small mt-1">Ghi chú: @ls.LyDo</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (Model.TrangThai == "COMPLETED" && danhGiaHienTai == null)
{
    <!-- Modal Đánh giá người bán (C3) -->
    <div class="modal fade" id="modalDanhGia" tabindex="-1" aria-labelledby="modalDanhGiaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form asp-area="User" asp-controller="Reviews" asp-action="Tao" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" id="modalDanhGiaLabel">
                            <i class="bi bi-star-fill text-warning me-1"></i> Đánh giá người bán
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>

                    <div class="modal-body py-3">
                        <div class="text-center mb-3">
                            <div class="fw-bold text-dark fs-5">@Model.TenShop</div>
                            <div class="text-muted small">Đơn hàng: <span class="font-monospace">#@Model.MaDon</span></div>
                        </div>

                        <!-- Chọn số sao trực quan -->
                        <div class="mb-3 text-center">
                            <label class="form-label fw-semibold small text-muted d-block">Mức độ hài lòng của bạn</label>
                            <div class="d-inline-flex gap-2 justify-content-center" id="starRatingContainer">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <button type="button" class="btn p-1 border-0 star-btn" data-value="@i" title="@i sao" style="font-size: 2rem; color: #ffc107;">
                                        <i class="bi bi-star-fill"></i>
                                    </button>
                                }
                            </div>
                            <input type="hidden" name="SoSao" id="inputSoSao" value="5" required />
                            <div class="small fw-semibold text-warning mt-1" id="starRatingText">5 sao - Rất hài lòng</div>
                        </div>

                        <!-- Nhận xét chi tiết -->
                        <div class="mb-2">
                            <label class="form-label fw-semibold small">Nhận xét chi tiết (tùy chọn)</label>
                            <textarea name="NoiDung" class="form-control rounded-3" rows="4" maxlength="1000"
                                      placeholder="Hãy chia sẻ trải nghiệm của bạn về tình trạng sản phẩm, mức độ đúng như mô tả và sự nhiệt tình của người bán..."></textarea>
                            <div class="form-text text-end small">Tối đa 1.000 ký tự</div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold"
                                style="background-color: var(--green, #285b43); border-color: var(--green, #285b43);">
                            Gửi đánh giá
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleHuyDon() {
            var el = document.getElementById("boxHuyDon");
            el.style.display = (el.style.display === "none" || el.style.display === "") ? "block" : "none";
        }
        // Script chọn số sao trực quan
        (function() {
            var container = document.getElementById('starRatingContainer');
            if (!container) return;
            var buttons = container.querySelectorAll('.star-btn');
            var input = document.getElementById('inputSoSao');
            var text = document.getElementById('starRatingText');
            var labels = {
                1: '1 sao - Rất không hài lòng',
                2: '2 sao - Không hài lòng',
                3: '3 sao - Bình thường',
                4: '4 sao - Hài lòng',
                5: '5 sao - Rất hài lòng'
            };

            function setStars(val) {
                if (input) input.value = val;
                if (text) text.textContent = labels[val] || (val + ' sao');
                buttons.forEach(function(btn) {
                    var v = parseInt(btn.getAttribute('data-value'), 10);
                    var icon = btn.querySelector('i');
                    if (v <= val) {
                        btn.style.color = '#ffc107';
                        if (icon) icon.className = 'bi bi-star-fill';
                    } else {
                        btn.style.color = '#ccc';
                        if (icon) icon.className = 'bi bi-star';
                    }
                });
            }

            buttons.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var v = parseInt(this.getAttribute('data-value'), 10);
                    setStars(v);
                });
            });

            setStars(5);
        })();
    </script>
}
