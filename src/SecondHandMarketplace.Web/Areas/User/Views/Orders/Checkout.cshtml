@model SecondHandMarketplace.Web.Models.ViewModels.Orders.CheckoutViewModel
@{
    ViewData["Title"] = "Xác nhận & Thanh toán";
}

<div class="container my-4" style="max-width: 1050px;">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="bi bi-shield-lock text-success"></i> Xác nhận & Đặt hàng</h2>
            <p class="text-muted small mb-0">Vui lòng kiểm tra địa chỉ nhận hàng và phương thức thanh toán trước khi hoàn tất.</p>
        </div>
        <a asp-area="User" asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            &larr; Quay lại giỏ hàng
        </a>
    </div>

    <partial name="_ThongBao" />

    <form asp-area="User" asp-controller="Orders" asp-action="DatHang" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaSanPhamMuaNgay" />
        <input type="hidden" asp-for="TienHang" />
        <input type="hidden" asp-for="PhiVanChuyen" />

        <div class="row g-4">
            <!-- Cột trái: Thông tin nhận hàng & Phương thức thanh toán -->
            <div class="col-lg-7">
                <!-- 1. Địa chỉ nhận hàng -->
                <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 p-4">
                    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-danger"></i> 1. Địa chỉ nhận hàng
                    </h5>

                    <div class="mb-3">
                        <label asp-for="TenNguoiNhan" class="form-label fw-semibold small text-dark">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input asp-for="TenNguoiNhan" class="form-control rounded-3" placeholder="Nhập họ tên đầy đủ..." />
                        <span asp-validation-for="TenNguoiNhan" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoDienThoaiNhan" class="form-label fw-semibold small text-dark">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input asp-for="SoDienThoaiNhan" class="form-control rounded-3" placeholder="Ví dụ: 0912345678" />
                        <span asp-validation-for="SoDienThoaiNhan" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="DiaChiNhan" class="form-label fw-semibold small text-dark">Địa chỉ giao hàng chi tiết <span class="text-danger">*</span></label>
                        <textarea asp-for="DiaChiNhan" rows="3" class="form-control rounded-3" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..."></textarea>
                        <span asp-validation-for="DiaChiNhan" class="text-danger small"></span>
                    </div>
                </div>

                <!-- 2. Phương thức thanh toán -->
                <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 p-4">
                    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <i class="bi bi-wallet2 text-success"></i> 2. Phương thức thanh toán
                    </h5>

                    <div class="d-flex flex-column gap-3">
                        <!-- COD -->
                        <label class="border rounded-3 p-3 d-flex align-items-start gap-3 cursor-pointer bg-light">
                            <input class="form-check-input mt-1" type="radio" asp-for="PhuongThucThanhToan" id="pt_cod" value="COD" checked />
                            <div>
                                <div class="fw-bold text-dark"><i class="bi bi-cash-stack text-success me-1"></i> Thanh toán tiền mặt khi nhận hàng (COD)</div>
                                <div class="text-secondary small mt-1">Bạn chỉ thanh toán cho người giao hàng khi đã kiểm tra kiện hàng.</div>
                            </div>
                        </label>

                        <!-- Bank transfer -->
                        <label class="border rounded-3 p-3 d-flex align-items-start gap-3 cursor-pointer">
                            <input class="form-check-input mt-1" type="radio" asp-for="PhuongThucThanhToan" id="pt_bank" value="BANK_TRANSFER" />
                            <div>
                                <div class="fw-bold text-dark"><i class="bi bi-bank text-primary me-1"></i> Chuyển khoản ngân hàng (VietQR)</div>
                                <div class="text-secondary small mt-1">Chuyển tiền nhanh 24/7 qua mã VietQR hoặc số tài khoản ngân hàng.</div>
                            </div>
                        </label>

                        <!-- Online -->
                        <label class="border rounded-3 p-3 d-flex align-items-start gap-3 cursor-pointer">
                            <input class="form-check-input mt-1" type="radio" asp-for="PhuongThucThanhToan" id="pt_online" value="ONLINE" />
                            <div>
                                <div class="fw-bold text-dark"><i class="bi bi-credit-card text-warning me-1"></i> Ví điện tử / Thẻ thanh toán</div>
                                <div class="text-secondary small mt-1">Hỗ trợ thanh toán bảo mật tức thì qua cổng trực tuyến.</div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Danh sách sản phẩm & Tổng tiền -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 bg-white sticky-top p-4" style="top: 90px;">
                    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">Món đồ đặt mua</h5>

                    <div class="pe-1 mb-3" style="max-height: 280px; overflow-y: auto;">
                        @if (Model.SanPhamMuaNgay != null)
                        {
                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-light border mb-2">
                                <img src="@(string.IsNullOrEmpty(Model.SanPhamMuaNgay.AnhDaiDien) ? "https://placehold.co/55x55?text=SP" : Model.SanPhamMuaNgay.AnhDaiDien)" 
                                     class="rounded-3 border" style="width: 55px; height: 55px; object-fit: cover;" alt="@Model.SanPhamMuaNgay.TenSanPham" />
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate small text-dark">@Model.SanPhamMuaNgay.TenSanPham</div>
                                    <div class="text-muted small" style="font-size: 11px;">Shop: @Model.SanPhamMuaNgay.TenShop</div>
                                </div>
                                <div class="fw-bold text-success text-nowrap small">@Model.SanPhamMuaNgay.Gia.ToString("N0") ₫</div>
                            </div>
                        }
                        else if (Model.GioHang != null)
                        {
                            @foreach (var shop in Model.GioHang.DanhSachNhomShop)
                            {
                                <div class="mb-3">
                                    <div class="small fw-bold text-dark mb-1"><i class="bi bi-shop text-success"></i> @shop.TenShop</div>
                                    @foreach (var it in shop.Items)
                                    {
                                        <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-light border mb-2">
                                            <img src="@(string.IsNullOrEmpty(it.AnhDaiDien) ? "https://placehold.co/55x55?text=SP" : it.AnhDaiDien)" 
                                                 class="rounded-3 border" style="width: 55px; height: 55px; object-fit: cover;" alt="@it.TenSanPham" />
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="fw-semibold text-truncate small text-dark">@it.TenSanPham</div>
                                                <div class="text-muted small" style="font-size: 11px;">SL: 1 (duy nhất)</div>
                                            </div>
                                            <div class="fw-bold text-success text-nowrap small">@it.Gia.ToString("N0") ₫</div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Chi tiết thanh toán -->
                    <div class="border-top pt-3 mb-4">
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Tiền hàng:</span>
                            <span class="fw-semibold text-dark">@Model.TienHang.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="fw-semibold text-success">@(Model.PhiVanChuyen == 0 ? "Miễn phí" : Model.PhiVanChuyen.ToString("N0") + " ₫")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-baseline pt-2 border-top">
                            <span class="fw-bold text-dark">Tổng thanh toán:</span>
                            <span class="h4 fw-bold text-success mb-0">@Model.TongThanhToan.ToString("N0") ₫</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success py-2 w-100 fw-semibold rounded-pill"
                            style="background-color: var(--green, #285b43); border-color: var(--green, #285b43);">
                        <i class="bi bi-check-circle-fill me-1"></i> Xác nhận đặt hàng
                    </button>
                    <div class="text-center text-muted small mt-2" style="font-size: 11px;">
                        <i class="bi bi-shield-check text-success"></i> Giao dịch được bảo vệ bởi sàn Re:Market
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
