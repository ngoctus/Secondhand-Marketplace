@model List<SecondHandMarketplace.Web.Models.ViewModels.Orders.DonHangItemViewModel>?
@{
    ViewData["Title"] = "Đặt hàng thành công";
    var danhSachMaDon = ViewBag.DanhSachMaDon as string[] ?? Array.Empty<string>();
    var orders = Model ?? new();
    var hasBankTransfer = orders.Any(d => d.PhuongThucThanhToan == "BANK_TRANSFER");
    var unpaidBankOrders = orders.Where(d => d.PhuongThucThanhToan == "BANK_TRANSFER" && d.TrangThaiThanhToan != "PAID").ToList();
    var hasCod = orders.Any(d => d.PhuongThucThanhToan == "COD");
}

<div class="container my-4" style="max-width: 820px;">
    <partial name="_ThongBao" />

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4 text-center">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success shadow-sm" 
                  style="width: 76px; height: 76px; font-size: 36px;">
                <i class="bi bi-check-lg"></i>
            </span>
        </div>
        <h2 class="fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif;">Đặt hàng thành công!</h2>
        <p class="text-secondary small mb-4" style="max-width: 540px; margin: 0 auto;">
            Cảm ơn bạn đã lựa chọn mua sắm đồ cũ cùng <strong>Re:Market</strong>. Đơn hàng của bạn đã được ghi nhận và người bán sẽ chuẩn bị gửi hàng cho bạn.
        </p>

        @if (danhSachMaDon.Length > 0)
        {
            <div class="p-3 bg-light rounded-4 border text-center mb-0 d-inline-block mx-auto" style="min-width: 280px;">
                <div class="text-muted small mb-1"><i class="bi bi-receipt text-success me-1"></i> Mã đơn hàng:</div>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    @foreach (var ma in danhSachMaDon)
                    {
                        var don = orders.FirstOrDefault(d => d.MaDon == ma);
                        if (don != null)
                        {
                            <a asp-area="User" asp-controller="Orders" asp-action="ChiTiet" asp-route-id="@don.MaDonHang" 
                               class="badge bg-white text-dark border text-decoration-none font-monospace px-3 py-2 fs-6 shadow-sm"
                               title="Nhấn để xem chi tiết đơn hàng">
                                #@ma <i class="bi bi-box-arrow-up-right ms-1 text-muted" style="font-size: 11px;"></i>
                            </a>
                        }
                        else
                        {
                            <span class="badge bg-white text-dark border font-monospace px-3 py-2 fs-6 shadow-sm">
                                #@ma
                            </span>
                        }
                    }
                </div>
            </div>
        }
    </div>

    @if (hasBankTransfer)
    {
        @if (unpaidBankOrders.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <i class="bi bi-qr-code-scan fs-4 text-primary"></i>
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Thanh toán chuyển khoản VietQR</h5>
                        <div class="text-muted small">Vui lòng quét mã QR bên dưới để hoàn tất thanh toán cho đơn hàng.</div>
                    </div>
                </div>

                @{
                    var tongTienCk = unpaidBankOrders.Sum(d => d.TongTien);
                    var noiDungCk = "REMARKET " + string.Join(" ", unpaidBankOrders.Select(d => d.MaDon));
                    var dsId = string.Join(",", unpaidBankOrders.Select(d => d.MaDonHang));
                    var qrModel = new SecondHandMarketplace.Web.Models.ViewModels.Orders.VietQrViewModel
                    {
                        SoTien = tongTienCk,
                        NoiDung = noiDungCk,
                        NganHang = "MB Bank (Quân Đội)",
                        SoTaiKhoan = "0987654321",
                        ChuTaiKhoan = "SAN THUONG MAI RE:MARKET",
                        DanhSachMaDonHang = dsId,
                        MaDonHang = unpaidBankOrders.Count == 1 ? unpaidBankOrders[0].MaDonHang : null,
                        ChoPhepXacNhan = false,
                        ReturnUrl = Context.Request.Path + Context.Request.QueryString
                    };
                }

                <partial name="_VietQRCard" model="qrModel" />
            </div>
        }
        else
        {
            <div class="alert alert-success d-flex align-items-center gap-3 rounded-4 p-4 shadow-sm mb-4 border-0">
                <i class="bi bi-check-circle-fill text-success fs-1"></i>
                <div>
                    <h6 class="fw-bold mb-1 text-success">Đã xác nhận thanh toán chuyển khoản thành công!</h6>
                    <div class="small text-secondary">Hệ thống đã ghi nhận thanh toán của bạn. Shop sẽ sớm đóng gói và bàn giao cho đơn vị vận chuyển.</div>
                </div>
            </div>
        }
    }

    @if (hasCod)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <div class="d-flex align-items-start gap-3">
                <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center p-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-cash-coin fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Thanh toán khi nhận hàng (COD)</h6>
                    <p class="text-secondary small mb-0">
                        Đơn hàng của bạn sẽ được giao tới địa chỉ đã đăng ký. Bạn hãy chuẩn bị tiền mặt để thanh toán cho shipper sau khi nhận và kiểm tra gói hàng.
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Danh sách các đơn đã đặt -->
    @if (orders.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center justify-content-between">
                <span><i class="bi bi-card-checklist text-success me-2"></i>Danh sách kiện hàng đã tạo</span>
                <span class="badge bg-light text-secondary border small">@orders.Count kiện</span>
            </h6>

            <div class="d-flex flex-column gap-3">
                @foreach (var don in orders)
                {
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-2 mb-2 border-bottom">
                            <div>
                                <span class="fw-bold font-monospace text-dark">#@don.MaDon</span>
                                <span class="text-muted small ms-2"><i class="bi bi-shop me-1 text-success"></i>@don.TenShop</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(don.TrangThaiThanhToan == "PAID" ? "bg-success" : "bg-warning text-dark") rounded-pill px-2 py-1 small">
                                    @(don.TrangThaiThanhToan == "PAID" ? "Đã thanh toán" : "Chưa thanh toán")
                                </span>
                                <span class="fw-bold text-success">@don.TongTien.ToString("N0") ₫</span>
                            </div>
                        </div>

                        @if (don.ChiTiet.Count > 0)
                        {
                            <div class="d-flex flex-column gap-2 mb-2">
                                @foreach (var sp in don.ChiTiet)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(sp.AnhDaiDien) ? "/uploads/products/placeholder.svg" : sp.AnhDaiDien)" 
                                             class="rounded-2 border bg-white" style="width: 40px; height: 40px; object-fit: cover;" 
                                             alt="@sp.TenSanPham"
                                             onerror="this.src='/uploads/banners/banner-1.svg';" />
                                        <div class="flex-grow-1 min-w-0 small text-truncate text-dark">
                                            @sp.TenSanPham
                                        </div>
                                        <div class="small text-muted font-monospace text-nowrap">
                                            @sp.Gia.ToString("N0") ₫
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="text-end pt-2 border-top">
                            <a asp-area="User" asp-controller="Orders" asp-action="ChiTiet" asp-route-id="@don.MaDonHang"
                               class="btn btn-outline-success btn-sm rounded-pill px-3" style="font-size: 12px;">
                                Chi tiết đơn này &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Điều hướng chân trang -->
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a asp-area="User" asp-controller="Orders" asp-action="Index" class="btn btn-success px-4 py-2 rounded-pill fw-semibold shadow-sm"
           style="background-color: var(--green, #285b43); border-color: var(--green, #285b43);">
            <i class="bi bi-box-seam me-1"></i> Quản lý đơn mua
        </a>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Tiếp tục khám phá
        </a>
    </div>
</div>
