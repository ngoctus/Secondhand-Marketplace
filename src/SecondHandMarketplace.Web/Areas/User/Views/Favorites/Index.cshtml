@model PagedResult<ProductCardVm>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="rm-main-content" style="padding-top:8px">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 style="font-family:'Playfair Display',serif; font-size:24px;">Sản phẩm yêu thích</h2>
        <a asp-area="" asp-controller="Products" asp-action="Index" class="btn-rm-outline">Tiếp tục khám phá</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rm-empty-state">
            <h3>Bạn chưa lưu sản phẩm nào</h3>
            <p>Nút tim ở góc ảnh mỗi tin đăng sẽ lưu sản phẩm vào đây để bạn so sánh dần.</p>
            <ol>
                <li>Mở "Tất cả sản phẩm", lọc theo danh mục, khoảng giá hoặc khu vực.</li>
                <li>Bấm nút tim trên tin bạn quan tâm để thêm vào danh sách này.</li>
                <li>Quay lại đây so sánh giá và tình trạng, rồi mở tin để chat với người bán.</li>
            </ol>
            <div class="d-flex gap-2 justify-content-center mt-4 flex-wrap">
                <a asp-area="" asp-controller="Products" asp-action="Index" class="btn-rm-primary">Tìm sản phẩm</a>
                <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-rm-outline">Đăng bán món của bạn</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-4">
            @foreach (var p in Model.Items)
            {
                <div class="col">
                    <partial name="_ProductCard" model="p" />
                </div>
            }
        </div>
        <partial name="_Pager" model="new PagerVm(Model.Page, Model.TotalPages)" />
    }
</div>
