@model PagedResult<ProductCardVm>
@{
    ViewData["Title"] = L["Fav_Title"];
}

<div class="rm-main-content" style="padding-top:8px">
    <div class="rm-fav-header">
        <div class="rm-fav-title-wrap">
            <h2 class="rm-fav-title">@L["Fav_Title"]</h2>
            <span class="rm-fav-count-pill"
                  id="rmFavTotalCount"
                  data-total="@Model.TotalItems"
                  data-template="@L["Fav_TotalCount", "{0}"]">
                @L["Fav_TotalCount", Model.TotalItems]
            </span>
        </div>
        <a asp-area="" asp-controller="Products" asp-action="Index" class="btn-rm-outline">@L["Fav_Continue"]</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rm-empty-state">
            <h3>@L["Fav_EmptyTitle"]</h3>
            <p>@L["Fav_EmptyDesc"]</p>
            <ol>
                <li>@L["Fav_Tip1"]</li>
                <li>@L["Fav_Tip2"]</li>
                <li>@L["Fav_Tip3"]</li>
            </ol>
            <div class="d-flex gap-2 justify-content-center mt-4 flex-wrap">
                <a asp-area="" asp-controller="Products" asp-action="Index" class="btn-rm-primary">@L["Fav_FindProducts"]</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-4">
            @foreach (var p in Model.Items)
            {
                <div class="col">
                    <partial name="_ProductCard" model="p" />
                </div>
            }
        </div>
        <partial name="_Pager" model="new PagerVm(Model.Page, Model.TotalPages)" />
    }
</div>
