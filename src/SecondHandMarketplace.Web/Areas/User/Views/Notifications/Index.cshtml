@model SecondHandMarketplace.Web.Models.ViewModels.Notifications.NotificationListVm
@{
    ViewData["Title"] = "Thông báo";
    static string TenLoai(string loai) => loai switch
    {
        "ORDER" => "Đơn hàng",
        "PRODUCT" => "Sản phẩm",
        _ => "Hệ thống"
    };
}
<div class="container py-4 rm-thong-bao">
    <div class="d-flex justify-content-between align-items-center mb-3 tb-head">
        <h2 class="mb-0">Thông báo</h2>
        <span class="text-muted">Chưa đọc: <strong>@Model.UnreadCount</strong></span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty panel">Bạn chưa có thông báo nào.</div>
    }
    else
    {
        <div class="list-group mb-3">
            @foreach (var item in Model.Items)
            {
                <div class="list-group-item d-flex justify-content-between align-items-start gap-3 @(item.DaDoc ? null : "is-unread")">
                    <div>
                        <div class="tb-title">
                            @item.TieuDe
                            @if (!item.DaDoc) { <span class="tb-badge">MỚI</span> }
                        </div>
                        <div class="tb-body">@item.NoiDung</div>
                        <div class="tb-meta">@TenLoai(item.Loai) · @HienThi.NgayGio(item.NgayTao)</div>
                    </div>
                    @if (!item.DaDoc)
                    {
                        <form asp-action="MarkRead" method="post" class="flex-shrink-0">
                            <input type="hidden" name="id" value="@item.MaThongBao" />
                            <input type="hidden" name="page" value="@Model.Page" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Đánh dấu đã đọc</button>
                        </form>
                    }
                    else
                    {
                        <span class="tb-read flex-shrink-0">Đã đọc</span>
                    }
                </div>
            }
        </div>

        <div class="d-flex justify-content-between">
            <span>Tổng @Model.TotalItems thông báo</span>
            <div class="d-flex gap-2">
                @if (Model.Page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page - 1)">Trước</a> }
                <span class="align-self-center">Trang @Model.Page / @Math.Max(1, Model.TotalPages)</span>
                @if (Model.Page < Model.TotalPages) { <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page + 1)">Sau</a> }
            </div>
        </div>
    }
</div>
