@model SecondHandMarketplace.Web.Models.ViewModels.Notifications.NotificationListVm
@{
    ViewData["Title"] = L["Notify_Title"].Value;
    var activeFilter = Model.Filter ?? "";
    Func<string, string> tenLoai = loai => loai switch
    {
        "ORDER" => L["Notify_TypeOrder"].Value,
        "PRODUCT" => L["Notify_TypeProduct"].Value,
        _ => L["Notify_TypeSystem"].Value
    };

    (string Icon, string CssClass, string ActionHint) DescribeNotification(SecondHandMarketplace.Web.Models.Entities.ThongBao item)
    {
        var text = $"{item.TieuDe} {item.NoiDung}".ToLowerInvariant();
        if (text.Contains("tranh chấp") || text.Contains("dispute"))
            return ("bi-exclamation-octagon-fill", "rm-notif-ic-danger", HienThi.Chon("Xem tranh chấp", "View dispute"));
        if (item.Loai == "ORDER" || text.Contains("đơn hàng"))
            return ("bi-bag-check-fill", "rm-notif-ic-order", HienThi.Chon("Xem đơn hàng", "View order"));
        if (item.Loai == "PRODUCT")
            return ("bi-box-seam-fill", "rm-notif-ic-product", HienThi.Chon("Xem sản phẩm", "View product"));
        if (text.Contains("đấu giá") || text.Contains("trả giá"))
            return ("bi-hammer", "rm-notif-ic-auction", HienThi.Chon("Xem đấu giá", "View auction"));
        if (text.Contains("kỹ thuật"))
            return ("bi-bug-fill", "rm-notif-ic-warn", HienThi.Chon("Xem báo cáo", "View report"));
        if (text.Contains("báo cáo"))
            return ("bi-flag-fill", "rm-notif-ic-warn", HienThi.Chon("Xem báo cáo", "View report"));
        if (text.Contains("đánh giá"))
            return ("bi-star-fill", "rm-notif-ic-product", HienThi.Chon("Xem đánh giá", "View reviews"));
        if (text.Contains("cửa hàng") || text.Contains("shop"))
            return ("bi-shop", "rm-notif-ic-order", HienThi.Chon("Xem cửa hàng", "View shop"));
        if (text.Contains("tài khoản") || text.Contains("mật khẩu"))
            return ("bi-person-check-fill", "rm-notif-ic-system", HienThi.Chon("Xem tài khoản", "View account"));
        return ("bi-bell-fill", "rm-notif-ic-system", HienThi.Chon("Mở chi tiết", "Open"));
    }
}

<div class="rm-notif-page">
    <div class="rm-notif-header-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rm-notif-header-icon">
                    <i class="bi bi-bell-fill" aria-hidden="true"></i>
                </div>
                <div>
                    <h2 class="h4 fw-bold mb-1 font-serif d-flex align-items-center gap-2">
                        <span>@L["Notify_Title"]</span>
                        @if (Model.UnreadCount > 0)
                        {
                            <span class="badge rounded-pill" style="background-color: var(--color-primary); font-size: 12px;">
                                @Model.UnreadCount @HienThi.Chon("chưa đọc", "unread")
                            </span>
                        }
                    </h2>
                    <p class="text-muted small mb-0">
                        @HienThi.Chon("Nhấn vào từng thông báo để đi thẳng đến đơn hàng, sản phẩm, báo cáo hoặc mục liên quan.", "Click any notification to jump directly to the related order, product, report, or section.")
                    </p>
                </div>
            </div>
            @if (Model.UnreadCount > 0)
            {
                <form asp-action="MarkAllRead" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-rm-outline rounded-pill py-2 px-3 small fw-semibold">
                        <i class="bi bi-check2-all me-1"></i> @L["Notify_MarkAll"]
                    </button>
                </form>
            }
        </div>

        <div class="rm-notif-tabs mt-3 pt-3 border-top" role="tablist">
            <a asp-action="Index" asp-route-filter="" class="rm-notif-tab @(string.IsNullOrEmpty(activeFilter) ? "active" : "")">
                <i class="bi bi-grid-fill me-1"></i>@HienThi.Chon("Tất cả", "All")
            </a>
            <a asp-action="Index" asp-route-filter="UNREAD" class="rm-notif-tab @(activeFilter == "UNREAD" ? "active" : "")">
                <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>@HienThi.Chon("Chưa đọc", "Unread")
                @if (Model.UnreadCount > 0)
                {
                    <span class="rm-notif-tab-count">@Model.UnreadCount</span>
                }
            </a>
            <a asp-action="Index" asp-route-filter="ORDER" class="rm-notif-tab @(activeFilter == "ORDER" ? "active" : "")">
                <i class="bi bi-bag me-1"></i>@L["Notify_TypeOrder"]
            </a>
            <a asp-action="Index" asp-route-filter="PRODUCT" class="rm-notif-tab @(activeFilter == "PRODUCT" ? "active" : "")">
                <i class="bi bi-box-seam me-1"></i>@L["Notify_TypeProduct"]
            </a>
            <a asp-action="Index" asp-route-filter="SYSTEM" class="rm-notif-tab @(activeFilter == "SYSTEM" ? "active" : "")">
                <i class="bi bi-megaphone me-1"></i>@L["Notify_TypeSystem"]
            </a>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white text-center p-5 mt-3">
            <div class="rm-notif-empty-badge mx-auto mb-3">
                <i class="bi bi-bell-slash"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">@HienThi.Chon("Chưa có thông báo nào", "No notifications yet")</h6>
            <p class="text-muted small mb-0">@L["Notify_Empty"]</p>
        </div>
    }
    else
    {
        <div class="rm-notif-list mt-3">
            @foreach (var item in Model.Items)
            {
                var (icon, icClass, hint) = DescribeNotification(item);
                var targetUrl = Url.Action("ChiTiet", "Notifications", new { area = "User", id = item.MaThongBao });
                <div class="rm-notif-card @(item.DaDoc ? "is-read" : "is-unread")">
                    <a href="@targetUrl" class="rm-notif-card-link">
                        <div class="rm-notif-icon @icClass">
                            <i class="bi @icon" aria-hidden="true"></i>
                        </div>
                        <div class="rm-notif-content">
                            <div class="rm-notif-title-row">
                                <span class="rm-notif-title">@item.TieuDe</span>
                                @if (!item.DaDoc)
                                {
                                    <span class="rm-notif-pill-new">@L["Notify_New"]</span>
                                }
                            </div>
                            <p class="rm-notif-desc mb-2">@item.NoiDung</p>
                            <div class="rm-notif-meta">
                                <span class="rm-notif-type-chip">@tenLoai(item.Loai)</span>
                                <span class="rm-notif-dot-sep">·</span>
                                <span><i class="bi bi-clock me-1"></i>@HienThi.NgayGio(item.NgayTao)</span>
                                <span class="rm-notif-goto ms-auto">
                                    @hint <i class="bi bi-arrow-right-short"></i>
                                </span>
                            </div>
                        </div>
                    </a>

                    @if (!item.DaDoc)
                    {
                        <form asp-action="MarkRead" method="post" class="rm-notif-side-action">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MaThongBao" />
                            <input type="hidden" name="page" value="@Model.Page" />
                            <input type="hidden" name="filter" value="@Model.Filter" />
                            <button type="submit" class="rm-notif-read-btn" title="@L["UserNotify_MarkRead"]">
                                <i class="bi bi-check2"></i>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4">
            <span class="small text-muted">@L["UserNotify_Total", Model.TotalItems]</span>
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex gap-2 align-items-center">
                    @if (Model.Page > 1)
                    {
                        <a class="btn-rm-outline py-1 px-3 small rounded-pill" asp-route-page="@(Model.Page - 1)" asp-route-filter="@Model.Filter">&larr; @L["Btn_Prev"]</a>
                    }
                    <span class="small text-muted">@L["Common_Page"] @Model.Page / @Math.Max(1, Model.TotalPages)</span>
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn-rm-outline py-1 px-3 small rounded-pill" asp-route-page="@(Model.Page + 1)" asp-route-filter="@Model.Filter">@L["Btn_Next"] &rarr;</a>
                    }
                </div>
            }
        </div>
    }
</div>
