@model PagedResult<MyProductVm>
@{
    ViewData["Title"] = L["Seller_Title"];
}

<div class="rm-main-content" style="padding-top:8px">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 style="font-family:'Playfair Display',serif; font-size:24px;">@L["Seller_Title"]</h2>
            <p class="text-muted mb-0" style="font-size:13.5px;">@L["Seller_Desc"]</p>
        </div>
        <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-rm-primary">+ @L["Nav_SellNow"]</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rm-empty-state">
            <h3>@L["Seller_EmptyTitle"]</h3>
            <p>@L["Seller_EmptyDesc"]</p>
            <ol>
                <li>@L["Seller_EmptyTip1"]</li>
                <li>@L["Seller_EmptyTip2"]</li>
                <li>@L["Seller_EmptyTip3"]</li>
                <li>@L["Seller_EmptyTip4"]</li>
            </ol>
            <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
                <a asp-area="User" asp-controller="Shop" asp-action="Index" class="btn-rm-outline">@L["Seller_ShopSetup"]</a>
                <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-rm-primary">@L["Nav_SellNow"]</a>
            </div>
        </div>
    }
    else
    {
        <div class="card p-0 overflow-hidden shadow-sm border-0 rounded-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@L["Seller_ColProduct"]</th>
                            <th>@L["Seller_ColPrice"]</th>
                            <th>@L["Seller_ColStatus"]</th>
                            <th>@L["Seller_ColUpdated"]</th>
                            <th class="text-end">@L["Seller_ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(p.AnhDaiDien))
                                        {
                                            <img src="@p.AnhDaiDien" alt="" class="rounded" width="48" height="48" style="object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="rounded bg-light d-inline-block" style="width:48px;height:48px;"></span>
                                        }
                                        <div>
                                            <b>@p.Ten</b>
                                            <div class="text-muted small">@L["Seller_PhotoCount", p.SoLuongAnh]</div>
                                            @if (p.TrangThai == "REJECTED" && !string.IsNullOrWhiteSpace(p.LyDoTuChoiGanNhat))
                                            {
                                                <div class="small text-danger mt-1"><strong>@L["Seller_RejectReason"]</strong> @p.LyDoTuChoiGanNhat</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@(p.Gia is null ? "—" : HienThi.Tien(p.Gia.Value))</td>
                                <td><span class="st st-@p.TrangThai.ToLowerInvariant()">@HienThi.TrangThaiSanPham(p.TrangThai)</span></td>
                                <td class="small text-muted">@HienThi.NgayGio(p.NgayCapNhat)</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                        @if (p.TrangThai is "DRAFT" or "REJECTED" or "HIDDEN" or "REMOVED"
                                             || (p.TrangThai == "PENDING_REVIEW" && p.PhanTichThatBai))
                                        {
                                            <form asp-action="GuiDuyet" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn-rm-outline btn-sm">@(p.TrangThai == "PENDING_REVIEW" ? (string)L["Seller_Reanalyze"] : (string)L["Seller_SubmitReview"])</button>
                                            </form>
                                        }
                                        @if (p.TrangThai == "ACTIVE")
                                        {
                                            <form asp-action="An" method="post" class="d-inline" onsubmit="return confirm('@L["Seller_ConfirmHide"]');">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn-rm-secondary btn-sm">@L["Seller_Hide"]</button>
                                            </form>
                                        }
                                        @if (p.TrangThai != "PENDING_REVIEW" && p.TrangThai != "RESERVED" && p.TrangThai != "SOLD")
                                        {
                                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn-rm-secondary btn-sm text-decoration-none">@L["Seller_EditShort"]</a>
                                        }
                                        @if (p.TrangThai is "ACTIVE" or "RESERVED" or "SOLD")
                                        {
                                            <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn-rm-secondary btn-sm text-decoration-none">@L["Seller_ViewListing"]</a>
                                        }
                                        @if (p.TrangThai != "RESERVED" && p.TrangThai != "SOLD")
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('@L["Seller_ConfirmDelete"]');">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" style="padding: 4px 10px; font-size: 13px; border-radius: 6px;">@L["Btn_Delete"]</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pager" model="new PagerVm(Model.Page, Model.TotalPages)" />
    }
</div>
