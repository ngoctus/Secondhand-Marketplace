@model PagedResult<MyProductVm>
@{
    ViewData["Title"] = "Sản phẩm của tôi";

    static string TrangThaiSp(string s) => s switch
    {
        "DRAFT" => "Bản nháp",
        "PENDING_REVIEW" => "Đang chờ duyệt",
        "ACTIVE" => "Đang bán",
        "REJECTED" => "Bị từ chối",
        "HIDDEN" => "Đang ẩn",
        "RESERVED" => "Đã có đơn",
        "SOLD" => "Đã bán",
        "REMOVED" => "Đã gỡ",
        _ => s
    };
}

<div class="rm-main-content" style="padding-top:8px">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 style="font-family:'Playfair Display',serif; font-size:24px;">Sản phẩm của tôi</h2>
            <p class="text-muted mb-0" style="font-size:13.5px;">Quản lý danh sách sản phẩm của cửa hàng bạn.</p>
        </div>
        <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-rm-primary">+ Đăng bán</a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rm-empty-state">
            <h3>Bạn chưa có sản phẩm nào</h3>
            <p>Cửa hàng là bắt buộc trước khi đăng tin, và tin chỉ hiển thị công khai sau khi kiểm duyệt đạt.</p>
            <ol>
                <li>Vào Thiết lập cửa hàng, đặt tên shop và chọn khu vực sinh sống để người mua gần bạn tìm thấy tin của bạn.</li>
                <li>Đăng bán món đầu tiên với ảnh thật, giá rõ và mô tả đủ các ý hệ thống yêu cầu.</li>
                <li>Bấm "Lưu và gửi duyệt"; tin sẽ chuyển sang "Đang chờ duyệt".</li>
                <li>Theo dõi danh sách này — nếu bị từ chối, sửa theo lý do rồi gửi lại.</li>
            </ol>
            <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
                <a asp-area="User" asp-controller="Shop" asp-action="Index" class="btn-rm-outline">Thiết lập cửa hàng</a>
                <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-rm-primary">Đăng bán</a>
            </div>
        </div>
    }
    else
    {
        <div class="card p-0 overflow-hidden shadow-sm border-0 rounded-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>SẢN PHẨM</th>
                            <th>GIÁ</th>
                            <th>TRẠNG THÁI</th>
                            <th>CẬP NHẬT</th>
                            <th class="text-end">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(p.AnhDaiDien))
                                        {
                                            <img src="@p.AnhDaiDien" alt="" class="rounded" width="48" height="48" style="object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="rounded bg-light d-inline-block" style="width:48px;height:48px;"></span>
                                        }
                                        <div>
                                            <b>@p.Ten</b>
                                            <div class="text-muted small">@p.SoLuongAnh ảnh</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@(p.Gia is null ? "—" : HienThi.Tien(p.Gia.Value))</td>
                                <td><span class="st st-@p.TrangThai.ToLowerInvariant()">@TrangThaiSp(p.TrangThai)</span></td>
                                <td class="small text-muted">@HienThi.NgayGio(p.NgayCapNhat)</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                        @if (p.TrangThai is "DRAFT" or "REJECTED" or "HIDDEN" or "REMOVED"
                                             || (p.TrangThai == "PENDING_REVIEW" && p.PhanTichThatBai))
                                        {
                                            <form asp-action="GuiDuyet" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn-rm-outline btn-sm">@(p.TrangThai == "PENDING_REVIEW" ? "Phân tích lại" : "Gửi duyệt")</button>
                                            </form>
                                        }
                                        @if (p.TrangThai == "ACTIVE")
                                        {
                                            <form asp-action="An" method="post" class="d-inline" onsubmit="return confirm('Ẩn sản phẩm này khỏi trang bán?');">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn-rm-secondary btn-sm">Ẩn</button>
                                            </form>
                                        }
                                        @if (p.TrangThai != "PENDING_REVIEW" && p.TrangThai != "RESERVED" && p.TrangThai != "SOLD")
                                        {
                                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn-rm-secondary btn-sm text-decoration-none">Sửa</a>
                                        }
                                        @if (p.TrangThai is "ACTIVE" or "RESERVED" or "SOLD")
                                        {
                                            <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn-rm-secondary btn-sm text-decoration-none">Xem trang bán</a>
                                        }
                                        @if (p.TrangThai != "RESERVED" && p.TrangThai != "SOLD")
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này không? Thao tác này không thể hoàn tác.');">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" style="padding: 4px 10px; font-size: 13px; border-radius: 6px;">Xóa</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pager" model="new PagerVm(Model.Page, Model.TotalPages)" />
    }
</div>
