@model ProductFormVm

<div asp-validation-summary="All" class="text-danger small mb-2"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Ten" class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
        <input asp-for="Ten" class="form-control" maxlength="200" placeholder="VD: Áo khoác denim nam size L" />
        <span asp-validation-for="Ten" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Gia" class="form-label">Giá (đồng) <span class="text-danger">*</span></label>
        <input asp-for="Gia" type="number" min="1000" step="1000" class="form-control" placeholder="VD: 250000" />
        <span asp-validation-for="Gia" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="MaDanhMuc" class="form-label">Danh mục <span class="text-danger">*</span></label>
        <select asp-for="MaDanhMuc" class="form-select" asp-items="@(new SelectList(Model.DanhSachDanhMuc.Where(d => d.DangHienThi), "MaDanhMuc", "Ten"))">
            <option value="">— Chọn danh mục —</option>
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="MaTinhTrang" class="form-label">Tình trạng <span class="text-danger">*</span></label>
        <select asp-for="MaTinhTrang" class="form-select" asp-items="@(new SelectList(Model.DanhSachTinhTrang.Where(t => t.DangSuDung), "MaTinhTrang", "Ten"))">
            <option value="">— Chọn tình trạng —</option>
        </select>
    </div>

    <div class="col-12">
        <label asp-for="MoTa" class="form-label">Mô tả <span class="text-danger">*</span></label>
        <textarea asp-for="MoTa" class="form-control" rows="6" maxlength="4000"
                  data-mota-toithieu="20" data-mota-dem="motaDem" data-mota-trang-thai="motaTrangThai"
                  placeholder="Ví dụ: Áo khoác denim mua 2023, mặc khoảng 10 lần, không phai màu, không rách. Còn thiếu 1 cúc tay áo. Giao kèm móc treo, không hộp. Bán vì đổi phong cách."></textarea>
        <div class="d-flex justify-content-between flex-wrap gap-2 mt-1">
            <small class="text-muted" id="motaDem"></small>
            <small id="motaTrangThai" class="fw-semibold"></small>
        </div>
        <span asp-validation-for="MoTa" class="text-danger small"></span>

        @* B10: nhờ AI soạn trước mô tả từ thông tin đã nhập ở trên; người bán vẫn phải tự kiểm lại trước khi gửi duyệt. *@
        <div class="rm-ai-mota" id="aiGoiYMota">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <button type="button" class="btn-rm-outline btn-sm" data-ai-mota-goi hidden>Nhờ AI gợi ý mô tả</button>
                <small class="text-muted" data-ai-mota-trang-thai role="status"></small>
            </div>
            <div class="rm-ai-mota-preview" data-ai-mota-xem-truoc hidden>
                <div class="rm-ai-mota-label">Bản nháp AI gợi ý (kiểm tra lại thông tin trước khi dùng)</div>
                <div class="rm-ai-mota-text" data-ai-mota-noi-dung></div>
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <button type="button" class="btn-rm-primary btn-sm" data-ai-mota-dien>Điền vào ô mô tả</button>
                    <button type="button" class="btn-rm-outline btn-sm" data-ai-mota-bo-qua>Bỏ qua</button>
                </div>
            </div>
        </div>

        @* Gợi ý nội dung theo luật duyệt: thiếu một trong các ý này là tin dễ bị trả lại. *@
        <div class="rm-form-hint mt-2">
            <div class="rm-form-hint-title">Mô tả nên có đủ 5 ý</div>
            <ul>
                <li>Tình trạng thực tế: còn mới khoảng bao nhiêu %, đã sửa chữa gì chưa.</li>
                <li>Thời gian đã sử dụng và nguồn gốc (mua khi nào, ở đâu).</li>
                <li>Phụ kiện đi kèm: hộp, sạc, remote, hóa đơn... (nếu không có thì ghi rõ).</li>
                <li>Lỗi/hư hại còn lại: trầy, phai, thiếu cúc, tróc da... để người mua không bị bất ngờ.</li>
                <li>Lý do bán và cách giao hàng bạn chấp nhận (gặp trực tiếp hay gửi chuyển phát).</li>
            </ul>
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">Ảnh sản phẩm (tối đa 10, bắt buộc ≥ 1 khi gửi duyệt)</label>
        <input type="file" name="AnhMoi" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" multiple />
        <div class="form-text">Mỗi ảnh tối đa 5MB. Ảnh đầu tiên trong đợt tải lên sẽ là ảnh chính nếu sản phẩm chưa có ảnh chính.</div>
    </div>

    @if (Model.AnhHienTai.Count > 0)
    {
        <div class="col-12">
            <div class="d-flex flex-wrap gap-2">
                @foreach (var a in Model.AnhHienTai)
                {
                    <div class="border rounded-3 p-1 text-center" style="width:110px;">
                        <img src="@a.DuongDan" alt="" class="rounded-2 w-100" style="height:84px; object-fit:cover;" />
                        @if (a.LaAnhChinh)
                        {
                            <div class="small fw-semibold mt-1">Ảnh chính</div>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-link btn-sm p-0" formaction="@Url.Action("DatAnhChinh", new { id = Model.Id, maAnh = a.MaAnh })">
                                Đặt làm chính
                            </button>
                        }
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 d-block mx-auto"
                                formaction="@Url.Action("XoaAnh", new { id = Model.Id, maAnh = a.MaAnh })"
                                onclick="return confirm('Xóa ảnh này?');">Xóa</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="rm-form-actions">
    <button type="submit" class="btn-rm-primary">Lưu nháp</button>
    <button type="submit" name="GuiDuyet" value="true" class="btn-rm-secondary">Lưu và gửi duyệt</button>
</div>

<div class="rm-form-hint mt-3">
    <div class="rm-form-hint-title">Điều kiện để tin đăng được duyệt</div>
    <ul>
        <li>Tên từ 5 ký tự, giá lớn hơn 0.</li>
        <li>Mô tả từ 20 ký tự và có đủ các ý ở trên.</li>
        <li>Có ít nhất 1 ảnh thật của món đồ (tối đa 10 ảnh).</li>
        <li>Đã chọn danh mục và tình trạng còn hiệu lực.</li>
    </ul>
    <div class="mt-1">Lưu nháp khi chưa xong; hệ thống chỉ kiểm duyệt khi bạn bấm "Lưu và gửi duyệt".</div>
</div>
