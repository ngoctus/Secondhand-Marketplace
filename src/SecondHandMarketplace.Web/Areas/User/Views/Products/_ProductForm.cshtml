@model ProductFormVm
@{
    // Danh sách chọn theo ngôn ngữ hiện tại: SelectList gắn thẳng property "Ten" thì option luôn ra tiếng Việt.
    var danhMucItems = Model.DanhSachDanhMuc.Where(d => d.DangHienThi)
        .Select(d => new SelectListItem(HienThi.TenDanhMuc(d.Ten), d.MaDanhMuc.ToString())).ToList();
    var tinhTrangItems = Model.DanhSachTinhTrang.Where(t => t.DangSuDung)
        .Select(t => new SelectListItem(HienThi.TenTinhTrang(t.Ten), t.MaTinhTrang.ToString())).ToList();
}

<div asp-validation-summary="All" class="text-danger small mb-2"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Ten" class="form-label">@L["Form_Name"] <span class="text-danger">*</span></label>
        <input asp-for="Ten" class="form-control" maxlength="200" placeholder="@L["Form_NamePlaceholder"]" />
        <span asp-validation-for="Ten" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Gia" class="form-label">@L["Form_Price"] <span class="text-danger">*</span></label>
        <input asp-for="Gia" type="number" min="1000" step="1000" class="form-control" placeholder="@L["Form_PricePlaceholder"]" />
        <span asp-validation-for="Gia" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="MaDanhMuc" class="form-label">@L["Form_Category"] <span class="text-danger">*</span></label>
        <select asp-for="MaDanhMuc" class="form-select" asp-items="danhMucItems">
            <option value="">@L["Form_ChooseCategory"]</option>
        </select>
        <span asp-validation-for="MaDanhMuc" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="MaTinhTrang" class="form-label">@L["Form_Condition"] <span class="text-danger">*</span></label>
        <select asp-for="MaTinhTrang" class="form-select" asp-items="tinhTrangItems">
            <option value="">@L["Form_ChooseCondition"]</option>
        </select>
        <span asp-validation-for="MaTinhTrang" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="MoTa" class="form-label">@L["Form_Description"] <span class="text-danger">*</span></label>
        <textarea asp-for="MoTa" class="form-control" rows="6" maxlength="4000"
                  data-mota-toithieu="20" data-mota-dem="motaDem" data-mota-trang-thai="motaTrangThai"
                  placeholder="@L["Form_DescriptionPlaceholder"]"></textarea>
        <div class="d-flex justify-content-between flex-wrap gap-2 mt-1">
            <small class="text-muted" id="motaDem"></small>
            <small id="motaTrangThai" class="fw-semibold"></small>
        </div>
        <span asp-validation-for="MoTa" class="text-danger small"></span>

        @* B10: nhờ AI soạn trước mô tả từ thông tin đã nhập ở trên; người bán vẫn phải tự kiểm lại trước khi gửi duyệt. *@
        <div class="rm-ai-mota" id="aiGoiYMota">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <button type="button" class="btn-rm-outline btn-sm" data-ai-mota-goi hidden>@L["Form_AiSuggest"]</button>
                <small class="text-muted" data-ai-mota-trang-thai role="status"></small>
            </div>
            <div class="rm-ai-mota-preview" data-ai-mota-xem-truoc hidden>
                <div class="rm-ai-mota-label">@L["Form_AiDraftLabel"]</div>
                <div class="rm-ai-mota-text" data-ai-mota-noi-dung></div>
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <button type="button" class="btn-rm-primary btn-sm" data-ai-mota-dien>@L["Form_AiFill"]</button>
                    <button type="button" class="btn-rm-outline btn-sm" data-ai-mota-bo-qua>@L["Form_AiSkip"]</button>
                </div>
            </div>
        </div>

        @* Gợi ý nội dung theo luật duyệt: thiếu một trong các ý này là tin dễ bị trả lại. *@
        <div class="rm-form-hint mt-2">
            <div class="rm-form-hint-title">@L["Form_HintTitle"]</div>
            <ul>
                <li>@L["Form_Hint1"]</li>
                <li>@L["Form_Hint2"]</li>
                <li>@L["Form_Hint3"]</li>
                <li>@L["Form_Hint4"]</li>
                <li>@L["Form_Hint5"]</li>
            </ul>
        </div>
    </div>

    <div class="col-12">
        <label class="form-label">@L["Form_ImagesLabel"]</label>

        @* B-03: một input file thật (vẫn POST bình thường) nhưng người bán chọn bằng vùng kéo thả.
           Thứ tự ảnh xem trước bên dưới chính là thứ tự gửi đi, nên ảnh đầu làm được ảnh bìa. *@
        <div class="rm-dropzone" data-anh-vung>
            <input type="file" name="AnhMoi" class="rm-dropzone-input" accept=".jpg,.jpeg,.png,.webp,.gif" multiple
                   data-anh-input data-anh-con-lai="@(Math.Max(0, 10 - Model.AnhHienTai.Count))" />
            <span class="rm-dropzone-hint" aria-hidden="true">＋</span>
            <b>@L["Form_DropTitle"]</b>
            <small>@L["Form_DropHint"]</small>
        </div>
        <div class="rm-anh-loi" data-anh-loi role="alert" hidden></div>

        @if (Model.AnhHienTai.Count > 0)
        {
            <div class="rm-anh-danh-sach" data-anh-da-luu>
                <div class="rm-anh-danh-sach-nhan">@L["Form_UploadedPhotos"]</div>
                <div class="rm-anh-luoi">
                    @foreach (var a in Model.AnhHienTai)
                    {
                        @* Luôn render cả nhãn "Ảnh bìa" lẫn hai nút; CSS ẩn theo class .is-bia
                           để JavaScript chỉ cần bật/tắt một class khi gọi AJAX. *@
                        <figure class="rm-anh-item @(a.LaAnhChinh ? "is-bia" : null)" data-ma-anh="@a.MaAnh">
                            <img src="@a.DuongDan" alt="@L["Form_UploadedImageAlt"]" loading="lazy" />
                            <span class="rm-anh-bia">@L["Form_Cover"]</span>
                            <figcaption class="rm-anh-actions">
                                <button type="button" class="rm-anh-btn" data-anh-dat-chinh
                                        data-url="@Url.Action("DatAnhChinh", new { id = Model.Id, maAnh = a.MaAnh })">@L["Form_SetCover"]</button>
                                <button type="button" class="rm-anh-btn rm-anh-btn-xoa" data-anh-xoa
                                        data-url="@Url.Action("XoaAnh", new { id = Model.Id, maAnh = a.MaAnh })">@L["Btn_Delete"]</button>
                            </figcaption>
                        </figure>
                    }
                </div>
            </div>
        }

        <div class="rm-anh-danh-sach" data-anh-preview hidden>
            <div class="rm-anh-danh-sach-nhan">@L["Form_NewPhotos"]</div>
            <div class="rm-anh-luoi"></div>
        </div>

        <div class="form-text">
            @Html.Raw(L["Form_ImageNote"])
        </div>
    </div>
</div>

<div class="rm-form-actions">
    <button type="submit" class="btn-rm-primary">@L["Form_SaveDraft"]</button>
    <button type="submit" name="GuiDuyet" value="true" class="btn-rm-secondary">@L["Form_SaveAndSubmit"]</button>
</div>

<div class="rm-form-hint mt-3">
    <div class="rm-form-hint-title">@L["Form_ApproveTitle"]</div>
    <ul>
        <li>@L["Form_ApproveRule1"]</li>
        <li>@L["Form_ApproveRule2"]</li>
        <li>@L["Form_ApproveRule3"]</li>
        <li>@L["Form_ApproveRule4"]</li>
    </ul>
    <div class="mt-1">@L["Form_ApproveNote"]</div>
</div>
