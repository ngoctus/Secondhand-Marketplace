@model ProductFormVm
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="rm-main-content" style="padding-top:8px; max-width:860px; margin:0 auto;">
    <div class="card shadow-sm border-0 rounded-3 p-4">
        <h2 style="font-family:'Playfair Display',serif; font-size:22px;" class="mb-3">Sửa sản phẩm</h2>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <partial name="_ProductForm" model="Model" />
        </form>

        <p class="mt-3 mb-0"><a asp-action="Index">← Quay lại danh sách</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
