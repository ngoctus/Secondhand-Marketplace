@model ProductFormVm
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="rm-main-content" style="padding-top:8px; max-width:860px; margin:0 auto;">
    <div class="card shadow-sm border-0 rounded-3 p-4">
        <h2 style="font-family:'Playfair Display',serif; font-size:22px;" class="mb-3">Sửa sản phẩm</h2>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <partial name="_ProductForm" model="Model" />
        </form>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <a asp-action="Index" class="text-decoration-none">← Quay lại danh sách</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này?');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Xóa sản phẩm này</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
