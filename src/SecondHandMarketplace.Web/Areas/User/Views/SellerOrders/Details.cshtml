@model OrderDetailVm
@{
    ViewData["Title"] = "Đơn " + Model.MaDon;
    var tiep = OrderRules.TiepTheoChoNguoiBan(Model.Status);
    var duocHuy = OrderRules.NguoiBanDuocHuy(Model.Status);
}
<p class="muted mt-3"><a asp-action="Index">← Danh sách đơn bán</a></p>
<div class="page-head">
    <div><h2>Đơn @Model.MaDon</h2><p class="muted">Người mua: @Model.BuyerName · Đặt lúc @HienThi.NgayGio(Model.CreatedAt)</p></div>
    <span class="@HienThi.LopTrangThai(Model.Status)">@HienThi.TrangThaiDon(Model.Status, Model.HinhThucNhan)</span>
</div>

@if (Model.ActiveDisputeId.HasValue)
{
    <div class="alert alert-warning border border-warning p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h6 class="fw-bold mb-1"><i class="bi bi-shield-exclamation"></i> Đơn hàng đang có khiếu nại từ người mua</h6>
            <p class="small text-muted mb-0">Lý do: @Model.ActiveDisputeReason (@(Model.ActiveDisputeStatus == "OPEN" ? "Chờ bạn phản hồi" : "Đang xử lý"))</p>
        </div>
        <a asp-area="User" asp-controller="Disputes" asp-action="ChiTiet" asp-route-id="@Model.ActiveDisputeId.Value" class="btn btn-warning btn-sm fw-semibold rounded-pill px-3">
            Xem & Phản hồi &rarr;
        </a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.DeliveryWindow))
{
    <div class="alert alert-light border rounded-3"><strong>Khung giờ nhận:</strong> @Model.DeliveryWindow</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <partial name="_ChiTietDon" model="Model" />
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <h3>Xử lý đơn</h3>
            @if (Model.Status == "CANCELLED")
            {
                <div class="note">Đơn đã bị hủy bởi <b>@HienThi.NguoiThucHien(Model.CancelledBy ?? "")</b>. Lý do: @Model.CancelReason</div>
            }
            else if (Model.Status == "DELIVERED")
            {
                <div class="note">Bạn đã giao thành công. Đơn sẽ hoàn tất khi người mua xác nhận đã nhận hàng.</div>
            }
            else if (Model.Status == "COMPLETED")
            {
                <div class="note">Đơn đã hoàn tất, sản phẩm đã chuyển sang trạng thái đã bán.</div>
            }

            @* Task D5: Nút xác nhận nhận tiền thủ công (VietQR / Tiền mặt) *@
            @if (Model.PaymentStatus != "PAID" && Model.Status != "PENDING" && Model.Status != "CANCELLED")
            {
                <div class="rm-khung-tien mb-3">
                    <div class="rm-khung-tien-title">
                        <i class="bi bi-wallet2"></i>Thanh toán: <span>Chưa xác nhận tiền</span>
                    </div>
                    <div class="rm-khung-tien-note">
                        Kiểm tra tài khoản ngân hàng hoặc khi nhận tiền mặt xong, người bán bấm nút xác nhận bên dưới:
                    </div>
                    <form asp-action="XacNhanNhanTien" method="post" onsubmit="return confirm('Bạn xác nhận đã nhận đủ tiền @HienThi.Tien(Model.Total) từ người mua?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="primary full">
                            <i class="bi bi-check-circle-fill"></i> Đã nhận tiền thành công
                        </button>
                    </form>
                </div>
            }

            @foreach (var s in tiep)
            {
                <form asp-action="UpdateStatus" method="post" class="mb-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="@s" />
                    <button class="primary full" type="submit">@OrderRules.NhanHanhDong(s)</button>
                </form>
            }

            @if (duocHuy)
            {
                <hr />
                <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('Hủy đơn hàng này?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="CANCELLED" />
                    <div class="field">
                        <label for="LyDoHuy">Lý do hủy đơn (bắt buộc)</label>
                        <textarea id="LyDoHuy" name="reason" rows="3" required maxlength="500" placeholder="Ví dụ: Sản phẩm không còn như mô tả..."></textarea>
                    </div>
                    <button class="reject full" type="submit">Hủy đơn</button>
                </form>
            }
        </div>
    </div>
</div>
