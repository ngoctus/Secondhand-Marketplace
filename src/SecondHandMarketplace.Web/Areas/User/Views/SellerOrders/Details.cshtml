@model OrderDetailVm
@{
    ViewData["Title"] = string.Format(L["SellerOrder_DetailsTitle"].Value, Model.MaDon);
    var tiep = OrderRules.TiepTheoChoNguoiBan(Model.Status);
    var duocHuy = OrderRules.NguoiBanDuocHuy(Model.Status);
}
<p class="muted mt-3"><a asp-action="Index">@L["SellerOrder_BackToList"]</a></p>
<div class="page-head">
    <div><h2>@string.Format(L["SellerOrder_DetailsTitle"].Value, Model.MaDon)</h2><p class="muted">@string.Format(L["SellerOrder_BuyerPrefix"].Value, Model.BuyerName, HienThi.NgayGio(Model.CreatedAt))</p></div>
    <span class="@HienThi.LopTrangThai(Model.Status)">@HienThi.TrangThaiDon(Model.Status, Model.HinhThucNhan)</span>
</div>

@if (Model.ActiveDisputeId.HasValue)
{
    <div class="alert alert-warning border border-warning p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h6 class="fw-bold mb-1"><i class="bi bi-shield-exclamation"></i> @L["SellerOrder_DisputeAlertTitle"]</h6>
            <p class="small text-muted mb-0">@string.Format(L["SellerOrder_DisputeReason"].Value, Model.ActiveDisputeReason, (Model.ActiveDisputeStatus == "OPEN" ? L["SellerOrder_DisputeWaitingSeller"].Value : L["SellerOrder_DisputeProcessing"].Value))</p>
        </div>
        <a asp-area="User" asp-controller="Disputes" asp-action="ChiTiet" asp-route-id="@Model.ActiveDisputeId.Value" class="btn btn-warning btn-sm fw-semibold rounded-pill px-3">
            @L["SellerOrder_DisputeViewRespond"] &rarr;
        </a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.DeliveryWindow))
{
    <div class="alert alert-light border rounded-3"><strong>@L["SellerOrder_DeliveryWindow"]</strong> @Model.DeliveryWindow</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <partial name="_ChiTietDon" model="Model" />
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <h3>@L["SellerOrder_ProcessHeading"]</h3>
            @if (Model.PaymentStatus == "REFUND_DUE")
            {
                <div class="alert alert-warning">
                    <strong>@L["SellerOrder_RefundPendingTitle"]</strong>
                    <div class="small mt-1">@L["SellerOrder_RefundPendingNote"]</div>
                </div>
                <form asp-action="XacNhanHoanTien" method="post" class="mb-3"
                      onsubmit="return confirm('@L["SellerOrder_RefundConfirmPrompt"].Value');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="maGiaoDichHoan" class="form-label small">@L["SellerOrder_RefundReferenceLabel"]</label>
                    <input id="maGiaoDichHoan" name="maGiaoDichHoan" class="form-control mb-2" maxlength="100" />
                    <button type="submit" class="btn btn-success w-100">@L["SellerOrder_ConfirmRefundBtn"]</button>
                </form>
            }
            @if (Model.Status == "CANCELLED")
            {
                <div class="note">@string.Format(L["SellerOrder_CancelledNote"].Value, HienThi.NguoiThucHien(Model.CancelledBy ?? ""), Model.CancelReason)</div>
            }
            else if (Model.Status == "DELIVERED")
            {
                <div class="note">@L["SellerOrder_DeliveredNote"]</div>
            }
            else if (Model.Status == "COMPLETED")
            {
                <div class="note">@L["SellerOrder_CompletedNote"]</div>
            }

            @* Task D5: Nút xác nhận nhận tiền thủ công (VietQR / Tiền mặt) *@
            @if (Model.PaymentStatus != "PAID" && Model.Status != "PENDING" && Model.Status != "CANCELLED")
            {
                <div class="rm-khung-tien mb-3">
                    <div class="rm-khung-tien-title">
                        <i class="bi bi-wallet2"></i>@L["OrderDetail_PaymentSection"]: <span>@L["SellerOrder_UnconfirmedPayment"]</span>
                    </div>
                    <div class="rm-khung-tien-note">
                        @L["SellerOrder_PaymentVerifyPrompt"]
                    </div>
                    <form asp-action="XacNhanNhanTien" method="post" onsubmit="return confirm('@string.Format(L["SellerOrder_ConfirmPaymentBtn"].Value) ?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-rm-primary full w-100">
                            <i class="bi bi-check-circle-fill"></i> @L["SellerOrder_ConfirmPaymentBtn"]
                        </button>
                    </form>
                </div>
            }

            @foreach (var s in tiep)
            {
                <form asp-action="UpdateStatus" method="post" class="mb-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="@s" />
                    <button class="btn btn-rm-primary full w-100" type="submit">@OrderRules.NhanHanhDong(s)</button>
                </form>
            }

            @if (duocHuy)
            {
                <hr />
                <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('@L["SellerOrder_CancelPrompt"].Value');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="CANCELLED" />
                    <div class="field mb-3">
                        <label for="LyDoHuy" class="form-label">@L["SellerOrder_CancelReasonLabel"]</label>
                        <textarea id="LyDoHuy" name="reason" class="form-control" rows="3" required maxlength="500" placeholder="@L["SellerOrder_CancelReasonPlaceholder"].Value"></textarea>
                    </div>
                    <button class="btn btn-outline-danger full w-100" type="submit">@L["SellerOrder_CancelSubmitBtn"]</button>
                </form>
            }
        </div>
    </div>
</div>
