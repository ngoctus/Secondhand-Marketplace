@model OrderListVm
@{
    ViewData["Title"] = L["SellerOrder_Title"];
    var tatCa = new[] { "PENDING", "CONFIRMED", "SHIPPING", "DELIVERED", "COMPLETED", "CANCELLED" };
}
<div class="page-head d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2>@L["SellerOrder_Title"]</h2><p class="muted">@L["SellerOrder_Subtitle"]</p></div>
    <div>
        <a asp-area="User" asp-controller="Reviews" asp-action="Shop" class="btn btn-rm-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-star me-1"></i> @L["SellerOrder_ViewReviews"]
        </a>
    </div>
</div>

<div class="status-tabs">
    <a class="@(Model.Status is null ? "on" : "")" asp-action="Index">@L["SellerOrder_FilterAll"] <b>@Model.Counts.Values.Sum()</b></a>
    @foreach (var s in tatCa)
    {
        <a class="@(Model.Status == s ? "on" : "")" asp-action="Index" asp-route-status="@s">@HienThi.TrangThaiDon(s) <b>@Model.Counts.GetValueOrDefault(s)</b></a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="status" value="@Model.Status" />
    <div class="col-md-6"><input name="q" value="@Model.Q" class="form-control" placeholder="@L["SellerOrder_SearchPlaceholder"].Value" /></div>
    <div class="col-auto"><button class="btn btn-rm-primary">@L["SellerOrder_SearchBtn"]</button></div>
</form>

@if (Model.Result.Items.Count == 0)
{
    <div class="empty panel rm-empty-state">@L["SellerOrder_Empty"]</div>
}
else
{
    <div class="panel table-wrap">
        <table class="table align-middle">
            <thead><tr><th>@L["SellerOrder_ColOrder"]</th><th>@L["SellerOrder_ColBuyer"]</th><th>@L["SellerOrder_ColTotal"]</th><th>@L["SellerOrder_ColPayment"]</th><th>@L["SellerOrder_ColStatus"]</th><th>@L["SellerOrder_ColDate"]</th><th class="text-end">@L["SellerOrder_ColAction"]</th></tr></thead>
            <tbody>
            @foreach (var o in Model.Result.Items)
            {
                <tr class="rm-order-row-card">
                    <td data-label="@(HienThi.Chon("Đơn hàng", "Order"))" class="rm-td-order-title">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(o.FirstImage)) { <img class="thumb" src="@o.FirstImage" alt="" data-fallback /> }
                            <div><b>@o.MaDon</b><div class="small text-muted">@o.FirstItem@(o.ItemCount > 1 ? $" +{o.ItemCount - 1} " + L["Cart_ItemCountSuffix"].Value : "")</div></div>
                        </div>
                    </td>
                    <td>@o.BuyerName</td>
                    <td><b>@HienThi.Tien(o.Total)</b></td>
                    <td class="small">@HienThi.PhuongThucThanhToan(o.PaymentMethod)<br />@HienThi.TrangThaiThanhToan(o.PaymentStatus)</td>
                    <td><span class="@HienThi.LopTrangThai(o.Status)">@HienThi.TrangThaiDon(o.Status)</span></td>
                    <td class="small">@HienThi.NgayGio(o.CreatedAt)</td>
                    <td class="text-end"><a class="btn btn-rm-outline btn-sm rounded-pill text-decoration-none" asp-action="Details" asp-route-id="@o.Id">@L["SellerOrder_ProcessBtn"]</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="new PagerVm(Model.Result.Page, Model.Result.TotalPages)" />
}
