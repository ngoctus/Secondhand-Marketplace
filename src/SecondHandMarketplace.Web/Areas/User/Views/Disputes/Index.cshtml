@model List<SecondHandMarketplace.Web.Models.ViewModels.Disputes.TranhChapDetailViewModel>
@{
    ViewData["Title"] = L["Dispute_MenuTitle"];
    var userId = User.LayNguoiDungId() ?? 0;
}

<div class="container my-4" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="bi bi-shield-exclamation text-warning"></i> @L["Dispute_MenuTitle"]</h2>
            <p class="text-muted small mb-0">@L["Dispute_Subtitle"]</p>
        </div>
        <a asp-area="User" asp-controller="Orders" asp-action="Index" class="btn btn-rm-secondary btn-sm rounded-pill px-3">
            &larr; @L["Dispute_BackToOrders"]
        </a>
    </div>

    <partial name="_ThongBao" />

    @if (!Model.Any())
    {
        <div class="card text-center p-5 border-0 rounded-4 shadow-sm bg-white my-4 rm-empty-state">
            <div class="card-body">
                <div class="display-3 text-muted mb-3">🛡️</div>
                <h4 class="fw-bold text-dark mb-2">@L["Dispute_EmptyTitle"]</h4>
                <p class="text-secondary small mb-4">@L["Dispute_EmptyDesc"]</p>
                <a asp-area="User" asp-controller="Orders" asp-action="Index" class="btn btn-rm-primary rounded-pill px-4 py-2 fw-semibold">
                    @L["Dispute_ViewOrders"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-4">@L["Dispute_ColOrder"]</th>
                            <th>@L["Dispute_ColRole"]</th>
                            <th>@L["Dispute_ColPartner"]</th>
                            <th>@L["Dispute_ColReason"]</th>
                            <th>@L["Dispute_ColOpenDate"]</th>
                            <th>@L["Dispute_ColStatus"]</th>
                            <th class="text-end pe-4">@L["Dispute_ColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.TrangThai switch
                            {
                                "OPEN" => "bg-warning text-dark",
                                "PROCESSING" => "bg-info text-dark",
                                "RESOLVED" => "bg-success text-white",
                                "REJECTED" => "bg-secondary text-white",
                                _ => "bg-light text-dark"
                            };

                            var statusText = HienThi.TrangThaiTranhChap(item.TrangThai);
                            var isBuyer = item.MaNguoiTao == userId;

                            <tr>
                                <td class="ps-4">
                                    <strong class="text-dark">#@item.MaDon</strong>
                                    <div class="small text-muted">@item.TongTien.ToString("N0") ₫</div>
                                </td>
                                <td>
                                    @if (isBuyer)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">@L["Dispute_RoleBuyer"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">@L["Dispute_RoleSeller"]</span>
                                    }
                                </td>
                                <td>
                                    @(isBuyer ? item.TenShop : item.TenNguoiTao)
                                </td>
                                <td style="max-width: 250px;">
                                    <div class="text-truncate small" title="@item.LyDo">@item.LyDo</div>
                                    @if (!string.IsNullOrEmpty(item.PhanQuyet))
                                    {
                                        <div class="small text-success text-truncate" title="@item.PhanQuyet">
                                            <i class="bi bi-check-circle"></i> @item.PhanQuyet
                                        </div>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @HienThi.NgayGio(item.NgayTao)
                                </td>
                                <td>
                                    <span class="badge @badgeClass rounded-pill px-2 py-1 small">@statusText</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="ChiTiet" asp-route-id="@item.MaTranhChap" class="btn btn-rm-outline btn-sm rounded-pill px-3">
                                        @L["Dispute_DetailsBtn"] &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
