@model List<SecondHandMarketplace.Web.Models.ViewModels.Disputes.TranhChapDetailViewModel>
@{
    ViewData["Title"] = "Khiếu nại & Tranh chấp";
    var userId = User.LayNguoiDungId() ?? 0;
}

<div class="container my-4" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="bi bi-shield-exclamation text-warning"></i> Khiếu nại & Tranh chấp</h2>
            <p class="text-muted small mb-0">Theo dõi tiến trình giải quyết khiếu nại các đơn hàng của bạn.</p>
        </div>
        <a asp-area="User" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            &larr; Xem danh sách đơn mua
        </a>
    </div>

    <partial name="_ThongBao" />

    @if (!Model.Any())
    {
        <div class="card text-center p-5 border-0 rounded-4 shadow-sm bg-white my-4">
            <div class="card-body">
                <div class="display-3 text-muted mb-3">🛡️</div>
                <h4 class="fw-bold text-dark mb-2">Chưa có khiếu nại nào</h4>
                <p class="text-secondary small mb-4">Bạn hiện không có bất kỳ tranh chấp hay khiếu nại đơn hàng nào đang chờ xử lý.</p>
                <a asp-area="User" asp-controller="Orders" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                    Xem các đơn hàng đã đặt
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-4">Mã đơn hàng</th>
                            <th>Vai trò</th>
                            <th>Đối tác giao dịch</th>
                            <th>Lý do khiếu nại</th>
                            <th>Ngày mở</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.TrangThai switch
                            {
                                "OPEN" => "bg-warning text-dark",
                                "PROCESSING" => "bg-info text-dark",
                                "RESOLVED" => "bg-success text-white",
                                "REJECTED" => "bg-secondary text-white",
                                _ => "bg-light text-dark"
                            };

                            var statusText = item.TrangThai switch
                            {
                                "OPEN" => "Chờ phản hồi",
                                "PROCESSING" => "Đang xử lý",
                                "RESOLVED" => "Đã giải quyết",
                                "REJECTED" => "Đã từ chối",
                                _ => item.TrangThai
                            };

                            var isBuyer = item.MaNguoiTao == userId;

                            <tr>
                                <td class="ps-4">
                                    <strong class="text-dark">#@item.MaDon</strong>
                                    <div class="small text-muted">@item.TongTien.ToString("N0") ₫</div>
                                </td>
                                <td>
                                    @if (isBuyer)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Người mua</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">Người bán (Shop)</span>
                                    }
                                </td>
                                <td>
                                    @(isBuyer ? item.TenShop : item.TenNguoiTao)
                                </td>
                                <td style="max-width: 250px;">
                                    <div class="text-truncate small" title="@item.LyDo">@item.LyDo</div>
                                    @if (!string.IsNullOrEmpty(item.PhanQuyet))
                                    {
                                        <div class="small text-success text-truncate" title="@item.PhanQuyet">
                                            <i class="bi bi-check-circle"></i> @item.PhanQuyet
                                        </div>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="badge @badgeClass rounded-pill px-2 py-1 small">@statusText</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="ChiTiet" asp-route-id="@item.MaTranhChap" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                        Chi tiết &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
