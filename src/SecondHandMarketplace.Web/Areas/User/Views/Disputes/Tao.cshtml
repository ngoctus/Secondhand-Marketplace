@model SecondHandMarketplace.Web.Models.ViewModels.Disputes.MoTranhChapViewModel
@{
    ViewData["Title"] = string.Format(L["Dispute_CreateTitle"].Value, Model.MaDon);
}

<div class="container my-4" style="max-width: 700px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">@L["Dispute_BreadcrumbRoot"]</a></li>
            <li class="breadcrumb-item active text-dark" aria-current="page">@L["Dispute_CreateBreadcrumb"]</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="display-5 text-warning mb-2">🛡️</div>
            <h2 class="h4 fw-bold text-dark">@L["Dispute_CreateHeading"]</h2>
            <p class="text-muted small">@L["Dispute_CreateSubtitle"]</p>
        </div>

        <partial name="_ThongBao" />

        <div class="p-3 bg-light rounded-3 mb-4 border">
            <div class="row g-2 small">
                <div class="col-6">
                    <span class="text-muted d-block">@L["Dispute_ColOrder"]:</span>
                    <strong class="text-dark">#@Model.MaDon</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block">@L["OrderDetail_ShopLabel"]</span>
                    <strong class="text-dark">@Model.TenShop</strong>
                </div>
                <div class="col-12 pt-2 border-top mt-2">
                    <span class="text-muted">@L["Checkout_TotalPayment"]</span>
                    <strong class="text-success ms-1">@Model.TongTien.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>

        <form asp-action="Tao" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaDonHang" />
            <input type="hidden" asp-for="MaDon" />
            <input type="hidden" asp-for="TenShop" />
            <input type="hidden" asp-for="TongTien" />

            <div class="mb-3">
                <label asp-for="LyDo" class="form-label fw-semibold text-dark">@L["Dispute_CreateReasonLabel"] <span class="text-danger">*</span></label>
                <textarea asp-for="LyDo" rows="4" class="form-control rounded-3" required
                          placeholder="@L["Dispute_CreateReasonPlaceholder"].Value"></textarea>
                <span asp-validation-for="LyDo" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-dark">@L["Dispute_CreateEvidenceLabel"]</label>
                <div class="mb-2">
                    <input asp-for="FileDinhKem" type="file" class="form-control rounded-3" accept="image/png,image/jpeg,image/webp" />
                    <span asp-validation-for="FileDinhKem" class="text-danger small"></span>
                </div>
                <div class="form-text small mb-2">@L["Dispute_CreateOrUrl"]</div>
                <input asp-for="BangChungAnh" type="text" class="form-control rounded-3 form-control-sm"
                       placeholder="@L["Dispute_CreateUrlPlaceholder"].Value" />
                <span asp-validation-for="BangChungAnh" class="text-danger small"></span>
                <div class="form-text small">@L["Dispute_CreateEvidenceTip"]</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning flex-grow-1 py-2 fw-semibold rounded-pill">
                    <i class="bi bi-shield-exclamation"></i> @L["Dispute_CreateSubmitBtn"]
                </button>
                <a asp-controller="Orders" asp-action="ChiTiet" asp-route-id="@Model.MaDonHang" class="btn btn-rm-secondary py-2 px-4 rounded-pill">
                    @L["Dispute_CreateCancelBtn"]
                </a>
            </div>
        </form>
    </div>
</div>
