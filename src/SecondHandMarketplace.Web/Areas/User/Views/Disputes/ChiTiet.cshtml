@model SecondHandMarketplace.Web.Models.ViewModels.Disputes.TranhChapDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết khiếu nại #{Model.MaTranhChap}";
    var userId = User.LayNguoiDungId() ?? 0;
    var isSeller = userId == Model.MaChuShop;
    var isBuyer = userId == Model.MaNguoiTao;

    var badgeClass = Model.TrangThai switch
    {
        "OPEN" => "bg-warning text-dark",
        "PROCESSING" => "bg-info text-dark",
        "RESOLVED" => "bg-success text-white",
        "REJECTED" => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };

    var statusText = Model.TrangThai switch
    {
        "OPEN" => "Chờ phản hồi",
        "PROCESSING" => "Đang xử lý",
        "RESOLVED" => "Đã giải quyết",
        "REJECTED" => "Đã từ chối",
        _ => Model.TrangThai
    };
}

<div class="container my-4" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Khiếu nại & Tranh chấp</a></li>
            <li class="breadcrumb-item active text-dark" aria-current="page">Khiếu nại #@Model.MaTranhChap</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                Khiếu nại đơn hàng #@Model.MaDon
                <span class="badge @badgeClass rounded-pill fs-6 ms-2">@statusText</span>
            </h2>
            <p class="text-muted small mb-0">Ngày mở: @Model.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            &larr; Quay lại danh sách
        </a>
    </div>

    <partial name="_ThongBao" />

    <!-- Tóm tắt đơn hàng -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-receipt text-primary me-1"></i> Thông tin đơn hàng</h6>
        <div class="row g-3 small">
            <div class="col-sm-6 col-md-3">
                <span class="text-muted d-block">Mã đơn hàng:</span>
                <strong class="text-dark">#@Model.MaDon</strong>
            </div>
            <div class="col-sm-6 col-md-3">
                <span class="text-muted d-block">Cửa hàng bán:</span>
                <strong class="text-dark">@Model.TenShop</strong>
            </div>
            <div class="col-sm-6 col-md-3">
                <span class="text-muted d-block">Người mua đặt hàng:</span>
                <strong class="text-dark">@Model.TenNguoiTao</strong>
            </div>
            <div class="col-sm-6 col-md-3">
                <span class="text-muted d-block">Tổng tiền đơn:</span>
                <strong class="text-success fs-6">@Model.TongTien.ToString("N0") ₫</strong>
            </div>
        </div>
    </div>

    <!-- Nội dung khiếu nại của người mua -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-chat-left-dots text-warning me-1"></i> Khiếu nại từ người mua (@Model.TenNguoiTao)</h6>
        <p class="text-dark mb-3" style="line-height: 1.6; white-space: pre-line;">@Model.LyDo</p>

        @if (!string.IsNullOrEmpty(Model.BangChungAnh))
        {
            <div class="mt-2">
                <span class="text-muted small d-block mb-2">Ảnh bằng chứng đính kèm:</span>
                @if (UrlAnToan.HopLe(Model.BangChungAnh))
                {
                    <img src="@Model.BangChungAnh" alt="Bằng chứng khiếu nại" class="img-thumbnail rounded-3" style="max-height: 250px; object-fit: contain;" />
                }
            </div>
        }
    </div>

    <!-- Phản hồi từ người bán (Shop) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-shop text-info me-1"></i> Phản hồi từ người bán (@Model.TenShop)</h6>

        @if (!string.IsNullOrEmpty(Model.PhanHoiNguoiBan))
        {
            <div class="p-3 bg-light rounded-3 text-dark border" style="line-height: 1.6; white-space: pre-line;">
                @Model.PhanHoiNguoiBan
            </div>
            <div class="small text-muted mt-2 text-end">Cập nhật lúc: @Model.NgayCapNhat.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        }
        else
        {
            <div class="alert alert-secondary small mb-3">Người bán chưa gửi phản hồi giải trình cho khiếu nại này.</div>
        }

        <!-- Nếu người xem là Chủ Shop và khiếu nại đang OPEN hoặc PROCESSING (chưa kết thúc), hiển thị form gửi phản hồi -->
        @if (isSeller && (Model.TrangThai == "OPEN" || Model.TrangThai == "PROCESSING"))
        {
            <div class="mt-3 pt-3 border-top">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-reply-fill text-primary"></i> Gửi phản hồi của cửa hàng</h6>
                <form asp-action="PhanHoi" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MaTranhChap" />
                    <div class="mb-3">
                        <textarea name="phanHoi" rows="3" class="form-control rounded-3" required
                                  placeholder="Nhập giải trình của cửa hàng, tình trạng đóng gói, đối soát với bên vận chuyển... (tối đa 1000 ký tự)"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-send"></i> Gửi phản hồi khiếu nại
                    </button>
                </form>
            </div>
        }
    </div>

    <!-- Phán quyết xử lý của Ban quản trị -->
    @if (!string.IsNullOrEmpty(Model.PhanQuyet) || Model.TrangThai == "RESOLVED" || Model.TrangThai == "REJECTED")
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 border-start border-4 border-success">
            <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-shield-check text-success me-1"></i> Quyết định của Ban quản trị</h6>
            <div class="alert alert-success fw-semibold mb-2">
                @Model.PhanQuyet
            </div>
            @if (!string.IsNullOrEmpty(Model.GhiChuAdmin))
            {
                <div class="small text-secondary mb-2">
                    <strong>Ghi chú từ BQT:</strong> @Model.GhiChuAdmin
                </div>
            }
            <div class="small text-muted d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                <span>Người giải quyết: <strong>@(Model.TenNguoiXuLy ?? "Ban quản trị")</strong></span>
                <span>Thời gian: @(Model.NgayGiaiQuyet?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
            </div>
        </div>
    }
</div>
