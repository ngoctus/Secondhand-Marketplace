@model SecondHandMarketplace.Web.Models.ViewModels.Reviews.DanhSachDanhGiaTheoShopVm
@{
    ViewData["Title"] = L["ShopRevMgr_Title"].Value;
}

<div class="container my-4" style="max-width: 950px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1 font-serif">
                <i class="bi bi-shop me-1" style="color: var(--color-primary);"></i> @L["ShopRevMgr_Title"]
            </h2>
            <div class="text-muted small">@L["ShopRevMgr_Subtitle"]</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="User" asp-controller="Reviews" asp-action="Index" class="btn-rm-outline rounded-pill py-1 px-3 small">
                <i class="bi bi-star me-1"></i> @L["ShopRevMgr_BtnWritten"]
            </a>
            <a asp-area="User" asp-controller="SellerOrders" asp-action="Index" class="btn-rm-outline rounded-pill py-1 px-3 small">
                <i class="bi bi-box-seam me-1"></i> @L["ShopRevMgr_BtnSellerOrders"]
            </a>
        </div>
    </div>

    @if (Model.MaCuaHang == 0)
    {
        <div class="card text-center p-5 border-0 rounded-4 shadow-sm bg-white my-4">
            <div class="card-body">
                <div class="display-3 text-muted mb-3">
                    <i class="bi bi-shop-window"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">@L["ShopRevMgr_NoShopTitle"]</h4>
                <p class="text-secondary small mb-4" style="max-width: 480px; margin: 0 auto;">
                    @L["ShopRevMgr_NoShopDesc"]
                </p>
                <a asp-area="User" asp-controller="Shop" asp-action="Index" class="btn-rm-primary rounded-pill px-4 py-2">
                    @L["ShopRevMgr_BtnCreateShop"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="row align-items-center g-3">
                <div class="col-md-7">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 60px; height: 60px; font-size: 26px;">
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-1">@Model.TenShop</h4>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fs-4 fw-bold text-warning">@(Model.DiemTrungBinh > 0 ? Model.DiemTrungBinh.ToString("0.0") : L["ShopRevMgr_NoScore"].Value)</span>
                                <span class="text-warning small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(Model.DiemTrungBinh))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted opacity-25"></i>
                                        }
                                    }
                                </span>
                                <span class="text-muted small">• @L["ShopRev_TotalReviews", Model.TotalItems]</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 text-md-end">
                    @if (Model.DiemTrungBinh >= 4.5m && Model.TotalItems >= 3)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-6">
                            <i class="bi bi-shield-fill-check me-1"></i> @L["ShopRevMgr_BadgeExcellent"]
                        </span>
                    }
                    else if (Model.DiemTrungBinh >= 4.0m)
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6">
                            <i class="bi bi-hand-thumbs-up-fill me-1"></i> @L["ShopRevMgr_BadgePositive"]
                        </span>
                    }
                    else if (Model.TotalItems > 0 && Model.DiemTrungBinh < 3.0m)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fs-6">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @L["ShopRevMgr_BadgeImprove"]
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border px-3 py-2 rounded-pill fs-6">
                            <i class="bi bi-shop me-1"></i> @L["ShopRevMgr_BadgeActive"]
                        </span>
                    }
                </div>
            </div>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="card text-center p-5 border-0 rounded-4 shadow-sm bg-white my-4">
                <div class="card-body">
                    <div class="display-3 text-muted mb-3">
                        <i class="bi bi-chat-heart"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">@L["ShopRevMgr_EmptyTitle"]</h5>
                    <p class="text-secondary small mb-0">@L["ShopRevMgr_EmptyDesc"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var review in Model.Items)
                {
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4" id="review-@review.MaDanhGia">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 pb-3 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(review.AnhDaiDienNguoiMua))
                                {
                                    <img src="@review.AnhDaiDienNguoiMua" alt="@review.TenNguoiMua"
                                         width="40" height="40" class="rounded-circle border" style="object-fit:cover" />
                                }
                                else
                                {
                                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold"
                                         style="width: 40px; height: 40px; background-color: var(--color-primary);">
                                        @(string.IsNullOrWhiteSpace(review.TenNguoiMua) ? "U" : review.TenNguoiMua.Substring(0, 1).ToUpperInvariant())
                                    </div>
                                }
                                <div>
                                    <div class="fw-bold text-dark">@review.TenNguoiMua</div>
                                    <div class="text-muted small" style="font-size: 11.5px;">
                                        <i class="bi bi-clock me-1"></i>@HienThi.NgayGio(review.NgayTao)
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-1">
                                @for (byte s = 1; s <= 5; s++)
                                {
                                    if (s <= review.SoSao)
                                    {
                                        <i class="bi bi-star-fill text-warning fs-5"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-secondary fs-5 opacity-50"></i>
                                    }
                                }
                                <span class="ms-1 fw-bold text-dark">@L["ShopRevMgr_StarUnit", review.SoSao]</span>
                            </div>
                        </div>

                        <div class="py-3">
                            <div class="text-muted small mb-1">@L["ShopRevMgr_BuyerCommentLabel"]</div>
                            @if (!string.IsNullOrWhiteSpace(review.NoiDung))
                            {
                                <p class="text-dark mb-0 p-3 rounded-3 border" style="white-space: pre-line; background-color: var(--color-surface); border-color: var(--color-border-subtle) !important;">@review.NoiDung</p>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0 p-2 rounded-2 small" style="background-color: var(--color-surface);">
                                    <i class="bi bi-info-circle me-1"></i>@L["ShopRevMgr_NoBuyerComment"]
                                </p>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.PhanHoiShop))
                        {
                            <div class="p-3 rounded-3 bg-success-subtle border border-success-subtle mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-success small">
                                        <i class="bi bi-reply-fill me-1"></i>@L["ShopRevMgr_YourReplyLabel"]
                                    </strong>
                                    @if (review.NgayPhanHoi.HasValue)
                                    {
                                        <span class="text-muted" style="font-size: 11px;">@HienThi.NgayGio(review.NgayPhanHoi.Value)</span>
                                    }
                                </div>
                                <p class="text-dark small mb-0" style="white-space: pre-line;">@review.PhanHoiShop</p>
                            </div>
                        }

                        <div class="border-top pt-3">
                            <button class="btn-rm-outline rounded-pill py-1 px-3 small" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#reply-form-@review.MaDanhGia"
                                    aria-expanded="false" aria-controls="reply-form-@review.MaDanhGia">
                                <i class="bi bi-chat-right-text me-1"></i>
                                @(string.IsNullOrWhiteSpace(review.PhanHoiShop) ? L["ShopRevMgr_BtnWriteReply"].Value : L["ShopRevMgr_BtnEditReply"].Value)
                            </button>

                            <div class="collapse mt-3" id="reply-form-@review.MaDanhGia">
                                <form asp-action="PhanHoi" method="post" class="p-3 rounded-3 border" style="background-color: var(--color-surface); border-color: var(--color-border-subtle) !important;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MaDanhGia" value="@review.MaDanhGia" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString#review-@review.MaDanhGia" />

                                    <div class="mb-2">
                                        <label class="form-label fw-semibold small text-dark">
                                            @L["ShopRevMgr_ReplyFieldLabel"]
                                        </label>
                                        <textarea name="PhanHoi" class="form-control form-control-sm" rows="3" maxlength="1000"
                                                  placeholder="@L["ShopRevMgr_ReplyPlaceholder"]" required>@review.PhanHoiShop</textarea>
                                        <div class="form-text" style="font-size: 11.5px;">@L["ShopRevMgr_ReplyHint"]</div>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn-rm-outline rounded-pill py-1 px-3 small"
                                                data-bs-toggle="collapse" data-bs-target="#reply-form-@review.MaDanhGia">@L["Btn_Cancel"]</button>
                                        <button type="submit" class="btn-rm-primary rounded-pill py-1 px-4 small">
                                            <i class="bi bi-send me-1"></i>@L["ShopRevMgr_BtnSendReply"]
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="@L["MyRev_PaginationAria"]" class="d-flex justify-content-center">
                    <ul class="pagination pagination-sm">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            var isActive = p == Model.Page;
                            <li class="page-item @(isActive ? "active" : "")">
                                <a class="page-link rounded-pill px-3 mx-1 @(isActive ? "border-0 text-white" : "text-dark bg-white border")"
                                   style="@(isActive ? "background-color: var(--color-primary);" : "")"
                                   asp-action="Shop" asp-route-page="@p">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    }
</div>
