@model CreateAuctionVm
@{ ViewData["Title"] = L["E_AuctionCreate"]; }

<div class="container py-3">
    <div class="panel mx-auto" style="max-width:720px">
        <div class="section-label">@L["E_AuctionCreateEyebrow"]</div>
        <h1 class="h3">@L["E_AuctionCreate"]</h1>

        @if (Model.Products.Count == 0)
        {
            <div class="alert alert-info" role="status">@L["E_AuctionNoEligibleProducts"]</div>
            <a class="btn btn-rm-outline" asp-action="Index">@L["E_AuctionBackToList"]</a>
        }
        else
        {
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <label for="productSelect">@L["E_AuctionProduct"]
                    <select asp-for="ProductId" class="form-select" id="productSelect">
                        <option value="">@L["E_AuctionChooseProduct"]</option>
                        @foreach (var p in Model.Products)
                        {
                            <option value="@p.Id" data-price="@((long)p.Price)">@p.Name — @HienThi.Tien(p.Price)</option>
                        }
                    </select>
                </label>
                <div class="form-row">
                    <label for="startPrice">@L["E_AuctionStartPriceLabel"]<input asp-for="StartPrice" type="number" min="1000" step="1000" id="startPrice" class="form-control" /></label>
                    <label asp-for="Step">@L["E_AuctionStepLabel"]<input asp-for="Step" type="number" min="1000" step="1000" value="@(Model.Step ?? 10000)" class="form-control" /></label>
                </div>
                <div class="form-row">
                    <label asp-for="StartAt">@L["E_AuctionStartAtLabel"]
                        <input asp-for="StartAt" type="datetime-local" value="@HienThi.ChoInputGio(null)" class="form-control" />
                    </label>
                    <label asp-for="EndAt">@L["E_AuctionEndAtLabel"]
                        <input asp-for="EndAt" type="datetime-local" value="@(Model.EndAt?.ToString("yyyy-MM-dd'T'HH:mm"))" class="form-control" />
                    </label>
                </div>
                <div class="alert alert-light border mt-3">@L["E_AuctionCreateNote"]</div>
                <button class="btn btn-rm-primary w-100" type="submit">@L["E_AuctionCreate"]</button>
            </form>
        }
        <p class="mt-3"><a asp-action="Index">← @L["E_AuctionBackToList"]</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Gợi ý giá khởi điểm = 70% giá niêm yết khi chọn sản phẩm
        const sel = document.getElementById('productSelect'), price = document.getElementById('startPrice');
        sel?.addEventListener('change', () => {
            const p = Number(sel.selectedOptions[0]?.dataset.price || 0);
            if (p && !price.value) price.value = Math.max(1000, Math.round(p * 0.7 / 1000) * 1000);
        });
    </script>
}
