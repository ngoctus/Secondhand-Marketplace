@model PagedResult<AuctionCardVm>
@{ ViewData["Title"] = L["E_SellerAuctionsTitle"]; }

<div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div><h2>@L["E_SellerAuctionsTitle"]</h2><p class="muted mb-0">@L["E_SellerAuctionsSubtitle"]</p></div>
    <a class="btn btn-rm-primary text-decoration-none" asp-action="Create"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@L["E_AuctionCreate"]</a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty panel rm-empty-state">
        <i class="bi bi-hammer fs-2 d-block mb-2" aria-hidden="true"></i>
        <p>@L["E_SellerAuctionsEmpty"]</p>
        <a class="btn btn-rm-outline" asp-action="Create">@L["E_AuctionCreate"]</a>
    </div>
}
else
{
    <div class="panel table-wrap">
        <div class="table-responsive"><table class="table align-middle">
            <thead><tr><th scope="col">@L["E_AuctionProduct"]</th><th scope="col">@L["E_AuctionStartPrice"]</th><th scope="col">@L["E_AuctionCurrentPrice"]</th><th scope="col">@L["E_AuctionBidTotal"]</th><th scope="col">@L["E_AuctionPeriod"]</th><th scope="col">@L["E_AuctionStatus"]</th><th scope="col" class="text-end">@L["E_AuctionAction"]</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Items)
            {
                <tr>
                    <td class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(a.Image)) { <img class="thumb" src="@a.Image" alt="" loading="lazy" data-fallback /> }
                        <b>@a.ProductName</b>
                    </td>
                    <td>@HienThi.Tien(a.StartPrice)</td>
                    <td><b>@HienThi.Tien(a.CurrentPrice)</b></td>
                    <td>@a.BidCount</td>
                    <td class="small">@HienThi.NgayGio(a.StartAt)<br />→ @HienThi.NgayGio(a.EndAt)</td>
                    <td>
                        <span class="@HienThi.LopTrangThai(a.Status)">@HienThi.TrangThaiPhien(a.Status)</span>
                        @if (a.Status == "ENDED" && a.WinnerName is not null) { <div class="small text-muted">@L["E_AuctionWinnerShort", a.WinnerName]</div> }
                        @if (a.Status == "CANCELLED" && !string.IsNullOrEmpty(a.CancelReason)) { <div class="small text-muted">@a.CancelReason</div> }
                    </td>
                    <td class="actions">
                        <a class="btn btn-rm-outline btn-sm rounded-pill text-decoration-none" asp-controller="PublicAuctions" asp-area="" asp-action="Details" asp-route-id="@a.Id">@L["E_AuctionView"]</a>
                        @if (a.Status is "RUNNING" or "SCHEDULED" && a.BidCount == 0)
                        {
                            <form asp-action="Cancel" method="post" onsubmit="return confirm('@L["E_AuctionCancelConfirm"].Value');">
                                <input type="hidden" name="id" value="@a.Id" />
                                <button class="btn btn-outline-danger btn-sm rounded-pill" type="submit">@L["E_AuctionCancel"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    </div>
    <partial name="_Pager" model="new PagerVm(Model.Page, Model.TotalPages)" />
}
