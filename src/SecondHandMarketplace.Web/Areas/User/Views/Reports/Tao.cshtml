@model SecondHandMarketplace.Web.Models.ViewModels.Reports.TaoBaoCaoViewModel
@{
    ViewData["Title"] = "Gửi báo cáo vi phạm";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" 
                  style="width: 42px; height: 42px; font-size: 20px;">
                <i class="bi bi-flag-fill"></i>
            </span>
            <div>
                <h4 class="fw-bold text-dark mb-0">Gửi báo cáo vi phạm</h4>
                <p class="text-muted small mb-0">Giúp cộng đồng Re:Market an toàn và minh bạch hơn.</p>
            </div>
        </div>

        <partial name="_ThongBao" />

        <form asp-area="User" asp-controller="Reports" asp-action="Tao" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LoaiDoiTuong" />
            <input type="hidden" asp-for="MaDoiTuong" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <!-- Thông tin đối tượng bị báo cáo -->
            <div class="p-3 bg-light rounded-3 border mb-3">
                <span class="text-muted small d-block">Đối tượng bị báo cáo:</span>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="badge bg-secondary rounded-pill small">@Model.LoaiDoiTuong</span>
                    <strong class="text-dark">@(string.IsNullOrEmpty(Model.TenDoiTuong) ? $"#{Model.MaDoiTuong}" : Model.TenDoiTuong)</strong>
                </div>
            </div>

            <!-- Lý do -->
            <div class="mb-3">
                <label asp-for="LyDo" class="form-label fw-semibold small text-dark">Lý do vi phạm <span class="text-danger">*</span></label>
                <select asp-for="LyDo" class="form-select rounded-3">
                    <option value="">-- Vui lòng chọn lý do --</option>
                    <option value="Hàng giả / Hàng nhái">Hàng giả / Hàng nhái</option>
                    <option value="Hàng cấm buôn bán">Hàng cấm buôn bán</option>
                    <option value="Lừa đảo / Gian lận thông tin">Lừa đảo / Gian lận thông tin</option>
                    <option value="Hình ảnh phản cảm / Vi phạm thuần phong mỹ tục">Hình ảnh phản cảm / Vi phạm thuần phong mỹ tục</option>
                    <option value="Người bán không trung thực về tình trạng">Người bán không trung thực về tình trạng</option>
                    <option value="Spam / Đăng tin lặp lại">Spam / Đăng tin lặp lại</option>
                    <option value="Khác">Lý do khác</option>
                </select>
                <span asp-validation-for="LyDo" class="text-danger small"></span>
            </div>

            <!-- Mô tả -->
            <div class="mb-4">
                <label asp-for="MoTa" class="form-label fw-semibold small text-dark">Mô tả cụ thể (tùy chọn)</label>
                <textarea asp-for="MoTa" rows="4" class="form-control rounded-3" placeholder="Cung cấp thêm chi tiết giúp Ban quản trị xác minh và xử lý nhanh chóng..."></textarea>
                <span asp-validation-for="MoTa" class="text-danger small"></span>
            </div>

            <!-- Nút gửi -->
            <div class="d-flex justify-content-between align-items-center">
                <a href="@(string.IsNullOrEmpty(ViewBag.ReturnUrl) ? "/" : ViewBag.ReturnUrl)" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    &larr; Hủy bỏ
                </a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold btn-sm">
                    <i class="bi bi-send me-1"></i> Gửi báo cáo
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
