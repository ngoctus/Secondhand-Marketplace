@model SecondHandMarketplace.Web.Models.ViewModels.Reports.TaoBaoCaoViewModel
@{
    ViewData["Title"] = L["Report_SubmitTitle"];
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" 
                  style="width: 42px; height: 42px; font-size: 20px;">
                <i class="bi bi-flag-fill"></i>
            </span>
            <div>
                <h4 class="fw-bold text-dark mb-0">@L["Report_SubmitTitle"]</h4>
                <p class="text-muted small mb-0">@L["Report_SubmitSubtitle"]</p>
            </div>
        </div>

        <partial name="_ThongBao" />

        <form asp-area="User" asp-controller="Reports" asp-action="Tao" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LoaiDoiTuong" />
            <input type="hidden" asp-for="MaDoiTuong" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <!-- Thông tin đối tượng bị báo cáo -->
            <div class="p-3 bg-light rounded-3 border mb-3">
                <span class="text-muted small d-block">@L["Report_TargetLabel"]</span>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="badge bg-secondary rounded-pill small">@Model.LoaiDoiTuong</span>
                    <strong class="text-dark">@(string.IsNullOrEmpty(Model.TenDoiTuong) ? $"#{Model.MaDoiTuong}" : Model.TenDoiTuong)</strong>
                </div>
            </div>

            <!-- Lý do -->
            <div class="mb-3">
                <label asp-for="LyDo" class="form-label fw-semibold small text-dark">@L["Report_ReasonLabel"] <span class="text-danger">*</span></label>
                <select asp-for="LyDo" class="form-select rounded-3">
                    <option value="">@L["Report_ReasonSelectDefault"]</option>
                    <option value="Hàng giả / Hàng nhái">@L["Report_ReasonFake"]</option>
                    <option value="Hàng cấm buôn bán">@L["Report_ReasonProhibited"]</option>
                    <option value="Lừa đảo / Gian lận thông tin">@L["Report_ReasonFraud"]</option>
                    <option value="Hình ảnh phản cảm / Vi phạm thuần phong mỹ tục">@L["Report_ReasonInappropriate"]</option>
                    <option value="Người bán không trung thực về tình trạng">@L["Report_ReasonDishonest"]</option>
                    <option value="Spam / Đăng tin lặp lại">@L["Report_ReasonSpam"]</option>
                    <option value="Khác">@L["Report_ReasonOther"]</option>
                </select>
                <span asp-validation-for="LyDo" class="text-danger small"></span>
            </div>

            <!-- Mô tả -->
            <div class="mb-4">
                <label asp-for="MoTa" class="form-label fw-semibold small text-dark">@L["Report_DescLabel"]</label>
                <textarea asp-for="MoTa" rows="4" class="form-control rounded-3" placeholder="@L["Report_DescPlaceholder"].Value"></textarea>
                <span asp-validation-for="MoTa" class="text-danger small"></span>
            </div>

            <!-- Nút gửi -->
            <div class="d-flex justify-content-between align-items-center">
                <a href="@(string.IsNullOrEmpty(ViewBag.ReturnUrl) || !Url.IsLocalUrl(ViewBag.ReturnUrl) ? "/" : ViewBag.ReturnUrl)" class="btn btn-rm-secondary rounded-pill px-3 btn-sm">
                    &larr; @L["Report_CancelBtn"]
                </a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold btn-sm">
                    <i class="bi bi-send me-1"></i> @L["Report_SubmitBtn"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
