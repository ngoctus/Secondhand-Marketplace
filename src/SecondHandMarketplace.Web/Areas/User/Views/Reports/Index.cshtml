@model List<SecondHandMarketplace.Web.Models.ViewModels.Reports.BaoCaoItemViewModel>
@{
    ViewData["Title"] = L["Report_HistoryTitle"];
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1"><i class="bi bi-shield-exclamation text-danger"></i> @L["Report_HistoryTitle"]</h2>
            <p class="text-muted small mb-0">@L["Report_HistorySubtitle"]</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="User" asp-controller="Reports" asp-action="TaoKyThuat" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-bug me-1"></i> @HienThi.Chon("Báo lỗi kỹ thuật", "Report Bug")
            </a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-rm-secondary btn-sm rounded-pill px-3">
                &larr; @L["Report_BackHome"]
            </a>
        </div>
    </div>

    <partial name="_ThongBao" />

    @if (!Model.Any())
    {
        <div class="card text-center p-5 shadow-sm border-0 bg-white rounded-4 rm-empty-state">
            <div class="card-body">
                <div class="display-4 text-muted mb-3">&#128737;</div>
                <h5 class="text-dark fw-bold">@L["Report_EmptyTitle"]</h5>
                <p class="text-secondary small mb-0">@L["Report_EmptyDesc"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>@L["Report_ColCode"]</th>
                            <th>@L["Report_ColTarget"]</th>
                            <th>@L["Report_ColReason"]</th>
                            <th>@L["Report_ColTime"]</th>
                            <th>@L["Report_ColStatus"]</th>
                            <th>@L["Report_ColAdminFeedback"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold font-monospace">#@item.MaBaoCao</td>
                                <td>
                                    @if (item.LoaiDoiTuong == "TECHNICAL")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle me-1">@HienThi.Chon("Kỹ thuật", "Technical")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary me-1">@item.LoaiDoiTuong</span>
                                    }
                                    <span class="fw-semibold">@item.TenDoiTuong</span>
                                </td>
                                <td>
                                    <div>@item.LyDo</div>
                                    @if (!string.IsNullOrEmpty(item.MoTa))
                                    {
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">@item.MoTa</small>
                                    }
                                </td>
                                <td class="text-muted small">@HienThi.NgayGio(item.NgayTao)</td>
                                <td>
                                    @switch (item.TrangThai)
                                    {
                                        case "PENDING":
                                            <span class="badge bg-warning text-dark rounded-pill">@L["Report_StatusPending"]</span>
                                            break;
                                        case "RESOLVED":
                                            <span class="badge bg-success rounded-pill">@L["Report_StatusResolved"]</span>
                                            break;
                                        case "DISMISSED":
                                            <span class="badge bg-secondary rounded-pill">@L["Report_StatusDismissed"]</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(item.GhiChuXuLy) ? "-" : item.GhiChuXuLy)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
