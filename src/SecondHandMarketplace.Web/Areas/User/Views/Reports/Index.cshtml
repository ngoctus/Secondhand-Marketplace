@model List<SecondHandMarketplace.Web.Models.ViewModels.Reports.BaoCaoItemViewModel>
@{
    ViewData["Title"] = "Lịch sử báo cáo của tôi";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1"><i class="bi bi-shield-exclamation"></i> Lịch sử báo cáo vi phạm</h2>
            <p class="text-muted small mb-0">Theo dõi tiến độ xử lý các báo cáo vi phạm bạn đã gửi.</p>
        </div>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Về trang chủ
        </a>
    </div>

    <partial name="_ThongBao" />

    @if (!Model.Any())
    {
        <div class="card text-center p-5 shadow-sm border-0 bg-light">
            <div class="card-body">
                <div class="display-4 text-muted mb-3">&#128737;</div>
                <h5 class="text-muted">Bạn chưa gửi báo cáo vi phạm nào</h5>
                <p class="text-secondary mb-0">Khi phát hiện sản phẩm hoặc cửa hàng có dấu hiệu vi phạm, hãy bấm nút <strong>"Báo cáo vi phạm"</strong> tại trang chi tiết sản phẩm hoặc cửa hàng để gửi phản ánh.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Mã</th>
                            <th>Đối tượng</th>
                            <th>Lý do</th>
                            <th>Thời gian gửi</th>
                            <th>Trạng thái</th>
                            <th>Phản hồi của Admin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.MaBaoCao</td>
                                <td>
                                    <span class="badge bg-secondary me-1">@item.LoaiDoiTuong</span>
                                    <span class="fw-semibold">@item.TenDoiTuong</span>
                                </td>
                                <td>
                                    <div>@item.LyDo</div>
                                    @if (!string.IsNullOrEmpty(item.MoTa))
                                    {
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">@item.MoTa</small>
                                    }
                                </td>
                                <td class="text-muted small">@item.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @switch (item.TrangThai)
                                    {
                                        case "PENDING":
                                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                            break;
                                        case "RESOLVED":
                                            <span class="badge bg-success">Đã xử lý</span>
                                            break;
                                        case "DISMISSED":
                                            <span class="badge bg-secondary">Bỏ qua</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(item.GhiChuXuLy) ? "-" : item.GhiChuXuLy)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
