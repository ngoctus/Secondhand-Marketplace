@model SecondHandMarketplace.Web.Models.ViewModels.Admin.AdminUsersVm
@{
    ViewData["Title"] = L["Admin_Users_Title"].Value;
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-bold mb-0">@L["Admin_Users_Title"]</h2>
        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
            @Model.TotalItems @L["Admin_Users_TotalLabel"]
        </span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input name="search" value="@Model.Search" class="form-control" placeholder="@L["Admin_Users_SearchPlaceholder"]" />
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">@L["Common_AllStatuses"]</option>
                        <option value="ACTIVE" selected="@(Model.Status == "ACTIVE")">@L["Common_Active"]</option>
                        <option value="LOCKED" selected="@(Model.Status == "LOCKED")">@L["Common_Locked"]</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary px-4"><i class="bi bi-funnel me-1"></i>@L["Btn_Filter"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">@L["Admin_Users_ColUser"]</th>
                        <th>@L["Account_Email"]</th>
                        <th>@L["Account_Phone"]</th>
                        <th>@L["Admin_Users_ColRole"]</th>
                        <th>@L["Admin_Users_ColStatusAppeal"]</th>
                        <th>@L["Common_CreatedAt"]</th>
                        <th class="pe-3">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@item.HoTen</td>
                            <td>@item.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(item.SoDienThoai) ? "—" : item.SoDienThoai)</td>
                            <td><span class="badge @(item.VaiTro == "ADMIN" ? "bg-danger" : "bg-secondary")">@item.VaiTro</span></td>
                            <td>
                                <span class="badge @(item.TrangThai == "ACTIVE" ? "bg-success" : "bg-danger")">
                                    @HienThi.TrangThaiTaiKhoan(item.TrangThai)
                                </span>
                                @if (item.SoLanBiKhoa > 0)
                                {
                                    <span class="badge @(item.SoLanBiKhoa >= 3 ? "bg-dark" : item.SoLanBiKhoa == 2 ? "bg-warning text-dark" : "bg-secondary") ms-1">
                                        @HienThi.Chon($"Khóa lần {item.SoLanBiKhoa}", $"Lock #{item.SoLanBiKhoa}")
                                    </span>
                                }
                                @if (item.PendingAppealId is int appealId)
                                {
                                    <div class="mt-1">
                                        <a class="badge bg-info text-dark text-decoration-none" asp-controller="AccountAppeals" asp-action="Details" asp-route-id="@appealId">
                                            <i class="bi bi-envelope-exclamation me-1"></i>@HienThi.Chon($"Có đơn khiếu nại #{appealId} (chờ duyệt)", $"Pending appeal #{appealId}")
                                        </a>
                                    </div>
                                }
                                @if (item.TrangThai == "LOCKED" && !string.IsNullOrWhiteSpace(item.LyDoKhoa))
                                {
                                    <div class="small text-muted mt-1">@item.LyDoKhoa</div>
                                }
                            </td>
                            <td>@HienThi.Ngay(item.NgayTao)</td>
                            <td class="pe-3">
                                @if (item.VaiTro != "ADMIN" && item.TrangThai == "ACTIVE")
                                {
                                    <form asp-action="Lock" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input name="reason" class="form-control form-control-sm" placeholder="@L["Admin_Users_LockReasonPlaceholder"]" required maxlength="500" />
                                        <button class="btn btn-sm btn-danger text-nowrap" type="submit">@L["Btn_Lock"]</button>
                                    </form>
                                }
                                else if (item.TrangThai == "LOCKED")
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (item.PendingAppealId is int pendingId)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" asp-controller="AccountAppeals" asp-action="Details" asp-route-id="@pendingId">@L["Admin_Users_ViewAppeal"]</a>
                                        }
                                        <form asp-action="Unlock" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="btn btn-sm btn-success" type="submit">@L["Btn_Unlock"]</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">@L["Common_NoData"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-muted">@Model.TotalItems @L["Admin_Users_TotalLabel"]</span>
        <div class="d-flex gap-2 align-items-center">
            @if (Model.Page > 1)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">@L["Btn_Prev"]</a>
            }
            <span class="small">@L["Common_Page"] @Model.Page / @Math.Max(1, Model.TotalPages)</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">@L["Btn_Next"]</a>
            }
        </div>
    </div>
</div>
