@model OrderDetailVm
@{
    ViewData["Title"] = L["E_OrderDetailTitle", Model.MaDon];
    var tiep = OrderRules.TiepTheoChoAdmin(Model.Status);
}
<p class="muted mt-3"><a asp-action="Index">← @L["E_OrderBackToList"]</a></p>
<div class="page-head">
    <div>
        <h2>@L["E_OrderDetailTitle", Model.MaDon]</h2>
        <p class="muted">@L["E_OrderBuyerShopMeta", Model.BuyerName, Model.ShopName, Model.SellerName, HienThi.NgayGio(Model.CreatedAt)]</p>
    </div>
    <span class="@HienThi.LopTrangThai(Model.Status)">@HienThi.TrangThaiDon(Model.Status)</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.DeliveryWindow))
{
    <div class="alert alert-light border rounded-3"><strong>@L["E_OrderDeliveryWindow"]</strong> @Model.DeliveryWindow</div>
}

<div class="row g-4">
    <div class="col-lg-8"><partial name="_ChiTietDon" model="Model" /></div>
    <div class="col-lg-4">
        <div class="panel">
            <h3>@L["E_OrderIntervene"]</h3>
            @if (Model.Status == "CANCELLED")
            {
                <div class="note">@L["E_OrderCancelledNote", HienThi.NguoiThucHien(Model.CancelledBy ?? ""), Model.CancelReason ?? ""]</div>
            }
            else if (tiep.Length == 0)
            {
                <div class="note">@L["E_OrderNoActions"]</div>
            }
            else
            {
                <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('@L["E_OrderStatusConfirm"]');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>@L["E_OrderChangeStatus"]
                        <select name="status" class="form-select">
                            @foreach (var s in tiep) { <option value="@s">@OrderRules.NhanHanhDong(s) → @HienThi.TrangThaiDon(s)</option> }
                        </select>
                    </label>
                    <label>@L["E_OrderReasonLabel"]
                        <textarea name="reason" class="form-control mt-1" rows="3" required minlength="5" maxlength="500"></textarea>
                    </label>
                    <button class="btn-rm-primary w-100 mt-3" type="submit">@L["E_OrderUpdateStatus"]</button>
                </form>
                <p class="muted mt-2">@L["E_OrderAuditNote"]</p>
            }
        </div>
    </div>
</div>
