@model AdminOrderListVm
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var f = Model.Filter;
}
<div class="page-head"><div><h2>Quản lý đơn hàng</h2><p class="muted">Toàn bộ đơn hàng trên sàn.</p></div></div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="q" value="@f.Q" class="form-control" placeholder="Mã đơn / tên người mua" /></div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">Mọi trạng thái</option>
            @foreach (var s in new[] { "PENDING", "CONFIRMED", "SHIPPING", "DELIVERED", "COMPLETED", "CANCELLED" })
            {
                <option value="@s" selected="@(f.Status == s)">@HienThi.TrangThaiDon(s)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="shopId" class="form-select">
            <option value="">Mọi cửa hàng</option>
            @foreach (var s in Model.Shops) { <option value="@s.Id" selected="@(f.ShopId == s.Id)">@s.Name</option> }
        </select>
    </div>
    <div class="col-md-2"><input type="date" name="from" value="@(f.From?.ToString("yyyy-MM-dd"))" class="form-control" title="Từ ngày" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@(f.To?.ToString("yyyy-MM-dd"))" class="form-control" title="Đến ngày" /></div>
    <div class="col-auto"><button class="btn btn-primary">Lọc</button> <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div>
</form>

<div class="panel table-wrap">
    <table class="table align-middle">
        <thead><tr><th>MÃ ĐƠN</th><th>NGƯỜI MUA</th><th>CỬA HÀNG</th><th>TỔNG TIỀN</th><th>THANH TOÁN</th><th>TRẠNG THÁI</th><th>NGÀY ĐẶT</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model.Result.Items)
        {
            <tr>
                <td><b>@o.MaDon</b><div class="small text-muted">@o.FirstItem@(o.ItemCount > 1 ? $" +{o.ItemCount - 1}" : "")</div></td>
                <td>@o.BuyerName</td>
                <td>@o.ShopName</td>
                <td><b>@HienThi.Tien(o.Total)</b></td>
                <td class="small">@HienThi.TrangThaiThanhToan(o.PaymentStatus)</td>
                <td><span class="@HienThi.LopTrangThai(o.Status)">@HienThi.TrangThaiDon(o.Status)</span></td>
                <td class="small">@HienThi.NgayGio(o.CreatedAt)</td>
                <td><a class="smallbtn text-decoration-none" asp-action="Details" asp-route-id="@o.Id">Chi tiết</a></td>
            </tr>
        }
        @if (Model.Result.Items.Count == 0) { <tr><td colspan="8" class="text-center text-muted">Không có đơn hàng nào.</td></tr> }
        </tbody>
    </table>
</div>
<div class="muted">Tổng @Model.Result.TotalItems đơn</div>
<partial name="_Pager" model="new PagerVm(Model.Result.Page, Model.Result.TotalPages)" />