@model AuctionDetailVm
@{
    ViewData["Title"] = string.Format(L["E_AuctionSessionTitle"].Value, Model.Id);
    var open = Model.Status is "RUNNING" or "SCHEDULED" or "ENDING";
}
<p class="muted mt-3"><a class="text-decoration-none" asp-action="Index">← @L["E_AuctionSessionsList"]</a></p>
<div class="page-head">
    <div><h2>@string.Format(L["E_AuctionSessionTitle"].Value, Model.Id) · @Model.ProductName</h2><p class="muted">@L["E_AuctionShopPrefix", Model.ShopName]</p></div>
    <span class="@HienThi.LopTrangThai(Model.Status)">@HienThi.TrangThaiPhien(Model.Status)</span>
</div>

<div class="kpi-grid">
    <div class="kpi"><b>@HienThi.Tien(Model.CurrentPrice)</b><span>@L["E_AuctionCurrentPrice"]</span></div>
    <div class="kpi"><b>@Model.BidCount</b><span>@L["E_AuctionBidTotal"]</span></div>
    <div class="kpi"><b>@HienThi.Tien(Model.Step)</b><span>@L["E_AuctionStepLabel"] (@HienThi.Tien(Model.StartPrice))</span></div>
</div>

<div class="panel">
    <div class="row">
        <div class="col-md-6"><b>@L["E_AuctionStartTimeLabel"]</b> @HienThi.NgayGio(Model.StartAt)</div>
        <div class="col-md-6"><b>@L["E_AuctionEndTimeLabel"]</b> @HienThi.NgayGio(Model.EndAt)</div>
    </div>
    @if (Model.Status == "ENDED" && Model.WinnerName is not null)
    {
        <p class="mt-2 mb-0">@L["E_AuctionWinnerAdmin", Model.WinnerName, HienThi.Tien(Model.WinningPrice ?? 0)]
            @if (Model.OrderId.HasValue) { <text> · </text><a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@L["E_AuctionViewOrder"]</a> }
        </p>
    }
    @if (Model.Status == "CANCELLED")
    {
        <p class="mt-2 mb-0">@L["E_AuctionCancelledBy", HienThi.NguoiThucHien(Model.CancelBy ?? ""), Model.CancelReason ?? "—"]</p>
    }
</div>

@if (open)
{
    <div class="panel">
        <h3>@L["E_AuctionCancelViolation"]</h3>
        <form asp-action="Cancel" method="post" onsubmit="return confirm('@L["E_AuctionCancelAdminConfirm"].Value');">
            <input type="hidden" name="id" value="@Model.Id" />
            <label class="form-label" for="cancel-auction-reason">@L["E_AuctionCancelReasonPlaceholder"]</label>
            <textarea id="cancel-auction-reason" name="reason" class="form-control" rows="3" required minlength="5" maxlength="500" placeholder="@L["E_AuctionCancelReasonPlaceholder"]"></textarea>
            <button class="btn btn-outline-danger mt-2" type="submit">@L["E_AuctionCancelSubmit"]</button>
        </form>
    </div>
}

<div class="panel">
    <h3>Lịch sử đặt giá (@Model.Bids.Count)</h3>
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th scope="col">@L["E_AuctionBidder"]</th><th scope="col">@L["E_AuctionAmount"]</th><th scope="col">@L["E_AuctionTime"]</th></tr></thead>
        <tbody>
        @foreach (var b in Model.Bids) { <tr><td>@b.Bidder</td><td><b>@HienThi.Tien(b.Amount)</b></td><td>@HienThi.NgayGio(b.At)</td></tr> }
        @if (Model.Bids.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">@L["E_AuctionNoBids"]</td></tr> }
        </tbody>
    </table></div>
</div>
