@model SecondHandMarketplace.Web.Models.ViewModels.Admin.AuditLogsVm
@{ ViewData["Title"] = "Nhật ký hệ thống"; }
<div class="container-fluid py-4">
    <h2>Nhật ký hệ thống</h2>
    <form method="get" class="row g-2 mb-3"><div class="col-md-2"><input name="userId" value="@Model.UserId" class="form-control" placeholder="Mã người dùng"/></div><div class="col-md-3"><input name="action" value="@Model.Action" class="form-control" placeholder="Hành động"/></div><div class="col-md-2"><input name="from" value="@Model.From?.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div><div class="col-md-2"><input name="to" value="@Model.To?.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Lọc</button></div></form>
    <div class="table-responsive"><table class="table table-striped table-sm align-middle"><thead><tr><th>Thời gian</th><th>Người thực hiện</th><th>Hành động</th><th>Đối tượng</th><th>Kết quả</th><th>Lý do / Chi tiết</th></tr></thead><tbody>
    @foreach(var log in Model.Items){<tr><td>@log.Time.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td>@(log.UserName ?? "Hệ thống") <small class="text-muted">#@log.UserId</small></td><td>@log.Action</td><td>@log.ObjectType #@log.ObjectId</td><td>@log.Result</td><td>@log.Reason @if(!string.IsNullOrWhiteSpace(log.Detail)){<div class="small text-muted">@log.Detail</div>}</td></tr>}
    @if(Model.Items.Count == 0){<tr><td colspan="6" class="text-center text-muted">Không có nhật ký.</td></tr>}
    </tbody></table></div>
    <div class="d-flex justify-content-between"><span>Tổng @Model.TotalItems bản ghi</span><div>@if(Model.Page>1){<a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page-1)" asp-route-userId="@Model.UserId" asp-route-action="@Model.Action" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Trước</a>} Trang @Model.Page / @Math.Max(1,Model.TotalPages) @if(Model.Page<Model.TotalPages){<a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page+1)" asp-route-userId="@Model.UserId" asp-route-action="@Model.Action" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">Sau</a>}</div></div>
</div>
