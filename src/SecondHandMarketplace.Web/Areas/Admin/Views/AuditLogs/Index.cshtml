@model SecondHandMarketplace.Web.Models.ViewModels.Admin.AuditLogsVm
@{
    ViewData["Title"] = L["Admin_Audit_Title"].Value;
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-bold mb-0">@L["Admin_Audit_Title"]</h2>
        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
            @Model.TotalItems @L["Admin_Audit_TotalRecords"]
        </span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-2">
                    <input name="userId" value="@Model.UserId" class="form-control" placeholder="@L["Admin_Audit_UserIdPlaceholder"]" />
                </div>
                <div class="col-md-3">
                    <input name="action" value="@Model.Action" class="form-control" placeholder="@L["Admin_Audit_ActionPlaceholder"]" />
                </div>
                <div class="col-md-2">
                    <input name="from" value="@Model.From?.ToString("yyyy-MM-dd")" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <input name="to" value="@Model.To?.ToString("yyyy-MM-dd")" type="date" class="form-control" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary px-4"><i class="bi bi-funnel me-1"></i>@L["Btn_Filter"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">@L["Admin_Audit_ColTime"]</th>
                        <th>@L["Admin_Audit_ColActor"]</th>
                        <th>@L["Admin_Audit_ColAction"]</th>
                        <th>@L["Admin_Audit_ColTarget"]</th>
                        <th>@L["Admin_Audit_ColResult"]</th>
                        <th class="pe-3">@L["Admin_Audit_ColReasonDetail"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Items)
                    {
                        <tr>
                            <td class="ps-3 text-nowrap">@HienThi.NgayGioGiay(log.Time)</td>
                            <td>@(log.UserName ?? L["Common_System"].Value) <small class="text-muted">#@log.UserId</small></td>
                            <td><code>@log.Action</code></td>
                            <td>@log.ObjectType #@log.ObjectId</td>
                            <td>
                                <span class="badge @(log.Result == "SUCCESS" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">@log.Result</span>
                            </td>
                            <td class="pe-3">
                                @log.Reason
                                @if (!string.IsNullOrWhiteSpace(log.Detail))
                                {
                                    <div class="small text-muted">@log.Detail</div>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">@L["Admin_Audit_Empty"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-muted">@Model.TotalItems @L["Admin_Audit_TotalRecords"]</span>
        <div class="d-flex gap-2 align-items-center">
            @if (Model.Page > 1)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page - 1)" asp-route-userId="@Model.UserId" asp-route-action="@Model.Action" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">@L["Btn_Prev"]</a>
            }
            <span class="small">@L["Common_Page"] @Model.Page / @Math.Max(1, Model.TotalPages)</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-route-page="@(Model.Page + 1)" asp-route-userId="@Model.UserId" asp-route-action="@Model.Action" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">@L["Btn_Next"]</a>
            }
        </div>
    </div>
</div>
