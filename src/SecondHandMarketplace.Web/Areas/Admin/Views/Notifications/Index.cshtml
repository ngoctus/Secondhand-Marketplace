@using System.Text.Json
@model SecondHandMarketplace.Web.Models.ViewModels.Notifications.AdminSendNotificationVm
@{
    ViewData["Title"] = L["AdminNotify_Title"].Value;
    var broadcastConfirmJs = JsonSerializer.Serialize(L["AdminNotify_ConfirmBroadcast"].Value);
}
<div class="container py-4" style="max-width:760px">
    <div class="mb-4">
        <h2 class="h4 fw-bold mb-1"><i class="bi bi-megaphone me-2 text-primary"></i>@L["AdminNotify_Title"]</h2>
        <p class="text-muted small mb-0">@L["AdminNotify_Subtitle"]</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Send" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold d-block">@L["AdminNotify_TargetLabel"]</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Target" value="USER" id="targetUser" />
                    <label class="form-check-label" for="targetUser">@L["AdminNotify_TargetUser"]</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Target" value="ALL" id="targetAll" />
                    <label class="form-check-label" for="targetAll">@L["AdminNotify_TargetAll"]</label>
                </div>
                <span asp-validation-for="Target" class="text-danger small d-block"></span>
            </div>

            <div class="mb-3" id="recipientGroup">
                <label asp-for="RecipientEmail" class="form-label fw-semibold">@L["AdminNotify_RecipientEmail"]</label>
                <input asp-for="RecipientEmail" class="form-control" maxlength="256" placeholder="@L["AdminNotify_RecipientPlaceholder"]" />
                <span asp-validation-for="RecipientEmail" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TieuDe" class="form-label fw-semibold">@L["AdminNotify_SubjectLabel"]</label>
                <input asp-for="TieuDe" class="form-control" maxlength="200" placeholder="@L["AdminNotify_SubjectPlaceholder"]" />
                <span asp-validation-for="TieuDe" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="NoiDung" class="form-label fw-semibold">@L["AdminNotify_BodyLabel"]</label>
                <textarea asp-for="NoiDung" class="form-control" rows="5" maxlength="1000" placeholder="@L["AdminNotify_BodyPlaceholder"]"></textarea>
                <span asp-validation-for="NoiDung" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary px-4 fw-semibold" id="sendButton">
                <i class="bi bi-send me-1"></i>@L["AdminNotify_SendBtn"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('sendButton').form;
            const group = document.getElementById('recipientGroup');
            const radios = document.querySelectorAll('input[name="Target"]');
            const isAll = () => document.getElementById('targetAll').checked;
            const sync = () => { group.hidden = isAll(); };
            radios.forEach(r => r.addEventListener('change', sync));
            sync();
            const confirmMsg = @Html.Raw(broadcastConfirmJs);
            // Gửi toàn hệ thống không thể thu hồi: hỏi xác nhận trước khi gửi.
            form.addEventListener('submit', e => {
                if (isAll() && !confirm(confirmMsg)) e.preventDefault();
            });
        })();
    </script>
}
