@model SecondHandMarketplace.Web.Models.ViewModels.Notifications.AdminSendNotificationVm
@{
    ViewData["Title"] = "Gửi thông báo hệ thống";
}
<div class="container py-4" style="max-width:720px">
    <h2>Gửi thông báo hệ thống</h2>
    <form asp-action="Send" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label d-block">Gửi tới</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Target" value="USER" id="targetUser" />
                <label class="form-check-label" for="targetUser">Một người dùng</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Target" value="ALL" id="targetAll" />
                <label class="form-check-label" for="targetAll">Toàn hệ thống (mọi tài khoản đang hoạt động)</label>
            </div>
            <span asp-validation-for="Target" class="text-danger d-block"></span>
        </div>

        <div class="mb-3" id="recipientGroup">
            <label asp-for="RecipientEmail" class="form-label"></label>
            <input asp-for="RecipientEmail" class="form-control" maxlength="256" placeholder="vd: chi.buyer@demo.local" />
            <span asp-validation-for="RecipientEmail" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TieuDe" class="form-label"></label>
            <input asp-for="TieuDe" class="form-control" maxlength="200" />
            <span asp-validation-for="TieuDe" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NoiDung" class="form-label"></label>
            <textarea asp-for="NoiDung" class="form-control" rows="5" maxlength="1000"></textarea>
            <span asp-validation-for="NoiDung" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary" id="sendButton">Gửi thông báo</button>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('sendButton').form;
            const group = document.getElementById('recipientGroup');
            const radios = document.querySelectorAll('input[name="Target"]');
            const isAll = () => document.getElementById('targetAll').checked;
            const sync = () => { group.hidden = isAll(); };
            radios.forEach(r => r.addEventListener('change', sync));
            sync();
            // Gửi toàn hệ thống không thể thu hồi: hỏi xác nhận trước khi gửi.
            form.addEventListener('submit', e => {
                if (isAll() && !confirm('Gửi thông báo này tới TẤT CẢ người dùng đang hoạt động?')) e.preventDefault();
            });
        })();
    </script>
}
