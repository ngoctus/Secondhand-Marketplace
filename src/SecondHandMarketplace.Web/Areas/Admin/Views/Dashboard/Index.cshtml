@model AdminDashboardVm
@{
    ViewData["Title"] = L["E_AdminDashTitle"];
    var tt = new[] { "PENDING", "CONFIRMED", "SHIPPING", "DELIVERED", "COMPLETED", "CANCELLED" };
}
<div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h2>@L["E_AdminDashTitle"]</h2>
        <p class="muted mb-0">@L["E_AdminDashSubtitle"]</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm btn-outline-success" asp-action="ExportCsv" title="@L["E_DashboardExportHint"]"><i class="bi bi-download me-1" aria-hidden="true"></i>@L["E_ExportCsv"]</a>
        <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalThemDoanhThu">
            <i class="bi bi-plus-circle me-1"></i>@L["E_AdminAddRevenue"]
        </button>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Users" asp-action="Index">@L["E_AdminUsers"]</a>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Sellers" asp-action="Index">@L["E_AdminShops"]</a>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Products" asp-action="Index" asp-route-tab="ACTIVE">@L["E_AdminProducts"]</a>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Index">@L["E_AdminOrders"]</a>
    </div>
</div>

<div class="kpi-grid">
    <a class="kpi highlight" asp-controller="Orders" asp-action="Index" asp-route-status="COMPLETED" title="Xem toàn bộ đơn hàng hoàn tất">
        <span>@L["E_DashRevenueCompleted"]</span>
        <b>@HienThi.Tien(Model.DoanhThu)</b>
        <small>@L["E_DashTotalProfit", HienThi.Tien(Model.TongLoiNhuan)]</small>
    </a>
    <a class="kpi highlight" asp-controller="Orders" asp-action="Index" asp-route-status="COMPLETED" title="Doanh thu đơn hoàn tất trong tháng @Model.ThangHienTai">
        <span>@L["E_DashMonthlyRevenue", Model.ThangHienTai]</span>
        <b>@HienThi.Tien(Model.DoanhThuThang)</b>
        <small>@L["E_DashOrdersThisMonth", Model.DonHoanTatThang]</small>
    </a>
    <a class="kpi highlight" href="#bang-ban-chay" title="Lợi nhuận sàn tháng @Model.ThangHienTai (chiết khấu @Model.TyLeLoiNhuan%)">
        <span>@L["E_DashMonthlyProfit", Model.ThangHienTai]</span>
        <b>@HienThi.Tien(Model.LoiNhuanThang)</b>
        <small>@L["E_DashPlatformFee", Model.TyLeLoiNhuan]</small>
    </a>
    <a class="kpi highlight" href="#bang-ban-chay" title="@(Model.SanPhamBanChayNhat?.Name ?? "Chưa có sản phẩm bán chạy")">
        <span>@L["E_DashTopProduct"]</span>
        <b class="kpi-text-val">@(Model.SanPhamBanChayNhat?.Name ?? (string)L["E_DashNoTopProduct"])</b>
        <small>@(Model.SanPhamBanChayNhat != null ? L["E_DashTopProductSales", Model.SanPhamBanChayNhat.QuantitySold, HienThi.Tien(Model.SanPhamBanChayNhat.Revenue)] : L["E_DashNoData"])</small>
    </a>
    <a class="kpi" asp-controller="Users" asp-action="Index" title="Quản lý người dùng (Thêm / Sửa / Xóa)">
        <span>@L["E_AdminUsers"]</span>
        <b>@Model.TongNguoiDung</b>
        <small>@L["E_DashManageRecords"]</small>
    </a>
    <a class="kpi" asp-controller="Sellers" asp-action="Index" title="Quản lý cửa hàng (Thêm / Sửa / Xóa)">
        <span>@L["E_AdminShops"]</span>
        <b>@Model.TongCuaHang</b>
        <small>@L["E_DashManageRecords"]</small>
    </a>
    <a class="kpi" asp-controller="Products" asp-action="Index" asp-route-tab="ACTIVE" title="Quản lý sản phẩm (Thêm / Sửa / Xóa)">
        <span>@L["E_AdminProducts"]</span>
        <b>@Model.TongSanPham</b>
        <small>@L["E_DashManageRecords"]</small>
    </a>
    <a class="kpi" asp-controller="Orders" asp-action="Index" title="Quản lý tổng đơn hàng (Thêm / Sửa / Xóa)">
        <span>@L["E_DashTotalOrders"]</span>
        <b>@Model.TongDonHang</b>
        <small>@L["E_DashCompletedCount", Model.DonHoanTat]</small>
    </a>
    <a class="kpi warn" asp-controller="Products" asp-action="Index" asp-route-tab="PENDING_REVIEW" title="Duyệt hoặc từ chối sản phẩm chờ duyệt">
        <span>@L["E_DashPendingProducts"]</span>
        <b>@Model.SanPhamChoDuyet</b>
        <small>@L["E_DashReviewNow"]</small>
    </a>
    <a class="kpi warn" asp-controller="Reports" asp-action="Index" title="Xử lý báo cáo vi phạm">
        <span>@L["E_DashPendingReports"]</span>
        <b>@(Model.BaoCaoChuaXuLy?.ToString() ?? "—")</b>
        <small>@L["E_DashCheckResolve"]</small>
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-8"><partial name="_BieuDo" /></div>
    <div class="col-lg-4">
        <div class="panel">
            <h3>@L["E_DashOrdersByStatus"]</h3>
            @foreach (var s in tt)
            {
                var n = Model.DonTheoTrangThai.GetValueOrDefault(s);
                <a class="bar-row text-decoration-none text-reset" asp-controller="Orders" asp-action="Index" asp-route-status="@s">
                    <span class="@HienThi.LopTrangThai(s)">@HienThi.TrangThaiDon(s)</span>
                    <div class="bar"><i style="width:@(Model.TongDonHang == 0 ? 0 : n * 100 / Model.TongDonHang)%"></i></div>
                    <b>@n</b>
                </a>
            }
        </div>
    </div>
</div>

<div class="panel mt-3" id="bang-ban-chay">
    <div class="panel-head">
        <h3>@L["E_DashTopProductsProfit"]</h3>
        <a asp-controller="Products" asp-action="Index" asp-route-tab="ACTIVE">@L["E_AdminProducts"]</a>
    </div>
    @if (Model.SanPhamBanChay.Count == 0)
    {
        <div class="empty">@L["E_DashNoCompletedProducts"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>@L["E_DashRank"]</th>
                        <th>@L["E_AdminProducts"]</th>
                        <th>@L["E_DashShop"]</th>
                        <th class="text-center">@L["E_DashQuantitySold"]</th>
                        <th class="text-end">@L["E_DashRevenue"]</th>
                        <th class="text-end">@L["E_DashPlatformProfit", Model.TyLeLoiNhuan]</th>
                        <th class="text-end">@L["E_DashAction"]</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.SanPhamBanChay.Count; i++)
                {
                    var p = Model.SanPhamBanChay[i];
                    var loiNhuanSp = Math.Round(p.Revenue * (Model.TyLeLoiNhuan / 100m), 0);
                    <tr>
                        <td><span class="badge @(i == 0 ? "bg-success" : "bg-secondary")">#@(i + 1)</span></td>
                        <td>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId"><strong>@p.Name</strong></a>
                            @if (i == 0)
                            {
                                <span class="badge bg-warning text-dark ms-1">@L["E_DashBestSeller"]</span>
                            }
                        </td>
                        <td>@p.ShopName</td>
                        <td class="text-center"><b>@p.QuantitySold</b></td>
                        <td class="text-end"><b>@HienThi.Tien(p.Revenue)</b></td>
                        <td class="text-end text-success"><b>@HienThi.Tien(loiNhuanSp)</b></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId">Xem</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="panel mt-3">
    <div class="panel-head d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h3 class="mb-0">@L["E_DashLatestOrders"]</h3>
        <div class="d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalThemDoanhThu">
                + @L["E_DashAddOrder"]
            </button>
            <a asp-controller="Orders" asp-action="Index">@L["E_DashViewAll"]</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@L["E_AuctionSessionCode"]</th>
                    <th>@L["E_AdminProducts"]</th>
                    <th>@L["E_DashBuyer"]</th>
                    <th>@L["E_DashShop"]</th>
                    <th>@L["E_DashRevenue"]</th>
                    <th>@L["E_DashProfit", Model.TyLeLoiNhuan]</th>
                    <th>@L["E_AuctionStatus"]</th>
                    <th class="text-end">@L["E_DashAction"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model.DonMoiNhat)
            {
                var loiNhuanDon = o.Status == "COMPLETED" ? Math.Round(o.Total * (Model.TyLeLoiNhuan / 100m), 0) : 0m;
                <tr>
                    <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id"><b>@o.MaDon</b></a></td>
                    <td>@o.FirstItem</td>
                    <td>@o.BuyerName</td>
                    <td>@o.ShopName</td>
                    <td><b>@HienThi.Tien(o.Total)</b></td>
                    <td class="text-success">@(o.Status == "COMPLETED" ? HienThi.Tien(loiNhuanDon) : "—")</td>
                    <td><span class="@HienThi.LopTrangThai(o.Status)">@HienThi.TrangThaiDon(o.Status)</span></td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">@L["E_DashDetails"]</a>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    onclick="openEditOrderModal(@o.Id, '@Html.Raw((o.MaDon ?? "").Replace("'", "\\'"))', '@Html.Raw((o.FirstItem ?? "").Replace("'", "\\'"))', @o.Total.ToString(System.Globalization.CultureInfo.InvariantCulture), '@o.Status')">
                                @L["E_DashEdit"]
                            </button>
                            <form asp-action="DeleteOrder" method="post" class="d-inline" onsubmit="return confirm('@L["E_DashCancelOrder", o.MaDon ?? ""].Value');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@o.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["E_DashDelete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Doanh Thu / Đơn Hàng -->
<div class="modal fade" id="modalThemDoanhThu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="CreateOrder" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">@L["E_DashAddOrderTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["E_DashCancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="newOrderProduct">@L["E_DashProductName"]</label>
                    <input id="newOrderProduct" type="text" name="productName" class="form-control" placeholder="@L["E_DashProductName"]" required maxlength="200" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderAmount">@L["E_DashAmount"]</label>
                    <input id="newOrderAmount" type="number" name="amount" class="form-control" min="1000" step="1000" value="500000" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderShop">@L["E_AdminShops"]</label>
                    <select id="newOrderShop" name="shopId" class="form-select">
                        @if (ViewBag.Shops != null)
                        {
                            foreach (var s in ViewBag.Shops)
                            {
                                <option value="@s.MaCuaHang">@s.TenShop</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderBuyer">@L["E_DashBuyerLabel"]</label>
                    <select id="newOrderBuyer" name="buyerId" class="form-select">
                        @if (ViewBag.Buyers != null)
                        {
                            foreach (var u in ViewBag.Buyers)
                            {
                                <option value="@u.MaNguoiDung">@u.HoTen</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderStatus">@L["E_DashOrderStatus"]</label>
                    <select id="newOrderStatus" name="status" class="form-select">
                        <option value="COMPLETED" selected>@HienThi.TrangThaiDon("COMPLETED") · @L["E_DashRevenueCompleted"]</option>
                        <option value="PENDING">@HienThi.TrangThaiDon("PENDING")</option>
                        <option value="CONFIRMED">@HienThi.TrangThaiDon("CONFIRMED")</option>
                        <option value="SHIPPING">@HienThi.TrangThaiDon("SHIPPING")</option>
                        <option value="DELIVERED">@HienThi.TrangThaiDon("DELIVERED")</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["E_DashCancel"]</button>
                <button type="submit" class="btn btn-success">@L["E_DashSave"]</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa Đơn Hàng / Doanh Thu -->
<div class="modal fade" id="modalSuaDoanhThu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="EditOrder" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editOrderId" />
            <div class="modal-header">
                <h5 class="modal-title">@L["E_DashEditOrderTitle"] <span id="editOrderCode" class="text-muted"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["E_DashCancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="editOrderProduct">@L["E_DashProductName"]</label>
                    <input type="text" name="productName" id="editOrderProduct" class="form-control" required maxlength="200" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="editOrderAmount">@L["E_DashTotalAmount"]</label>
                    <input type="number" name="amount" id="editOrderAmount" class="form-control" min="1000" step="1000" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="editOrderStatus">@L["E_DashOrderStatus"]</label>
                    <select name="status" id="editOrderStatus" class="form-select">
                        @foreach (var s in tt)
                        {
                            <option value="@s">@HienThi.TrangThaiDon(s)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["E_DashCancel"]</button>
                <button type="submit" class="btn btn-primary">@L["E_DashUpdate"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        function openEditOrderModal(id, code, product, amount, status) {
            document.getElementById('editOrderId').value = id;
            document.getElementById('editOrderCode').textContent = '(' + code + ')';
            document.getElementById('editOrderProduct').value = product;
            document.getElementById('editOrderAmount').value = amount;
            document.getElementById('editOrderStatus').value = status;
            new bootstrap.Modal(document.getElementById('modalSuaDoanhThu')).show();
        }
    </script>
}
