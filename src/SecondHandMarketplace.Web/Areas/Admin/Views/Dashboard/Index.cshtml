@model AdminDashboardVm
@{
    ViewData["Title"] = L["E_AdminDashTitle"];
    var tt = new[] { "PENDING", "CONFIRMED", "SHIPPING", "DELIVERED", "COMPLETED", "CANCELLED" };
    var completionRate = Model.TongDonHang > 0 ? Math.Round(Model.DonHoanTat * 100.0 / Model.TongDonHang, 1) : 0;
    var activeRate = Model.TongSanPham > 0 ? Math.Round(Model.SanPhamDangBan * 100.0 / Model.TongSanPham, 1) : 0;
    var totalAlerts = Model.SanPhamChoDuyet + (Model.BaoCaoChuaXuLy ?? 0) + Model.TranhChapDangMo + Model.KhieuNaiChoXuLy;

    var statusLabelsJson = System.Text.Json.JsonSerializer.Serialize(tt.Select(s => HienThi.TrangThaiDon(s).ToString()).ToArray());
    var statusCountsJson = System.Text.Json.JsonSerializer.Serialize(tt.Select(s => Model.DonTheoTrangThai.GetValueOrDefault(s)).ToArray());
    var catLabelsJson = System.Text.Json.JsonSerializer.Serialize(Model.TopDanhMuc.Select(c => HienThi.TenDanhMuc(c.Name).ToString()).ToArray());
    var catCountsJson = System.Text.Json.JsonSerializer.Serialize(Model.TopDanhMuc.Select(c => c.Count).ToArray());
}

<div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="mb-1">@L["E_AdminDashTitle"]</h2>
        <p class="muted mb-0">@L["E_AdminDashSubtitle"]</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a class="btn-rm-outline btn-sm text-decoration-none" asp-action="ExportCsv" title="@L["E_DashboardExportHint"]">
            <i class="bi bi-download" aria-hidden="true"></i>
            <span>@L["E_ExportCsv"]</span>
        </a>
        <button type="button" class="btn-rm-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalThemDoanhThu">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            <span>@L["E_AdminAddRevenue"]</span>
        </button>
    </div>
</div>

<!-- Dải "Cần xử lý ngay" giúp Admin thấy việc gấp ngay khi mở Dashboard -->
<section class="admin-urgent-strip" aria-label="@(HienThi.LaTiengAnh ? "Action needed" : "Cần xử lý ngay")">
    <div class="admin-urgent-head">
        <span class="admin-urgent-badge @(totalAlerts > 0 ? "has-alerts" : "")">
            <i class="bi @(totalAlerts > 0 ? "bi-bell-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
            @(HienThi.LaTiengAnh ? "Action Queue" : "Cần xử lý ngay"): <strong>@totalAlerts</strong>
        </span>
        <span class="text-muted small">@(HienThi.LaTiengAnh ? "Click any item to jump directly to its moderation queue" : "Nhấn vào từng mục để xử lý ngay")</span>
    </div>
    <div class="admin-urgent-grid">
        <a class="admin-urgent-item @(Model.SanPhamChoDuyet > 0 ? "is-warn" : "")" asp-controller="Products" asp-action="Index" asp-route-tab="PENDING_REVIEW">
            <div class="admin-urgent-icon"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="admin-urgent-val">@Model.SanPhamChoDuyet</div>
                <div class="admin-urgent-lbl">@L["E_DashPendingProducts"]</div>
            </div>
        </a>
        <a class="admin-urgent-item @((Model.BaoCaoChuaXuLy ?? 0) > 0 ? "is-danger" : "")" asp-controller="Reports" asp-action="Index">
            <div class="admin-urgent-icon"><i class="bi bi-flag"></i></div>
            <div>
                <div class="admin-urgent-val">@(Model.BaoCaoChuaXuLy?.ToString() ?? "0")</div>
                <div class="admin-urgent-lbl">@L["E_DashPendingReports"]</div>
            </div>
        </a>
        <a class="admin-urgent-item @(Model.TranhChapDangMo > 0 ? "is-danger" : "")" asp-controller="Disputes" asp-action="Index">
            <div class="admin-urgent-icon"><i class="bi bi-exclamation-octagon"></i></div>
            <div>
                <div class="admin-urgent-val">@Model.TranhChapDangMo</div>
                <div class="admin-urgent-lbl">@L["Admin_Disputes"]</div>
            </div>
        </a>
        <a class="admin-urgent-item @(Model.KhieuNaiChoXuLy > 0 ? "is-warn" : "")" asp-controller="AccountAppeals" asp-action="Index">
            <div class="admin-urgent-icon"><i class="bi bi-person-lock"></i></div>
            <div>
                <div class="admin-urgent-val">@Model.KhieuNaiChoXuLy</div>
                <div class="admin-urgent-lbl">@L["Admin_AccountAppeals"]</div>
            </div>
        </a>
        <a class="admin-urgent-item" asp-controller="Auctions" asp-action="Index">
            <div class="admin-urgent-icon"><i class="bi bi-hammer"></i></div>
            <div>
                <div class="admin-urgent-val">@Model.PhienDangMo</div>
                <div class="admin-urgent-lbl">@(HienThi.LaTiengAnh ? "Active Auctions" : "Đấu giá đang mở")</div>
            </div>
        </a>
    </div>
</section>

<!-- Lưới KPI 4 cột rõ ràng, không bị cắt chữ -->
<section class="admin-kpi-grid" aria-label="@(HienThi.LaTiengAnh ? "Key metrics" : "Chỉ số chính")">
    <a class="admin-kpi-card is-primary" asp-controller="Orders" asp-action="Index" asp-route-status="COMPLETED">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_DashRevenueCompleted"]</span>
            <span class="admin-kpi-icon"><i class="bi bi-cash-stack"></i></span>
        </div>
        <div class="admin-kpi-value">@HienThi.Tien(Model.DoanhThu)</div>
        <div class="admin-kpi-sub">@L["E_DashTotalProfit", HienThi.Tien(Model.TongLoiNhuan)]</div>
    </a>

    <a class="admin-kpi-card is-primary" asp-controller="Orders" asp-action="Index" asp-route-status="COMPLETED">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_DashMonthlyRevenue", Model.ThangHienTai]</span>
            <span class="admin-kpi-icon"><i class="bi bi-calendar-check"></i></span>
        </div>
        <div class="admin-kpi-value">@HienThi.Tien(Model.DoanhThuThang)</div>
        <div class="admin-kpi-sub">@L["E_DashOrdersThisMonth", Model.DonHoanTatThang]</div>
    </a>

    <a class="admin-kpi-card is-primary" href="#bang-ban-chay">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_DashMonthlyProfit", Model.ThangHienTai]</span>
            <span class="admin-kpi-icon"><i class="bi bi-graph-up-arrow"></i></span>
        </div>
        <div class="admin-kpi-value">@HienThi.Tien(Model.LoiNhuanThang)</div>
        <div class="admin-kpi-sub">@L["E_DashPlatformFee", Model.TyLeLoiNhuan]</div>
    </a>

    <a class="admin-kpi-card" asp-controller="Orders" asp-action="Index">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_DashTotalOrders"]</span>
            <span class="admin-kpi-icon"><i class="bi bi-box-seam"></i></span>
        </div>
        <div class="admin-kpi-value">@Model.TongDonHang</div>
        <div class="admin-kpi-sub">@L["E_DashCompletedCount", Model.DonHoanTat] (@completionRate%)</div>
    </a>

    <a class="admin-kpi-card" asp-controller="Users" asp-action="Index">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_AdminUsers"]</span>
            <span class="admin-kpi-icon"><i class="bi bi-people"></i></span>
        </div>
        <div class="admin-kpi-value">@Model.TongNguoiDung</div>
        <div class="admin-kpi-sub">@(Model.NguoiDungBiKhoa > 0 ? $"{Model.NguoiDungBiKhoa} " + (HienThi.LaTiengAnh ? "locked" : "đang khóa") : L["E_DashManageRecords"].Value)</div>
    </a>

    <a class="admin-kpi-card" asp-controller="Sellers" asp-action="Index">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_AdminShops"]</span>
            <span class="admin-kpi-icon"><i class="bi bi-shop"></i></span>
        </div>
        <div class="admin-kpi-value">@Model.TongCuaHang</div>
        <div class="admin-kpi-sub">@L["E_DashManageRecords"]</div>
    </a>

    <a class="admin-kpi-card" asp-controller="Products" asp-action="Index" asp-route-tab="ACTIVE">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_AdminProducts"]</span>
            <span class="admin-kpi-icon"><i class="bi bi-tag"></i></span>
        </div>
        <div class="admin-kpi-value">@Model.TongSanPham</div>
        <div class="admin-kpi-sub">@Model.SanPhamDangBan @(HienThi.LaTiengAnh ? "active" : "đang bán") · @Model.SanPhamDaBan @(HienThi.LaTiengAnh ? "sold" : "đã bán")</div>
    </a>

    <a class="admin-kpi-card" href="#bang-ban-chay">
        <div class="admin-kpi-top">
            <span class="admin-kpi-label">@L["E_DashTopProduct"]</span>
            <span class="admin-kpi-icon"><i class="bi bi-trophy"></i></span>
        </div>
        <div class="admin-kpi-value admin-kpi-text">@(Model.SanPhamBanChayNhat?.Name ?? (string)L["E_DashNoTopProduct"])</div>
        <div class="admin-kpi-sub">@(Model.SanPhamBanChayNhat != null ? L["E_DashTopProductSales", Model.SanPhamBanChayNhat.QuantitySold, HienThi.Tien(Model.SanPhamBanChayNhat.Revenue)] : L["E_DashNoData"])</div>
    </a>
</section>

<!-- Hàng sơ đồ 1: Biểu đồ doanh thu & Biểu đồ tròn trạng thái đơn -->
<div class="row g-3 mt-1">
    <div class="col-lg-8"><partial name="_BieuDo" /></div>
    <div class="col-lg-4">
        <div class="panel h-100 d-flex flex-column">
            <div class="panel-head">
                <h3>@L["E_DashOrdersByStatus"]</h3>
                <a asp-controller="Orders" asp-action="Index">@L["E_DashViewAll"]</a>
            </div>
            <div class="admin-donut-wrap">
                <canvas id="orderStatusDonut"></canvas>
            </div>
            <div class="admin-status-list mt-3">
                @foreach (var s in tt)
                {
                    var n = Model.DonTheoTrangThai.GetValueOrDefault(s);
                    var pct = Model.TongDonHang > 0 ? Math.Round(n * 100.0 / Model.TongDonHang, 0) : 0;
                    <a class="admin-status-row" asp-controller="Orders" asp-action="Index" asp-route-status="@s">
                        <span class="@HienThi.LopTrangThai(s)">@HienThi.TrangThaiDon(s)</span>
                        <span class="admin-status-nums"><b>@n</b> <small class="text-muted">(@pct%)</small></span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Hàng sơ đồ 2: Top Danh mục & Sơ đồ luồng vận hành sàn -->
<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-head">
                <h3>@(HienThi.LaTiengAnh ? "Products by Category" : "Phân bổ sản phẩm theo danh mục")</h3>
                <a asp-controller="Categories" asp-action="Index">@L["Admin_Categories"]</a>
            </div>
            @if (Model.TopDanhMuc.Count == 0)
            {
                <div class="empty">@L["E_DashNoData"]</div>
            }
            else
            {
                <div class="admin-cat-chart-box">
                    <canvas id="categoryBarChart"></canvas>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-head">
                <h3>@(HienThi.LaTiengAnh ? "Marketplace Operations Flow" : "Sơ đồ luồng vận hành sàn")</h3>
                <span class="badge bg-success-subtle text-success border">@(HienThi.LaTiengAnh ? "Live Snapshot" : "Trạng thái thực tế")</span>
            </div>
            <div class="admin-flow-diagram">
                <div class="admin-flow-row">
                    <a class="admin-flow-node" asp-controller="Products" asp-action="Index">
                        <span class="admin-flow-step">1</span>
                        <div class="admin-flow-title">@(HienThi.LaTiengAnh ? "Listings" : "Tin đăng")</div>
                        <div class="admin-flow-num">@Model.TongSanPham</div>
                    </a>
                    <i class="bi bi-arrow-right admin-flow-arrow" aria-hidden="true"></i>
                    <a class="admin-flow-node @(Model.SanPhamChoDuyet > 0 ? "is-warn" : "")" asp-controller="Products" asp-action="Index" asp-route-tab="PENDING_REVIEW">
                        <span class="admin-flow-step">2</span>
                        <div class="admin-flow-title">@(HienThi.LaTiengAnh ? "Pending" : "Chờ duyệt")</div>
                        <div class="admin-flow-num">@Model.SanPhamChoDuyet</div>
                    </a>
                    <i class="bi bi-arrow-right admin-flow-arrow" aria-hidden="true"></i>
                    <a class="admin-flow-node is-good" asp-controller="Products" asp-action="Index" asp-route-tab="ACTIVE">
                        <span class="admin-flow-step">3</span>
                        <div class="admin-flow-title">@(HienThi.LaTiengAnh ? "Active" : "Đang bán")</div>
                        <div class="admin-flow-num">@Model.SanPhamDangBan</div>
                    </a>
                    <i class="bi bi-arrow-right admin-flow-arrow" aria-hidden="true"></i>
                    <a class="admin-flow-node is-good" asp-controller="Orders" asp-action="Index" asp-route-status="COMPLETED">
                        <span class="admin-flow-step">4</span>
                        <div class="admin-flow-title">@(HienThi.LaTiengAnh ? "Completed" : "Hoàn tất")</div>
                        <div class="admin-flow-num">@Model.DonHoanTat</div>
                    </a>
                </div>

                <div class="admin-health-bars mt-4">
                    <div class="admin-health-item">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@(HienThi.LaTiengAnh ? "Active Listing Rate" : "Tỷ lệ sản phẩm đang hiển thị")</span>
                            <b>@activeRate%</b>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" style="width: @activeRate.ToString(System.Globalization.CultureInfo.InvariantCulture)%; background-color: var(--color-primary);"></div>
                        </div>
                    </div>
                    <div class="admin-health-item">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@(HienThi.LaTiengAnh ? "Order Completion Rate" : "Tỷ lệ đơn hàng hoàn tất")</span>
                            <b>@completionRate%</b>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" style="width: @completionRate.ToString(System.Globalization.CultureInfo.InvariantCulture)%; background-color: var(--color-success);"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="panel mt-3" id="bang-ban-chay">
    <div class="panel-head">
        <h3>@L["E_DashTopProductsProfit"]</h3>
        <a asp-controller="Products" asp-action="Index" asp-route-tab="ACTIVE">@L["E_AdminProducts"]</a>
    </div>
    @if (Model.SanPhamBanChay.Count == 0)
    {
        <div class="empty">@L["E_DashNoCompletedProducts"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>@L["E_DashRank"]</th>
                        <th>@L["E_AdminProducts"]</th>
                        <th>@L["E_DashShop"]</th>
                        <th class="text-center">@L["E_DashQuantitySold"]</th>
                        <th class="text-end">@L["E_DashRevenue"]</th>
                        <th class="text-end">@L["E_DashPlatformProfit", Model.TyLeLoiNhuan]</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.SanPhamBanChay.Count; i++)
                {
                    var p = Model.SanPhamBanChay[i];
                    var loiNhuanSp = Math.Round(p.Revenue * (Model.TyLeLoiNhuan / 100m), 0);
                    var productUrl = Url.Action("Details", "Products", new { id = p.ProductId });
                    <tr class="admin-clickable-row" data-href="@productUrl">
                        <td><span class="badge @(i == 0 ? "bg-success" : "bg-secondary")">#@(i + 1)</span></td>
                        <td>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId" class="text-decoration-none text-dark admin-row-title"><strong>@p.Name</strong></a>
                            @if (i == 0)
                            {
                                <span class="badge bg-warning text-dark ms-1">@L["E_DashBestSeller"]</span>
                            }
                        </td>
                        <td>@p.ShopName</td>
                        <td class="text-center"><b>@p.QuantitySold</b></td>
                        <td class="text-end"><b>@HienThi.Tien(p.Revenue)</b></td>
                        <td class="text-end text-success"><b>@HienThi.Tien(loiNhuanSp)</b></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="panel mt-3">
    <div class="panel-head d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h3 class="mb-0">@L["E_DashLatestOrders"]</h3>
        <div class="d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalThemDoanhThu">
                + @L["E_DashAddOrder"]
            </button>
            <a asp-controller="Orders" asp-action="Index">@L["E_DashViewAll"]</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@L["E_AuctionSessionCode"]</th>
                    <th>@L["E_AdminProducts"]</th>
                    <th>@L["E_DashBuyer"]</th>
                    <th>@L["E_DashShop"]</th>
                    <th>@L["E_DashRevenue"]</th>
                    <th>@L["E_DashProfit", Model.TyLeLoiNhuan]</th>
                    <th>@L["E_AuctionStatus"]</th>
                    <th class="text-end">@L["E_DashAction"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model.DonMoiNhat)
            {
                var loiNhuanDon = o.Status == "COMPLETED" ? Math.Round(o.Total * (Model.TyLeLoiNhuan / 100m), 0) : 0m;
                var orderUrl = Url.Action("Details", "Orders", new { id = o.Id });
                <tr class="admin-clickable-row" data-href="@orderUrl">
                    <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="text-decoration-none admin-row-title"><b>@o.MaDon</b></a></td>
                    <td>@o.FirstItem</td>
                    <td>@o.BuyerName</td>
                    <td>@o.ShopName</td>
                    <td><b>@HienThi.Tien(o.Total)</b></td>
                    <td class="text-success">@(o.Status == "COMPLETED" ? HienThi.Tien(loiNhuanDon) : "—")</td>
                    <td><span class="@HienThi.LopTrangThai(o.Status)">@HienThi.TrangThaiDon(o.Status)</span></td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-order-id="@o.Id"
                                    data-order-code="@(o.MaDon ?? "")"
                                    data-order-product="@(o.FirstItem ?? "")"
                                    data-order-amount="@o.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-order-status="@o.Status"
                                    onclick="openEditOrderModal(this)">
                                @L["E_DashEdit"]
                            </button>
                            <form asp-action="DeleteOrder" method="post" class="d-inline" onsubmit="return confirm('@L["E_DashCancelOrder", o.MaDon ?? ""].Value');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@o.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["E_DashDelete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Doanh Thu / Đơn Hàng -->
<div class="modal fade" id="modalThemDoanhThu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="CreateOrder" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">@L["E_DashAddOrderTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["E_DashCancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="newOrderProduct">@L["E_DashProductName"]</label>
                    <input id="newOrderProduct" type="text" name="productName" class="form-control" placeholder="@L["E_DashProductName"]" required maxlength="200" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderAmount">@L["E_DashAmount"]</label>
                    <input id="newOrderAmount" type="number" name="amount" class="form-control" min="1000" step="1000" value="500000" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderShop">@L["E_AdminShops"]</label>
                    <select id="newOrderShop" name="shopId" class="form-select">
                        @if (ViewBag.Shops != null)
                        {
                            foreach (var s in ViewBag.Shops)
                            {
                                <option value="@s.MaCuaHang">@s.TenShop</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderBuyer">@L["E_DashBuyerLabel"]</label>
                    <select id="newOrderBuyer" name="buyerId" class="form-select">
                        @if (ViewBag.Buyers != null)
                        {
                            foreach (var u in ViewBag.Buyers)
                            {
                                <option value="@u.MaNguoiDung">@u.HoTen</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="newOrderStatus">@L["E_DashOrderStatus"]</label>
                    <select id="newOrderStatus" name="status" class="form-select">
                        <option value="COMPLETED" selected>@HienThi.TrangThaiDon("COMPLETED") · @L["E_DashRevenueCompleted"]</option>
                        <option value="PENDING">@HienThi.TrangThaiDon("PENDING")</option>
                        <option value="CONFIRMED">@HienThi.TrangThaiDon("CONFIRMED")</option>
                        <option value="SHIPPING">@HienThi.TrangThaiDon("SHIPPING")</option>
                        <option value="DELIVERED">@HienThi.TrangThaiDon("DELIVERED")</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["E_DashCancel"]</button>
                <button type="submit" class="btn btn-success">@L["E_DashSave"]</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa Đơn Hàng / Doanh Thu -->
<div class="modal fade" id="modalSuaDoanhThu" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="EditOrder" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editOrderId" />
            <div class="modal-header">
                <h5 class="modal-title">@L["E_DashEditOrderTitle"] <span id="editOrderCode" class="text-muted"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["E_DashCancel"]"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="editOrderProduct">@L["E_DashProductName"]</label>
                    <input type="text" name="productName" id="editOrderProduct" class="form-control" required maxlength="200" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="editOrderAmount">@L["E_DashTotalAmount"]</label>
                    <input type="number" name="amount" id="editOrderAmount" class="form-control" min="1000" step="1000" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="editOrderStatus">@L["E_DashOrderStatus"]</label>
                    <select name="status" id="editOrderStatus" class="form-select">
                        @foreach (var s in tt)
                        {
                            <option value="@s">@HienThi.TrangThaiDon(s)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["E_DashCancel"]</button>
                <button type="submit" class="btn btn-primary">@L["E_DashUpdate"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        function openEditOrderModal(btn) {
            const { orderId, orderCode, orderProduct, orderAmount, orderStatus } = btn.dataset;
            document.getElementById('editOrderId').value = orderId;
            document.getElementById('editOrderCode').textContent = '(' + (orderCode || '') + ')';
            document.getElementById('editOrderProduct').value = orderProduct || '';
            document.getElementById('editOrderAmount').value = orderAmount || '';
            document.getElementById('editOrderStatus').value = orderStatus || '';
            new bootstrap.Modal(document.getElementById('modalSuaDoanhThu')).show();
        }

        window.addEventListener('load', () => {
            if (typeof Chart === 'undefined') return;

            const donutEl = document.getElementById('orderStatusDonut');
            if (donutEl) {
                new Chart(donutEl, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(statusLabelsJson),
                        datasets: [{
                            data: @Html.Raw(statusCountsJson),
                            backgroundColor: ['#D4A359', '#6C8EAD', '#7BA098', '#8EB897', '#3F6B4F', '#C46A60'],
                            borderWidth: 2,
                            borderColor: '#FFFFFF'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '64%',
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            const catEl = document.getElementById('categoryBarChart');
            if (catEl) {
                new Chart(catEl, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(catLabelsJson),
                        datasets: [{
                            label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(HienThi.LaTiengAnh ? "Products" : "Số sản phẩm")),
                            data: @Html.Raw(catCountsJson),
                            backgroundColor: 'rgba(104, 112, 90, 0.82)',
                            hoverBackgroundColor: '#535B47',
                            borderRadius: 6,
                            barThickness: 18
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { beginAtZero: true, ticks: { precision: 0 } },
                            y: { grid: { display: false } }
                        }
                    }
                });
            }
        });
    </script>
}
