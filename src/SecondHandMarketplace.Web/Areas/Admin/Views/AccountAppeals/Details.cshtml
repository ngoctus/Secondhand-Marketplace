@using SecondHandMarketplace.Web.Services.Accounts
@model AdminAccountAppealDetailDto
@{
    ViewData["Title"] = $"Đơn khiếu nại tài khoản #{Model.MaKhieuNai}";
    var isPending = Model.TrangThai == AccountAppealRules.StatusPending;
    var isAppeal = Model.LoaiYeuCau == AccountAppealRules.TypeAppeal;
    var statusBadge = Model.TrangThai switch
    {
        AccountAppealRules.StatusPending => "bg-warning text-dark",
        AccountAppealRules.StatusApproved => "bg-success",
        AccountAppealRules.StatusRejected => "bg-danger",
        _ => "bg-secondary"
    };
    var hasValidImage = !string.IsNullOrWhiteSpace(Model.BangChungAnh) && UrlAnToan.HopLe(Model.BangChungAnh);
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Khiếu nại tài khoản</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Đơn #@Model.MaKhieuNai</li>
                </ol>
            </nav>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h4 class="fw-bold mb-0">Đơn #@Model.MaKhieuNai — @AccountAppealRules.RequestTypeLabel(Model.LoaiYeuCau, Model.LanKhoaThu)</h4>
                <span class="badge @statusBadge">@AccountAppealRules.StatusLabel(Model.TrangThai)</span>
                <span class="badge @(Model.LanKhoaThu >= AccountAppealRules.PermanentLockThreshold ? "bg-danger" : Model.LanKhoaThu == AccountAppealRules.FeeLockTier ? "bg-warning text-dark" : "bg-secondary")">
                    Khóa lần @Model.LanKhoaThu
                </span>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại hàng chờ
        </a>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Nội dung đơn, Phí/Biên lai, Lịch sử vi phạm, Các đơn trước -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Nội dung đơn của người dùng</h5>

                    <div class="mb-3">
                        <div class="text-muted small mb-1">Lý do khóa tại thời điểm gửi đơn</div>
                        <div class="p-3 bg-light rounded-3 text-danger fw-medium">@Model.LyDoKhoaLucGui</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small mb-1">
                            @(isAppeal ? "Giải trình khiếu nại khóa nhầm" : "Nội dung cam kết mở khóa")
                        </div>
                        <div class="p-3 bg-light rounded-3" style="white-space: pre-wrap;">@Model.NoiDung</div>
                    </div>

                    <div class="text-muted small">
                        <i class="bi bi-clock me-1"></i> Gửi lúc: @HienThi.NgayGio(Model.NgayTao)
                    </div>
                </div>
            </div>

            @if (Model.YeuCauPhi || hasValidImage)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 @(Model.YeuCauPhi ? "border-start border-4 border-warning" : "")">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">
                            @(Model.YeuCauPhi ? "Đối chiếu phí mở khóa lần 2 (VietQR) & Biên lai" : "Ảnh bằng chứng đính kèm")
                        </h5>

                        @if (Model.YeuCauPhi)
                        {
                            <div class="alert alert-warning mb-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div>
                                        <div><strong>Số tiền cần đối chiếu:</strong> <span class="fs-5 text-danger fw-bold">@Model.SoTienPhi.ToString("N0") đ</span></div>
                                        <div>
                                            <strong>Mã nội dung chuyển khoản chuẩn:</strong>
                                            <code id="transferRefCode" class="fs-6 ms-1">@(Model.MaGiaoDichThamChieu ?? "—")</code>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Model.MaGiaoDichThamChieu))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-dark" id="btnCopyRefCode">
                                            <i class="bi bi-clipboard me-1"></i> Sao chép mã CK
                                        </button>
                                    }
                                </div>
                                <div class="small mt-2 mb-0">
                                    Admin kiểm tra tài khoản ngân hàng của sàn đã nhận đúng số tiền và nội dung chuyển khoản khớp biên lai bên dưới trước khi bấm Chấp thuận.
                                </div>
                            </div>
                        }

                        @if (hasValidImage)
                        {
                            <div>
                                <div class="text-muted small mb-2">
                                    @(Model.YeuCauPhi ? "Ảnh biên lai chuyển khoản" : "Ảnh bằng chứng người dùng gửi")
                                    (bấm vào ảnh để phóng to)
                                </div>
                                <div class="d-flex flex-wrap align-items-start gap-3">
                                    <button type="button" class="btn p-0 border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#evidenceZoomModal">
                                        <img src="@Model.BangChungAnh"
                                             alt="Ảnh bằng chứng / biên lai"
                                             class="img-thumbnail rounded-3"
                                             style="max-height: 300px; cursor: zoom-in;" />
                                    </button>
                                    <div class="d-flex flex-column gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#evidenceZoomModal">
                                            <i class="bi bi-zoom-in me-1"></i> Phóng to ảnh
                                        </button>
                                        <a href="@Model.BangChungAnh" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Mở ảnh ở tab mới
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (Model.YeuCauPhi)
                        {
                            <div class="alert alert-danger mb-0">
                                Đơn yêu cầu phí nhưng không có đường dẫn ảnh biên lai hợp lệ.
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Lịch sử vi phạm gần đây -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom pb-2">
                        <h5 class="fw-bold mb-0">Lịch sử vi phạm của tài khoản</h5>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger">Hiệu lực: @Model.SoViPhamHieuLuc / @AccountAppealRules.PermanentLockThreshold</span>
                            <span class="badge bg-secondary">Tổng lịch sử: @Model.TongViPhamLichSu</span>
                            <a asp-controller="Violations" asp-action="Index" asp-route-sellerId="@Model.MaNguoiDung" class="btn btn-sm btn-outline-secondary">
                                Xem trang Vi phạm
                            </a>
                        </div>
                    </div>

                    @if (Model.ViPhamGanDay.Count == 0)
                    {
                        <div class="text-muted fst-italic">Chưa ghi nhận bản ghi vi phạm kiểm duyệt hoặc báo cáo đã xử lý nào.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Nguồn</th>
                                        <th>Chi tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Model.ViPhamGanDay)
                                    {
                                        <tr>
                                            <td class="text-nowrap small">@HienThi.NgayGio(v.ThoiGian)</td>
                                            <td class="text-nowrap">
                                                <span class="badge @(v.Nguon.Contains("Hiệu lực") ? "bg-warning text-dark" : "bg-light text-muted border")">
                                                    @v.Nguon
                                                </span>
                                            </td>
                                            <td class="small">@v.MoTa</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Các đơn trước đó của user -->
            @if (Model.CacDonKhacCuaUser.Count > 0)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Các đơn khiếu nại khác của người dùng (@Model.CacDonKhacCuaUser.Count)</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Mã</th>
                                        <th>Loại / Lần khóa</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày gửi</th>
                                        <th>Ghi chú Admin</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var other in Model.CacDonKhacCuaUser)
                                    {
                                        var otherBadge = other.TrangThai switch
                                        {
                                            AccountAppealRules.StatusPending => "bg-warning text-dark",
                                            AccountAppealRules.StatusApproved => "bg-success",
                                            AccountAppealRules.StatusRejected => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        <tr>
                                            <td><strong>#@other.MaKhieuNai</strong></td>
                                            <td class="small">
                                                @AccountAppealRules.RequestTypeLabel(other.LoaiYeuCau, other.LanKhoaThu)
                                                <span class="text-muted">(Lần @other.LanKhoaThu)</span>
                                            </td>
                                            <td><span class="badge @otherBadge">@AccountAppealRules.StatusLabel(other.TrangThai)</span></td>
                                            <td class="small text-nowrap">@HienThi.NgayGio(other.NgayTao)</td>
                                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(other.GhiChuAdmin) ? "—" : other.GhiChuAdmin)</td>
                                            <td><a asp-action="Details" asp-route-id="@other.MaKhieuNai" class="small">Xem</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Cột phải: Thông tin tài khoản + Form Duyệt / Từ chối -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Thông tin tài khoản</h5>
                    <dl class="row small mb-0">
                        <dt class="col-5 text-muted">Họ tên</dt>
                        <dd class="col-7 fw-semibold">@Model.HoTen (#@Model.MaNguoiDung)</dd>

                        <dt class="col-5 text-muted">Email</dt>
                        <dd class="col-7">@Model.Email</dd>

                        <dt class="col-5 text-muted">Điện thoại</dt>
                        <dd class="col-7">@(Model.SoDienThoai ?? "—")</dd>

                        <dt class="col-5 text-muted">Trạng thái TK</dt>
                        <dd class="col-7">
                            <span class="badge @(Model.TrangThaiTaiKhoan == "ACTIVE" ? "bg-success" : "bg-danger")">
                                @Model.TrangThaiTaiKhoan
                            </span>
                        </dd>

                        <dt class="col-5 text-muted">Số lần bị khóa</dt>
                        <dd class="col-7 fw-semibold">@Model.SoLanBiKhoaHienTai lần</dd>

                        @if (Model.ThoiGianKhoaHienTai is not null)
                        {
                            <dt class="col-5 text-muted">Khóa gần nhất</dt>
                            <dd class="col-7">@HienThi.NgayGio(Model.ThoiGianKhoaHienTai.Value)</dd>
                        }

                        @if (Model.MocTinhViPham is not null)
                        {
                            <dt class="col-5 text-muted">Mốc reset gậy</dt>
                            <dd class="col-7">@HienThi.NgayGio(Model.MocTinhViPham.Value)</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.TenShop))
                        {
                            <dt class="col-5 text-muted">Cửa hàng</dt>
                            <dd class="col-7">
                                @Model.TenShop
                                <span class="badge @(Model.TrangThaiShop == "ACTIVE" ? "bg-success" : "bg-secondary") ms-1">@Model.TrangThaiShop</span>
                            </dd>
                        }
                    </dl>
                    <div class="mt-3 pt-2 border-top">
                        <a asp-controller="Users" asp-action="Index" asp-route-search="@Model.Email" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="bi bi-person-gear me-1"></i> Mở tại Quản lý người dùng
                        </a>
                    </div>
                </div>
            </div>

            @if (isPending)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 border-top border-4 border-success">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-success mb-2">
                            <i class="bi bi-check-circle me-1"></i> Chấp thuận &amp; Mở khóa
                        </h5>
                        <p class="small text-muted mb-3">
                            @if (isAppeal)
                            {
                                <span>
                                    Duyệt <strong>Khiếu nại khóa nhầm</strong> sẽ mở khóa tài khoản + cửa hàng, đặt lại mốc vi phạm về <code>0/3</code>
                                    và <strong>giảm số lần bị khóa đi 1</strong> (từ @Model.SoLanBiKhoaHienTai → @Math.Max(0, Model.SoLanBiKhoaHienTai - 1)).
                                </span>
                            }
                            else
                            {
                                <span>
                                    Duyệt <strong>Cam kết mở khóa</strong> sẽ mở khóa tài khoản + cửa hàng, đặt lại mốc vi phạm về <code>0/3</code>
                                    và <strong>giữ nguyên số lần bị khóa (@Model.SoLanBiKhoaHienTai)</strong>.
                                </span>
                            }
                        </p>
                        <form asp-action="Approve" asp-route-id="@Model.MaKhieuNai" method="post">
                            <div class="mb-3">
                                <label for="approveNote" class="form-label small fw-semibold">Ghi chú cho người dùng (tùy chọn)</label>
                                <textarea id="approveNote" name="ghiChuAdmin" class="form-control form-control-sm" rows="3" maxlength="1000"
                                          placeholder="VD: Đã đối chiếu biên lai chuyển khoản / Xác nhận hệ thống khóa nhầm..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-success w-100"
                                    onclick="return confirm('Xác nhận CHẤP THUẬN đơn #@Model.MaKhieuNai và MỞ KHÓA tài khoản @Model.Email?');">
                                <i class="bi bi-unlock me-1"></i> Chấp thuận &amp; Mở khóa tài khoản
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 border-top border-4 border-danger">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-danger mb-2">
                            <i class="bi bi-x-circle me-1"></i> Từ chối đơn
                        </h5>
                        <p class="small text-muted mb-3">
                            Tài khoản sẽ giữ nguyên trạng thái <code>LOCKED</code>. Lý do từ chối sẽ được hiển thị cho người dùng và gửi qua email.
                        </p>
                        <form asp-action="Reject" asp-route-id="@Model.MaKhieuNai" method="post">
                            <div class="mb-3">
                                <label for="rejectNote" class="form-label small fw-semibold">
                                    Lý do từ chối <span class="text-danger">*</span> (tối thiểu @AccountAppealRules.MinAdminRejectNoteLength ký tự)
                                </label>
                                <textarea id="rejectNote" name="ghiChuAdmin" class="form-control form-control-sm" rows="4"
                                          required minlength="@AccountAppealRules.MinAdminRejectNoteLength" maxlength="1000"
                                          placeholder="Nêu rõ lý do từ chối (VD: Biên lai chưa khớp số tiền/mã CK, bằng chứng chưa đủ căn cứ...)"></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger w-100"
                                    onclick="return confirm('Xác nhận TỪ CHỐI đơn #@Model.MaKhieuNai?');">
                                <i class="bi bi-x-octagon me-1"></i> Từ chối đơn này
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 border-top border-4 @(Model.TrangThai == AccountAppealRules.StatusApproved ? "border-success" : "border-danger")">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-2">Kết quả xử lý</h5>
                        <div class="mb-2">
                            <span class="badge @statusBadge">@AccountAppealRules.StatusLabel(Model.TrangThai)</span>
                        </div>
                        <div class="small text-muted mb-2">
                            <div><strong>Người xử lý:</strong> @(Model.TenNguoiXuLy ?? (Model.NguoiXuLyId.HasValue ? $"Admin #{Model.NguoiXuLyId}" : "—"))</div>
                            @if (Model.NgayXuLy is not null)
                            {
                                <div><strong>Thời gian:</strong> @HienThi.NgayGio(Model.NgayXuLy.Value)</div>
                            }
                        </div>
                        <div class="small">
                            <strong>Ghi chú Admin:</strong>
                            <div class="p-2 bg-light rounded-2 mt-1" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.GhiChuAdmin) ? "Không có ghi chú." : Model.GhiChuAdmin)</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (hasValidImage)
{
    <div class="modal fade" id="evidenceZoomModal" tabindex="-1" aria-labelledby="evidenceZoomModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="evidenceZoomModalLabel">
                        @(Model.YeuCauPhi ? "Biên lai chuyển khoản" : "Ảnh bằng chứng") — Đơn #@Model.MaKhieuNai
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body text-center bg-dark p-3">
                    <img src="@Model.BangChungAnh" alt="Ảnh phóng to" class="img-fluid rounded" style="max-height: 80vh;" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('btnCopyRefCode');
            const codeEl = document.getElementById('transferRefCode');
            if (btn && codeEl) {
                btn.addEventListener('click', async () => {
                    const text = codeEl.textContent?.trim();
                    if (!text) return;
                    try {
                        await navigator.clipboard.writeText(text);
                        const original = btn.innerHTML;
                        btn.innerHTML = '<i class="bi bi-check2 me-1"></i> Đã sao chép';
                        setTimeout(() => btn.innerHTML = original, 1800);
                    } catch { }
                });
            }
        })();
    </script>
}
