@model SecondHandMarketplace.Web.Models.ViewModels.Reviews.DanhSachShopCanRaSoatVm
@{
    ViewData["Title"] = L["AdminRev_Title"].Value;
    var filter = Model.Filter;
    var tab = filter.TabChuanHoa;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var pageSize = Model.PageSize;
}

<div class="container-fluid my-4 px-md-4" style="max-width: 1350px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">
                <i class="bi bi-clipboard2-pulse text-danger me-1"></i> @L["AdminRev_Heading"]
            </h2>
            <p class="text-muted small mb-0">
                @L["AdminRev_Criteria", Model.TongShopCanRaSoat]
            </p>
        </div>
        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-flag me-1"></i> @L["Admin_Reports"]
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white mb-3">
        <div class="card-body pb-0">
            <ul class="nav nav-tabs border-0">
                <li class="nav-item">
                    <a class="nav-link fw-semibold @(tab == "can_ra_soat" ? "active text-danger" : "text-muted")"
                       asp-action="Index" asp-route-tab="can_ra_soat" asp-route-search="@filter.Search">
                        <i class="bi bi-exclamation-triangle me-1"></i> @L["AdminRev_TabFlagged"]
                        <span class="badge rounded-pill @(tab == "can_ra_soat" ? "bg-danger" : "bg-secondary") ms-1">@Model.TongShopCanRaSoat</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-semibold @(tab == "all" ? "active text-primary" : "text-muted")"
                       asp-action="Index" asp-route-tab="all" asp-route-search="@filter.Search">
                        <i class="bi bi-shop me-1"></i> @L["AdminRev_TabAll"]
                    </a>
                </li>
            </ul>
            <form method="get" class="row g-2 align-items-center py-3">
                <input type="hidden" name="tab" value="@tab" />
                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input name="search" value="@filter.Search" class="form-control" maxlength="200"
                               placeholder="@L["AdminRev_SearchPlaceholder"]" />
                    </div>
                </div>
                <div class="col-auto">
                    <select name="pageSize" class="form-select">
                        <option value="10" selected="@(pageSize == 10)">@L["AdminRev_PerPage", 10]</option>
                        <option value="20" selected="@(pageSize == 20)">@L["AdminRev_PerPage", 20]</option>
                        <option value="50" selected="@(pageSize == 50)">@L["AdminRev_PerPage", 50]</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary px-3"><i class="bi bi-funnel me-1"></i>@L["Btn_Filter"]</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(filter.Search))
                {
                    <div class="col-auto">
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-tab="@tab">
                            <i class="bi bi-x-circle me-1"></i>@L["AdminRev_ClearSearch"]
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th class="ps-3" style="min-width: 210px;">@L["Admin_Sellers_ColShop"]</th>
                        <th style="min-width: 220px;">@L["Admin_Sellers_ColOwner"]</th>
                        <th style="min-width: 170px;">@L["Admin_Sellers_ColArea"]</th>
                        <th class="text-center" style="width: 120px;">@L["AdminRev_ColRating"]</th>
                        <th class="text-center" style="width: 150px;">@L["AdminRev_ColCompletedOrders"]</th>
                        <th class="text-center" style="width: 110px;">@L["AdminRev_ColReports"]</th>
                        <th class="text-end pe-3" style="min-width: 300px;">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-emoji-smile fs-4 d-block mb-2"></i>
                                @(tab == "can_ra_soat"
                                    ? L["AdminRev_EmptyFlagged"].Value
                                    : L["AdminRev_EmptyAll"].Value)
                            </td>
                        </tr>
                    }
                    @foreach (var shop in Model.Items)
                    {
                        <tr>
                            <td class="ps-3">
                                <a class="fw-semibold text-dark text-decoration-none"
                                   asp-action="Details" asp-route-id="@shop.MaCuaHang">@shop.TenShop</a>
                                <div class="small mt-1">
                                    @if (shop.TrangThaiShop == "LOCKED")
                                    {
                                        <span class="badge bg-danger">@HienThi.TrangThaiTaiKhoan("LOCKED")</span>
                                        @if (!string.IsNullOrWhiteSpace(shop.LyDoKhoa))
                                        {
                                            <span class="text-muted ms-1">@shop.LyDoKhoa</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@HienThi.TrangThaiTaiKhoan("ACTIVE")</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@shop.TenChuShop</div>
                                <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@shop.EmailChuShop</div>
                                @if (!string.IsNullOrWhiteSpace(shop.SoDienThoai))
                                {
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@shop.SoDienThoai</div>
                                }
                            </td>
                            <td class="small text-secondary">@shop.KhuVuc</td>
                            <td class="text-center">
                                @if (shop.DiemTrungBinh < 3.0m)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        @shop.DiemTrungBinh.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) <i class="bi bi-star-fill"></i>
                                    </span>
                                }
                                else if (shop.DiemTrungBinh < 4.0m)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                        @shop.DiemTrungBinh.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) <i class="bi bi-star-fill"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        @shop.DiemTrungBinh.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) <i class="bi bi-star-fill"></i>
                                    </span>
                                }
                                <div class="small text-muted mt-1">@L["AdminRev_ReviewsCount", shop.SoDanhGia]</div>
                            </td>
                            <td class="text-center">
                                <span class="fw-semibold text-dark">@shop.SoDonThanhCong</span>
                                <div class="small text-muted">@L["AdminRev_CompletedOrdersUnit"]</div>
                            </td>
                            <td class="text-center">
                                @if (shop.SoBaoCao > 0)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2" title="@L["AdminRev_ReportsTip"]">
                                        @shop.SoBaoCao
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary rounded-pill"
                                       asp-action="Details" asp-route-id="@shop.MaCuaHang" title="@L["AdminRev_BtnInspect"]">
                                        <i class="bi bi-search me-1"></i>@L["AdminRev_BtnInspect"]
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary rounded-pill"
                                       asp-area="Admin" asp-controller="Orders" asp-action="Index"
                                       asp-route-shopId="@shop.MaCuaHang" title="@L["AdminRev_BtnOrderHistory"]">
                                        <i class="bi bi-receipt me-1"></i>@L["AdminRev_BtnOrderHistory"]
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill"
                                            data-bs-toggle="modal" data-bs-target="#modalCanhBao"
                                            data-shop-id="@shop.MaCuaHang" data-shop-name="@shop.TenShop"
                                            data-tab="@tab" title="@L["AdminRev_BtnSendWarn"]">
                                        <i class="bi bi-megaphone me-1"></i>@L["AdminRev_BtnWarn"]
                                    </button>
                                    @if (shop.TrangThaiShop == "LOCKED")
                                    {
                                        <form asp-action="UnlockShop" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maCuaHang" value="@shop.MaCuaHang" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button class="btn btn-sm btn-outline-success rounded-pill" title="@L["AdminRev_BtnUnlockShop"]">
                                                <i class="bi bi-unlock me-1"></i>@L["Btn_Unlock"]
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill"
                                                data-bs-toggle="modal" data-bs-target="#modalKhoaShop"
                                                data-shop-id="@shop.MaCuaHang" data-shop-name="@shop.TenShop"
                                                title="@L["AdminRev_BtnLockShop"]">
                                            <i class="bi bi-lock me-1"></i>@L["AdminRev_BtnLockShop"]
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <span class="text-muted small">
                    @L["Common_Page"] @Model.CurrentPage / @Model.TotalPages — @L["AdminRev_ShopsCount", Model.TotalItems]
                </span>
                <nav aria-label="@L["MyRev_PaginationAria"]">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-tab="@tab"
                               asp-route-search="@filter.Search" asp-route-pageSize="@pageSize"
                               asp-route-page="@(Model.CurrentPage - 1)">&laquo; @L["Btn_Prev"]</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.CurrentPage</span>
                        </li>
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-tab="@tab"
                               asp-route-search="@filter.Search" asp-route-pageSize="@pageSize"
                               asp-route-page="@(Model.CurrentPage + 1)">@L["Btn_Next"] &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@* Modal khóa shop *@
<div class="modal fade" id="modalKhoaShop" tabindex="-1" aria-labelledby="modalKhoaShopLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="LockShop" method="post" class="modal-content border-0 rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maCuaHang" value="" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-danger" id="modalKhoaShopLabel">
                    <i class="bi bi-lock me-1"></i>@L["AdminRev_ModalLockTitle"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Btn_Close"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">@L["AdminRev_ModalLockIntro"] <strong data-vai-tro="ten-shop"></strong>.</p>
                <label class="form-label fw-semibold small">@L["AdminRev_ModalLockReasonLabel"] <span class="text-danger">*</span></label>
                <textarea name="reason" class="form-control" rows="3" maxlength="500" required
                          placeholder="@L["AdminRev_ModalLockPlaceholder"]"></textarea>
                <div class="form-text">@L["AdminRev_ModalLockHint"]</div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="submit" class="btn btn-danger rounded-pill px-3">
                    <i class="bi bi-lock me-1"></i>@L["AdminRev_ModalLockConfirm"]
                </button>
            </div>
        </form>
    </div>
</div>

@* Modal gửi cảnh cáo *@
<div class="modal fade" id="modalCanhBao" tabindex="-1" aria-labelledby="modalCanhBaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Warn" method="post" class="modal-content border-0 rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maCuaHang" value="" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-warning" id="modalCanhBaoLabel">
                    <i class="bi bi-megaphone me-1"></i>@L["AdminRev_ModalWarnTitle"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Btn_Close"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">@L["AdminRev_ModalWarnIntro"] <strong data-vai-tro="ten-shop"></strong>.</p>
                <label class="form-label fw-semibold small">@L["AdminRev_ModalWarnLabel"] <span class="text-danger">*</span></label>
                <textarea name="reason" class="form-control" rows="4" maxlength="1000" required
                          placeholder="@L["AdminRev_ModalWarnPlaceholder"]"></textarea>
                <div class="form-text">@L["AdminRev_ModalWarnHint"]</div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                <button type="submit" class="btn btn-warning rounded-pill px-3">
                    <i class="bi bi-send me-1"></i>@L["AdminRev_BtnSendWarn"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function ganDuLieu(modalId) {
                var modal = document.getElementById(modalId);
                if (!modal) return;
                modal.addEventListener('show.bs.modal', function (event) {
                    var nut = event.relatedTarget;
                    if (!nut) return;
                    modal.querySelector('input[name="maCuaHang"]').value = nut.getAttribute('data-shop-id') || '';
                    var ten = modal.querySelector('[data-vai-tro="ten-shop"]');
                    if (ten) ten.textContent = nut.getAttribute('data-shop-name') || '';
                });
            }
            ganDuLieu('modalKhoaShop');
            ganDuLieu('modalCanhBao');
        })();
    </script>
}
