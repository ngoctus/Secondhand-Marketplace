@model SecondHandMarketplace.Web.Models.ViewModels.Admin.ForbiddenKeywordsVm
@{
    ViewData["Title"] = L["AdminKw_Title"].Value;
}
<div class="container-fluid py-4">
    <div class="mb-3">
        <h2 class="h4 fw-bold mb-1">@L["AdminKw_Title"]</h2>
        <p class="text-muted small mb-0">
            @L["AdminKw_DescHigh"] @L["AdminKw_DescLow"] @L["AdminKw_DescNote"]
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h5 class="fw-bold mb-3">@L["AdminKw_AddSection"]</h5>
        <form asp-action="Add" method="post" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input name="phrase" class="form-control" placeholder="@L["AdminKw_PhrasePlaceholder"]" required maxlength="100" />
            </div>
            <div class="col-md-2">
                <input name="group" class="form-control" placeholder="@L["AdminKw_GroupPlaceholder"]" maxlength="30" />
            </div>
            <div class="col-md-2">
                <select name="level" class="form-select">
                    <option value="LOW" selected>@L["AdminKw_OptLow"]</option>
                    <option value="HIGH">@L["AdminKw_OptHigh"]</option>
                </select>
            </div>
            <div class="col-md-3">
                <input name="note" class="form-control" placeholder="@L["AdminKw_NotePlaceholder"]" maxlength="500" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary px-3"><i class="bi bi-plus-lg me-1"></i>@L["AdminKw_AddBtn"]</button>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input name="search" value="@Model.Search" class="form-control" placeholder="@L["AdminKw_SearchPlaceholder"]" />
                </div>
                <div class="col-md-2">
                    <select name="level" class="form-select">
                        <option value="" selected="@string.IsNullOrEmpty(Model.Level)">@L["AdminKw_AllLevels"]</option>
                        <option value="HIGH" selected="@(Model.Level == "HIGH")">HIGH</option>
                        <option value="LOW" selected="@(Model.Level == "LOW")">LOW</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="active" class="form-select">
                        <option value="" selected="@(Model.Active == null)">@L["Common_AllStatuses"]</option>
                        <option value="true" selected="@(Model.Active == true)">@L["AdminKw_Active"]</option>
                        <option value="false" selected="@(Model.Active == false)">@L["AdminKw_Disabled"]</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-secondary px-3"><i class="bi bi-funnel me-1"></i>@L["Btn_Filter"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th class="ps-3">@L["AdminMod_ColKeyword"]</th>
                        <th>@L["AdminKw_ColGroup"]</th>
                        <th>@L["AdminMod_ColLevel"]</th>
                        <th>@L["AdminKw_ColNote"]</th>
                        <th>@L["Common_Status"]</th>
                        <th class="text-end pe-3">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var k in Model.Items)
                {
                    <tr>
                        <td class="ps-3">
                            <strong>@k.Phrase</strong>
                            <div class="small text-muted">@k.NormalizedPhrase</div>
                        </td>
                        <td colspan="3">
                            <form asp-action="Update" method="post" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="id" value="@k.Id" />
                                <input name="group" value="@k.Group" class="form-control form-control-sm" style="max-width:170px" maxlength="30" />
                                <select name="level" class="form-select form-select-sm" style="max-width:110px">
                                    <option value="LOW" selected="@(k.Level == "LOW")">LOW</option>
                                    <option value="HIGH" selected="@(k.Level == "HIGH")">HIGH</option>
                                </select>
                                <input name="note" value="@k.Note" class="form-control form-control-sm" maxlength="500" />
                                <button class="btn btn-sm btn-outline-primary text-nowrap">@L["Btn_SaveShort"]</button>
                            </form>
                        </td>
                        <td>
                            @if (k.Active)
                            {
                                <span class="badge bg-success rounded-pill">@L["AdminKw_Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill">@L["AdminKw_Disabled"]</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <form asp-action="Toggle" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@k.Id" />
                                <input type="hidden" name="active" value="@((!k.Active).ToString().ToLowerInvariant())" />
                                <button class="btn btn-sm @(k.Active ? "btn-outline-warning" : "btn-outline-success") text-nowrap">
                                    @(k.Active ? L["AdminKw_BtnDisable"].Value : L["AdminKw_BtnEnable"].Value)
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">@L["AdminKw_Empty"]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
