@model SecondHandMarketplace.Web.Areas.Admin.Controllers.CategoryManagementVm
@{ ViewData["Title"] = "Danh mục và tình trạng"; }
<div class="container-fluid py-4">
    <h2>Danh mục và tình trạng sản phẩm</h2>
    <h4 class="mt-4">Danh mục</h4>
    <form asp-action="SaveCategory" method="post" class="row g-2 mb-3"><div class="col-md-5"><input name="name" class="form-control" placeholder="Tên danh mục" required maxlength="100"/></div><div class="col-md-2"><input name="order" type="number" class="form-control" value="0"/></div><div class="col-md-2 form-check align-self-center"><input name="visible" type="checkbox" value="true" checked class="form-check-input"/><label class="form-check-label">Hiển thị</label></div><div class="col-auto"><button class="btn btn-primary">Thêm danh mục</button></div></form>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Tên</th><th>Thứ tự</th><th>Hiển thị</th><th></th></tr></thead><tbody>@foreach(var c in Model.Categories){<tr><td><form asp-action="SaveCategory" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@c.MaDanhMuc"/><input name="name" value="@c.Ten" class="form-control"/><input name="order" type="number" value="@c.ThuTuHienThi" class="form-control" style="max-width:100px"/><select name="visible" class="form-select" style="max-width:130px"><option value="true" selected="@c.DangHienThi">Hiện</option><option value="false" selected="@(!c.DangHienThi)">Ẩn</option></select><button class="btn btn-sm btn-outline-primary">Lưu</button></form></td><td colspan="2"></td><td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.MaDanhMuc"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa hoặc ẩn danh mục này?')">Xóa</button></form></td></tr>}</tbody></table></div>
    <h4 class="mt-5">Tình trạng sản phẩm</h4>
    <form asp-action="SaveCondition" method="post" class="row g-2 mb-3"><div class="col-md-2"><input name="code" class="form-control" placeholder="Mã (NEW)" required maxlength="30"/></div><div class="col-md-3"><input name="name" class="form-control" placeholder="Tên tình trạng" required maxlength="100"/></div><div class="col-md-3"><input name="description" class="form-control" placeholder="Mô tả" maxlength="500"/></div><div class="col-md-1"><input name="order" type="number" class="form-control" value="0"/></div><div class="col-auto"><button class="btn btn-primary">Thêm</button></div></form>
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Mã</th><th>Tên</th><th>Mô tả</th><th>Thứ tự</th><th>Đang dùng</th><th></th></tr></thead><tbody>@foreach(var c in Model.Conditions){<tr><td colspan="6"><form asp-action="SaveCondition" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@c.MaTinhTrang"/><input name="code" value="@c.Ma" class="form-control" style="max-width:120px"/><input name="name" value="@c.Ten" class="form-control"/><input name="description" value="@c.MoTa" class="form-control"/><input name="order" type="number" value="@c.ThuTuHienThi" class="form-control" style="max-width:90px"/><select name="active" class="form-select" style="max-width:120px"><option value="true" selected="@c.DangSuDung">Có</option><option value="false" selected="@(!c.DangSuDung)">Không</option></select><button class="btn btn-sm btn-outline-primary">Lưu</button><button formaction="@Url.Action("DeleteCondition")" name="id" value="@c.MaTinhTrang" class="btn btn-sm btn-outline-danger" formmethod="post" onclick="return confirm('Xóa hoặc ẩn tình trạng này?')">Xóa</button></form></td></tr>}</tbody></table></div>
</div>
