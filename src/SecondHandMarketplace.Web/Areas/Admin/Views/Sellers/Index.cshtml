@model IReadOnlyList<SecondHandMarketplace.Web.Models.Entities.CuaHang>
@{
    ViewData["Title"] = L["Admin_Sellers_Title"].Value;
}
<div class="container-fluid py-4">
    <h2 class="h4 fw-bold mb-3">@L["Admin_Sellers_Title"]</h2>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input name="search" value="@ViewBag.Search" class="form-control" placeholder="@L["Admin_Sellers_SearchPlaceholder"]" />
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">@L["Common_AllStatuses"]</option>
                        <option value="ACTIVE" selected="@(ViewBag.Status as string == "ACTIVE")">@L["Common_Active"]</option>
                        <option value="LOCKED" selected="@(ViewBag.Status as string == "LOCKED")">@L["Common_Locked"]</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary px-4"><i class="bi bi-funnel me-1"></i>@L["Btn_Filter"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">@L["Admin_Sellers_ColShop"]</th>
                        <th>@L["Admin_Sellers_ColOwner"]</th>
                        <th>@L["Admin_Sellers_ColContact"]</th>
                        <th>@L["Admin_Sellers_ColArea"]</th>
                        <th>@L["Common_Status"]</th>
                        <th class="pe-3">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shop in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <strong>@shop.TenShop</strong>
                                <div class="small text-muted">@shop.MoTa</div>
                            </td>
                            <td>
                                @shop.NguoiDung.HoTen<br />
                                <small class="text-muted">@shop.NguoiDung.Email</small>
                            </td>
                            <td>@shop.SoDienThoaiLienHe</td>
                            <td>
                                @if (shop.PhuongXa is not null && shop.TinhThanh is not null)
                                {
                                    <span>@shop.PhuongXa.TenPhuongXa, @shop.TinhThanh.TenTinhThanh</span>
                                }
                                else
                                {
                                    <span class="text-muted">@L["Common_NotUpdated"]</span>
                                }
                            </td>
                            <td>
                                @if (shop.TrangThai == "LOCKED")
                                {
                                    <span class="badge bg-danger">@HienThi.TrangThaiTaiKhoan("LOCKED")</span>
                                    <div class="small text-muted">@shop.LyDoKhoa</div>
                                }
                                else
                                {
                                    <span class="badge bg-success">@HienThi.TrangThaiTaiKhoan("ACTIVE")</span>
                                }
                            </td>
                            <td class="pe-3">
                                @if (shop.TrangThai == "ACTIVE")
                                {
                                    <form asp-action="Lock" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="id" value="@shop.MaCuaHang" />
                                        <input name="reason" class="form-control form-control-sm" placeholder="@L["Admin_Users_LockReasonPlaceholder"]" required maxlength="500" />
                                        <button class="btn btn-sm btn-danger text-nowrap">@L["Btn_Lock"]</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Unlock" method="post">
                                        <input type="hidden" name="id" value="@shop.MaCuaHang" />
                                        <button class="btn btn-sm btn-success">@L["Btn_Unlock"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">@L["Admin_Sellers_Empty"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
