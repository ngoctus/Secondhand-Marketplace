@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="@(HienThi.LaTiengAnh ? "en" : "vi")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["Admin_SiteTitle"]</title>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="rm-csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    <meta name="description" content="@L["Admin_MetaDescription"]" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* B-05: toàn bộ <style> của khung Admin đã dời vào wwwroot/css/site.css (mục 13) để dùng token màu của sàn. *@
</head>
<body class="rm-body">
    <a class="rm-skip-link" href="#admin-main-content">@HienThi.Chon("Bỏ qua điều hướng", "Skip to main content")</a>
    <div class="admin-layout-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>Re:Market</span>
                </a>
                <span class="admin-sidebar-badge">ADMIN</span>
            </div>
            <nav class="admin-nav" aria-label="@L["Admin_MenuAria"]">
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> <span>@L["Admin_Dashboard"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-box-seam"></i> <span>@L["Admin_Orders"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> <span>@L["Admin_Users"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Sellers" asp-action="Index">
                    <i class="bi bi-shop"></i> <span>@L["Admin_Sellers"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                    <i class="bi bi-star"></i> <span>@L["Admin_Reviews"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-check2-circle"></i> <span>@L["Admin_Products"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Auctions" asp-action="Index">
                    <i class="bi bi-hammer"></i> <span>@L["Admin_Auctions"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-grid"></i> <span>@L["Admin_Categories"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Banners" asp-action="Index">
                    <i class="bi bi-images"></i> <span>@L["Admin_Banners"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Disputes" asp-action="Index">
                    <i class="bi bi-exclamation-octagon"></i> <span>@L["Admin_Disputes"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-flag"></i> <span>@L["Admin_Reports"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Violations" asp-action="Index">
                    <i class="bi bi-shield-exclamation"></i> <span>@L["Admin_Violations"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="AccountAppeals" asp-action="Index">
                    <i class="bi bi-person-lock"></i> <span>@L["Admin_AccountAppeals"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Notifications" asp-action="Index">
                    <i class="bi bi-megaphone"></i> <span>@L["Admin_Notifications"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="ForbiddenKeywords" asp-action="Index">
                    <i class="bi bi-slash-circle"></i> <span>@L["Admin_ForbiddenKeywords"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                    <i class="bi bi-journal-text"></i> <span>@L["Admin_AuditLogs"]</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="AiSettings" asp-action="Index">
                    <i class="bi bi-robot"></i> <span>@L["Admin_AiSettings"]</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-content-wrap">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small">@L["Admin_PageLabel"]</span>
                    <strong class="text-dark small">@ViewData["Title"]</strong>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <partial name="_LanguageSwitcher" />
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" target="_blank" title="@L["Admin_BackToMarketplace"]">
                        <i class="bi bi-box-arrow-up-right"></i>
                        <span>@L["Admin_BackToMarketplace"]</span>
                    </a>
                    <div class="d-flex align-items-center gap-2 border-start ps-3">
                        <span class="badge bg-danger">ADMIN</span>
                        <span class="small fw-semibold text-dark">@User.Identity?.Name</span>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none" title="@L["Nav_Logout"]">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <!-- Body Content -->
            <main class="admin-main" id="admin-main-content" tabindex="-1">
                <partial name="_ThongBao" />
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="admin-footer d-flex justify-content-between align-items-center">
                <span>© @DateTime.Now.Year Re:Market - @L["Admin_FooterCopy"]</span>
                <span class="text-muted">@L["Admin_Version"]</span>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @* B-05: dung _I18nScript (render tu dian JSON + site.js) de toast/confirm trong Admin cung theo ngon ngu, khong fallback tieng Viet. *@
    <partial name="_I18nScript" />
    <script>
        // Tự động đánh dấu active link menu admin dựa trên URL hiện tại
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.admin-nav-item').forEach(link => {
                const href = link.getAttribute('href')?.toLowerCase();
                if (href && currentPath.startsWith(href) && href !== '/admin') {
                    link.classList.add('active');
                } else if (href === '/admin' && (currentPath === '/admin' || currentPath === '/admin/dashboard')) {
                    link.classList.add('active');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
