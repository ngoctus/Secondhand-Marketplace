@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Re:Market</title>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="rm-csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    <meta name="description" content="Trang quản trị hệ thống Re:Market" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .admin-layout-wrapper { display: flex; min-height: 100vh; background-color: #f8fafc; font-family: var(--font-main, 'Be Vietnam Pro', sans-serif); }
        .admin-sidebar { width: 250px; background-color: #0f172a; color: #cbd5e1; display: flex; flex-direction: column; flex-shrink: 0; }
        .admin-sidebar-header { padding: 18px 20px; border-bottom: 1px solid #1e293b; display: flex; align-items: center; justify-content: space-between; }
        .admin-sidebar-header a { text-decoration: none; color: #fff; font-weight: 700; font-size: 17px; display: flex; align-items: center; gap: 8px; }
        .admin-sidebar-badge { font-size: 10px; font-weight: 600; padding: 2px 6px; background-color: #dc2626; color: #fff; border-radius: 4px; text-transform: uppercase; }
        .admin-nav { padding: 10px 0; overflow-y: auto; flex-grow: 1; }
        .admin-nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 18px; color: #94a3b8; text-decoration: none; font-size: 13px; font-weight: 500; transition: all 0.15s ease; border-left: 3px solid transparent; }
        .admin-nav-item:hover { color: #f8fafc; background-color: #1e293b; }
        .admin-nav-item.active { color: #fff; background-color: #1e293b; border-left-color: var(--color-brand-primary, #285b43); font-weight: 600; }
        .admin-nav-item i { font-size: 15px; width: 18px; text-align: center; }
        .admin-content-wrap { flex-grow: 1; display: flex; flex-direction: column; min-width: 0; }
        .admin-topbar { height: 58px; background-color: #fff; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; position: sticky; top: 0; z-index: 100; }
        .admin-main { padding: 24px; flex-grow: 1; }
        .admin-footer { padding: 14px 24px; border-top: 1px solid #e2e8f0; background: #fff; font-size: 12px; color: #64748b; }
    </style>
</head>
<body class="rm-body">
    <div class="admin-layout-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>Re:Market</span>
                </a>
                <span class="admin-sidebar-badge">ADMIN</span>
            </div>
            <nav class="admin-nav" aria-label="Menu Quản Trị">
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> <span>Thống kê hệ thống</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-box-seam"></i> <span>Quản lý đơn hàng</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> <span>Người dùng</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Sellers" asp-action="Index">
                    <i class="bi bi-shop"></i> <span>Cửa hàng</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                    <i class="bi bi-star"></i> <span>Rà soát đánh giá shop</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-check2-circle"></i> <span>Duyệt sản phẩm</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-grid"></i> <span>Danh mục</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Banners" asp-action="Index">
                    <i class="bi bi-images"></i> <span>Banner</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Disputes" asp-action="Index">
                    <i class="bi bi-exclamation-octagon"></i> <span>Tranh chấp</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-flag"></i> <span>Báo cáo vi phạm</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="ForbiddenKeywords" asp-action="Index">
                    <i class="bi bi-slash-circle"></i> <span>Từ khóa cấm</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                    <i class="bi bi-journal-text"></i> <span>Nhật ký hệ thống</span>
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="AiSettings" asp-action="Index">
                    <i class="bi bi-robot"></i> <span>Cấu hình AI</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-content-wrap">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small">Trang quản trị:</span>
                    <strong class="text-dark small">@ViewData["Title"]</strong>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" target="_blank" title="Mở trang chủ khách hàng">
                        <i class="bi bi-box-arrow-up-right"></i>
                        <span>Về Marketplace</span>
                    </a>
                    <div class="d-flex align-items-center gap-2 border-start ps-3">
                        <span class="badge bg-danger">ADMIN</span>
                        <span class="small fw-semibold text-dark">@User.Identity?.Name</span>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none" title="Đăng xuất">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <!-- Body Content -->
            <main class="admin-main">
                <partial name="_ThongBao" />
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="admin-footer d-flex justify-content-between align-items-center">
                <span>© @DateTime.Now.Year Re:Market - Hệ thống Quản trị & Điều hành Sàn</span>
                <span class="text-muted">Phiên bản 2.0 (Bảo mật & Kiểm duyệt)</span>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Tự động đánh dấu active link menu admin dựa trên URL hiện tại
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.admin-nav-item').forEach(link => {
                const href = link.getAttribute('href')?.toLowerCase();
                if (href && currentPath.startsWith(href) && href !== '/admin') {
                    link.classList.add('active');
                } else if (href === '/admin' && (currentPath === '/admin' || currentPath === '/admin/dashboard')) {
                    link.classList.add('active');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
