@model SecondHandMarketplace.Web.Models.ViewModels.Orders.VietQrViewModel

<div class="vietqr-card border rounded-4 p-4 bg-white shadow-sm mb-4">
    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-qr-code fs-5"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0 text-dark">Thanh toán Chuyển khoản VietQR</h6>
                <div class="text-muted" style="font-size: 11.5px;">Quét mã bằng mọi app ngân hàng hoặc ví điện tử (Napas 247)</div>
            </div>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
            <i class="bi bi-lightning-charge-fill me-1"></i>Xử lý tự động
        </span>
    </div>

    <div class="row g-4 align-items-center">
        <!-- Khung QR Code -->
        <div class="col-md-5 text-center">
            <div class="vietqr-frame d-inline-block p-2 rounded-3 border bg-light shadow-sm" style="max-width: 230px;">
                <div class="bg-primary text-white text-center py-1 rounded-2 mb-1 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
                    MB BANK · VIETQR NAPAS
                </div>
                <img src="@Model.QrUrl" 
                     alt="VietQR Mã thanh toán" 
                     class="img-fluid rounded border bg-white" 
                     style="width: 200px; height: 200px; object-fit: contain;"
                     onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 200 200\'><rect width=\'200\' height=\'200\' fill=\'%23f8f9fa\'/><rect x=\'20\' y=\'20\' width=\'50\' height=\'50\' fill=\'%23111827\'/><rect x=\'30\' y=\'30\' width=\'30\' height=\'30\' fill=\'%23fff\'/><rect x=\'35\' y=\'35\' width=\'20\' height=\'20\' fill=\'%23111827\'/><rect x=\'130\' y=\'20\' width=\'50\' height=\'50\' fill=\'%23111827\'/><rect x=\'140\' y=\'30\' width=\'30\' height=\'30\' fill=\'%23fff\'/><rect x=\'145\' y=\'35\' width=\'20\' height=\'20\' fill=\'%23111827\'/><rect x=\'20\' y=\'130\' width=\'50\' height=\'50\' fill=\'%23111827\'/><rect x=\'30\' y=\'140\' width=\'30\' height=\'30\' fill=\'%23fff\'/><rect x=\'35\' y=\'145\' width=\'20\' height=\'20\' fill=\'%23111827\'/><circle cx=\'100\' cy=\'100\' r=\'18\' fill=\'%231f5c3d\'/><text x=\'100\' y=\'104\' font-size=\'8\' fill=\'%23fff\' font-weight=\'bold\' text-anchor=\'middle\'>RE:MARKET</text></svg>';" />
                <div class="mt-2 text-muted fw-semibold" style="font-size: 11px;">
                    <i class="bi bi-camera me-1"></i>Mở camera / App ngân hàng để quét
                </div>
            </div>
        </div>

        <!-- Chi tiết chuyển khoản -->
        <div class="col-md-7">
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">Ngân hàng thụ hưởng</div>
                        <div class="fw-bold text-dark small">@Model.NganHang (MB)</div>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary font-monospace">BIN: @Model.MaNganHang</span>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">Số tài khoản</div>
                        <div class="fw-bold text-primary font-monospace fs-6">@Model.SoTaiKhoan</div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" onclick="copyVietQrRaw('@Model.SoTaiKhoan', this)">
                        <i class="bi bi-clipboard me-1"></i>Chép
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">Chủ tài khoản</div>
                        <div class="fw-bold text-dark small">@Model.ChuTaiKhoan</div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" onclick="copyVietQrRaw('@Model.ChuTaiKhoan', this)">
                        <i class="bi bi-clipboard me-1"></i>Chép
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-success-subtle border border-success-subtle">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">Số tiền chính xác</div>
                        <div class="fw-bold text-success fs-5">@Model.SoTien.ToString("N0") ₫</div>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" onclick="copyVietQrRaw('@((long)Model.SoTien)', this)">
                        <i class="bi bi-clipboard me-1"></i>Chép
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-warning-subtle border border-warning-subtle">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">Nội dung chuyển khoản (bắt buộc)</div>
                        <div class="fw-bold text-dark font-monospace">@Model.NoiDung</div>
                    </div>
                    <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" onclick="copyVietQrRaw('@Model.NoiDung', this)">
                        <i class="bi bi-clipboard me-1"></i>Chép
                    </button>
                </div>
            </div>

            <div class="alert alert-info py-2 px-3 small mt-3 mb-0" style="font-size: 12px;">
                <i class="bi bi-info-circle-fill me-1"></i> <strong>Lưu ý:</strong> Vui lòng giữ nguyên nội dung chuyển khoản để hệ thống tự động xác nhận giao dịch trong vòng 1-3 phút.
            </div>

            @if (Model.ChoPhepXacNhan && (Model.MaDonHang.HasValue || !string.IsNullOrEmpty(Model.DanhSachMaDonHang)))
            {
                <form asp-area="User" asp-controller="Orders" asp-action="XacNhanThanhToan" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    @if (Model.MaDonHang.HasValue)
                    {
                        <input type="hidden" name="maDonHang" value="@Model.MaDonHang.Value" />
                    }
                    @if (!string.IsNullOrEmpty(Model.DanhSachMaDonHang))
                    {
                        <input type="hidden" name="dsMaDonHang" value="@Model.DanhSachMaDonHang" />
                    }
                    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                    {
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    }
                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-semibold py-2">
                        <i class="bi bi-check-circle-fill me-1"></i> Tôi đã chuyển khoản xong
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<script>
function copyVietQr(elementId, btn) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const text = el.innerText.trim();
    copyTextToClipboard(text, btn);
}
function copyVietQrRaw(text, btn) {
    copyTextToClipboard(text, btn);
}
function copyTextToClipboard(text, btn) {
    navigator.clipboard.writeText(text).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2"></i> Đã chép!';
        btn.classList.add('btn-success');
        setTimeout(() => {
            btn.innerHTML = orig;
            btn.classList.remove('btn-success');
        }, 1800);
    }).catch(err => {
        alert('Đã sao chép: ' + text);
    });
}
</script>
