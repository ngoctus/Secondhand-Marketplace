@model SecondHandMarketplace.Web.Models.ViewModels.Orders.VietQrViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var clipboardMessages = new
    {
        copied = HienThi.Chon("Đã chép", "Copied"),
        copiedTitle = HienThi.Chon("Đã sao chép!", "Copied!"),
        copiedContent = HienThi.Chon("Đã sao chép nội dung: \"{0}\" vào bộ nhớ tạm.", "Copied \"{0}\" to your clipboard."),
        copyFailedTitle = HienThi.Chon("Không thể tự sao chép", "Could not copy automatically"),
        copyFailed = HienThi.Chon("Vui lòng chọn và sao chép thủ công: ", "Please select and copy manually: "),
        copyFailedToast = HienThi.Chon("Không thể sao chép tự động: ", "Automatic copy failed: "),
        copyManually = HienThi.Chon("Vui lòng sao chép thủ công:", "Please copy manually:")
    };
}

<div class="vietqr-card border rounded-4 p-4 bg-white shadow-sm mb-4">
    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-qr-code fs-5"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0 text-dark">@HienThi.Chon("Thanh toán chuyển khoản VietQR", "VietQR Bank Transfer")</h6>
                <div class="text-muted" style="font-size: 11.5px;">@HienThi.Chon("Mã QR được tạo theo chuẩn EMVCo Napas247.", "QR code generated to the EMVCo Napas247 standard.")</div>
            </div>
        </div>
        <!-- Nhãn "Xác nhận thủ công" theo quy định của đồ án (Task D4) -->
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill small">
            <i class="bi bi-hand-index-thumb me-1"></i>@HienThi.Chon("Xác nhận thủ công", "Manual confirmation")
        </span>
    </div>

    <!-- KHUNG QUY ĐỊNH AN TOÀN THANH TOÁN (Bắt buộc theo tài liệu nhóm - Người D) -->
    <div class="alert alert-warning border border-warning rounded-3 p-3 mb-3" style="font-size: 12px; line-height: 1.5;">
        <div class="fw-bold text-dark d-flex align-items-center gap-1 mb-1">
            <i class="bi bi-shield-exclamation text-warning fs-6"></i>
            <span>@HienThi.Chon("Quy định an toàn giao dịch chuyển khoản:", "Bank transfer safety:")</span>
        </div>
        <ul class="mb-0 ps-3 text-secondary">
            <li><strong>@HienThi.Chon("Người mua", "Buyer"):</strong> @HienThi.Chon("Kiểm tra tên chủ tài khoản, số tiền và nội dung chuyển khoản trước khi xác nhận trong ứng dụng ngân hàng.", "Verify the account name, amount, and transfer reference before confirming in your banking app.")</li>
            <li><strong>@HienThi.Chon("Người bán", "Seller"):</strong> @HienThi.Chon("Chỉ xác nhận đơn sau khi đã kiểm tra và thấy tiền vào tài khoản ngân hàng.", "Confirm an order only after verifying that the money reached your bank account.")</li>
            <li><strong>@HienThi.Chon("Lưu ý", "Note"):</strong> @HienThi.Chon("Hệ thống không tự động xác nhận với ngân hàng và nền tảng không bảo chứng thanh toán.", "The platform does not automatically verify bank transfers or guarantee payment.")</li>
        </ul>
    </div>

    <div class="row g-4 align-items-center">
        <!-- Khung QR Code -->
        <div class="col-md-5 text-center">
            <div class="vietqr-frame d-inline-block p-2 rounded-3 border bg-light shadow-sm" style="max-width: 240px;">
                <div class="bg-primary text-white text-center py-1 rounded-2 mb-1 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
                    @Model.NganHang.ToUpperInvariant() · VIETQR NAPAS
                </div>
                <!-- Ảnh mã QR sinh offline nội bộ bằng QRCoder (theo bài giảng UTC2) -->
                <img src="@Model.QrImageSource"
                     alt="@HienThi.Chon("Mã thanh toán VietQR", "VietQR payment code")"
                     class="img-fluid rounded border bg-white" 
                     style="width: 210px; height: 210px; object-fit: contain;" />
                <div class="mt-2 text-muted fw-semibold" style="font-size: 11px;">
                    <i class="bi bi-camera me-1"></i>@HienThi.Chon("Mở camera hoặc ứng dụng ngân hàng để quét", "Scan with your camera or banking app")
                </div>
            </div>
        </div>

        <!-- Chi tiết chuyển khoản -->
        <div class="col-md-7">
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">@HienThi.Chon("Ngân hàng thụ hưởng", "Receiving bank")</div>
                        <div class="fw-bold text-dark small">@Model.NganHang</div>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary font-monospace">BIN: @Model.MaNganHang</span>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">@HienThi.Chon("Số tài khoản cửa hàng", "Shop account number")</div>
                        <div class="fw-bold text-primary font-monospace fs-6">@Model.SoTaiKhoan</div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" data-copy-value="@Model.SoTaiKhoan" onclick="copyVietQrRaw(this.dataset.copyValue, this)">
                        <i class="bi bi-clipboard me-1"></i>@HienThi.Chon("Chép", "Copy")
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light border">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">@HienThi.Chon("Chủ tài khoản", "Account holder")</div>
                        <div class="fw-bold text-dark small">@Model.ChuTaiKhoan</div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" data-copy-value="@Model.ChuTaiKhoan" onclick="copyVietQrRaw(this.dataset.copyValue, this)">
                        <i class="bi bi-clipboard me-1"></i>@HienThi.Chon("Chép", "Copy")
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-success-subtle border border-success-subtle">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">@HienThi.Chon("Số tiền chính xác", "Exact amount")</div>
                        <div class="fw-bold text-success fs-5">@Model.SoTien.ToString("N0") ₫</div>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" data-copy-value="@((long)Model.SoTien)" onclick="copyVietQrRaw(this.dataset.copyValue, this)">
                        <i class="bi bi-clipboard me-1"></i>@HienThi.Chon("Chép", "Copy")
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-warning-subtle border border-warning-subtle">
                    <div>
                        <div class="text-muted" style="font-size: 11px;">@HienThi.Chon("Nội dung chuyển khoản (bắt buộc)", "Transfer reference (required)")</div>
                        <div class="fw-bold text-dark font-monospace">@Model.NoiDung</div>
                    </div>
                    <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-2 py-0 copy-btn" style="font-size: 12px;" data-copy-value="@Model.NoiDung" onclick="copyVietQrRaw(this.dataset.copyValue, this)">
                        <i class="bi bi-clipboard me-1"></i>@HienThi.Chon("Chép", "Copy")
                    </button>
                </div>
            </div>

            <div class="alert alert-info py-2 px-3 small mt-3 mb-0" style="font-size: 12px;">
                <i class="bi bi-info-circle-fill me-1"></i> <strong>@HienThi.Chon("Lưu ý:", "Note:")</strong> @HienThi.Chon("Re:Market chưa kết nối với ngân hàng để tự xác minh giao dịch. Shop chỉ cập nhật đã thanh toán sau khi kiểm tra tài khoản thực tế. Hãy xác minh tên shop, chủ tài khoản, số tiền và mã đơn trước khi chuyển.", "Re:Market does not connect to banks to verify transfers. The shop marks an order paid only after checking its bank account. Verify the shop, account holder, amount, and order reference before transferring.")
            </div>

            @if (Model.ChoPhepXacNhan && (Model.MaDonHang.HasValue || !string.IsNullOrEmpty(Model.DanhSachMaDonHang)))
            {
                <form asp-area="User" asp-controller="Orders" asp-action="XacNhanThanhToan" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    @if (Model.MaDonHang.HasValue)
                    {
                        <input type="hidden" name="maDonHang" value="@Model.MaDonHang.Value" />
                    }
                    @if (!string.IsNullOrEmpty(Model.DanhSachMaDonHang))
                    {
                        <input type="hidden" name="dsMaDonHang" value="@Model.DanhSachMaDonHang" />
                    }
                    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                    {
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    }
                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-semibold py-2 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> @HienThi.Chon("Tôi đã chuyển khoản xong", "I have completed the transfer")
                    </button>
                    <div class="text-center text-muted small mt-2" style="font-size: 11.5px;">
                        <i class="bi bi-bell me-1"></i>@HienThi.Chon("Shop sẽ nhận thông báo để đối soát giao dịch và chuẩn bị hàng.", "The shop will be notified to verify the transfer and prepare your order.")
                    </div>
                </form>
            }

            @if (Env.IsDevelopment() && (Model.MaDonHang.HasValue || !string.IsNullOrEmpty(Model.DanhSachMaDonHang)))
            {
                <div class="mt-3 p-3 bg-warning-subtle border border-warning rounded-3 text-center">
                    <div class="d-flex align-items-center justify-content-center gap-1 fw-bold text-dark mb-1" style="font-size: 13px;">
                        <i class="bi bi-lightning-charge-fill text-warning"></i>
                        <span>[DEMO] @HienThi.Chon("Mô phỏng thanh toán tức thì", "Instant payment simulation")</span>
                    </div>
                    <div class="small text-muted mb-2" style="font-size: 11px;">
                        @HienThi.Chon("Chỉ hiển thị trong môi trường Development. Nút này sẽ mô phỏng shop xác nhận đơn và thanh toán ngay.", "Shown only in Development. This button simulates the shop confirming the order and payment immediately.")
                    </div>
                    <form asp-area="User" asp-controller="Orders" asp-action="MoPhongThanhToanDemo" method="post">
                        @Html.AntiForgeryToken()
                        @if (Model.MaDonHang.HasValue)
                        {
                            <input type="hidden" name="maDonHang" value="@Model.MaDonHang.Value" />
                        }
                        @if (!string.IsNullOrEmpty(Model.DanhSachMaDonHang))
                        {
                            <input type="hidden" name="dsMaDonHang" value="@Model.DanhSachMaDonHang" />
                        }
                        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                        {
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        }
                        <button type="submit" class="btn btn-warning w-100 rounded-pill fw-bold py-2 shadow-sm border border-warning-subtle text-dark">
                            <i class="bi bi-play-circle-fill me-1"></i> @HienThi.Chon("Mô phỏng thanh toán (Demo)", "Simulate payment (Demo)")
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<script>
function copyVietQrRaw(text, btn) {
    copyTextToClipboard(text, btn);
}
function copyTextToClipboard(text, btn) {
    const messages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(clipboardMessages));
    navigator.clipboard.writeText(text).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2"></i> ' + messages.copied + '!';
        btn.classList.add('btn-success');
        if (window.showNotifyBox) {
            window.showNotifyBox({
                title: messages.copiedTitle,
                message: messages.copiedContent.replace('{0}', text),
                type: 'success',
                autoCloseMs: 2500
            });
        } else if (typeof window.showToast === 'function') {
            window.showToast(messages.copiedContent.replace('{0}', text), 'info', 2500);
        }
        setTimeout(() => {
            btn.innerHTML = orig;
            btn.classList.remove('btn-success');
        }, 1800);
    }).catch(err => {
        if (window.showNotifyBox) {
            window.showNotifyBox({
                title: messages.copyFailedTitle,
                message: messages.copyFailed + text,
                type: 'warning'
            });
        } else if (typeof window.showToast === 'function') {
            window.showToast(messages.copyFailedToast + text, 'warning', 3500);
        } else {
            prompt(messages.copyManually, text);
        }
    });
}
</script>
