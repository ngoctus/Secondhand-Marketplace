@* Dùng: <partial name="_BieuDo" /> trong view có action Chart. Cần nhúng Chart.js ở @section Scripts của view cha. *@
<div class="panel" id="dashboardRevenueChart" data-url="@Url.Action("Chart")" data-culture="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US" ? "en-US" : "vi-VN")">
    <div class="panel-head">
        <h3>@L["E_ChartTitle"]</h3>
        <div class="seg">
            <button type="button" class="on" data-mode="day" aria-pressed="true">@L["E_ChartDays"]</button>
            <button type="button" data-mode="month" aria-pressed="false">@L["E_ChartMonths"]</button>
        </div>
    </div>
    <div class="chart-box"><canvas id="revenueChart"></canvas></div>
</div>

<script>
    window.addEventListener('load', () => {
        if (typeof Chart === 'undefined') return;
        const root = document.getElementById('dashboardRevenueChart');
        const ctx = document.getElementById('revenueChart');
        const chart = new Chart(ctx, {
            data: { labels: [], datasets: [
                { type: 'bar', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["E_ChartRevenue"].Value)), data: [], backgroundColor: 'rgba(104, 112, 90, 0.78)', hoverBackgroundColor: '#68705A', borderRadius: 6, yAxisID: 'y' },
                { type: 'line', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["E_ChartOrders"].Value)), data: [], borderColor: '#B28A4A', backgroundColor: '#B28A4A', borderWidth: 2.5, pointRadius: 3, pointHoverRadius: 5, tension: .32, yAxisID: 'y1' }
            ]},
            options: {
                responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
                scales: {
                    y:  { beginAtZero: true, ticks: { callback: v => Number(v).toLocaleString(root.dataset.culture) } },
                    y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { precision: 0 } }
                }
            }
        });
        async function load(mode) {
            const res = await fetch(root.dataset.url + '?mode=' + mode, { headers: { Accept: 'application/json' } });
            if (!res.ok) return;
            const d = await res.json();
            chart.data.labels = d.labels;
            chart.data.datasets[0].data = d.revenue;
            chart.data.datasets[1].data = d.orders;
            chart.update();
        }
        root.querySelectorAll('.seg button').forEach(b => b.addEventListener('click', () => {
            root.querySelectorAll('.seg button').forEach(x => { x.classList.remove('on'); x.setAttribute('aria-pressed', 'false'); });
            b.classList.add('on');
            b.setAttribute('aria-pressed', 'true');
            load(b.dataset.mode);
        }));
        load('day');
    });
</script>
