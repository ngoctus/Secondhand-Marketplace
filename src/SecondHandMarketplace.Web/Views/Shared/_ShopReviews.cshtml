@model SecondHandMarketplace.Web.Models.ViewModels.Reviews.DanhSachDanhGiaTheoShopVm
@{
    var items = Model?.Items ?? Array.Empty<SecondHandMarketplace.Web.Models.ViewModels.Reviews.DanhGiaItemVm>();
    var totalItems = Model?.TotalItems ?? 0;
    var avgScore = Model?.DiemTrungBinh ?? 0m;
}

<div class="card card-body border-0 shadow-sm rounded-4 bg-white" id="shop-reviews-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 border-bottom pb-3">
        <div>
            <h2 class="h5 fw-bold text-dark mb-1">
                <i class="bi bi-star-fill text-warning me-1"></i> @L["ShopRev_Title"]
                <span class="text-muted fw-normal fs-6">(@totalItems)</span>
            </h2>
            <div class="text-muted small">@L["ShopRev_Subtitle"]</div>
        </div>

        @if (totalItems > 0)
        {
            <div class="d-flex align-items-center gap-2 bg-light px-3 py-2 rounded-pill border">
                <span class="fs-4 fw-bold text-warning">@avgScore.ToString("0.0")</span>
                <div class="d-flex flex-column lh-1">
                    <div class="text-warning small">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(avgScore))
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-muted opacity-25"></i>
                            }
                        }
                    </div>
                    <span class="text-muted" style="font-size: 11px;">@L["ShopRev_TotalReviews", totalItems]</span>
                </div>
            </div>
        }
    </div>

    @if (items.Count == 0)
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-chat-heart text-secondary fs-3 d-block mb-2"></i>
            <span>@L["ShopRev_Empty"]</span>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var review in items)
            {
                <div class="p-3 rounded-3 border" style="background-color: var(--color-surface); border-color: var(--color-border-subtle) !important;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrWhiteSpace(review.AnhDaiDienNguoiMua))
                            {
                                <img src="@review.AnhDaiDienNguoiMua" alt="@review.TenNguoiMua"
                                     width="36" height="36" class="rounded-circle border" style="object-fit:cover" />
                            }
                            else
                            {
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold small"
                                     style="width: 36px; height: 36px; background-color: var(--color-primary);">
                                    @(string.IsNullOrWhiteSpace(review.TenNguoiMua) ? "U" : review.TenNguoiMua.Substring(0, 1).ToUpperInvariant())
                                </div>
                            }
                            <div>
                                <div class="fw-semibold text-dark small">@review.TenNguoiMua</div>
                                <div class="text-warning small" style="font-size: 11px;">
                                    @for (byte s = 1; s <= 5; s++)
                                    {
                                        if (s <= review.SoSao)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-secondary opacity-50"></i>
                                        }
                                    }
                                    <span class="text-muted ms-1">@L["ShopRev_StarCount", review.SoSao]</span>
                                </div>
                            </div>
                        </div>

                        <div class="text-muted small" style="font-size: 11px;">
                            <i class="bi bi-check2-circle text-success me-1"></i>@L["ShopRev_VerifiedBuyer"] • @HienThi.Ngay(review.NgayTao)
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(review.NoiDung))
                    {
                        <p class="text-dark small mb-0 ps-1" style="white-space: pre-line;">@review.NoiDung</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic small mb-0 ps-1">@L["ShopRev_NoComment"]</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(review.PhanHoiShop))
                    {
                        <div class="mt-2.5 p-2.5 rounded-3 bg-white border border-success-subtle border-start border-start-3 border-start-success ms-2 mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 11px;">
                                    <i class="bi bi-reply-fill me-1"></i>@L["ShopRev_SellerReply"]
                                </span>
                                @if (review.NgayPhanHoi.HasValue)
                                {
                                    <span class="text-muted" style="font-size: 11px;">@HienThi.Ngay(review.NgayPhanHoi.Value)</span>
                                }
                            </div>
                            <p class="text-dark small mb-0 ps-1" style="white-space: pre-line; font-size: 12.5px;">@review.PhanHoiShop</p>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model != null && Model.TotalPages > 1)
        {
            var prodPage = Context.Request.Query["page"].ToString();
            var pagePrefix = !string.IsNullOrWhiteSpace(prodPage) ? $"page={prodPage}&" : "";
            <div class="d-flex justify-content-center mt-3">
                <nav aria-label="@L["ShopRev_PaginationAria"]">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            var isActive = p == Model.Page;
                            <li class="page-item @(isActive ? "active" : "")">
                                <a class="page-link rounded-pill px-3 mx-1 @(isActive ? "text-white border-0" : "text-dark bg-white border")"
                                   style="@(isActive ? "background-color: var(--color-primary);" : "")"
                                   href="?@(pagePrefix)reviewPage=@p#shop-reviews"
                                   data-review-page="@p">
                                    @p
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>
