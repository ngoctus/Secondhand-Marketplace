@* Thông báo dùng chung chuẩn UI kit Re:Market (Task C-01)
   Phân tách:
   - Thao tác nhẹ / trạng thái thông thường: Toast góc phải màn hình
   - Cảnh báo lỗi nghiêm trọng: Modal Dialog trung tâm *@
@{
    // Ngăn chặn render lặp nếu cả Layout và View con cùng gọi
    if (Context.Items.ContainsKey("_ThongBaoRendered"))
    {
        return;
    }
    Context.Items["_ThongBaoRendered"] = true;

    var thanhCong = (TempData["ThanhCong"] ?? TempData["Success"]) as string;
    var loi = (TempData["Loi"] ?? TempData["Error"]) as string;
    var canhBao = (TempData["CanhBao"] ?? TempData["Warning"]) as string;
    var thongTin = (TempData["ThongBao"] ?? TempData["Info"] ?? TempData["OtpSent"] ?? TempData["Message"]) as string;
    var modalLoi = (TempData["ModalLoi"] ?? TempData["CriticalError"]) as string;
    var modalTieuDe = (TempData["ModalTieuDe"] ?? TempData["ModalTitle"] ?? "Cảnh báo nghiêm trọng") as string;
}

@* 1. Modal Dialog trung tâm cho các cảnh báo lỗi nghiêm trọng *@
@if (!string.IsNullOrWhiteSpace(modalLoi))
{
    <div class="rm-modal-overlay" id="rmCriticalModal" role="dialog" aria-modal="true">
        <div class="rm-modal-card">
            <div class="rm-modal-header">
                <div class="rm-modal-icon-badge danger" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <h5 class="rm-modal-title">@modalTieuDe</h5>
            </div>
            <div class="rm-modal-body">
                <p class="mb-0">@modalLoi</p>
            </div>
            <div class="rm-modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill px-4 py-1" onclick="this.closest('.rm-modal-overlay').remove(); document.body.classList.remove('rm-modal-open');">
                    Đã hiểu
                </button>
            </div>
        </div>
    </div>
}

@* 2. Toast trôi nổi góc phải màn hình cho các phản hồi thao tác nhẹ *@
@if (!string.IsNullOrWhiteSpace(thanhCong) || !string.IsNullOrWhiteSpace(loi) || !string.IsNullOrWhiteSpace(canhBao) || !string.IsNullOrWhiteSpace(thongTin))
{
    <div class="rm-toasts" id="rmToastsContainer" aria-live="polite">
        @if (!string.IsNullOrWhiteSpace(thanhCong))
        {
            <div class="rm-toast rm-toast-success" role="status">
                <div class="rm-toast-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="rm-toast-body">
                    <span class="rm-toast-msg">@thanhCong</span>
                </div>
                <button type="button" class="rm-toast-close" aria-label="Đóng thông báo" onclick="this.closest('.rm-toast').remove()">
                    &times;
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(canhBao))
        {
            <div class="rm-toast rm-toast-warning" role="status">
                <div class="rm-toast-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="rm-toast-body">
                    <span class="rm-toast-msg">@canhBao</span>
                </div>
                <button type="button" class="rm-toast-close" aria-label="Đóng thông báo" onclick="this.closest('.rm-toast').remove()">
                    &times;
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(thongTin))
        {
            <div class="rm-toast rm-toast-info" role="status">
                <div class="rm-toast-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="rm-toast-body">
                    <span class="rm-toast-msg">@thongTin</span>
                </div>
                <button type="button" class="rm-toast-close" aria-label="Đóng thông báo" onclick="this.closest('.rm-toast').remove()">
                    &times;
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(loi))
        {
            <div class="rm-toast rm-toast-error" role="alert">
                <div class="rm-toast-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="rm-toast-body">
                    <span class="rm-toast-msg">@loi</span>
                </div>
                <button type="button" class="rm-toast-close" aria-label="Đóng thông báo" onclick="this.closest('.rm-toast').remove()">
                    &times;
                </button>
            </div>
        }
    </div>
}
