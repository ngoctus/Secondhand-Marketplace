@using SecondHandMarketplace.Web.Common
@using SecondHandMarketplace.Web.Services.Categories
@using SecondHandMarketplace.Web.Services.Carts
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject ICategoryService CategoryService
@inject ICartService CartService
@inject IConfiguration Configuration
@{
    IReadOnlyList<SecondHandMarketplace.Web.Models.Entities.DanhMuc> menuDanhMuc = [];
    try
    {
        menuDanhMuc = await CategoryService.GetCategoriesAsync();
    }
    catch
    {
        // Layout vẫn phải render được khi DB chưa sẵn sàng
        menuDanhMuc = [];
    }

    var cartCount = 0;
    if (User.Identity?.IsAuthenticated == true && User.IsInRole("USER") && User.LayNguoiDungId() is int currentUserId)
    {
        try
        {
            cartCount = await CartService.DemSoLuongMonAsync(currentUserId);
        }
        catch
        {
            cartCount = 0;
        }
    }

    var currentArea = Context.Request.RouteValues["area"]?.ToString() ?? string.Empty;
    var currentController = Context.Request.RouteValues["controller"]?.ToString() ?? string.Empty;
    var currentAction = Context.Request.RouteValues["action"]?.ToString() ?? string.Empty;
    var configuredTitle = ViewData["Title"]?.ToString() ?? "Re:Market";
    const string brandSuffix = " - Re:Market";
    var seoTitle = configuredTitle.EndsWith(brandSuffix, StringComparison.OrdinalIgnoreCase)
        ? configuredTitle[..^brandSuffix.Length]
        : configuredTitle;
    var seoDescription = ViewData["MetaDescription"]?.ToString() ?? L["Layout_MetaDescription"].Value;
    var publicSiteUrl = Configuration["Site:PublicBaseUrl"]?.TrimEnd('/');
    var isPrivatePage = Context.Response.StatusCode >= 400
        || currentArea.Equals("Admin", StringComparison.OrdinalIgnoreCase)
        || currentArea.Equals("User", StringComparison.OrdinalIgnoreCase)
        || currentController.Equals("Account", StringComparison.OrdinalIgnoreCase);
    var canonicalUrl = Uri.TryCreate(publicSiteUrl, UriKind.Absolute, out var publicSiteUri)
        ? $"{publicSiteUri.GetLeftPart(UriPartial.Authority)}{Context.Request.Path}"
        : null;
    var isSellerChannelPage = currentArea.Equals("User", StringComparison.OrdinalIgnoreCase) &&
                              (currentController.Equals("Products", StringComparison.OrdinalIgnoreCase) ||
                               currentController.Equals("SellerOrders", StringComparison.OrdinalIgnoreCase) ||
                               currentController.Equals("Auctions", StringComparison.OrdinalIgnoreCase) ||
                               currentController.Equals("Shop", StringComparison.OrdinalIgnoreCase) ||
                               currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) ||
                               (currentController.Equals("Reviews", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Shop", StringComparison.OrdinalIgnoreCase)));
}
<!DOCTYPE html>
<html lang="@(HienThi.LaTiengAnh ? "en" : "vi")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@seoDescription" />
    <meta name="robots" content="@(isPrivatePage ? "noindex, nofollow" : "index, follow")" />
    @if (canonicalUrl is not null)
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:url" content="@canonicalUrl" />
    }
    <meta property="og:type" content="@(ViewData["OgType"]?.ToString() ?? "website")" />
    <meta property="og:site_name" content="Re:Market" />
    <meta property="og:title" content="@seoTitle - Re:Market" />
    <meta property="og:description" content="@seoDescription" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@seoTitle - Re:Market" />
    <meta name="twitter:description" content="@seoDescription" />
    <title>@seoTitle - Re:Market</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="rm-csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    
    <!-- Google Fonts: Be Vietnam Pro & Playfair Display (hỗ trợ 100% tiếng Việt không lỗi dấu) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <script src="~/js/animations.js" asp-append-version="true"></script>
</head>
<body class="rm-body">
    <a class="rm-skip-link" href="#main-content">@HienThi.Chon("Bỏ qua điều hướng", "Skip to main content")</a>
    <!-- Header Navbar tối giản: Brand · Danh mục · Đấu giá · Tìm kiếm rộng · Avatar Mega-Menu · Giỏ hàng · Chuông · Đăng bán -->
    <header class="rm-header">
        <div class="rm-header-inner">
            <!-- Nút menu mobile (< 992px) -->
            <button type="button" class="rm-mobile-toggle" id="mobileMenuBtn" aria-label="@L["Layout_OpenMenu"]" aria-expanded="false" aria-controls="mobileDrawer">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
            </button>

            <!-- Brand Logo -->
            <a class="rm-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="rm-brand-badge" aria-hidden="true"></span>
                <span>Re:Market</span>
            </a>

            <!-- Điều hướng trái gọn gàng: Tất cả danh mục + Đấu giá -->
            <nav class="rm-nav" aria-label="@L["Layout_MainNavAria"]">
                <div class="rm-nav-item rm-dropdown">
                    <button type="button" class="rm-nav-link rm-cat-trigger" id="catMenuBtn" aria-expanded="false" aria-haspopup="true">
                        <svg viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="2" width="5.5" height="5.5" rx="1.2" />
                            <rect x="10.5" y="2" width="5.5" height="5.5" rx="1.2" />
                            <rect x="2" y="10.5" width="5.5" height="5.5" rx="1.2" />
                            <rect x="10.5" y="10.5" width="5.5" height="5.5" rx="1.2" />
                        </svg>
                        <span>@L["Nav_AllCategories"]</span>
                        <svg class="rm-chevron" viewBox="0 0 12 8" width="10" height="6" fill="currentColor" aria-hidden="true"><path d="M1.41 0L6 4.58L10.59 0L12 1.41L6 7.41L0 1.41L1.41 0Z"/></svg>
                    </button>
                    <div class="rm-dropdown-menu rm-cat-dropdown" id="catDropdownMenu" aria-labelledby="catMenuBtn" hidden>
                        @foreach (var c in menuDanhMuc)
                        {
                            <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-CategoryId="@c.MaDanhMuc" asp-route-Keyword="@(Context.Request.Query["Keyword"])">@HienThi.TenDanhMuc(c.Ten)</a>
                        }
                        <div class="rm-dropdown-divider"></div>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Sort="newest" asp-route-Keyword="@(Context.Request.Query["Keyword"])">@L["Nav_Newest"]</a>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-PriceRange="1" asp-route-Keyword="@(Context.Request.Query["Keyword"])">@L["Nav_BestPrice"]</a>
                        <a class="rm-dropdown-item fw-semibold" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Keyword="@(Context.Request.Query["Keyword"])">@L["Nav_ViewAll"]</a>
                    </div>
                </div>

                <a class="rm-nav-link" asp-area="" asp-controller="PublicAuctions" asp-action="Index">@L["E_AuctionNav"]</a>
            </nav>

            <!-- Thanh tìm kiếm trung tâm rộng rãi -->
            <form class="rm-header-search" asp-area="" asp-controller="Products" asp-action="Index" method="get" role="search" aria-label="@L["Layout_SearchProductAria"]">
                @if (Context.Request.RouteValues["controller"]?.ToString()?.Equals("Products", StringComparison.OrdinalIgnoreCase) == true && string.IsNullOrEmpty(currentArea))
                {
                    @if (Context.Request.Query.ContainsKey("CategoryId"))
                    {
                        <input type="hidden" name="CategoryId" value="@Context.Request.Query["CategoryId"]" />
                    }
                    @if (Context.Request.Query.ContainsKey("PriceRange"))
                    {
                        <input type="hidden" name="PriceRange" value="@Context.Request.Query["PriceRange"]" />
                    }
                    @if (Context.Request.Query.ContainsKey("ConditionId"))
                    {
                        <input type="hidden" name="ConditionId" value="@Context.Request.Query["ConditionId"]" />
                    }
                    @if (Context.Request.Query.ContainsKey("MaTinhThanh"))
                    {
                        <input type="hidden" name="MaTinhThanh" value="@Context.Request.Query["MaTinhThanh"]" />
                    }
                    @if (Context.Request.Query.ContainsKey("MaPhuongXa"))
                    {
                        <input type="hidden" name="MaPhuongXa" value="@Context.Request.Query["MaPhuongXa"]" />
                    }
                    @if (Context.Request.Query.ContainsKey("Sort"))
                    {
                        <input type="hidden" name="Sort" value="@Context.Request.Query["Sort"]" />
                    }
                }
                <input type="search" name="Keyword" class="search-input" placeholder="@L["Search_Placeholder"]" value="@(Context.Request.Query["Keyword"])" autocomplete="off" aria-label="@L["Layout_KeywordAria"]" />
                <button type="submit" class="search-submit-btn" aria-label="@L["Header_SearchSubmitAria"]">
                    <svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="9" cy="9" r="6"></circle>
                        <line x1="13.5" y1="13.5" x2="18" y2="18"></line>
                    </svg>
                </button>
            </form>

            <!-- Cụm hành động phải gọn: Avatar (Mega-Menu 2 cột + Ngôn ngữ) · Giỏ hàng · Thông báo · Đăng bán -->
            <div class="rm-header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var userAvatar = User.FindFirst("avatar")?.Value;
                    var userInitial = User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpperInvariant() : "U";

                    <div class="rm-dropdown">
                        <button type="button" class="rm-user-trigger" id="userMenuBtn" aria-expanded="false" aria-haspopup="true" title="@User.Identity?.Name">
                            @if (!string.IsNullOrWhiteSpace(userAvatar))
                            {
                                <img src="@userAvatar" alt="@User.Identity?.Name" class="user-avatar" style="object-fit: cover;" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';" />
                                <span class="user-avatar" style="display:none;" aria-hidden="true">@userInitial</span>
                            }
                            else
                            {
                                <span class="user-avatar" aria-hidden="true">@userInitial</span>
                            }
                            <svg class="rm-chevron" viewBox="0 0 12 8" width="10" height="6" fill="currentColor" aria-hidden="true"><path d="M1.41 0L6 4.58L10.59 0L12 1.41L6 7.41L0 1.41L1.41 0Z"/></svg>
                        </button>

                        <div class="rm-dropdown-menu rm-account-mega" id="userDropdownMenu" aria-labelledby="userMenuBtn" hidden>
                            <div class="rm-mega-profile">
                                @if (!string.IsNullOrWhiteSpace(userAvatar))
                                {
                                    <img src="@userAvatar" alt="@User.Identity?.Name" class="rm-mega-avatar" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';" />
                                    <span class="rm-mega-avatar" style="display:none;" aria-hidden="true">@userInitial</span>
                                }
                                else
                                {
                                    <span class="rm-mega-avatar" aria-hidden="true">@userInitial</span>
                                }
                                <div class="rm-mega-profile-info">
                                    <div class="rm-mega-name">@User.Identity?.Name</div>
                                    <a class="rm-mega-sublink" asp-area="" asp-controller="Account" asp-action="Profile">@L["Header_ManageProfile"]</a>
                                </div>
                            </div>

                            <div class="rm-mega-columns">
                                <!-- Cột trái: Mua hàng + Bán hàng (hoặc Quản trị nếu là ADMIN) -->
                                <div class="rm-mega-col rm-mega-col-left">
                                    @if (User.IsInRole("USER"))
                                    {
                                        <div class="rm-mega-group">
                                            <div class="rm-mega-heading">@L["Header_GroupBuying"]</div>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Favorites" asp-action="Index">
                                                <i class="bi bi-heart" aria-hidden="true"></i>
                                                <span>@L["Nav_Favorites"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Orders" asp-action="Index">
                                                <i class="bi bi-bag" aria-hidden="true"></i>
                                                <span>@L["Nav_MyOrders"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Reviews" asp-action="Index">
                                                <i class="bi bi-star" aria-hidden="true"></i>
                                                <span>@L["Nav_MyReviews"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Disputes" asp-action="Index">
                                                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                                                <span>@L["Nav_Disputes"]</span>
                                            </a>
                                        </div>

                                        <div class="rm-mega-group">
                                            <div class="rm-mega-heading">@L["Header_GroupSelling"]</div>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Products" asp-action="Create">
                                                <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                                <span>@L["Nav_SellNow"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Products" asp-action="Index">
                                                <i class="bi bi-box-seam" aria-hidden="true"></i>
                                                <span>@L["Nav_ManageProducts"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="SellerOrders" asp-action="Index">
                                                <i class="bi bi-receipt" aria-hidden="true"></i>
                                                <span>@L["Nav_SellerOrders"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Auctions" asp-action="Index">
                                                <i class="bi bi-hammer" aria-hidden="true"></i>
                                                <span>@L["E_SellerAuctionsNav"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                                                <span>@L["Nav_RevenueStats"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Shop" asp-action="Index">
                                                <i class="bi bi-shop" aria-hidden="true"></i>
                                                <span>@L["Nav_MyShop"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Reviews" asp-action="Shop">
                                                <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                                                <span>@L["Nav_ShopReviews"]</span>
                                            </a>
                                        </div>
                                    }
                                    else if (User.IsInRole("ADMIN"))
                                    {
                                        <div class="rm-mega-group">
                                            <div class="rm-mega-heading">@L["Nav_Admin"]</div>
                                            <div class="rm-mega-admin-list">
                                                <partial name="_AdminLinks" />
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Cột phải: Tài khoản + Cài đặt (gồm chuyển ngôn ngữ VI | EN) -->
                                <div class="rm-mega-col rm-mega-col-right">
                                    <div class="rm-mega-group">
                                        <div class="rm-mega-heading">@L["Header_GroupAccount"]</div>
                                        <a class="rm-mega-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person" aria-hidden="true"></i>
                                            <span>@L["Nav_Profile"]</span>
                                        </a>
                                        <a class="rm-mega-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-shield-lock" aria-hidden="true"></i>
                                            <span>@L["Nav_ChangePassword"]</span>
                                        </a>
                                        @if (User.IsInRole("USER"))
                                        {
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Notifications" asp-action="Index">
                                                <i class="bi bi-bell" aria-hidden="true"></i>
                                                <span>@L["Notify_Title"]</span>
                                            </a>
                                            <a class="rm-mega-item" asp-area="User" asp-controller="Reports" asp-action="Index">
                                                <i class="bi bi-flag" aria-hidden="true"></i>
                                                <span>@L["Nav_ReportHistory"]</span>
                                            </a>
                                        }
                                    </div>

                                    <div class="rm-mega-group">
                                        <div class="rm-mega-heading">@L["Header_GroupSettings"]</div>
                                        <div class="rm-mega-lang-row">
                                            <span class="rm-mega-lang-label">
                                                <i class="bi bi-globe2" aria-hidden="true"></i>
                                                <span>@L["Header_Language"]</span>
                                            </span>
                                            <partial name="_LanguageSwitcher" />
                                        </div>
                                        <a class="rm-mega-item" asp-area="" asp-controller="Help" asp-action="Index">
                                            <i class="bi bi-question-circle" aria-hidden="true"></i>
                                            <span>@L["Footer_HelpCenter"]</span>
                                        </a>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            <button type="submit" class="rm-mega-item rm-mega-item-danger">
                                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                                <span>@L["Nav_Logout"]</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (User.IsInRole("USER"))
                    {
                        <a asp-area="User" asp-controller="Cart" asp-action="Index" class="rm-header-icon-btn rm-cart-link" title="@L["Nav_Cart"]" aria-label="@L["Nav_Cart"]">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <span class="rm-cart-badge count" id="rmCartBadge" style="@(cartCount > 0 ? "display: inline-flex;" : "display: none;")">
                                @(cartCount > 99 ? "99+" : cartCount.ToString())
                            </span>
                        </a>
                    }

                    <div class="rm-notify-slot">
                        <partial name="_ChuongThongBao" />
                    </div>

                    @if (User.IsInRole("USER"))
                    {
                        <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-rm-primary rm-header-cta">@L["Nav_SellNow"]</a>
                    }
                    else if (User.IsInRole("ADMIN"))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-rm-primary rm-header-cta">@L["Nav_Admin"]</a>
                    }
                }
                else
                {
                    <div class="rm-auth-guest">
                        <a class="rm-auth-link" asp-area="" asp-controller="Account" asp-action="Register">@L["Nav_Register"]</a>
                        <span class="rm-auth-sep" aria-hidden="true"></span>
                        <a class="rm-auth-link" asp-area="" asp-controller="Account" asp-action="Login">@L["Nav_Login"]</a>
                    </div>
                    <partial name="_LanguageSwitcher" />
                    <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/User/Products/Create" class="btn-rm-primary rm-header-cta">@L["Nav_SellNow"]</a>
                }
            </div>
        </div>
        <div class="rm-mobile-drawer" id="mobileDrawer" hidden>
            <form asp-area="" asp-controller="Products" asp-action="Index" method="get" class="mb-3" role="search" aria-label="@L["Layout_SearchProductAria"]">
                <input type="search" name="Keyword" class="form-control" placeholder="@L["Search_Placeholder"]"
                       value="@(Context.Request.Query["Keyword"])" autocomplete="off" aria-label="@L["Layout_KeywordAria"]" />
            </form>

            <div class="rm-mobile-heading">@L["Nav_Categories"]</div>
            @foreach (var c in menuDanhMuc.Take(6))
            {
                <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-CategoryId="@c.MaDanhMuc" asp-route-Keyword="@(Context.Request.Query["Keyword"])">@HienThi.TenDanhMuc(c.Ten)</a>
            }

            <div class="rm-dropdown-divider"></div>
            <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Sort="newest" asp-route-Keyword="@(Context.Request.Query["Keyword"])">@L["Nav_Newest"]</a>
            <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-PriceRange="1" asp-route-Keyword="@(Context.Request.Query["Keyword"])">@L["Nav_BestPrice"]</a>
            <a class="rm-dropdown-item" asp-area="" asp-controller="PublicAuctions" asp-action="Index">@L["E_AuctionNav"]</a>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("ADMIN"))
            {
                <div class="rm-dropdown-divider"></div>
                <div class="rm-mobile-heading">@L["Nav_Admin"]</div>
                <partial name="_AdminLinks" />
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="rm-dropdown-divider"></div>
                <div class="rm-mobile-heading">@L["Layout_Account"]</div>
                <a class="rm-dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">@L["Nav_Profile"]</a>
                <a class="rm-dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">@L["Nav_ChangePassword"]</a>
                @if (User.IsInRole("USER"))
                {
                    <a class="rm-dropdown-item d-flex justify-content-between align-items-center" asp-area="User" asp-controller="Cart" asp-action="Index">
                        <span>@L["Nav_Cart"]</span>
                        <span class="rm-cart-badge-mobile" style="@(cartCount > 0 ? "display: inline-block;" : "display: none;")">
                            @(cartCount > 99 ? "99+" : cartCount.ToString())
                        </span>
                    </a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Favorites" asp-action="Index">@L["Nav_Favorites"]</a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Orders" asp-action="Index">@L["Layout_MyOrdersShort"]</a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Reviews" asp-action="Index">@L["Nav_MyReviews"]</a>
                    <div class="rm-dropdown-divider"></div>
                    <a class="rm-dropdown-item fw-semibold" asp-area="User" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-shop me-1"></i> @L["Nav_SellerChannel"]
                    </a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="SellerOrders" asp-action="Index">@L["Nav_SellerOrders"]</a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Auctions" asp-action="Index">@L["E_SellerAuctionsNav"]</a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Reviews" asp-action="Shop">@L["Nav_ShopReviews"]</a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Dashboard" asp-action="Index">@L["Layout_ShopStats"]</a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Shop" asp-action="Index">@L["Nav_MyShop"]</a>
                    <a class="rm-dropdown-item" asp-area="User" asp-controller="Products" asp-action="Create">@L["Layout_PostProduct"]</a>
                }
                <div class="rm-dropdown-divider"></div>
                <div class="rm-mega-lang-row px-2 py-1">
                    <span class="rm-mega-lang-label">
                        <i class="bi bi-globe2" aria-hidden="true"></i>
                        <span>@L["Header_Language"]</span>
                    </span>
                    <partial name="_LanguageSwitcher" />
                </div>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                    <button type="submit" class="rm-dropdown-item text-danger">@L["Nav_Logout"]</button>
                </form>
            }
            else
            {
                <div class="rm-dropdown-divider"></div>
                <a class="rm-dropdown-item" asp-area="" asp-controller="Account" asp-action="Login">@L["Nav_Login"]</a>
                <a class="rm-dropdown-item" asp-area="" asp-controller="Account" asp-action="Register">@L["Nav_Register"]</a>
                <div class="rm-dropdown-divider"></div>
                <div class="rm-mega-lang-row px-2 py-1">
                    <span class="rm-mega-lang-label">
                        <i class="bi bi-globe2" aria-hidden="true"></i>
                        <span>@L["Header_Language"]</span>
                    </span>
                    <partial name="_LanguageSwitcher" />
                </div>
            }
        </div>
    </header>

    <!-- Main Content -->
    <main class="rm-main-content" id="main-content" tabindex="-1">
        @if (isSellerChannelPage)
        {
            <nav class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-2 border-bottom" aria-label="@L["Layout_SellerChannelNavAria"]">
                <span class="fw-bold text-dark me-2 d-inline-flex align-items-center gap-1">
                    <i class="bi bi-shop text-primary"></i> @L["Nav_SellerChannel"]:
                </span>
                <a asp-area="User" asp-controller="Products" asp-action="Index"
                   class="btn btn-sm @(currentController.Equals("Products", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">
                    @L["Nav_ManageProducts"]
                </a>
                <a asp-area="User" asp-controller="SellerOrders" asp-action="Index"
                   class="btn btn-sm @(currentController.Equals("SellerOrders", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">
                    @L["Nav_SellerOrders"]
                </a>
                    <a asp-area="User" asp-controller="Auctions" asp-action="Index"
                       class="btn btn-sm @(currentController.Equals("Auctions", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">
                        @L["E_SellerAuctionsNav"]
                    </a>
                <a asp-area="User" asp-controller="Shop" asp-action="Index"
                   class="btn btn-sm @(currentController.Equals("Shop", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">
                    @L["Nav_MyShop"]
                </a>
                <a asp-area="User" asp-controller="Reviews" asp-action="Shop"
                   class="btn btn-sm @(currentController.Equals("Reviews", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Shop", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">
                    @L["Nav_ShopReviews"]
                </a>
                <a asp-area="User" asp-controller="Dashboard" asp-action="Index"
                   class="btn btn-sm @(currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")">
                    @L["Nav_RevenueStats"]
                </a>
            </nav>
        }
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <!-- Add to Cart Confirmation Box / Modal -->
    <div class="rm-cart-backdrop" id="rmCartModal" role="dialog" aria-modal="true" aria-labelledby="rmCartModalTitle">
        <div class="rm-cart-box">
            <button type="button" class="rm-cart-box-x" id="rmCartModalCloseX" aria-label="@L["Layout_Close"]">&times;</button>
            <div class="rm-cart-box-header">
                <div class="rm-cart-box-icon">
                    <i class="bi bi-check2"></i>
                </div>
                <div>
                    <h4 class="rm-cart-box-title" id="rmCartModalTitle">@L["Layout_CartAdded"]</h4>
                    <div class="text-muted small">@L["Layout_CartAddedDesc"]</div>
                </div>
            </div>
            <div class="rm-cart-box-item">
                <img id="rmCartModalImg" class="rm-cart-box-img" src="" alt="@L["Layout_ProductImage"]" />
                <div class="rm-cart-box-info">
                    <div class="rm-cart-box-name" id="rmCartModalName"></div>
                    <div class="rm-cart-box-price" id="rmCartModalPrice"></div>
                </div>
            </div>
            <div class="rm-cart-box-actions">
                <button type="button" class="rm-cart-box-btn-close" id="rmCartModalCloseBtn">@L["Layout_KeepShopping"]</button>
                <a asp-area="User" asp-controller="Cart" asp-action="Index" class="rm-cart-box-btn-view">@L["Layout_ViewCart"]</a>
            </div>
        </div>
    </div>

    <!-- Footer chuẩn 100% Wireframe (Ảnh 3, 4, 5) -->
    <footer class="rm-footer">
        <div class="rm-footer-container">
            <div class="rm-footer-grid">
                <!-- Cột 1: Logo & Slogan -->
                <div>
                    <a class="rm-footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="rm-brand-badge" style="background-color: var(--color-primary);" aria-hidden="true"></span>
                        <span>Re:Market</span>
                    </a>
                    <p class="rm-footer-slogan">
                        @L["Footer_Slogan"]
                    </p>
                </div>

                <!-- Cột 2: Về chúng tôi -->
                <div>
                    <h4 class="rm-footer-heading">@L["Footer_AboutUs"]</h4>
                    <ul class="rm-footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="About">@L["Footer_About"]</a></li>
                        <li><a href="/gioi-thieu#lien-he">@L["Footer_Contact"]</a></li>
                        <li><a asp-controller="Help" asp-action="Index">@L["Footer_HelpCenter"]</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Hỗ trợ -->
                <div>
                    <h4 class="rm-footer-heading">@L["Footer_Support"]</h4>
                    <ul class="rm-footer-links">
                        <li><a asp-controller="Help" asp-action="Index" asp-fragment="faq">@L["Footer_Faq"]</a></li>
                        <li><a asp-controller="Help" asp-action="Index" asp-fragment="giao-dich">@L["Footer_SafeTrading"]</a></li>
                        <li><a asp-area="User" asp-controller="Reports" asp-action="Index">@L["Footer_ReportViolation"]</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Locked">@L["Layout_AppealUnlock"]</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Chính sách -->
                <div>
                    <h4 class="rm-footer-heading">@L["Footer_Policy"]</h4>
                    <ul class="rm-footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Terms">@L["Footer_Terms"]</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="BuyingPolicy">@HienThi.Chon("Chính sách mua hàng", "Buying policy")</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="SellerPolicy">@HienThi.Chon("Chính sách người bán", "Seller policy")</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@L["Footer_Privacy"]</a></li>
                        <li><a asp-controller="Help" asp-action="Index" asp-fragment="su-co">@L["Layout_IncidentRules"]</a></li>
                    </ul>
                </div>

                <!-- Cột 5: Liên hệ và hỗ trợ -->
                <div>
                    <h4 class="rm-footer-heading">@L["Layout_Social"]</h4>
                    <div class="rm-social-icons">
                        <a class="social-circle" href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a class="social-circle" href="https://www.youtube.com/" target="_blank" rel="noopener" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a class="social-circle" href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                    <p class="rm-footer-contact-note">@L["Layout_OrderCodeNote"]</p>
                </div>
            </div>

            <div class="rm-footer-bottom">
                © @DateTime.Now.Year Re:Market. @L["Footer_Copyright"]
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <partial name="_I18nScript" />
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/realtime.js" asp-append-version="true" data-hub="@Url.Content("~/hubs/notification")"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)

    <partial name="_ChatWidget" />
    <partial name="_AiChatWidget" />
</body>
</html>
