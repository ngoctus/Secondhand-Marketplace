@using SecondHandMarketplace.Web.Common
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Re:Market</title>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="rm-csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    
    <!-- Google Fonts: Be Vietnam Pro & Playfair Display (hỗ trợ 100% tiếng Việt không lỗi dấu) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="rm-body">
    <!-- Header Navbar chuẩn Wireframe (Ảnh 2, 4, 5) -->
    <header class="rm-header">
        <div class="rm-header-inner">
            <!-- Brand Logo -->
            <a class="rm-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="rm-brand-badge" aria-hidden="true"></span>
                <span>Re:Market</span>
            </a>

            <!-- Search Bar pill theo Wireframe -->
            <form class="rm-header-search" asp-area="" asp-controller="Products" asp-action="Index" method="get">
                <span class="search-icon" aria-hidden="true">
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="9" cy="9" r="6"></circle>
                        <line x1="13.5" y1="13.5" x2="18" y2="18"></line>
                    </svg>
                </span>
                <input type="search" name="Keyword" class="search-input" placeholder="Tìm món đồ bạn cần..." value="@(Context.Request.Query["Keyword"])" autocomplete="off" />
            </form>

            <!-- Menu điều hướng ngang -->
            <nav class="rm-nav" aria-label="Điều hướng chính">
                <!-- Dropdown Danh mục -->
                <div class="rm-nav-item rm-dropdown">
                    <button type="button" class="rm-nav-link" id="catMenuBtn" aria-expanded="false" aria-haspopup="true">
                        <span>Danh mục</span>
                        <svg viewBox="0 0 12 8" width="10" height="6" fill="currentColor"><path d="M1.41 0L6 4.58L10.59 0L12 1.41L6 7.41L0 1.41L1.41 0Z"/></svg>
                    </button>
                    <div class="rm-dropdown-menu" id="catDropdownMenu" aria-labelledby="catMenuBtn" hidden>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Keyword="Thời trang">Thời trang</a>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Keyword="Điện tử">Điện tử</a>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Keyword="Đồ gia dụng">Đồ gia dụng</a>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Keyword="Sách">Sách</a>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Keyword="Phụ kiện">Phụ kiện</a>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index" asp-route-Keyword="Nội thất">Nội thất</a>
                        <div class="rm-dropdown-divider"></div>
                        <a class="rm-dropdown-item" asp-area="" asp-controller="Products" asp-action="Index">Xem tất cả</a>
                    </div>
                </div>

                <a class="rm-nav-link" asp-area="" asp-controller="Products" asp-action="Index">Mới đăng</a>
                <a class="rm-nav-link" asp-area="" asp-controller="Products" asp-action="Index" asp-route-MaxPrice="300000">Giá tốt</a>
                <a class="rm-nav-link" asp-area="" asp-controller="PublicAuctions" asp-action="Index">Đấu giá</a>

                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("ADMIN"))
                {
                    <div class="rm-nav-item rm-dropdown">
                        <button type="button" class="rm-nav-link" id="adminMenuBtn" aria-expanded="false">
                            <span style="color: var(--color-primary); font-weight: 600;">Quản trị</span>
                            <svg viewBox="0 0 12 8" width="10" height="6" fill="currentColor"><path d="M1.41 0L6 4.58L10.59 0L12 1.41L6 7.41L0 1.41L1.41 0Z"/></svg>
                        </button>
                        <div class="rm-dropdown-menu" id="adminDropdownMenu" aria-labelledby="adminMenuBtn" hidden>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Thống kê hệ thống</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Orders" asp-action="Index">Quản lý đơn hàng</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Auctions" asp-action="Index">Quản lý đấu giá</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Users" asp-action="Index">Người dùng</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Sellers" asp-action="Index">Cửa hàng</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Products" asp-action="Index">Duyệt sản phẩm</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Categories" asp-action="Index">Danh mục</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Banners" asp-action="Index">Banner</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Disputes" asp-action="Index">Tranh chấp</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="Index">Báo cáo vi phạm</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="ForbiddenKeywords" asp-action="Index">Từ khóa cấm</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Nhật ký hệ thống</a>
                            <a class="rm-dropdown-item" asp-area="Admin" asp-controller="AiSettings" asp-action="Index">Cấu hình AI</a>
                        </div>
                    </div>
                }
            </nav>

            <!-- Cụm hành động người dùng theo Wireframe -->
            <div class="rm-header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("USER"))
                    {
                        <a asp-area="User" asp-controller="Favorites" asp-action="Index" class="rm-nav-link" title="Yêu thích">
                            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </a>
                        <a asp-area="User" asp-controller="Cart" asp-action="Index" class="rm-nav-link" title="Giỏ hàng">
                            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                        </a>
                    }

                    <div class="rm-notify-slot">
                        <partial name="_ChuongThongBao" />
                    </div>

                    <div class="rm-dropdown">
                        <button type="button" class="rm-user-trigger" id="userMenuBtn" aria-expanded="false">
                            <span class="user-avatar" aria-hidden="true">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")
                            </span>
                            <span style="font-size: 13.5px; font-weight: 500;">@User.Identity?.Name</span>
                            <svg viewBox="0 0 12 8" width="9" height="5" fill="currentColor"><path d="M1.41 0L6 4.58L10.59 0L12 1.41L6 7.41L0 1.41L1.41 0Z"/></svg>
                        </button>
                        <div class="rm-dropdown-menu" id="userDropdownMenu" style="right: 0; left: auto; width: 220px;" hidden>
                            <a class="rm-dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">Hồ sơ cá nhân</a>
                            <a class="rm-dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                            @if (User.IsInRole("USER"))
                            {
                                <div class="rm-dropdown-divider"></div>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Orders" asp-action="Index">Đơn mua của tôi</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="SellerOrders" asp-action="Index">Đơn bán (Shop)</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Auctions" asp-action="Index">Đấu giá của tôi</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Dashboard" asp-action="Index">Thống kê doanh thu</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Favorites" asp-action="Index">Yêu thích</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Shop" asp-action="Index">Cửa hàng của tôi</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Products" asp-action="Index">Quản lý sản phẩm</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Disputes" asp-action="Index">Khiếu nại / Tranh chấp</a>
                                <a class="rm-dropdown-item" asp-area="User" asp-controller="Reports" asp-action="Index">Lịch sử báo cáo</a>
                            }
                            <div class="rm-dropdown-divider"></div>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                <button type="submit" class="rm-dropdown-item" style="color: var(--color-error);">Đăng xuất</button>
                            </form>
                        </div>
                    </div>

                    <a asp-area="User" asp-controller="Products" asp-action="Index" class="btn-rm-primary">Đăng bán</a>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn-rm-outline">Đăng nhập</a>
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="btn-rm-outline">Đăng ký</a>
                    <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/User/Products" class="btn-rm-primary">Đăng bán</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="rm-main-content" role="main">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <!-- Footer chuẩn 100% Wireframe (Ảnh 3, 4, 5) -->
    <footer class="rm-footer">
        <div class="rm-footer-container">
            <div class="rm-footer-grid">
                <!-- Cột 1: Logo & Slogan -->
                <div>
                    <a class="rm-footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="rm-brand-badge" style="background-color: var(--color-primary);" aria-hidden="true"></span>
                        <span>Re:Market</span>
                    </a>
                    <p class="rm-footer-slogan">
                        Chợ đồ cũ giúp món đồ có thêm một vòng đời mới.
                    </p>
                </div>

                <!-- Cột 2: Về chúng tôi -->
                <div>
                    <h4 class="rm-footer-heading">Về chúng tôi</h4>
                    <ul class="rm-footer-links">
                        <li><a href="#gioi-thieu">Giới thiệu</a></li>
                        <li><a href="#lien-he">Liên hệ</a></li>
                        <li><a href="#tuyen-dung">Tuyển dụng</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Hỗ trợ -->
                <div>
                    <h4 class="rm-footer-heading">Hỗ trợ</h4>
                    <ul class="rm-footer-links">
                        <li><a href="#faq">FAQ</a></li>
                        <li><a href="#giao-dich">Hướng dẫn giao dịch an toàn</a></li>
                        <li><a asp-area="User" asp-controller="Reports" asp-action="Index">Báo cáo vi phạm</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Chính sách -->
                <div>
                    <h4 class="rm-footer-heading">Chính sách</h4>
                    <ul class="rm-footer-links">
                        <li><a href="#dieu-khoan">Điều khoản sử dụng</a></li>
                        <li><a href="#bao-mat">Chính sách bảo mật</a></li>
                        <li><a href="#quy-dinh">Quy định cộng đồng</a></li>
                    </ul>
                </div>

                <!-- Cột 5: Mạng xã hội -->
                <div>
                    <h4 class="rm-footer-heading">Mạng xã hội</h4>
                    <div class="rm-social-icons">
                        <span class="social-circle" aria-hidden="true"></span>
                        <span class="social-circle" aria-hidden="true"></span>
                        <span class="social-circle" aria-hidden="true"></span>
                    </div>
                </div>
            </div>

            <div class="rm-footer-bottom">
                © 2026 Re:Market. Bảo lưu mọi quyền.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_AiChatWidget" />
</body>
</html>
