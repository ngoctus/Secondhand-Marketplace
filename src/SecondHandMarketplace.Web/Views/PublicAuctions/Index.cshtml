@model PagedResult<AuctionCardVm>
@{
    ViewData["Title"] = "Sàn đấu giá";
    var tab = (string)ViewBag.Tab;
    var q = (string?)ViewBag.Q;
    var tabs = new[] { ("dang-dien-ra", "Đang diễn ra"), ("sap-dien-ra", "Sắp diễn ra"), ("da-ket-thuc", "Đã kết thúc") };
}

<div class="catalog-page">
    <div class="section-head">
        <div><div class="eyebrow">SÀN ĐẤU GIÁ</div><h2>Săn đồ cũ giá tốt</h2></div>
        <form method="get" class="auction-search">
            <input type="hidden" name="tab" value="@tab" />
            <input name="q" value="@q" placeholder="Tìm sản phẩm đang đấu giá..." />
            <button class="primary" type="submit">Tìm</button>
        </form>
    </div>

    <div class="status-tabs">
        @foreach (var (key, label) in tabs)
        {
            <a class="@(tab == key ? "on" : "")" asp-action="Index" asp-route-tab="@key" asp-route-q="@q">@label</a>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty panel">Chưa có phiên đấu giá nào trong mục này.</div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var a in Model.Items)
            {
                <div class="product-card">
                    <a asp-action="Details" asp-route-id="@a.Id">
                        @if (!string.IsNullOrEmpty(a.Image))
                        {
                            <img src="@a.Image" alt="@a.ProductName" data-fallback />
                        }
                        else
                        {

                            <div class="product-art-fallback">♻</div>
                        }
                        <div class="product-info">
                            <h3 class="product-title">@a.ProductName</h3>
                            <div class="product-meta"><span>@a.ShopName</span><span>@a.BidCount lượt đặt</span></div>
                            <div class="price">@HienThi.Tien(a.CurrentPrice)</div>
                            <div class="card-foot">
                                <span class="@HienThi.LopTrangThai(a.Status)">@HienThi.TrangThaiPhien(a.Status)</span>
                                @if (a.Status == "RUNNING")
                                {
                                    <span class="muted"><span class="js-countdown" data-end="@HienThi.Iso(a.EndAt)"></span></span>
                                }
                                else if (a.Status == "SCHEDULED")
                                {
                                    <span class="muted">Bắt đầu @HienThi.NgayGio(a.StartAt)</span>
                                }
                                else
                                {
                                    <span class="muted">@HienThi.NgayGio(a.EndAt)</span>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
        <partial name="_Pager" model="new PagerVm(Model.Page, Model.TotalPages)" />
    }
</div>

@section Scripts {
    <script src="~/js/auction.js" asp-append-version="true"></script>
}