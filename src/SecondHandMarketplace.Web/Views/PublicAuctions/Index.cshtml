@model PagedResult<AuctionCardVm>
@{
    ViewData["Title"] = L["E_AuctionPageTitle"];
    var tab = (string)ViewBag.Tab;
    var q = (string?)ViewBag.Q;
    var tabs = new[] { ("dang-dien-ra", (string)L["E_AuctionTabRunning"]), ("sap-dien-ra", (string)L["E_AuctionTabScheduled"]), ("da-ket-thuc", (string)L["E_AuctionTabEnded"]) };
}

<div class="container py-4">
    <nav class="rm-breadcrumb" aria-label="@L["Detail_BreadcrumbAria"]">
        <a asp-controller="Home" asp-action="Index">@L["E_AuctionBreadcrumbHome"]</a>
        <span class="sep">/</span>
        <span>@L["E_AuctionPageTitle"]</span>
    </nav>

    <div class="rm-page-head">
        <div>
            <div class="section-label">@L["E_AuctionEyebrow"]</div>
            <h1 class="rm-page-title">@L["E_AuctionHeadline"]</h1>
        </div>
        <form method="get" class="auction-search">
            <input type="hidden" name="tab" value="@tab" />
            <label class="visually-hidden" for="auction-search-q">@L["E_AuctionSearchPlaceholder"]</label>
            <input id="auction-search-q" name="q" value="@q" placeholder="@L["E_AuctionSearchPlaceholder"]" />
            <button type="submit" class="btn-rm-primary">@L["E_AuctionSearch"]</button>
        </form>
    </div>

    <div class="status-tabs">
        @foreach (var (key, label) in tabs)
        {
            <a class="@(tab == key ? "on" : "")" asp-action="Index" asp-route-tab="@key" asp-route-q="@q">@label</a>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rm-empty-state">
            <p>@L["E_AuctionEmpty"]</p>
            <a asp-controller="Products" asp-action="Index" class="btn-rm-outline">@L["E_AuctionBrowseProducts"]</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
            @foreach (var a in Model.Items)
            {
                <div class="col">
                    <article class="rm-product-card" data-product-id="@a.ProductId">
                        <div class="rm-card-media">
                            <a asp-action="Details" asp-route-id="@a.Id" class="rm-card-image-link" tabindex="-1">
                                @if (!string.IsNullOrEmpty(a.Image))
                                {
                                    <img src="@a.Image" alt="@a.ProductName" class="rm-card-image" loading="lazy" data-fallback />
                                }
                                else
                                {
                                    <div class="wireframe-placeholder">
                                    <span>@L["E_AuctionImagePlaceholder"] 4:5</span>
                                    </div>
                                }
                            </a>
                            <span class="rm-card-badge">@HienThi.TrangThaiPhien(a.Status)</span>
                        </div>

                        <div class="rm-card-body">
                            <h3 class="rm-card-title">
                                <a asp-action="Details" asp-route-id="@a.Id" title="@a.ProductName">@a.ProductName</a>
                            </h3>
                            <div class="rm-card-pricing">
                                <span class="rm-card-price">@HienThi.Tien(a.CurrentPrice)</span>
                            </div>
                            <div class="rm-card-seller">
                                <span class="seller-circle" aria-hidden="true"></span>
                                <span>@a.ShopName · @L["E_AuctionBidCount", a.BidCount]</span>
                            </div>
                            <div class="rm-auction-foot">
                                @if (a.Status == "RUNNING")
                                {
                                    <span class="rm-auction-time"><span class="js-countdown" data-end="@HienThi.Iso(a.EndAt)" data-prefix="@L["E_AuctionTimePrefix"]"></span></span>
                                }
                                else if (a.Status == "SCHEDULED")
                                {
                                    <span class="rm-auction-time">@L["E_AuctionStartsAt", HienThi.NgayGio(a.StartAt)]</span>
                                }
                                else
                                {
                                    <span class="rm-auction-time">@L["E_AuctionEndedAt", HienThi.NgayGio(a.EndAt)]</span>
                                }
                                <a asp-action="Details" asp-route-id="@a.Id" class="btn-rm-outline rm-auction-cta">@L["E_AuctionViewSession"]</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        <partial name="_Pager" model="new PagerVm(Model.Page, Model.TotalPages)" />
    }
</div>

@section Scripts {
    <script src="~/js/auction.js" asp-append-version="true"></script>
}
