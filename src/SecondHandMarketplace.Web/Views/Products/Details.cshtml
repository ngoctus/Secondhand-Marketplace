@model ProductDetailVm
@using SecondHandMarketplace.Web.Services.Products
@inject IProductService ProductService
@inject SecondHandMarketplace.Web.Services.Auctions.IAuctionService Auctions
@{
    ViewData["Title"] = Model.Name;
    var category = Model.CategoryName ?? "Thời trang";
    var condition = Model.ConditionName ?? "Rất tốt";

    var phienDauGiaId = await Auctions.GetOpenAuctionIdForProductAsync(Model.Id);

    var trangThai = Model.Status switch
    {
        "RESERVED" => "Đang được giữ chỗ",
        "SOLD" => "Đã bán",
        _ => "Đang bán"
    };

    // Lấy thêm sản phẩm liên quan
    List<ProductCardVm> lienQuan = new();
    try
    {
        lienQuan = (await ProductService.SearchAsync(new ProductSearchVm())).Items.Where(p => p.Id != Model.Id).Take(4).ToList();
    }
    catch { }

    if (lienQuan.Count == 0)
    {
        lienQuan = new List<ProductCardVm>
        {
            new ProductCardVm { Id = 10, Name = "Áo sơ mi linen size L", Price = 150000, ShopName = "Hà Closet", ConditionName = "Tốt" },
            new ProductCardVm { Id = 11, Name = "Quần jeans ống rộng", Price = 220000, ShopName = "Shop An", ConditionName = "Rất tốt" },
            new ProductCardVm { Id = 12, Name = "Áo khoác bomber", Price = 300000, ShopName = "Linh Store", ConditionName = "Mới" },
            new ProductCardVm { Id = 13, Name = "Mũ lưỡi trai vintage", Price = 90000, ShopName = "Tuấn Vintage", ConditionName = "Tốt" }
        };
    }
}

<!-- Breadcrumb (Ảnh 5) -->
<nav class="rm-breadcrumb" aria-label="Đường dẫn trang">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
    <span class="sep">/</span>
    <a asp-controller="Products" asp-action="Index" asp-route-Keyword="@category">@category</a>
    <span class="sep">/</span>
    <span>@Model.Name</span>
</nav>

<!-- PHẦN TRÊN: Ảnh gallery & Thông tin sản phẩm (Ảnh 5) -->
<div class="detail-top-grid">
    <!-- CỘT ẢNH SẢN PHẨM -->
    <div>
        <div class="detail-main-img" title="Nhấn để phóng to ảnh">
            @if (Model.Images != null && Model.Images.Count > 0)
            {
                <img id="mainProductImg" src="@Model.Images[0]" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover; cursor: zoom-in;" data-fallback data-zoomable />
            }
            else
            {
                <div class="wireframe-placeholder" style="aspect-ratio: 4 / 5;">
                    <span>Ảnh sản phẩm chính</span>
                </div>
            }
        </div>

        <!-- Thumbnail nhỏ -->
        <div class="detail-thumbnails">
            @if (Model.Images != null && Model.Images.Count > 0)
            {
                @for (int i = 0; i < Math.Min(Model.Images.Count, 5); i++)
                {
                    <div class="thumbnail-item @(i == 0 ? "active" : "")" title="Xem ảnh @(i + 1)">
                        <img src="@Model.Images[i]" alt="Ảnh @(i + 1)" style="width: 100%; height: 100%; object-fit: cover;" data-fallback />
                    </div>
                }
            }
            else
            {
                <div class="thumbnail-item active">
                    <div class="wireframe-placeholder"><span>Ảnh 1</span></div>
                </div>
                <div class="thumbnail-item">
                    <div class="wireframe-placeholder"><span>Ảnh 2</span></div>
                </div>
                <div class="thumbnail-item">
                    <div class="wireframe-placeholder"><span>Ảnh 3</span></div>
                </div>
                <div class="thumbnail-item">
                    <div class="wireframe-placeholder"><span>Ảnh 4</span></div>
                </div>
                <div class="thumbnail-item">
                    <div class="wireframe-placeholder"><span>Ảnh 5</span></div>
                </div>
            }
        </div>
    </div>

    <!-- CỘT THÔNG TIN MUA HÀNG -->
    <div>
        <div class="detail-meta-label">@category.ToUpperInvariant()</div>
        <h1 class="detail-title">@Model.Name</h1>

        <div class="detail-pricing-row">
            <span class="main-price">@Model.Price.ToString("N0")đ</span>
            @if (Model.Status != "AVAILABLE")
            {
                <span class="badge bg-warning text-dark px-2 py-1 ms-2" style="font-size: 13px;">@trangThai</span>
            }
        </div>

        @if (phienDauGiaId.HasValue)
        {
            <div class="alert alert-warning py-2 px-3 my-2 d-flex align-items-center justify-content-between rounded-3 border-warning" style="font-size: 13px;">
                <span><strong>Sản phẩm này đang được đấu giá!</strong></span>
                <a asp-controller="PublicAuctions" asp-action="Details" asp-route-id="@phienDauGiaId" class="btn btn-sm btn-outline-dark fw-semibold">Xem phiên đấu giá →</a>
            </div>
        }

        <div class="detail-tags-row">
            <span class="tag-badge">@condition</span>
            <span>Đăng @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
            <span class="badge bg-light text-muted border px-2 py-1">Đồ cũ (1 món duy nhất)</span>
        </div>

        <div class="detail-short-desc">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "Sản phẩm đã được kiểm duyệt chất lượng trước khi đăng bán trên hệ thống." : Model.Description)
        </div>

        <div class="mb-4">
            <div style="font-size: 12px; color: var(--color-text-muted); margin-bottom: 6px;">Kích thước</div>
            <button type="button" class="btn-rm-outline" style="padding: 4px 14px; font-size: 13px; font-weight: 600;">M</button>
        </div>

        @if (Model.CanBuy)
        {
            <div class="detail-actions-row">
                <form asp-area="User" asp-controller="Cart" asp-action="Them" method="post" style="display: inline-block;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maSanPham" value="@Model.Id" />
                    <button type="submit" class="btn-rm-outline" style="padding: 10px 18px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        Thêm vào giỏ
                    </button>
                </form>
                <a asp-area="User" asp-controller="Orders" asp-action="Checkout" asp-route-maSanPham="@Model.Id" class="btn-main text-decoration-none text-center" style="padding: 10px 24px; font-weight: 600;">
                    Mua ngay
                </a>
                <button type="button" class="btn-icon-sq" title="Yêu thích" aria-label="Thêm vào yêu thích">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </button>
                <button type="button" class="btn-share">Chia sẻ</button>
            </div>
        }
        else
        {
            <div class="alert alert-secondary py-2 mb-3" style="font-size: 13px;">
                Sản phẩm này hiện không thể đặt mua (đang giữ chỗ, đã bán hoặc thuộc cửa hàng của bạn).
            </div>
        }

        <!-- Hộp thông tin shop vắn tắt -->
        <div class="shop-snippet-box">
            <div class="shop-snippet-left">
                <div class="shop-snippet-avatar"></div>
                <div class="shop-snippet-info">
                    <b>@Model.ShopName</b>
                    <span>★ 4.8 · 125 đánh giá</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (User.IsInRole("USER"))
                {
                    <button type="button" class="btn-rm-outline js-chat-seller" style="font-size: 12px; padding: 6px 12px;"
                            data-product-id="@Model.Id"
                            data-prefill="@($"Chào shop, mình quan tâm sản phẩm \"{Model.Name}\" ạ.")">💬 Chat</button>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                       class="btn-rm-outline" style="font-size: 12px; padding: 6px 12px;">💬 Chat</a>
                }
                <a href="#" class="btn-rm-outline" style="font-size: 12px; padding: 6px 12px;">Xem shop</a>
            </div>
        </div>

        <div class="mt-2 d-flex justify-content-between align-items-center">
            <a asp-area="User" asp-controller="Reports" asp-action="Tao" asp-route-loai="PRODUCT" asp-route-id="@Model.Id" asp-route-ten="@Model.Name" style="font-size: 12px; color: var(--color-danger, #d9534f); text-decoration: none;">
                🚩 Báo cáo tin đăng vi phạm
            </a>
            <span style="font-size: 12px; color: var(--color-text-muted);">Cam kết giao dịch minh bạch</span>
        </div>
    </div>
</div>

<!-- PHẦN GIỮA: 3 Khối nội dung chi tiết (Ảnh 5) -->
<div class="detail-content-card">
    <!-- 1. Mô tả chi tiết -->
    <div class="detail-content-block">
        <h4>Mô tả chi tiết</h4>
        <p>
            @(string.IsNullOrWhiteSpace(Model.Description) 
                ? "Nội dung mô tả chi tiết của người bán: chất liệu, thương hiệu, thời gian đã sử dụng, lý do bán... Thông số: Dài 68cm - Rộng vai 52cm - Chất liệu denim cotton." 
                : Model.Description)
        </p>
    </div>

    <!-- 2. Thông tin người bán -->
    <div class="detail-content-block">
        <h4>Thông tin người bán</h4>
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="shop-snippet-avatar" style="width: 44px; height: 44px;"></div>
                <div>
                    <b>@Model.ShopName</b>
                    <p style="font-size: 12.5px; color: var(--color-text-muted); margin: 2px 0 0;">
                        Tham gia 2024 · Phản hồi trong 1 giờ · 45 sản phẩm
                    </p>
                </div>
            </div>
            <a href="#" class="btn-rm-outline" style="font-size: 13px; padding: 6px 14px;">Xem shop</a>
        </div>
    </div>

    <!-- 3. Chính sách & Bảo hành -->
    <div class="detail-content-block">
        <h4>Chính sách & Bảo hành</h4>
        <div class="row row-cols-1 row-cols-md-2 g-3" style="font-size: 13px;">
            <div class="col d-flex gap-2">
                <span style="color: var(--color-primary); font-size: 16px;">✓</span>
                <div>
                    <b>Kiểm tra khi nhận</b>
                    <div style="color: var(--color-text-secondary); font-size: 12px;">Được đồng kiểm trước khi thanh toán.</div>
                </div>
            </div>
            <div class="col d-flex gap-2">
                <span style="color: var(--color-primary); font-size: 16px;">↺</span>
                <div>
                    <b>Đổi trả 48 giờ</b>
                    <div style="color: var(--color-text-secondary); font-size: 12px;">Hoàn tiền nếu hàng không đúng mô tả.</div>
                </div>
            </div>
            <div class="col d-flex gap-2">
                <span style="color: var(--color-primary); font-size: 16px;">🛡</span>
                <div>
                    <b>Bảo vệ người mua</b>
                    <div style="color: var(--color-text-secondary); font-size: 12px;">Tiền được giữ đến khi bạn bấm xác nhận.</div>
                </div>
            </div>
            <div class="col d-flex gap-2">
                <span style="color: var(--color-primary); font-size: 16px;">🚚</span>
                <div>
                    <b>Giao hàng toàn quốc</b>
                    <div style="color: var(--color-text-secondary); font-size: 12px;">Phí ship tính theo đơn vị vận chuyển.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Đánh giá từ người mua -->
    <div class="detail-content-block">
        <h4>Đánh giá từ người mua</h4>
        <div class="d-flex align-items-center gap-4 mb-4 flex-wrap">
            <div class="text-center" style="min-width: 120px;">
                <div style="font-size: 38px; font-weight: 700; color: var(--color-primary); line-height: 1;">4.8</div>
                <div style="color: var(--color-star); font-size: 15px; margin: 4px 0;">★★★★★</div>
                <span style="font-size: 12px; color: var(--color-text-muted);">125 nhận xét</span>
            </div>

            <div class="flex-grow-1" style="max-width: 380px;">
                <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 12px;">
                    <span style="width: 20px;">5★</span>
                    <div class="flex-grow-1" style="height: 6px; background-color: #E2D7C5; border-radius: 3px; overflow: hidden;">
                        <div style="width: 85%; height: 100%; background-color: var(--color-primary);"></div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 12px;">
                    <span style="width: 20px;">4★</span>
                    <div class="flex-grow-1" style="height: 6px; background-color: #E2D7C5; border-radius: 3px; overflow: hidden;">
                        <div style="width: 12%; height: 100%; background-color: var(--color-primary);"></div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 12px;">
                    <span style="width: 20px;">3★</span>
                    <div class="flex-grow-1" style="height: 6px; background-color: #E2D7C5; border-radius: 3px; overflow: hidden;">
                        <div style="width: 2%; height: 100%; background-color: var(--color-primary);"></div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 12px;">
                    <span style="width: 20px;">2★</span>
                    <div class="flex-grow-1" style="height: 6px; background-color: #E2D7C5; border-radius: 3px; overflow: hidden;">
                        <div style="width: 1%; height: 100%; background-color: var(--color-primary);"></div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2" style="font-size: 12px;">
                    <span style="width: 20px;">1★</span>
                    <div class="flex-grow-1" style="height: 6px; background-color: #E2D7C5; border-radius: 3px; overflow: hidden;">
                        <div style="width: 0%; height: 100%; background-color: var(--color-primary);"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3 Nhận xét mẫu của người mua -->
        <div class="d-flex flex-column gap-3 pt-2">
            <div class="d-flex justify-content-between align-items-start border-top pt-3" style="border-color: var(--color-border) !important;">
                <div class="d-flex gap-3">
                    <div class="author-circle" style="width: 32px; height: 32px; flex-shrink: 0;"></div>
                    <div>
                        <b style="font-size: 13px;">Tên người dùng</b>
                        <div style="color: var(--color-star); font-size: 12px; margin: 2px 0;">★★★★★</div>
                        <p style="font-size: 13px; color: var(--color-text-secondary); margin: 0;">Nội dung nhận xét về sản phẩm và người bán.</p>
                    </div>
                </div>
                <span style="font-size: 11.5px; color: var(--color-text-muted);">2 tuần trước</span>
            </div>

            <div class="d-flex justify-content-between align-items-start border-top pt-3" style="border-color: var(--color-border) !important;">
                <div class="d-flex gap-3">
                    <div class="author-circle" style="width: 32px; height: 32px; flex-shrink: 0;"></div>
                    <div>
                        <b style="font-size: 13px;">Tên người dùng</b>
                        <div style="color: var(--color-star); font-size: 12px; margin: 2px 0;">★★★★★</div>
                        <p style="font-size: 13px; color: var(--color-text-secondary); margin: 0;">Nội dung nhận xét về sản phẩm và người bán.</p>
                    </div>
                </div>
                <span style="font-size: 11.5px; color: var(--color-text-muted);">2 tuần trước</span>
            </div>

            <div class="d-flex justify-content-between align-items-start border-top pt-3" style="border-color: var(--color-border) !important;">
                <div class="d-flex gap-3">
                    <div class="author-circle" style="width: 32px; height: 32px; flex-shrink: 0;"></div>
                    <div>
                        <b style="font-size: 13px;">Tên người dùng</b>
                        <div style="color: var(--color-star); font-size: 12px; margin: 2px 0;">★★★★★</div>
                        <p style="font-size: 13px; color: var(--color-text-secondary); margin: 0;">Nội dung nhận xét về sản phẩm và người bán.</p>
                    </div>
                </div>
                <span style="font-size: 11.5px; color: var(--color-text-muted);">2 tuần trước</span>
            </div>
        </div>
    </div>
</div>

<!-- PHẦN DƯỚI: Sản phẩm liên quan (Ảnh 5) -->
<section class="landing-section pt-0">
    <h2 class="section-title mb-4">Sản phẩm liên quan</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
        @foreach (var p in lienQuan)
        {
            <div class="col">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>
</section>
