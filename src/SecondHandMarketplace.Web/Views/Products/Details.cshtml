@model ProductDetailVm
@using SecondHandMarketplace.Web.Common
@using SecondHandMarketplace.Web.Services.Products
@using SecondHandMarketplace.Web.Services.Reviews
@using SecondHandMarketplace.Web.Services.Auctions
@inject IProductService ProductService
@inject IReviewService Reviews
@inject IAuctionService Auctions
@{
    ViewData["Title"] = Model.Name;

    var danhMuc = string.IsNullOrWhiteSpace(Model.CategoryName) ? (string)L["Detail_Uncategorized"] : HienThi.TenDanhMuc(Model.CategoryName);
    var urlDanhMuc = Model.CategoryId is int maDanhMuc
        ? Url.Action("Index", "Products", new { CategoryId = maDanhMuc })
        : Url.Action("Index", "Products");
    var urlXemShop = Url.Action("Details", "Shops", new { id = Model.ShopId });
    var openAuctionId = await Auctions.GetOpenAuctionIdForProductAsync(Model.Id);

    // Vài đánh giá mới nhất của shop (dữ liệu của C: bảng DanhGia + vw_DiemCuaHang).
    var danhGia = await Reviews.LayDanhGiaTheoShopAsync(Model.ShopId, page: 1, pageSize: 3);

    // Sản phẩm liên quan: ưu tiên cùng danh mục, chưa đủ 4 thì bù tin mới nhất.
    var lienQuan = (await ProductService.SearchAsync(new ProductSearchVm { CategoryId = Model.CategoryId, PageSize = 12 }))
        .Items.Where(p => p.Id != Model.Id).Take(4).ToList();
    if (lienQuan.Count < 4)
    {
        lienQuan.AddRange((await ProductService.SearchAsync(new ProductSearchVm { PageSize = 12 }))
            .Items.Where(p => p.Id != Model.Id && lienQuan.All(x => x.Id != p.Id))
            .Take(4 - lienQuan.Count));
    }
}

<!-- Breadcrumb (Ảnh 5) -->
<nav class="rm-breadcrumb" aria-label="@L["Detail_BreadcrumbAria"]">
    <a asp-controller="Home" asp-action="Index">@L["Nav_Home"]</a>
    <span class="sep">/</span>
    <a href="@urlDanhMuc">@danhMuc</a>
    <span class="sep">/</span>
    <span>@Model.Name</span>
</nav>

<!-- PHẦN TRÊN: Ảnh gallery & Thông tin sản phẩm (Ảnh 5) -->
<div class="detail-top-grid">
    <!-- CỘT ẢNH SẢN PHẨM (B-05) -->
    <div class="rm-gallery" data-anh-bo-suu>
        <div class="detail-main-img" title="@L["Detail_ZoomHint"]">
            @if (Model.Images.Count > 0)
            {
                <img id="mainProductImg" src="@Model.Images[0]" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover; cursor: zoom-in;" data-fallback data-zoomable />
                @if (Model.Images.Count > 1)
                {
                    <button type="button" class="rm-anh-mui rm-anh-mui-trai" data-anh-bac="-1" aria-label="@L["Detail_PrevImage"]">&#8249;</button>
                    <button type="button" class="rm-anh-mui rm-anh-mui-phai" data-anh-bac="1" aria-label="@L["Detail_NextImage"]">&#8250;</button>
                    <span class="rm-anh-dem" data-anh-dem>1 / @Model.Images.Count</span>
                }
            }
            else
            {
                <div class="wireframe-placeholder" style="aspect-ratio: 4 / 5;">
                    <span>@L["Detail_NoImages"]</span>
                </div>
            }
        </div>

        @* B-05: dải thumbnail cuộn ngang, giữ đủ số ảnh của tin thay vì cắt cứng 5 như trước.
           Thumbnail là <button> nên bàn phím Tab tới từng ảnh được; người dùng tắt JS vẫn xem
           ảnh chính và tự cuộn dải bằng chuột cảm ứng. *@
        @if (Model.Images.Count > 1)
        {
            <div class="detail-thumbnails">
                @for (int i = 0; i < Model.Images.Count; i++)
                {
                    <button type="button" class="thumbnail-item @(i == 0 ? "active" : "")" data-anh-index="@i"
                            aria-label="@L["Detail_ImageAria", i + 1, Model.Images.Count]" aria-current="@(i == 0 ? "true" : null)">
                        <img src="@Model.Images[i]" alt="@L["Detail_ImageAlt", i + 1]" loading="lazy" data-fallback />
                    </button>
                }
            </div>
        }
    </div>

    <!-- CỘT THÔNG TIN MUA HÀNG -->
    <div class="detail-info-panel">
        <div class="detail-meta-label">@danhMuc.ToUpperInvariant()</div>
        <h1 class="detail-title">@Model.Name</h1>

        <div class="detail-pricing-row">
            <span class="main-price">@HienThi.Tien(Model.Price)</span>
            @if (Model.Status != "ACTIVE")
            {
                <span class="badge bg-warning text-dark px-2 py-1 ms-2" style="font-size: 13px;">@Model.TrangThaiHienThi</span>
            }
        </div>

        @if (openAuctionId.HasValue && User.LayNguoiDungId() != Model.SellerUserId)
        {
            <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 mb-0" role="status">
                <span><i class="bi bi-hammer me-1" aria-hidden="true"></i>@L["E_ProductAuctionNotice"]</span>
                <a class="btn btn-rm-outline btn-sm rounded-pill px-3 text-nowrap" asp-area="" asp-controller="PublicAuctions" asp-action="Details" asp-route-id="@openAuctionId.Value">
                    @L["E_ProductAuctionCta"] <span aria-hidden="true">→</span>
                </a>
            </div>
        }

        <div class="detail-tags-row">
            <span class="tag-badge">@(string.IsNullOrWhiteSpace(Model.ConditionName) ? (string)L["Detail_ConditionUnknown"] : HienThi.TenTinhTrang(Model.ConditionName))</span>
            <span>@L["Detail_PostedAt", HienThi.Ngay(Model.CreatedAt)]</span>
            <span class="badge bg-light text-muted border px-2 py-1">
                @(string.IsNullOrWhiteSpace(Model.KhuVuc) ? (string)L["Detail_AreaUnknown"] : Model.KhuVuc)
            </span>
        </div>

        <div class="detail-short-desc">
            @(string.IsNullOrWhiteSpace(Model.Description) ? (string)L["Detail_NoShortDesc"] : Model.Description)
        </div>

        @{
            var currentUserId = User.LayNguoiDungId();
            var isOwner = currentUserId.HasValue && currentUserId.Value == Model.SellerUserId;
            var currentUrl = Context.Request.Path + Context.Request.QueryString;
        }

        @if (isOwner)
        {
            <div class="detail-actions-row mb-3">
                <a asp-area="User" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn-main text-decoration-none text-center" style="padding: 10px 24px; font-weight: 600;">
                    <i class="bi bi-pencil-square me-1"></i> @L["Detail_ManageListing"]
                </a>
                <a asp-area="User" asp-controller="Products" asp-action="Index" class="btn-rm-outline text-decoration-none text-center" style="padding: 10px 20px; font-weight: 600;">
                    @L["Detail_MyProductList"]
                </a>
            </div>
        }
        else if (Model.CanBuy)
        {
            <div class="detail-actions-row">
                @if (User.IsInRole("USER"))
                {
                    <form asp-area="User" asp-controller="Cart" asp-action="Them" method="post" class="rm-add-to-cart-form" data-product-id="@Model.Id" data-product-name="@Model.Name" data-product-price="@Model.Price.ToString("N0") ₫" data-product-image="@(Model.Images.FirstOrDefault() ?? "")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maSanPham" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="btn-rm-outline" style="padding: 10px 18px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            @L["Btn_AddToCart"]
                        </button>
                    </form>
                    <a asp-area="User" asp-controller="Orders" asp-action="Checkout" asp-route-maSanPham="@Model.Id" class="btn-main text-decoration-none text-center" style="padding: 10px 24px; font-weight: 600;">
                        @L["Btn_BuyNow"]
                    </a>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@currentUrl" class="btn-rm-outline text-decoration-none" style="padding: 10px 18px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        @L["Detail_LoginToBuy"]
                    </a>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Checkout", "Orders", new { area = "User", maSanPham = Model.Id })" class="btn-main text-decoration-none text-center" style="padding: 10px 24px; font-weight: 600;">
                        @L["Btn_BuyNow"]
                    </a>
                }
                else
                {
                    <span class="text-muted small">@L["Detail_BuyerAccountOnly"]</span>
                }
                @* Cùng class với nút tim trên thẻ sản phẩm để site.js đánh dấu trạng thái yêu thích. *@
                <button type="button" class="rm-card-favorite-btn" data-product-id="@Model.Id" aria-label="@L["Card_FavoriteAria"]"
                        data-label-them="@L["Card_FavoriteAria"]" data-label-bo="@L["Card_UnfavoriteAria"]" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-secondary py-2 mb-3" style="font-size: 13px;">
                @L["Detail_CannotOrder", Model.TrangThaiHienThi]
            </div>
        }

        <!-- Hộp thông tin shop vắn tắt -->
        <div class="shop-snippet-box">
            <div class="shop-snippet-left">
                @if (!string.IsNullOrWhiteSpace(Model.ShopLogoUrl))
                {
                    <img src="@Model.ShopLogoUrl" alt="" class="shop-snippet-avatar rm-seller-logo" data-fallback />
                }
                else
                {
                    <div class="shop-snippet-avatar"></div>
                }
                <div class="shop-snippet-info">
                    <a href="@urlXemShop" class="detail-shop-name">@Model.ShopName</a>
                    @if (Model.CoDanhGia && Model.DiemTrungBinh.HasValue)
                    {
                        <span class="text-warning fw-bold" style="font-size: 12px;">
                            ★ @Model.DiemTrungBinh.Value.ToString("0.0") <span class="text-muted fw-normal">(@Model.SoDanhGia)</span>
                        </span>
                    }
                    else
                    {
                        <span style="font-size: 12px; color: var(--color-text-muted);">@Model.DanhGiaHienThi</span>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (User.IsInRole("USER"))
                {
                    <button type="button" class="btn-rm-outline js-chat-seller" style="font-size: 12px; padding: 6px 12px;"
                            data-product-id="@Model.Id"
                            data-prefill="@L["Detail_ChatPrefill", Model.Name]">💬 Chat</button>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                       class="btn-rm-outline" style="font-size: 12px; padding: 6px 12px;">💬 Chat</a>
                }
                <a href="@urlXemShop" class="btn-rm-outline" style="font-size: 12px; padding: 6px 12px;">@L["Detail_ViewShop"]</a>
            </div>
        </div>

        <div class="mt-2 d-flex justify-content-between align-items-center">
            <a asp-area="User" asp-controller="Reports" asp-action="Tao" asp-route-loai="PRODUCT" asp-route-id="@Model.Id" asp-route-ten="@Model.Name" style="font-size: 12px; color: var(--color-error); text-decoration: none;">
                🚩 @L["Detail_ReportListing"]
            </a>
            <span style="font-size: 12px; color: var(--color-text-muted);">@L["Detail_Transparency"]</span>
        </div>
    </div>
</div>

<!-- PHẦN GIỮA: Khối nội dung chi tiết (Ảnh 5) -->
<div class="detail-content-card">
    <!-- 1. Mô tả chi tiết -->
    <div class="detail-content-block">
        <h4>@L["Detail_DescriptionTitle"]</h4>
        @if (string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted mb-0" style="font-size: 13.5px;">
                @L["Detail_NoDescription"]
            </p>
        }
        else
        {
            <p style="white-space: pre-line;">@Model.Description</p>
        }
    </div>

    <!-- 2. Thông tin người bán -->
    <div class="detail-content-block">
        <h4>@L["Detail_SellerInfo"]</h4>
        <div class="detail-shop-box">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.ShopLogoUrl))
                    {
                        <img src="@Model.ShopLogoUrl" alt="" class="detail-shop-logo rm-seller-logo" data-fallback />
                    }
                    else
                    {
                        <div class="detail-shop-logo"></div>
                    }
                    <div>
                        <a href="@urlXemShop" class="detail-shop-name fw-bold fs-6">@Model.ShopName</a>
                        <p class="detail-shop-meta mb-0 mt-1">
                            <span>@(Model.SoDonThanhCong > 0 ? (string)L["Detail_CompletedOrders", Model.SoDonThanhCong] : (string)L["Detail_NoCompletedOrders"])</span>
                            <span>•</span>
                            <span>@(string.IsNullOrWhiteSpace(Model.KhuVuc) ? (string)L["Detail_AreaUnknown"] : Model.KhuVuc)</span>
                        </p>
                    </div>
                </div>

                <!-- Card chỉ số uy tín & điểm sao nổi bật (C-04) -->
                <div class="d-flex align-items-center gap-3 bg-white px-3 py-2 rounded-3 border shadow-sm">
                    @if (Model.CoDanhGia && Model.DiemTrungBinh.HasValue)
                    {
                        <div class="text-center pe-3 border-end">
                            <div class="d-flex align-items-center gap-1 justify-content-center">
                                <span class="fs-4 fw-bold" style="color: var(--color-star); line-height: 1;">@Model.DiemTrungBinh.Value.ToString("0.0")</span>
                                <i class="bi bi-star-fill text-warning fs-5"></i>
                            </div>
                            <div class="text-muted" style="font-size: 11px;">@L["Detail_TrustScore"]</div>
                        </div>
                        <div>
                            <div class="fw-semibold text-dark" style="font-size: 13px;">@L["Detail_ReviewCount", Model.SoDanhGia]</div>
                            <div class="text-warning small" style="letter-spacing: 1px; font-size: 12px;">
                                @(new string('★', (int)Math.Round(Model.DiemTrungBinh.Value)))
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 12.5px;">
                            <i class="bi bi-shop fs-4 text-success opacity-75"></i>
                            <div>
                                <div class="fw-semibold text-dark">@L["Detail_NewShop"]</div>
                                <div style="font-size: 11px;">@L["Detail_NoReviewYet"]</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ShopDescription))
            {
                <p style="font-size: 13px; color: var(--color-text-secondary); margin: 12px 0 0; padding-top: 10px; border-top: 1px dashed var(--color-border);">@Model.ShopDescription</p>
            }
        </div>
    </div>

    <!-- 3. Mẹo giao dịch an toàn -->
    <div class="detail-content-block">
        <h4>@L["Detail_SafetyTitle"]</h4>
        <div class="rm-safety-tips">
            <ul>
                <li>@L["Detail_SafetyTip1"]</li>
                <li>@L["Detail_SafetyTip2"]</li>
                <li>@L["Detail_SafetyTip3"]</li>
                <li>@L["Detail_SafetyTip4"]</li>
            </ul>
        </div>
    </div>

    <!-- 4. Đánh giá từ người mua -->
    <div class="detail-content-block">
        <h4>@L["Detail_BuyerReviews"]</h4>
        @if (danhGia.TotalItems == 0)
        {
            <div class="detail-review-empty">
                @L["Detail_ReviewsEmpty"]
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <div style="font-size: 30px; font-weight: 700; color: var(--color-primary); line-height: 1;">@danhGia.DiemTrungBinh.ToString("0.0")</div>
                <div style="font-size: 13px; color: var(--color-text-muted);">
                    <span style="color: var(--color-star); letter-spacing: 2px;">@(new string('★', (int)Math.Round(danhGia.DiemTrungBinh)))</span><br />
                    @L["Detail_ReviewsFromBuyers", danhGia.TotalItems]
                </div>
                <a href="@(urlXemShop + "#shop-reviews-card")" class="btn-rm-outline ms-auto" style="font-size: 12px; padding: 6px 12px;">@L["Detail_ViewAllReviews"]</a>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var dg in danhGia.Items)
                {
                    <div class="d-flex justify-content-between align-items-start border-top pt-3 detail-review-item" style="border-color: var(--color-border) !important;">
                        <div class="d-flex gap-3">
                            <div class="author-circle" style="width: 32px; height: 32px; flex-shrink: 0;"></div>
                            <div>
                                <b style="font-size: 13px;">@HienThi.AnDanhTinh(dg.TenNguoiMua)</b>
                                <div style="color: var(--color-star); font-size: 12px; margin: 2px 0;">@(new string('★', dg.SoSao))</div>
                                <p style="font-size: 13px; color: var(--color-text-secondary); margin: 0;">
                                    @(string.IsNullOrWhiteSpace(dg.NoiDung) ? (string)L["Detail_NoReviewContent"] : dg.NoiDung)
                                </p>
                                @if (!string.IsNullOrWhiteSpace(dg.PhanHoiShop))
                                {
                                    <div class="mt-2 p-2 rounded-2 border-start border-3 border-success" style="background-color: var(--color-surface); font-size: 12px;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="text-success" style="font-size: 11.5px;">
                                                <i class="bi bi-reply-fill me-1"></i>@L["Detail_ShopReply"]
                                            </strong>
                                            @if (dg.NgayPhanHoi.HasValue)
                                            {
                                                <span class="text-muted" style="font-size: 10.5px;">@HienThi.Ngay(dg.NgayPhanHoi.Value)</span>
                                            }
                                        </div>
                                        <p class="text-dark mb-0" style="white-space: pre-line;">@dg.PhanHoiShop</p>
                                    </div>
                                }
                            </div>
                        </div>
                        <span class="detail-review-date" style="font-size: 11.5px; color: var(--color-text-muted);">@HienThi.Ngay(dg.NgayTao)</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- PHẦN DƯỚI: Sản phẩm liên quan (Ảnh 5) -->
@if (lienQuan.Count > 0)
{
    <section class="landing-section pt-0">
        <h2 class="section-title mb-4">@L["Detail_RelatedProducts"]</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
            @foreach (var p in lienQuan)
            {
                <div class="col">
                    <partial name="_ProductCard" model="p" />
                </div>
            }
        </div>
    </section>
}
