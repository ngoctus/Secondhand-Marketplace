@model ProductDetailVm
@{
    ViewData["Title"] = Model.Name;
    var trangThai = Model.Status switch
    {
        "RESERVED" => "Đang được giữ chỗ",
        "SOLD" => "Đã bán",
        _ => "Đang bán"
    };
}

<div class="row">
    <div class="col-md-6">
        @if (Model.Images.Count == 0)
        {
            <div class="product-art-fallback" aria-label="Chưa có ảnh sản phẩm">♻</div>
        }
        else
        {
            foreach (var img in Model.Images)
            {
                <img src="@img" class="img-fluid mb-2" alt="@Model.Name" data-fallback />
            }
        }
    </div>
    <div class="col-md-6">
        <h2>@Model.Name</h2>
        <h4 class="text-danger">@Model.Price.ToString("N0")đ</h4>
        <p><span class="pill">@trangThai</span></p>
        <p>Danh mục: @(Model.CategoryName ?? "Chưa phân loại") | Tình trạng: @(Model.ConditionName ?? "Chưa rõ") | Cửa hàng: @Model.ShopName</p>
        <p>@Model.Description</p>

        @* TODO: nút Thêm vào giỏ / Mua ngay (chỉ hiện khi Model.CanBuy) *@
        @* TODO: nút Yêu thích, Chat với người bán, Báo cáo vi phạm *@
    </div>
</div>