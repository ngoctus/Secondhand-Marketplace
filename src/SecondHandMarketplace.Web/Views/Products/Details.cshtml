@model ProductDetailVm
@using SecondHandMarketplace.Web.Common
@using SecondHandMarketplace.Web.Services.Products
@using SecondHandMarketplace.Web.Services.Reviews
@inject IProductService ProductService
@inject IReviewService Reviews
@{
    ViewData["Title"] = Model.Name;

    var danhMuc = string.IsNullOrWhiteSpace(Model.CategoryName) ? "Chưa phân loại" : Model.CategoryName;
    var urlDanhMuc = Model.CategoryId is int maDanhMuc
        ? Url.Action("Index", "Products", new { CategoryId = maDanhMuc })
        : Url.Action("Index", "Products");
    var urlXemShop = Url.Action("Details", "Shops", new { id = Model.ShopId });

    // Vài đánh giá mới nhất của shop (dữ liệu của C: bảng DanhGia + vw_DiemCuaHang).
    var danhGia = await Reviews.LayDanhGiaTheoShopAsync(Model.ShopId, page: 1, pageSize: 3);

    // Sản phẩm liên quan: ưu tiên cùng danh mục, chưa đủ 4 thì bù tin mới nhất.
    var lienQuan = (await ProductService.SearchAsync(new ProductSearchVm { CategoryId = Model.CategoryId, PageSize = 12 }))
        .Items.Where(p => p.Id != Model.Id).Take(4).ToList();
    if (lienQuan.Count < 4)
    {
        lienQuan.AddRange((await ProductService.SearchAsync(new ProductSearchVm { PageSize = 12 }))
            .Items.Where(p => p.Id != Model.Id && lienQuan.All(x => x.Id != p.Id))
            .Take(4 - lienQuan.Count));
    }
}

<!-- Breadcrumb (Ảnh 5) -->
<nav class="rm-breadcrumb" aria-label="Đường dẫn trang">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
    <span class="sep">/</span>
    <a href="@urlDanhMuc">@danhMuc</a>
    <span class="sep">/</span>
    <span>@Model.Name</span>
</nav>

<!-- PHẦN TRÊN: Ảnh gallery & Thông tin sản phẩm (Ảnh 5) -->
<div class="detail-top-grid">
    <!-- CỘT ẢNH SẢN PHẨM -->
    <div>
        <div class="detail-main-img" title="Nhấn để phóng to ảnh">
            @if (Model.Images.Count > 0)
            {
                <img id="mainProductImg" src="@Model.Images[0]" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover; cursor: zoom-in;" data-fallback data-zoomable />
            }
            else
            {
                <div class="wireframe-placeholder" style="aspect-ratio: 4 / 5;">
                    <span>Người bán chưa tải ảnh lên</span>
                </div>
            }
        </div>

        <!-- Thumbnail nhỏ -->
        <div class="detail-thumbnails">
            @for (int i = 0; i < Math.Min(Model.Images.Count, 5); i++)
            {
                <div class="thumbnail-item @(i == 0 ? "active" : "")" title="Xem ảnh @(i + 1)">
                    <img src="@Model.Images[i]" alt="Ảnh @(i + 1)" style="width: 100%; height: 100%; object-fit: cover;" data-fallback />
                </div>
            }
        </div>
    </div>

    <!-- CỘT THÔNG TIN MUA HÀNG -->
    <div>
        <div class="detail-meta-label">@danhMuc.ToUpperInvariant()</div>
        <h1 class="detail-title">@Model.Name</h1>

        <div class="detail-pricing-row">
            <span class="main-price">@HienThi.Tien(Model.Price)</span>
            @if (Model.Status != "ACTIVE")
            {
                <span class="badge bg-warning text-dark px-2 py-1 ms-2" style="font-size: 13px;">@Model.TrangThaiHienThi</span>
            }
        </div>

        <div class="detail-tags-row">
            <span class="tag-badge">@(string.IsNullOrWhiteSpace(Model.ConditionName) ? "Chưa ghi tình trạng" : Model.ConditionName)</span>
            <span>Đăng @HienThi.Ngay(Model.CreatedAt)</span>
            <span class="badge bg-light text-muted border px-2 py-1">
                @(string.IsNullOrWhiteSpace(Model.KhuVuc) ? "Chưa cập nhật khu vực" : Model.KhuVuc)
            </span>
        </div>

        <div class="detail-short-desc">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "Người bán chưa viết mô tả cho tin đăng này." : Model.Description)
        </div>

        @{
            var currentUserId = User.LayNguoiDungId();
            var isOwner = currentUserId.HasValue && currentUserId.Value == Model.SellerUserId;
            var currentUrl = Context.Request.Path + Context.Request.QueryString;
        }

        @if (isOwner)
        {
            <div class="detail-actions-row mb-3">
                <a asp-area="User" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn-main text-decoration-none text-center" style="padding: 10px 24px; font-weight: 600;">
                    <i class="bi bi-pencil-square me-1"></i> Quản lý tin đăng
                </a>
                <a asp-area="User" asp-controller="Products" asp-action="Index" class="btn-rm-outline text-decoration-none text-center" style="padding: 10px 20px; font-weight: 600;">
                    Danh sách sản phẩm của tôi
                </a>
            </div>
        }
        else if (Model.CanBuy)
        {
            <div class="detail-actions-row">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-area="User" asp-controller="Cart" asp-action="Them" method="post" style="display: inline-block;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maSanPham" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <button type="submit" class="btn-rm-outline" style="padding: 10px 18px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            Thêm vào giỏ
                        </button>
                    </form>
                    <a asp-area="User" asp-controller="Orders" asp-action="Checkout" asp-route-maSanPham="@Model.Id" class="btn-main text-decoration-none text-center" style="padding: 10px 24px; font-weight: 600;">
                        Mua ngay
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@currentUrl" class="btn-rm-outline text-decoration-none" style="padding: 10px 18px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        Đăng nhập để mua
                    </a>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Checkout", "Orders", new { area = "User", maSanPham = Model.Id })" class="btn-main text-decoration-none text-center" style="padding: 10px 24px; font-weight: 600;">
                        Mua ngay
                    </a>
                }
                @* Cùng class với nút tim trên thẻ sản phẩm để site.js đánh dấu trạng thái yêu thích. *@
                <button type="button" class="rm-card-favorite-btn" data-product-id="@Model.Id" aria-label="Thêm vào yêu thích">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-secondary py-2 mb-3" style="font-size: 13px;">
                Sản phẩm này hiện không thể đặt mua (@Model.TrangThaiHienThi.ToLowerInvariant()).
            </div>
        }

        <!-- Hộp thông tin shop vắn tắt -->
        <div class="shop-snippet-box">
            <div class="shop-snippet-left">
                @if (!string.IsNullOrWhiteSpace(Model.ShopLogoUrl))
                {
                    <img src="@Model.ShopLogoUrl" alt="" class="shop-snippet-avatar rm-seller-logo" data-fallback />
                }
                else
                {
                    <div class="shop-snippet-avatar"></div>
                }
                <div class="shop-snippet-info">
                    <a href="@urlXemShop" class="detail-shop-name">@Model.ShopName</a>
                    <span>@Model.DanhGiaHienThi</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (User.IsInRole("USER"))
                {
                    <button type="button" class="btn-rm-outline js-chat-seller" style="font-size: 12px; padding: 6px 12px;"
                            data-product-id="@Model.Id"
                            data-prefill="@($"Chào shop, mình quan tâm sản phẩm \"{Model.Name}\" ạ.")">💬 Chat</button>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                       class="btn-rm-outline" style="font-size: 12px; padding: 6px 12px;">💬 Chat</a>
                }
                <a href="@urlXemShop" class="btn-rm-outline" style="font-size: 12px; padding: 6px 12px;">Xem shop</a>
            </div>
        </div>

        <div class="mt-2 d-flex justify-content-between align-items-center">
            <a asp-area="User" asp-controller="Reports" asp-action="Tao" asp-route-loai="PRODUCT" asp-route-id="@Model.Id" asp-route-ten="@Model.Name" style="font-size: 12px; color: var(--color-danger, #d9534f); text-decoration: none;">
                🚩 Báo cáo tin đăng vi phạm
            </a>
            <span style="font-size: 12px; color: var(--color-text-muted);">Cam kết giao dịch minh bạch</span>
        </div>
    </div>
</div>

<!-- PHẦN GIỮA: Khối nội dung chi tiết (Ảnh 5) -->
<div class="detail-content-card">
    <!-- 1. Mô tả chi tiết -->
    <div class="detail-content-block">
        <h4>Mô tả chi tiết</h4>
        @if (string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted mb-0" style="font-size: 13.5px;">
                Người bán chưa mô tả chi tiết món này. Bạn nên bấm Chat để hỏi về chất liệu, thời gian đã sử dụng và lỗi còn lại trước khi mua.
            </p>
        }
        else
        {
            <p style="white-space: pre-line;">@Model.Description</p>
        }
    </div>

    <!-- 2. Thông tin người bán -->
    <div class="detail-content-block">
        <h4>Thông tin người bán</h4>
        <div class="detail-shop-box">
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.ShopLogoUrl))
                {
                    <img src="@Model.ShopLogoUrl" alt="" class="detail-shop-logo rm-seller-logo" data-fallback />
                }
                else
                {
                    <div class="detail-shop-logo"></div>
                }
                <div>
                    <a href="@urlXemShop" class="detail-shop-name">@Model.ShopName</a>
                    <p class="detail-shop-meta">
                        <span class="@(Model.CoDanhGia ? "" : "is-empty")">@Model.DanhGiaHienThi</span>
                        <span>@(Model.SoDonThanhCong > 0 ? $"{Model.SoDonThanhCong} đơn đã hoàn tất" : "Chưa có đơn hoàn tất")</span>
                        <span>@(string.IsNullOrWhiteSpace(Model.KhuVuc) ? "Chưa cập nhật khu vực" : Model.KhuVuc)</span>
                    </p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ShopDescription))
            {
                <p style="font-size: 13px; color: var(--color-text-secondary); margin: 10px 0 0;">@Model.ShopDescription</p>
            }
        </div>
    </div>

    <!-- 3. Mẹo giao dịch an toàn -->
    <div class="detail-content-block">
        <h4>Mẹo giao dịch an toàn</h4>
        <div class="rm-safety-tips">
            <ul>
                <li>Chỉ nhắn tin và đặt đơn ngay trên Re:Market; không chuyển khoản ngoài hệ thống.</li>
                <li>Yêu cầu ảnh thật hoặc video món đồ, hỏi rõ lỗi còn lại trước khi chốt giá.</li>
                <li>Khi nhận hàng: kiểm tra kỹ rồi mới bấm xác nhận hoàn tất đơn.</li>
                <li>Thấy tin đăng nghi vấn? Dùng nút "Báo cáo tin đăng vi phạm" để ban kiểm duyệt xử lý.</li>
            </ul>
        </div>
    </div>

    <!-- 4. Đánh giá từ người mua -->
    <div class="detail-content-block">
        <h4>Đánh giá từ người mua</h4>
        @if (danhGia.TotalItems == 0)
        {
            <div class="detail-review-empty">
                Shop chưa có đánh giá nào. Nhận xét đầu tiên sẽ xuất hiện sau khi người mua xác nhận hoàn tất đơn hàng.
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <div style="font-size: 30px; font-weight: 700; color: var(--color-primary); line-height: 1;">@danhGia.DiemTrungBinh.ToString("0.0")</div>
                <div style="font-size: 13px; color: var(--color-text-muted);">
                    <span style="color: var(--color-star); letter-spacing: 2px;">@(new string('★', (int)Math.Round(danhGia.DiemTrungBinh)))</span><br />
                    @danhGia.TotalItems đánh giá từ người mua đã hoàn tất đơn
                </div>
                <a href="@(urlXemShop + "#shop-reviews-card")" class="btn-rm-outline ms-auto" style="font-size: 12px; padding: 6px 12px;">Xem tất cả đánh giá</a>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var dg in danhGia.Items)
                {
                    <div class="d-flex justify-content-between align-items-start border-top pt-3 detail-review-item" style="border-color: var(--color-border) !important;">
                        <div class="d-flex gap-3">
                            <div class="author-circle" style="width: 32px; height: 32px; flex-shrink: 0;"></div>
                            <div>
                                <b style="font-size: 13px;">@HienThi.AnDanhTinh(dg.TenNguoiMua)</b>
                                <div style="color: var(--color-star); font-size: 12px; margin: 2px 0;">@(new string('★', dg.SoSao))</div>
                                <p style="font-size: 13px; color: var(--color-text-secondary); margin: 0;">
                                    @(string.IsNullOrWhiteSpace(dg.NoiDung) ? "Khách không để lại nội dung." : dg.NoiDung)
                                </p>
                            </div>
                        </div>
                        <span class="detail-review-date" style="font-size: 11.5px; color: var(--color-text-muted);">@HienThi.Ngay(dg.NgayTao)</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- PHẦN DƯỚI: Sản phẩm liên quan (Ảnh 5) -->
@if (lienQuan.Count > 0)
{
    <section class="landing-section pt-0">
        <h2 class="section-title mb-4">Sản phẩm liên quan</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
            @foreach (var p in lienQuan)
            {
                <div class="col">
                    <partial name="_ProductCard" model="p" />
                </div>
            }
        </div>
    </section>
}
