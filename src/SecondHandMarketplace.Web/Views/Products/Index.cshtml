@model ProductSearchResultVm
@{
    ViewData["Title"] = L["Search_ResultsBreadcrumb"];
    var f = Model.Filter;
    var keyword = f.Keyword?.Trim() ?? "";

    // Số bộ lọc đang bật, hiển thị trên nút "Hiện bộ lọc" của mobile; nội dung chip do _SearchResults lo.
    var soBoLocDangChon = 0
        + (f.CategoryId is null ? 0 : 1)
        + (f.ConditionId is null ? 0 : 1)
        + (string.IsNullOrWhiteSpace(Model.KhuVucDaChon) ? 0 : 1)
        + (string.IsNullOrWhiteSpace(f.TenPhanGia) && f.MinPrice is null && f.MaxPrice is null ? 0 : 1);

    // Thanh trượt giá kéo trên thang thật của gian hàng; bước 50.000đ đủ mịn mà không tạo hàng nghìn vị trí.
    var buocGia = 50_000m;
    var giaMin = Math.Floor((Model.BienGiaMin ?? 0m) / buocGia) * buocGia;
    var giaMax = Math.Ceiling((Model.BienGiaMax ?? 0m) / buocGia) * buocGia;
    var keoGiaDuoc = giaMax > giaMin;
    var giaToiThieuKe = f.MinPrice is null ? giaMin : Math.Max(giaMin, Math.Round(f.MinPrice.Value / buocGia) * buocGia);
    var giaToiDaKe = f.MaxPrice is null ? giaMax : Math.Min(giaMax, Math.Round(f.MaxPrice.Value / buocGia) * buocGia);
}

<!-- Breadcrumb (Ảnh 4) -->
<nav class="rm-breadcrumb" aria-label="@L["Detail_BreadcrumbAria"]">
    <a asp-controller="Home" asp-action="Index">@L["Nav_Home"]</a>
    <span class="sep">/</span>
    <span>@L["Search_ResultsBreadcrumb"]</span>
</nav>

<!-- Layout 2 cột: Bộ lọc + Danh sách sản phẩm (Ảnh 4) -->
<div class="search-page-layout">
    <!-- CỘT BỘ LỌC (Sidebar) -->
    <aside class="filter-sidebar" data-rm-reveal="left">
        <div class="filter-header">
            <h3>@L["Search_PanelTitle"]</h3>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" asp-route-Keyword="@keyword" class="btn-reset">@L["Search_ClearShort"]</a>
                @* Điện thoại: để gọn bảng lọc dưới nút này người mua thấy kết quả trước khi phải cuộn qua bộ lọc. *@
                <button type="button" class="filter-toggle d-lg-none" data-bs-toggle="collapse" data-bs-target="#filterPanel"
                        data-so-bo-loc="@soBoLocDangChon" aria-controls="filterPanel" aria-expanded="false">
                    @L["Search_ShowFilters"]@(soBoLocDangChon > 0 ? $" ({soBoLocDangChon})" : "")
                </button>
            </div>
        </div>

        <form method="get" asp-action="Index" id="filterPanel" class="filter-panel collapse d-lg-block">
            @if (!string.IsNullOrEmpty(f.Sort))
            {
                <input type="hidden" name="Sort" value="@f.Sort" />
            }

            <!-- Tìm trong kết quả: trên điện thoại ô search của header có thể bị thu gọn -->
            <div class="filter-group">
                <div class="filter-title">@L["Search_KeywordTitle"]</div>
                <input type="search" name="Keyword" value="@keyword" class="filter-keyword-input"
                       placeholder="@L["Search_KeywordPlaceholder"]" />
            </div>

            <!-- Khu vực sinh sống (thành phần chọn khu vực của A, mục A4) -->
            <div class="filter-group filter-khu-vuc">
                <div class="filter-title">@L["Search_AreaTitle"]</div>
                <partial name="_ChonKhuVuc" model="Model.KhuVuc" />
                <div class="form-text">@L["Search_AreaHint"]</div>
            </div>

            <!-- Danh mục -->
            <div class="filter-group">
                <div class="filter-title">@L["Search_CategoryTitle"]</div>
                <div class="filter-radio-list">
                    <label class="filter-label">
                        <input type="radio" name="CategoryId" value="" checked="@(f.CategoryId == null)" />
                        <span>@L["Search_All"]</span>
                    </label>
                    @foreach (var c in Model.DanhSachDanhMuc)
                    {
                        <label class="filter-label">
                            <input type="radio" name="CategoryId" value="@c.MaDanhMuc" checked="@(f.CategoryId == c.MaDanhMuc)" />
                            <span>@HienThi.TenDanhMuc(c.Ten)</span>
                        </label>
                    }
                </div>
            </div>

            @* B-04: hai input range chồng lên nhau thay cho 6 nút radio. Mỗi input vẫn là control thật
               của form GET nên tắt JS người mua vẫn kéo được từng đầu; JS chỉ chồng chúng thành một dải.
               Kéo hết cỡ hai đầu = không lọc giá, vì MinPrice/MaxPrice khi đó bằng đúng biên của thang. *@
            <div class="filter-group" data-gia-slider>
                <div class="filter-title">@L["Search_PriceTitle"]</div>
                @if (keoGiaDuoc)
                {
                    var nguyenBo = giaToiThieuKe <= giaMin && giaToiDaKe >= giaMax;
                    <div class="rm-gia-readout" data-gia-readout>@(nguyenBo ? (string)L["Search_AllPrices"] : $"{HienThi.Tien(giaToiThieuKe)} – {HienThi.Tien(giaToiDaKe)}")</div>
                    <div class="rm-gia-slider">
                        <div class="rm-gia-track" aria-hidden="true"><span class="rm-gia-band" data-gia-band></span></div>
                        <input type="range" class="rm-gia-range rm-gia-range-lo" name="MinPrice" data-gia-lo
                               min="@giaMin" max="@giaMax" step="@buocGia" value="@giaToiThieuKe"
                               aria-label="@L["Search_PriceMinAria"]" />
                        <input type="range" class="rm-gia-range rm-gia-range-cao" name="MaxPrice" data-gia-cao
                               min="@giaMin" max="@giaMax" step="@buocGia" value="@giaToiDaKe"
                               aria-label="@L["Search_PriceMaxAria"]" />
                    </div>
                    <div class="rm-gia-scale">
                        <span>@HienThi.Tien(giaMin)</span>
                        <span>@HienThi.Tien(giaMax)</span>
                    </div>
                }
                else
                {
                    <div class="form-text">@L["Search_NoPriceScale"]</div>
                }
            </div>

            <!-- Tình trạng -->
            <div class="filter-group">
                <div class="filter-title">@L["Search_ConditionTitle"]</div>
                <div class="filter-radio-list">
                    <label class="filter-label">
                        <input type="radio" name="ConditionId" value="" checked="@(f.ConditionId == null)" />
                        <span>@L["Search_All"]</span>
                    </label>
                    @foreach (var t in Model.DanhSachTinhTrang)
                    {
                        <label class="filter-label">
                            <input type="radio" name="ConditionId" value="@t.MaTinhTrang" checked="@(f.ConditionId == t.MaTinhTrang)" />
                            <span>@HienThi.TenTinhTrang(t.Ten)</span>
                        </label>
                    }
                </div>
            </div>

            <button type="submit" class="btn-rm-primary w-100" style="padding: 10px;">@L["Search_Apply"]</button>
        </form>
    </aside>

    <!-- CỘT KẾT QUẢ SẢN PHẨM -->
    <main>
        @* B-04: toàn bộ khối này là một partial, và cũng là thứ fetch trả về khi lọc/sắp xếp/đánh trang.
           Server render một lần cho request thường nên link chia sẻ vẫn y nguyên. *@
        <div id="ketQuaTimKiem" data-muc-tieu="@Url.Action("Index")">
            <partial name="_SearchResults" model="Model" />
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/khu-vuc.js" asp-append-version="true"></script>
    <script src="~/js/bo-loc-nhanh.js" asp-append-version="true"></script>
}
