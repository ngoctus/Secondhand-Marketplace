@model PagedResult<ProductCardVm>
@using SecondHandMarketplace.Web.Models.ViewModels
@inject SecondHandMarketplace.Web.Services.Categories.ICategoryService CategoryService
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    var query = ViewContext.HttpContext.Request.Query;
    var keyword = query["Keyword"].ToString();
    var tieuDe = string.IsNullOrWhiteSpace(keyword) ? "Tất cả sản phẩm" : $"Kết quả cho “{keyword}”";

    var displayList = Model.Items;
    var categories = await CategoryService.GetCategoriesAsync();
    var conditions = await CategoryService.GetConditionsAsync();
}

<!-- Breadcrumb (Ảnh 4) -->
<nav class="rm-breadcrumb" aria-label="Đường dẫn trang">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
    <span class="sep">/</span>
    <span>Kết quả tìm kiếm</span>
</nav>

<!-- Layout 2 cột: Bộ lọc + Danh sách sản phẩm (Ảnh 4) -->
<div class="search-page-layout">
    <!-- CỘT BỘ LỌC (Sidebar) -->
    <aside class="filter-sidebar">
        <form id="product-filter" method="get" asp-action="Index">
            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <input type="hidden" name="Keyword" value="@keyword" />
            }

            <div class="filter-header">
                <h3>Bộ lọc</h3>
                <a asp-action="Index" class="btn-reset">Xóa</a>
            </div>

            <!-- Danh mục (Checkbox) -->
            <div class="filter-group">
                <div class="filter-title">Danh mục</div>
                <div class="filter-checkbox-list">
                    @foreach (var categoryItem in categories)
                    {
                        <label class="filter-label">
                            <input type="radio" name="CategoryId" value="@categoryItem.MaDanhMuc" @(query["CategoryId"] == categoryItem.MaDanhMuc.ToString() ? "checked" : null) />
                            <span>@categoryItem.Ten</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Khoảng giá -->
            <div class="filter-group">
                <div class="filter-title">Khoảng giá</div>
                <div class="price-inputs">
                    <div class="input-wrap">
                        <input name="MinPrice" value="@query["MinPrice"]" type="number" min="0" placeholder="Từ" />
                    </div>
                    <div class="input-wrap">
                        <input name="MaxPrice" value="@query["MaxPrice"]" type="number" min="0" placeholder="Đến" />
                    </div>
                </div>
                <!-- Range slider mỏng màu olive -->
                <div style="height: 4px; background-color: var(--color-primary); border-radius: 2px; margin: 10px 0 4px;"></div>
            </div>

            <!-- Tình trạng (Radio) -->
            <div class="filter-group">
                <div class="filter-title">Tình trạng</div>
                <div class="filter-radio-list">
                    @foreach (var conditionItem in conditions)
                    {
                        <label class="filter-label">
                            <input type="radio" name="ConditionId" value="@conditionItem.MaTinhTrang" @(query["ConditionId"] == conditionItem.MaTinhTrang.ToString() ? "checked" : null) />
                            <span>@conditionItem.Ten</span>
                        </label>
                    }
                </div>
            </div>

            <button type="submit" class="btn-rm-primary w-100" style="padding: 10px;">Áp dụng bộ lọc</button>
        </form>
    </aside>

    <!-- CỘT KẾT QUẢ SẢN PHẨM -->
    <main>
        <div class="search-results-header">
            <div>
                <h2>@tieuDe</h2>
                <span class="count-label">@Model.TotalItems sản phẩm</span>
            </div>
            <div class="sort-select-box">
                <label for="sortOrder">Sắp xếp:</label>
                <select id="sortOrder" name="Sort" form="product-filter">
                    <option value="newest" selected="@(query["Sort"] == "newest" || string.IsNullOrEmpty(query["Sort"]) ? "selected" : null)">Mới nhất</option>
                    <option value="price_asc" selected="@(query["Sort"] == "price_asc" ? "selected" : null)">Giá tăng dần</option>
                    <option value="price_desc" selected="@(query["Sort"] == "price_desc" ? "selected" : null)">Giá giảm dần</option>
                </select>
            </div>
        </div>

        @if (!displayList.Any())
        {
            <div style="background-color: var(--color-surface); padding: 48px; border-radius: var(--radius-lg); text-align: center;">
                <p style="color: var(--color-text-secondary); margin-bottom: 16px;">Không tìm thấy sản phẩm nào phù hợp với bộ lọc.</p>
                <a asp-action="Index" class="btn-rm-outline">Xem tất cả sản phẩm</a>
            </div>
        }
        else
        {
            <!-- Lưới 3 cột chuẩn Ảnh 4 -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @foreach (var p in displayList)
                {
                    <div class="col">
                        <partial name="_ProductCard" model="p" />
                    </div>
                }
            </div>

            <nav class="rm-pagination" aria-label="Phân trang">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a class="rm-page-item @(pageNumber == Model.Page ? "is-active" : "")"
                       asp-route-page="@pageNumber"
                       asp-route-Sort="@query["Sort"]"
                       asp-route-Keyword="@query["Keyword"]"
                       asp-route-CategoryId="@query["CategoryId"]"
                       asp-route-ConditionId="@query["ConditionId"]"
                       asp-route-MinPrice="@query["MinPrice"]"
                       asp-route-MaxPrice="@query["MaxPrice"]">@pageNumber</a>
                }
            </nav>
        }
    </main>
</div>
