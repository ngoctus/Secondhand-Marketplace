@model ProductSearchResultVm
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    var f = Model.Filter;
    var ketQua = Model.Result;
    var keyword = f.Keyword?.Trim() ?? "";
    var tieuDe = string.IsNullOrWhiteSpace(keyword) ? "Tất cả sản phẩm" : $"Kết quả cho “{keyword}”";

    string LocUrl(string key, string? value)
    {
        var pairs = Context.Request.Query
            .Where(k => !k.Key.Equals(key, StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value, (k, v) => new KeyValuePair<string, string?>(k.Key, v))
            .ToList();
        if (!string.IsNullOrEmpty(value)) pairs.Add(new KeyValuePair<string, string?>(key, value));
        return Context.Request.Path + QueryString.Create(pairs);
    }

    var chips = new List<string>();
    if (f.CategoryId is int maDanhMuc)
        chips.Add(Model.DanhSachDanhMuc.FirstOrDefault(c => c.MaDanhMuc == maDanhMuc)?.Ten ?? "Danh mục");
    if (!string.IsNullOrWhiteSpace(f.TenPhanGia)) chips.Add(f.TenPhanGia);
    if (f.ConditionId is int maTinhTrang)
        chips.Add(Model.DanhSachTinhTrang.FirstOrDefault(t => t.MaTinhTrang == maTinhTrang)?.Ten ?? "Tình trạng");
    if (!string.IsNullOrWhiteSpace(Model.KhuVucDaChon)) chips.Add(Model.KhuVucDaChon);
}

<!-- Breadcrumb (Ảnh 4) -->
<nav class="rm-breadcrumb" aria-label="Đường dẫn trang">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
    <span class="sep">/</span>
    <span>Kết quả tìm kiếm</span>
</nav>

<!-- Layout 2 cột: Bộ lọc + Danh sách sản phẩm (Ảnh 4) -->
<div class="search-page-layout">
    <!-- CỘT BỘ LỌC (Sidebar) -->
    <aside class="filter-sidebar">
        <form method="get" asp-action="Index">
            @* Khu vực đã chọn phải đi theo mọi link sắp xếp/phân trang của trang này. *@
            @if (f.MaTinhThanh.HasValue)
            {
                <input type="hidden" name="MaTinhThanh" value="@f.MaTinhThanh" />
            }
            @if (f.MaPhuongXa.HasValue)
            {
                <input type="hidden" name="MaPhuongXa" value="@f.MaPhuongXa" />
            }

            <div class="filter-header">
                <h3>Bộ lọc</h3>
                <a asp-action="Index" asp-route-Keyword="@keyword" class="btn-reset">Xóa</a>
            </div>

            <!-- Tìm trong kết quả: trên điện thoại ô search của header có thể bị thu gọn -->
            <div class="filter-group">
                <div class="filter-title">Từ khóa</div>
                <input type="search" name="Keyword" value="@keyword" class="filter-keyword-input"
                       placeholder="VD: xe đạp, laptop, áo khoác..." />
            </div>

            <!-- Khu vực sinh sống (thành phần chọn khu vực của A, mục A4) -->
            <div class="filter-group filter-khu-vuc">
                <div class="filter-title">Khu vực sinh sống</div>
                <partial name="_ChonKhuVuc" model="Model.KhuVuc" />
                <div class="form-text">Lọc theo nơi người bán sinh sống, không phải khoảng cách tới bạn.</div>
            </div>

            <!-- Danh mục -->
            <div class="filter-group">
                <div class="filter-title">Danh mục</div>
                <div class="filter-radio-list">
                    <label class="filter-label">
                        <input type="radio" name="CategoryId" value="" checked="@(f.CategoryId == null)" />
                        <span>Tất cả</span>
                    </label>
                    @foreach (var c in Model.DanhSachDanhMuc)
                    {
                        <label class="filter-label">
                            <input type="radio" name="CategoryId" value="@c.MaDanhMuc" checked="@(f.CategoryId == c.MaDanhMuc)" />
                            <span>@c.Ten</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Khoảng giá: phân khúc cố định, không nhập tay -->
            <div class="filter-group">
                <div class="filter-title">Khoảng giá</div>
                <div class="filter-radio-list">
                    @for (var i = 0; i < ProductSearchVm.KhoPhanGia.Length; i++)
                    {
                        <label class="filter-label">
                            <input type="radio" name="PriceRange" value="@i" checked="@((f.PriceRange ?? 0) == i)" />
                            <span>@ProductSearchVm.KhoPhanGia[i].Label</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Tình trạng -->
            <div class="filter-group">
                <div class="filter-title">Tình trạng</div>
                <div class="filter-radio-list">
                    <label class="filter-label">
                        <input type="radio" name="ConditionId" value="" checked="@(f.ConditionId == null)" />
                        <span>Tất cả</span>
                    </label>
                    @foreach (var t in Model.DanhSachTinhTrang)
                    {
                        <label class="filter-label">
                            <input type="radio" name="ConditionId" value="@t.MaTinhTrang" checked="@(f.ConditionId == t.MaTinhTrang)" />
                            <span>@t.Ten</span>
                        </label>
                    }
                </div>
            </div>

            <button type="submit" class="btn-rm-primary w-100" style="padding: 10px;">Áp dụng bộ lọc</button>
        </form>
    </aside>

    <!-- CỘT KẾT QUẢ SẢN PHẨM -->
    <main>
        <div class="search-results-header">
            <div>
                <h2>@tieuDe</h2>
                <span class="count-label">@ketQua.TotalItems sản phẩm</span>
            </div>
            <div class="sort-select-box">
                <label for="sortOrder">Sắp xếp:</label>
                <select id="sortOrder" onchange="location.href=this.selectedOptions[0].dataset.url">
                    @foreach (var (key, label) in ProductSearchVm.KhoSapXep)
                    {
                        <option value="@key" data-url="@LocUrl("sort", key)" selected="@((f.Sort ?? "newest") == key)">@label</option>
                    }
                </select>
            </div>
        </div>

        @if (chips.Count > 0)
        {
            <div class="rm-active-filters">
                @foreach (var chip in chips)
                {
                    <span class="rm-filter-chip">@chip</span>
                }
                <a asp-action="Index" asp-route-Keyword="@keyword" class="rm-filter-clear">Xóa bộ lọc</a>
            </div>
        }

        @if (ketQua.Items.Count == 0)
        {
            <div class="rm-empty-state">
                <h3>Chưa có sản phẩm nào khớp</h3>
                <p>Bộ lọc hiện đang quá chặt hoặc khu vực bạn chọn chưa có người bán nào đăng tin.</p>
                <ol>
                    <li>Bỏ bớt bộ lọc danh mục, khoảng giá hoặc tình trạng.</li>
                    <li>Thử từ khóa ngắn hơn, ví dụ "áo khoác" thay vì "áo khoác jeans nữ form rộng".</li>
                    <li>Chuyển sang khu vực khác hoặc để "Tất cả khu vực".</li>
                    <li>Chưa tìm được món bạn cần? Bấm "Đăng bán" để người khác hỏi mua món của bạn.</li>
                </ol>
                <div class="d-flex gap-2 justify-content-center mt-4 flex-wrap">
                    <a asp-action="Index" asp-route-Keyword="@keyword" class="btn-rm-outline">Xóa bộ lọc giá và tình trạng</a>
                    <a asp-action="Index" class="btn-rm-primary">Xem tất cả sản phẩm</a>
                </div>
            </div>
        }
        else
        {
            <!-- Lưới 3 cột chuẩn Ảnh 4 -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @foreach (var p in ketQua.Items)
                {
                    <div class="col">
                        <partial name="_ProductCard" model="p" />
                    </div>
                }
            </div>

            @if (ketQua.TotalPages > 1)
            {
                <partial name="_Pager" model="new PagerVm(ketQua.Page, ketQua.TotalPages)" />
            }
        }
    </main>
</div>

@section Scripts {
    <script src="~/js/khu-vuc.js" asp-append-version="true"></script>
}
