@model SecondHandMarketplace.Web.Models.ViewModels.Account.LockedAccountVm
@using SecondHandMarketplace.Web.Common
@using SecondHandMarketplace.Web.Services.Accounts
@{
    ViewData["Title"] = HienThi.Chon("Khiếu nại & Mở khóa tài khoản", "Account Appeal & Unlock");
    var overview = Model.Overview;
}

<div class="container py-4" style="max-width: 920px;">
    @if (Model.RequiresTokenVerification || overview == null)
    {
        <div class="card shadow-sm border-0 my-5 text-center p-4 p-md-5">
            <div class="mb-3">
                <i class="bi bi-shield-lock text-danger" style="font-size: 3.5rem;"></i>
            </div>
            <h3 class="fw-bold mb-2">@HienThi.Chon("Xác minh tài khoản bị khóa", "Verify Locked Account")</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 540px;">
                @HienThi.Chon(
                    "Để xem lý do khóa, lịch sử vi phạm và gửi đơn khiếu nại hoặc cam kết mở khóa, vui lòng đăng nhập bằng tài khoản bị khóa của bạn tại trang Đăng nhập để hệ thống xác thực an toàn.",
                    "To view the lock reason, violation history, and submit an appeal or unlock commitment, please sign in with your locked account on the Sign In page for secure verification.")
            </p>
            <div>
                <a asp-action="Login" class="btn btn-primary px-4 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> @L["Account_Login_Title"]
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Header Banner -->
        <div class="card shadow-sm border-0 mb-4 bg-danger bg-opacity-10 border-start border-danger border-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-danger fs-6 px-3 py-2">
                                <i class="bi bi-lock-fill me-1"></i> @HienThi.Chon("TÀI KHOẢN ĐANG BỊ KHÓA", "ACCOUNT IS LOCKED")
                            </span>
                            @if (overview.LanKhoaHienTai == 1)
                            {
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">@HienThi.Chon("Lần khóa: 1 / 3", "Lock count: 1 / 3")</span>
                            }
                            else if (overview.LanKhoaHienTai == 2)
                            {
                                <span class="badge bg-danger fs-6 px-3 py-2">@HienThi.Chon("Lần khóa: 2 / 3 (Tái phạm)", "Lock count: 2 / 3 (Repeat)")</span>
                            }
                            else
                            {
                                <span class="badge bg-dark fs-6 px-3 py-2">@HienThi.Chon($"Lần khóa: {overview.LanKhoaHienTai} (Mức cao nhất)", $"Lock count: {overview.LanKhoaHienTai} (Highest tier)")</span>
                            }
                        </div>
                        <h4 class="fw-bold text-dark mb-1">@overview.HoTen (@overview.Email)</h4>
                        <div class="text-muted small">
                            @HienThi.Chon("Thời điểm khóa:", "Locked at:") @(overview.ThoiGianKhoa.HasValue ? HienThi.NgayGio(overview.ThoiGianKhoa) : "N/A")
                        </div>
                    </div>
                    <div>
                        <a asp-action="Login" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> @L["Btn_BackToLogin"]
                        </a>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(overview.LyDoKhoa))
                {
                    <div class="mt-3 p-3 bg-white rounded border">
                        <div class="fw-semibold text-danger small mb-1"><i class="bi bi-info-circle me-1"></i> @HienThi.Chon("Lý do khóa tài khoản:", "Lock reason:")</div>
                        <div class="text-dark">@overview.LyDoKhoa</div>
                    </div>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- Cột trái: Lịch sử gậy & Thông tin -->
            <div class="col-12 col-lg-5">
                <!-- Thẻ Vi phạm hiệu lực -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark"><i class="bi bi-exclamation-octagon text-danger me-1"></i> @HienThi.Chon("Gậy vi phạm hiệu lực", "Active Violation Strikes")</span>
                        <span class="badge @(overview.SoViPhamHieuLuc >= overview.NguongKhoa ? "bg-danger" : "bg-warning text-dark")">
                            @overview.SoViPhamHieuLuc / @overview.NguongKhoa @HienThi.Chon("gậy", "strikes")
                        </span>
                    </div>
                    <div class="card-body p-3">
                        @if (overview.ViPhamHieuLuc.Count == 0)
                        {
                            <div class="text-muted small text-center py-3">@HienThi.Chon("Không có vi phạm mới ghi nhận sau lần mở khóa gần nhất.", "No new violations recorded since the last unlock.")</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var v in overview.ViPhamHieuLuc)
                                {
                                    <div class="list-group-item px-0 py-2">
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span class="fw-semibold text-dark">[@v.Nguon]</span>
                                            <span>@HienThi.NgayGio(v.ThoiGian)</span>
                                        </div>
                                        <div class="small mt-1 text-secondary">@v.MoTa</div>
                                    </div>
                                }
                            </div>
                            @if (overview.SoViPhamHieuLuc > overview.ViPhamHieuLuc.Count)
                            {
                                <div class="text-muted small text-center pt-2 border-top">
                                    <em>@HienThi.Chon($"(Hiển thị {overview.ViPhamHieuLuc.Count} vi phạm gần nhất trong tổng số {overview.SoViPhamHieuLuc} vi phạm hiệu lực)", $"(Showing {overview.ViPhamHieuLuc.Count} most recent of {overview.SoViPhamHieuLuc} active violations)")</em>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Thẻ Hướng dẫn chính sách 3 lần khóa -->
                <div class="card shadow-sm border-0 mb-4 bg-light">
                    <div class="card-body p-3 small">
                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check text-primary me-1"></i> @HienThi.Chon("Quy định xử lý mở khóa", "Account Unlock Policy")</h6>
                        <ul class="ps-3 mb-0 text-muted">
                            <li class="mb-1"><strong>@HienThi.Chon("Khóa lần 1:", "1st Lock:")</strong> @HienThi.Chon("Mở khóa miễn phí qua giải trình hoặc cam kết.", "Free unlock via explanation or commitment.")</li>
                            <li class="mb-1"><strong>@HienThi.Chon("Khóa lần 2:", "2nd Lock:")</strong> @HienThi.Chon("Khiếu nại khóa nhầm miễn phí; Cam kết mở khóa yêu cầu ký quỹ 200.000đ qua VietQR và gửi kèm ảnh biên lai.", "Wrongful lock appeal is free; Unlock commitment requires a 200,000 VND deposit via VietQR with receipt photo.")</li>
                            <li><strong>@HienThi.Chon("Khóa lần 3+:", "3rd+ Lock:")</strong> @HienThi.Chon("Đóng cam kết mở khóa; chỉ tiếp nhận Khiếu nại nếu bị hệ thống quét nhầm.", "Unlock commitment closed; only wrongful lock appeals are accepted.")</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Form khiếu nại / cam kết -->
            <div class="col-12 col-lg-7">
                <!-- Thông báo chu kỳ / Cooldown -->
                @if (overview.CoDonDangCho)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-clock-history fs-4"></i>
                        <div>
                            <strong>@HienThi.Chon("Đang chờ duyệt:", "Pending review:")</strong> @HienThi.Chon($"Bạn đang có một đơn khiếu nại / yêu cầu mở khóa đang chờ Ban quản trị xử lý (Gửi lúc {HienThi.NgayGio(overview.DonGanNhat?.NgayTao)}). Vui lòng kiên nhẫn chờ phản hồi.", $"You already have an appeal / unlock request awaiting Admin review (Submitted at {HienThi.NgayGio(overview.DonGanNhat?.NgayTao)}). Please wait for a response.")
                        </div>
                    </div>
                }
                else if (overview.DangTrongCooldown)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-hourglass-split fs-4"></i>
                        <div>
                            <strong>@HienThi.Chon("Tạm khóa lượt gửi:", "Submission cooldown:")</strong> @HienThi.Chon($"Bạn đã gửi đủ {overview.SoLuotToiDaChuKy} lượt trong chu kỳ hiện tại. Bạn có thể gửi lại sau:", $"You have reached {overview.SoLuotToiDaChuKy} submissions in the current cycle. You can submit again in:") <strong><span id="cooldownTimer" data-ends-at="@(overview.CooldownKetThucUtc.HasValue ? HienThi.Iso(overview.CooldownKetThucUtc.Value) : "")">@(overview.CooldownKetThucUtc.HasValue && overview.CooldownKetThucUtc.Value > DateTime.UtcNow ? AccountAppealRules.FormatRemainingTime(overview.CooldownKetThucUtc.Value - DateTime.UtcNow) : HienThi.Chon("0 phút", "0 minutes"))</span></strong>.
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info d-flex align-items-center justify-content-between mb-4 small py-2 px-3">
                        <span><i class="bi bi-info-circle me-1"></i> @HienThi.Chon("Lượt gửi còn lại trong chu kỳ:", "Remaining submissions in this cycle:") <strong>@overview.SoLuotConLaiChuKy / @overview.SoLuotToiDaChuKy</strong>.</span>
                    </div>
                }

                @if (overview.CoTheGuiDonMoi)
                {
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3">
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-send text-primary me-1"></i> @HienThi.Chon("Gửi yêu cầu xem xét mở khóa", "Submit Unlock Review Request")</h5>
                        </div>
                        <div class="card-body p-4">
                            <form asp-action="SubmitAppeal" method="post" enctype="multipart/form-data" id="appealForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Token" value="@Model.Token" />

                                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                                <!-- Chọn loại yêu cầu -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@HienThi.Chon("Loại yêu cầu", "Request Type") <span class="text-danger">*</span></label>
                                    <div class="d-flex flex-column gap-2">
                                        <div class="form-check p-3 border rounded bg-light">
                                            <input class="form-check-input" type="radio" name="LoaiYeuCau" id="radioAppeal" value="@AccountAppealRules.TypeAppeal" checked />
                                            <label class="form-check-label fw-semibold text-dark" for="radioAppeal">
                                                @HienThi.Chon("Khiếu nại khóa nhầm / Bị oan (Miễn phí)", "Wrongful Lock Appeal (Free)")
                                            </label>
                                            <div class="text-muted small mt-1">
                                                @HienThi.Chon("Dành cho trường hợp hệ thống hoặc người khác báo cáo nhầm. Nếu được duyệt, hệ thống sẽ xóa tiền án đợt khóa này.", "For cases where the system or others reported by mistake. If approved, this lock record will be cleared.")
                                            </div>
                                        </div>

                                        @if (overview.ChoPhepCamKetMoKhoa)
                                        {
                                            <div class="form-check p-3 border rounded bg-light">
                                                <input class="form-check-input" type="radio" name="LoaiYeuCau" id="radioUnlock" value="@AccountAppealRules.TypeUnlockRequest" />
                                                <label class="form-check-label fw-semibold text-dark" for="radioUnlock">
                                                    @HienThi.Chon("Cam kết không tái phạm & Xin mở khóa", "Compliance Commitment & Unlock Request")
                                                    @if (overview.YeuCauPhiLan2)
                                                    {
                                                        <span class="badge bg-danger ms-1">@HienThi.Chon("Yêu cầu phí ký quỹ 200.000đ", "200,000 VND deposit required")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success ms-1">@HienThi.Chon("Miễn phí", "Free")</span>
                                                    }
                                                </label>
                                                <div class="text-muted small mt-1">
                                                    @HienThi.Chon("Dành cho trường hợp bạn nhận lỗi và cam kết tuân thủ chính sách sàn.", "For cases where you acknowledge the violation and commit to marketplace policies.")
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-3 border rounded bg-light opacity-50">
                                                <div class="fw-semibold text-muted">
                                                    <i class="bi bi-slash-circle me-1"></i> @HienThi.Chon("Cam kết mở khóa (Đã đóng)", "Unlock Commitment (Closed)")
                                                </div>
                                                <div class="text-muted small mt-1">
                                                    @HienThi.Chon("Tài khoản bị khóa từ lần thứ 3 trở lên không áp dụng hình thức cam kết mở khóa.", "Accounts locked 3 or more times are not eligible for unlock commitments.")
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Hộp VietQR (Chỉ hiển thị khi chọn Cam kết mở khóa ở lần 2) -->
                                @if (overview.YeuCauPhiLan2 && overview.ThongTinPhiQr != null)
                                {
                                    <div id="vietQrSection" class="p-3 border rounded bg-light mb-3 d-none">
                                        <h6 class="fw-bold text-danger mb-2">
                                            <i class="bi bi-qr-code-scan me-1"></i> @HienThi.Chon("Thanh toán phí ký quỹ cam kết (200.000đ)", "Pay Commitment Deposit Fee (200,000 VND)")
                                        </h6>
                                        <p class="small text-muted mb-3">
                                            @HienThi.Chon("Vui lòng quét mã VietQR bên dưới hoặc chuyển khoản chính xác nội dung để hệ thống đối soát. Sau khi hoàn tất, vui lòng tải ảnh chụp màn hình chuyển khoản thành công vào ô đính kèm bên dưới.", "Please scan the VietQR code below or transfer with the exact description for verification. Once completed, upload the transfer receipt screenshot below.")
                                        </p>
                                        <div class="row align-items-center">
                                            <div class="col-12 col-md-5 text-center mb-3 mb-md-0">
                                                <img src="@overview.ThongTinPhiQr.QrDataUrl" alt="VietQR Mở Khóa" class="img-fluid rounded border bg-white p-2 shadow-sm" style="max-width: 180px;" />
                                            </div>
                                            <div class="col-12 col-md-7 small">
                                                <div class="mb-1"><strong>@HienThi.Chon("Ngân hàng:", "Bank:")</strong> @overview.ThongTinPhiQr.TenNganHang (@overview.ThongTinPhiQr.MaNganHang)</div>
                                                <div class="mb-1"><strong>@HienThi.Chon("Số tài khoản:", "Account No:")</strong> <span class="font-monospace fw-bold text-dark">@overview.ThongTinPhiQr.SoTaiKhoan</span></div>
                                                <div class="mb-1"><strong>@HienThi.Chon("Chủ tài khoản:", "Account Holder:")</strong> @overview.ThongTinPhiQr.ChuTaiKhoan</div>
                                                <div class="mb-1"><strong>@HienThi.Chon("Số tiền:", "Amount:")</strong> <span class="text-danger fw-bold fs-6">200.000 VNĐ</span></div>
                                                <div class="mt-2 p-2 bg-white rounded border">
                                                    <div class="text-muted small">@HienThi.Chon("Nội dung chuyển khoản (bắt buộc):", "Transfer description (required):")</div>
                                                    <div class="d-flex align-items-center justify-content-between mt-1">
                                                        <span class="font-monospace fw-bold text-primary" id="qrTransferContent">@overview.ThongTinPhiQr.NoiDungChuyenKhoan</span>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="navigator.clipboard.writeText(document.getElementById('qrTransferContent').innerText); alert('@HienThi.Chon("Đã sao chép nội dung chuyển khoản!", "Copied transfer description!")');">
                                                            <i class="bi bi-copy"></i> @HienThi.Chon("Sao chép", "Copy")
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Nội dung giải trình / cam kết -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="NoiDung">
                                        @HienThi.Chon("Nội dung giải trình / Cam kết", "Explanation / Commitment Details") <span class="text-danger">*</span>
                                    </label>
                                    <textarea name="NoiDung" id="NoiDung" class="form-control" rows="4" placeholder="@HienThi.Chon("Nhập chi tiết lý do giải trình hoặc nội dung cam kết (tối thiểu 20 ký tự)...", "Enter your detailed explanation or commitment (at least 20 characters)...")" required minlength="20" maxlength="2000">@Model.NoiDung</textarea>
                                    <span asp-validation-for="NoiDung" class="text-danger small d-block mt-1"></span>
                                    <div class="form-text small">@HienThi.Chon("Tối thiểu 20 ký tự, tối đa 2000 ký tự.", "Minimum 20 characters, maximum 2000 characters.")</div>
                                </div>

                                <!-- Ảnh bằng chứng / biên lai -->
                                <div class="mb-4">
                                    <label class="form-label fw-semibold" for="FileDinhKem" id="evidenceLabel">
                                        @HienThi.Chon("Ảnh minh chứng (Tùy chọn)", "Evidence Image (Optional)")
                                    </label>
                                    <input type="file" name="FileDinhKem" id="FileDinhKem" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                    <div class="form-text small" id="evidenceHelp">
                                        @HienThi.Chon("Hỗ trợ định dạng JPG, PNG, WEBP. Tối đa 5MB.", "Supports JPG, PNG, WEBP. Max 5MB.")
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                    <i class="bi bi-send me-1"></i> @HienThi.Chon("Gửi yêu cầu tới Ban quản trị", "Submit Request to Administration")
                                </button>
                            </form>
                        </div>
                    </div>
                }

                <!-- Lịch sử các đơn trong đợt khóa này -->
                @if (overview.LichSuDonDotNay.Count > 0)
                {
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-text me-1"></i> @HienThi.Chon("Lịch sử yêu cầu đợt khóa này", "Request History for Current Lock")</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 small">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@HienThi.Chon("Ngày gửi", "Submitted")</th>
                                            <th>@HienThi.Chon("Loại", "Type")</th>
                                            <th>@L["Admin_Status"]</th>
                                            <th>@HienThi.Chon("Phản hồi quản trị", "Admin Response")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var don in overview.LichSuDonDotNay)
                                        {
                                            <tr>
                                                <td>@HienThi.NgayGio(don.NgayTao)</td>
                                                <td>
                                                    @if (don.LoaiYeuCau == AccountAppealRules.TypeAppeal)
                                                    {
                                                        <span class="badge bg-secondary">@HienThi.Chon("Khiếu nại", "Appeal")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info text-dark">@HienThi.Chon("Cam kết", "Commitment")</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (don.TrangThai == AccountAppealRules.StatusPending)
                                                    {
                                                        <span class="badge bg-warning text-dark">@HienThi.Chon("Chờ duyệt", "Pending")</span>
                                                    }
                                                    else if (don.TrangThai == AccountAppealRules.StatusApproved)
                                                    {
                                                        <span class="badge bg-success">@HienThi.Chon("Đã duyệt", "Approved")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">@HienThi.Chon("Bị từ chối", "Rejected")</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(don.GhiChuAdmin))
                                                    {
                                                        <div class="text-dark">@don.GhiChuAdmin</div>
                                                        @if (don.NgayXuLy.HasValue)
                                                        {
                                                            <div class="text-muted" style="font-size: 0.75rem;">(@HienThi.NgayGio(don.NgayXuLy))</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            const isTier2 = @(overview != null && overview.YeuCauPhiLan2 ? "true" : "false");
            const vietQrSection = $('#vietQrSection');
            const evidenceLabel = $('#evidenceLabel');
            const evidenceInput = $('#FileDinhKem');
            const evidenceHelp = $('#evidenceHelp');

            function updateFormState() {
                const selectedType = $('input[name="LoaiYeuCau"]:checked').val();
                if (selectedType === '@AccountAppealRules.TypeUnlockRequest' && isTier2) {
                    vietQrSection.removeClass('d-none');
                    evidenceLabel.html('@Html.Raw(HienThi.Chon("Ảnh biên lai chuyển khoản <span class=\"text-danger\">*</span>", "Transfer Receipt Screenshot <span class=\"text-danger\">*</span>"))');
                    evidenceInput.attr('required', true);
                    evidenceHelp.text('@Html.Raw(HienThi.Chon("Bắt buộc tải ảnh chụp biên lai chuyển khoản phí mở khóa 200.000đ.", "Required: upload the 200,000 VND unlock deposit receipt screenshot."))');
                } else {
                    vietQrSection.addClass('d-none');
                    evidenceLabel.text('@Html.Raw(HienThi.Chon("Ảnh minh chứng (Tùy chọn)", "Evidence Image (Optional)"))');
                    evidenceInput.removeAttr('required');
                    evidenceHelp.text('@Html.Raw(HienThi.Chon("Hỗ trợ định dạng JPG, PNG, WEBP. Tối đa 5MB.", "Supports JPG, PNG, WEBP. Max 5MB."))');
                }
            }

            $('input[name="LoaiYeuCau"]').on('change', updateFormState);
            updateFormState();

            $('#appealForm').on('submit', function () {
                const noiDung = $('#NoiDung').val().trim();
                if (noiDung.length < 20) {
                    alert('@Html.Raw(HienThi.Chon("Nội dung giải trình / cam kết phải có ít nhất 20 ký tự.", "Explanation / commitment must be at least 20 characters."))');
                    return false;
                }
                const btn = $(this).find('button[type="submit"]');
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> @Html.Raw(HienThi.Chon("Đang gửi...", "Submitting..."))');
            });

            // 3.12: Đếm ngược thời gian Cooldown realtime
            const timerEl = document.getElementById('cooldownTimer');
            if (timerEl && timerEl.dataset.endsAt) {
                const endsAt = new Date(timerEl.dataset.endsAt).getTime();
                const interval = setInterval(function () {
                    const diffMs = endsAt - Date.now();
                    if (diffMs <= 0) {
                        clearInterval(interval);
                        timerEl.innerText = "@Html.Raw(HienThi.Chon("0 phút (Chu kỳ mới đã mở)", "0 minutes (New cycle opened)"))";
                        setTimeout(function () { location.reload(); }, 1500);
                    } else {
                        const totalMinutes = Math.ceil(diffMs / 60000);
                        const days = Math.floor(totalMinutes / (24 * 60));
                        const hours = Math.floor((totalMinutes % (24 * 60)) / 60);
                        const minutes = totalMinutes % 60;
                        const parts = [];
                        if (days > 0) parts.push(days + ' @Html.Raw(HienThi.Chon("ngày", "d"))');
                        if (hours > 0) parts.push(hours + ' @Html.Raw(HienThi.Chon("giờ", "h"))');
                        if (minutes > 0 || parts.length === 0) parts.push(minutes + ' @Html.Raw(HienThi.Chon("phút", "m"))');
                        timerEl.innerText = parts.join(' ');
                    }
                }, 10000);
            }
        });
    </script>
}
