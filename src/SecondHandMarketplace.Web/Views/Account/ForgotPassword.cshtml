@model ForgotPasswordVm
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="form-page page rm-auth-page"><div class="row justify-content-center py-5"><div class="col-12 col-md-7 col-lg-5">
    <div class="card shadow-sm border-0 rm-auth-card"><div class="card-body p-4 p-md-5">
        <h2 class="text-center mb-2">Quên mật khẩu?</h2>
        <p class="text-center text-muted mb-4">Nhập email đã đăng ký để nhận mã OTP đặt lại mật khẩu.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
            <button type="submit" class="btn btn-primary w-100 mt-4">Gửi mã OTP</button>
        </form>
        <p class="text-center mt-4 mb-0"><a asp-action="Login">Quay lại đăng nhập</a></p>
    </div></div>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
