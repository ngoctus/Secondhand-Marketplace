@model ForgotPasswordVm
@{
    ViewData["Title"] = L["Account_ForgotPassword"].Value;
}
<div class="form-page page rm-auth-page"><div class="row justify-content-center py-5"><div class="col-12 col-md-7 col-lg-5">
    <div class="card shadow-sm border-0 rm-auth-card"><div class="card-body p-4 p-md-5">
        <h2 class="text-center mb-2">@L["Account_ForgotPassword"]</h2>
        <p class="text-center text-muted mb-4">@L["Account_Forgot_Subtitle"]</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <label asp-for="Email" class="form-label">@L["Account_Email"]</label>
            <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
            <button type="submit" class="btn btn-primary w-100 mt-4">@L["Account_SendOtp"]</button>
        </form>
        <p class="text-center mt-4 mb-0"><a asp-action="Login">@L["Btn_BackToLogin"]</a></p>
    </div></div>
</div></div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('form').on('submit', function () {
            if ($(this).valid()) {
                const btn = $(this).find('button[type="submit"]');
                btn.prop('disabled', true);
                btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@HienThi.Chon("Đang gửi mã...", "Sending code...")');
            }
        });
    </script>
}
