@model ProfileVm
@{
    ViewData["Title"] = L["Nav_Profile"].Value;
}
<div class="container py-4 rm-account-page" style="max-width:760px">
    <h2>@L["Nav_Profile"]</h2>
    <p class="text-muted">@L["Account_Profile_Subtitle"]</p>
    <form asp-action="Profile" method="post" class="card card-body border-0 shadow-sm rounded-4 gap-3 rm-account-form mb-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div>
            <label asp-for="HoTen" class="form-label fw-semibold">@L["Account_FullName"]</label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="Email" class="form-label fw-semibold">@L["Account_Email"]</label>
            <input asp-for="Email" class="form-control bg-light" readonly />
            <small class="text-muted">@L["Account_EmailReadonlyHint"]</small>
        </div>
        <div>
            <label asp-for="SoDienThoai" class="form-label fw-semibold">@L["Account_Phone"]</label>
            <input asp-for="SoDienThoai" class="form-control" required />
            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="DiaChiMacDinh" class="form-label fw-semibold">@L["Account_DefaultAddress"]</label>
            <textarea asp-for="DiaChiMacDinh" class="form-control" rows="2"></textarea>
            <span asp-validation-for="DiaChiMacDinh" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="AnhDaiDien" class="form-label fw-semibold">@L["Account_AvatarUrl"]</label>
            <input asp-for="AnhDaiDien" class="form-control" placeholder="/uploads/avatar.jpg" />
            <span asp-validation-for="AnhDaiDien" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 mt-1">
            <button class="btn btn-primary" type="submit">@L["Btn_Save"]</button>
            <a asp-action="ChangePassword" class="btn btn-outline-secondary">@L["Nav_ChangePassword"]</a>
        </div>
    </form>

    @if (User.IsInRole("USER"))
    {
        <div class="card card-body border-0 shadow-sm rounded-4">
            <h5 class="mb-3">@L["Account_Profile_Utilities"]</h5>
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="User" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-bag-check me-1"></i> @L["Nav_MyOrders"]
                </a>
                <a asp-area="User" asp-controller="Favorites" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-heart me-1"></i> @L["Nav_Favorites"]
                </a>
                <a asp-area="User" asp-controller="Reviews" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-star me-1"></i> @L["Nav_MyReviews"]
                </a>
                <a asp-area="User" asp-controller="Disputes" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-exclamation-diamond me-1"></i> @L["Nav_Disputes"]
                </a>
                <a asp-area="User" asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-flag me-1"></i> @L["Nav_ReportHistory"]
                </a>
                <a asp-area="User" asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-shop me-1"></i> @L["Nav_SellerChannel"]
                </a>
            </div>
        </div>
    }
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
