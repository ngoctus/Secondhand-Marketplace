@model ResetPasswordOtpVm
@{
    ViewData["Title"] = L["Account_Reset_Title"].Value;
}
<div class="form-page page rm-auth-page"><div class="row justify-content-center py-5"><div class="col-12 col-md-7 col-lg-5">
    <div class="card shadow-sm border-0 rm-auth-card"><div class="card-body p-4 p-md-5">
        <h2 class="text-center mb-2">@L["Account_Reset_Title"]</h2>
        @if (TempData["Loi"] is string error) { <div class="alert alert-danger d-flex align-items-center gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 text-danger"></i><div>@error</div></div> }
        <p class="text-center text-muted mb-4">@L["Account_Reset_Subtitle"]</p>
        <form asp-action="ResetPassword" method="post">
            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label">@L["Account_OtpCode"]</label>
                <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="@L["Account_Otp6Digits"]" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">@L["Account_NewPassword"]</label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="@L["Account_PasswordRulePlaceholder"]" />
                <div class="form-text text-muted small mt-1"><i class="bi bi-shield-lock me-1"></i> @L["Account_PasswordRuleHint"]</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">@L["Account_ConfirmNewPassword"]</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">@L["Account_ConfirmAndReset"]</button>
        </form>
        <form asp-action="ResendResetCode" method="post" class="text-center mt-3">
            <input type="hidden" name="Email" value="@Model.Email" />
            <button type="submit" class="btn btn-link">@L["Account_ResendOtp"]</button>
        </form>
        <p class="text-center mt-2 mb-0"><a asp-action="Login">@L["Btn_BackToLogin"]</a></p>
    </div></div>
</div></div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('form').on('submit', function () {
            if ($(this).valid()) {
                const btn = $(this).find('button[type="submit"]');
                btn.prop('disabled', true);
            }
        });
    </script>
}
