@model ResetPasswordOtpVm
@{ ViewData["Title"] = "Xác nhận OTP"; }
<div class="form-page page"><div class="row justify-content-center py-5"><div class="col-12 col-md-7 col-lg-5">
    <div class="card shadow-sm border-0"><div class="card-body p-4 p-md-5">
        <h2 class="text-center mb-2">Đặt lại mật khẩu</h2>
        @if (TempData["OtpSent"] is string sent) { <div class="alert alert-info" role="status">@sent</div> }
        @if (TempData["Loi"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
        <p class="text-center text-muted mb-4">Mã OTP có hiệu lực trong 10 phút. Kiểm tra cả thư mục spam.</p>
        <form asp-action="ResetPassword" method="post">
            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Code" class="form-label">Mã OTP</label><input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6 chữ số" /><span asp-validation-for="Code" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Xác nhận và đổi mật khẩu</button>
        </form>
        <form asp-action="ResendResetCode" method="post" class="text-center mt-3"><input type="hidden" name="Email" value="@Model.Email" /><button type="submit" class="btn btn-link">Gửi lại mã OTP</button></form>
        <p class="text-center mt-2 mb-0"><a asp-action="Login">Quay lại đăng nhập</a></p>
    </div></div>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
