@model ChangePasswordVm
@{
    ViewData["Title"] = L["Nav_ChangePassword"].Value;
}
<div class="container py-4 rm-account-page" style="max-width:620px">
    <h2 class="mb-3">@L["Nav_ChangePassword"]</h2>
    <form asp-action="ChangePassword" method="post" class="card card-body border-0 shadow-sm rounded-4 gap-3 rm-account-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div>
            <label asp-for="CurrentPassword" class="form-label fw-semibold">@L["Account_CurrentPassword"]</label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="NewPassword" class="form-label fw-semibold">@L["Account_NewPassword"]</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="@L["Account_PasswordRulePlaceholder"]" />
            <div class="form-text text-muted small mt-1"><i class="bi bi-shield-lock me-1"></i> @L["Account_PasswordRuleHint"]</div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="form-label fw-semibold">@L["Account_ConfirmNewPassword"]</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-primary" type="submit">@L["Nav_ChangePassword"]</button>
            <a asp-action="Profile" class="btn btn-outline-secondary">@L["Btn_Back"]</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
