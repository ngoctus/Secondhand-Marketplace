@model ChangePasswordVm
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="container py-4 rm-account-page" style="max-width:620px">
    <h2>Đổi mật khẩu</h2>
    <form asp-action="ChangePassword" method="post" class="card card-body gap-3 rm-account-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
        <div><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="text-danger"></span></div>
        <div><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Đổi mật khẩu</button><a asp-action="Profile" class="btn btn-outline-secondary">Quay lại</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
