@model ChangePasswordVm
@{
    ViewData["Title"] = L["Nav_ChangePassword"].Value;
    var isOtpVerified = !string.IsNullOrWhiteSpace(Model.VerifiedToken);
    var userEmail = ViewBag.UserEmail as string ?? string.Empty;
    var otpSent = ViewBag.OtpSent as bool? ?? false;
}
<div class="container py-4 rm-account-page" style="max-width:620px">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">@L["Nav_ChangePassword"]</h2>
        @if (!isOtpVerified)
        {
            <span class="badge rounded-pill text-bg-primary px-3 py-2">@L["Account_OtpStep1Badge"]</span>
        }
        else
        {
            <span class="badge rounded-pill text-bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i>@L["Account_ChangePwdStep2Badge"]</span>
        }
    </div>

    @if (TempData["ThongBao"] is string info) { <div class="alert alert-info d-flex align-items-center gap-2" role="alert"><i class="bi bi-envelope-check-fill fs-5 flex-shrink-0"></i><div>@info</div></div> }
    @if (TempData["ThanhCong"] is string okMsg) { <div class="alert alert-success d-flex align-items-center gap-2" role="alert"><i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i><div>@okMsg</div></div> }
    @if (TempData["Loi"] is string err) { <div class="alert alert-danger d-flex align-items-center gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i><div>@err</div></div> }

    @if (!isOtpVerified)
    {
        <div class="card card-body border-0 shadow-sm rounded-4 gap-3 rm-account-form">
            <p class="text-muted mb-1">
                @Html.Raw(string.Format(L["Account_ChangePwdOtpDesc"].Value, System.Net.WebUtility.HtmlEncode(userEmail)))
            </p>
            <form asp-action="SendChangePasswordOtp" method="post">
                <button type="submit" class="btn-rm-outline w-100">
                    <i class="bi bi-send me-1"></i>@(otpSent ? L["Account_ResendOtpEmail"] : L["Account_SendOtpEmail"])
                </button>
            </form>

            <hr class="my-1" />

            <form asp-action="VerifyChangePasswordOtp" method="post" class="d-flex flex-column gap-3">
                <div>
                    <label for="otpCodeInput" class="form-label fw-semibold">@L["Account_OtpCode"]</label>
                    <input id="otpCodeInput" name="code" class="form-control text-center fs-4 fw-bold" style="letter-spacing: 6px;" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-rm-primary flex-grow-1">@L["Account_ConfirmOtpBtn"]</button>
                    <a asp-action="Profile" class="btn-rm-outline">@L["Btn_Back"]</a>
                </div>
            </form>
        </div>
    }
    else
    {
        <form asp-action="ChangePassword" method="post" class="card card-body border-0 shadow-sm rounded-4 gap-3 rm-account-form">
            <input asp-for="VerifiedToken" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div>
                <label asp-for="CurrentPassword" class="form-label fw-semibold">@L["Account_CurrentPassword"]</label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div>
                <label asp-for="NewPassword" class="form-label fw-semibold">@L["Account_NewPassword"]</label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="@L["Account_PasswordRulePlaceholder"]" />
                <div class="form-text text-muted small mt-1"><i class="bi bi-shield-lock me-1"></i> @L["Account_PasswordRuleHint"]</div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">@L["Account_ConfirmNewPassword"]</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-primary" type="submit">@L["Nav_ChangePassword"]</button>
                <a asp-action="Profile" class="btn btn-outline-secondary">@L["Btn_Back"]</a>
            </div>
        </form>
    }
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
