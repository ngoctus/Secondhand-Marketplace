@using SecondHandMarketplace.Web.Models.ViewModels.Account
@{
    var provider = (string)(ViewBag.Provider ?? "Google");
    var isGoogle = provider.Equals("Google", StringComparison.OrdinalIgnoreCase);
    var returnUrl = (string?)ViewBag.ReturnUrl;
    var accounts = (List<ExternalAccountItemVm>?)ViewBag.Accounts ?? new List<ExternalAccountItemVm>();
    ViewData["Title"] = $"Đăng nhập bằng {provider}";
}

<div class="container py-5" style="max-width: 520px;">
    <div class="card border-0 shadow rounded-4 overflow-hidden bg-white">
        <!-- Header -->
        <div class="p-4 text-center border-bottom bg-light">
            @if (isGoogle)
            {
                <svg width="40" height="40" viewBox="0 0 24 24" class="mb-2">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                </svg>
            }
            else
            {
                <svg width="40" height="40" fill="#1877F2" viewBox="0 0 24 24" class="mb-2">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
            }
            <h4 class="fw-bold text-dark mb-1">Chọn tài khoản thử nghiệm (Development)</h4>
            <p class="text-muted small mb-0">để tiếp tục đến <strong class="text-dark">Re:Market</strong></p>
        </div>

        <div class="p-4">
            <partial name="_ThongBao" />

            <!-- Danh sách 4 tài khoản test có sẵn -->
            <div class="mb-4">
                <div class="small fw-semibold text-secondary text-uppercase mb-2" style="font-size: 11px; letter-spacing: 0.5px;">
                    Tài khoản thử nghiệm có sẵn
                </div>
                <div class="list-group list-group-flush rounded-3 border">
                    @foreach (var acc in accounts)
                    {
                        <form asp-action="ExternalLoginSelectAccountSubmit" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="provider" value="@provider" />
                            <input type="hidden" name="email" value="@acc.Email" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="list-group-item list-group-item-action p-3 d-flex align-items-center gap-3 border-0 border-bottom">
                                <img src="@(string.IsNullOrWhiteSpace(acc.AnhDaiDien) ? (isGoogle ? "https://lh3.googleusercontent.com/a/default-user=s96-c" : "https://graph.facebook.com/v12.0/me/picture?type=large") : acc.AnhDaiDien)"
                                     alt="@acc.HoTen" class="rounded-circle border" style="width: 42px; height: 42px; object-fit: cover;" />
                                <div class="text-start flex-grow-1">
                                    <div class="fw-semibold text-dark">@acc.HoTen</div>
                                    <div class="text-muted small">@acc.Email</div>
                                </div>
                                <i class="bi bi-chevron-right text-muted small"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- Hướng dẫn tích hợp OAuth thật -->
            <div class="alert alert-light border small text-muted mb-3 d-flex gap-2 align-items-start">
                <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                <div>
                    <strong>Chế độ Mock OAuth (Development):</strong> Chỉ cho phép chọn 1 trong 4 tài khoản thử nghiệm có sẵn khi <code>MockOAuth:Enabled = true</code>. Ở môi trường Production, route này bị vô hiệu hóa hoàn toàn.
                </div>
            </div>

            <div class="text-center">
                <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="text-decoration-none small text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>
