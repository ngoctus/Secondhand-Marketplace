@using SecondHandMarketplace.Web.Services.Products
@using SecondHandMarketplace.Web.Services.Banners
@using SecondHandMarketplace.Web.Services.Categories
@using SecondHandMarketplace.Web.Services.Reviews
@using SecondHandMarketplace.Web.Models.ViewModels.Reviews
@inject IProductService ProductService
@inject IBannerService BannerService
@inject ICategoryService CategoryService
@inject IReviewService Reviews
@{
    ViewData["Title"] = "Trang chủ";

    List<SecondHandMarketplace.Web.Models.Entities.DanhMuc> danhMuc = new();
    try
    {
        danhMuc = (await CategoryService.GetCategoriesAsync()).ToList();
    }
    catch { }

    List<SecondHandMarketplace.Web.Models.Entities.Banner> banners = new();
    try
    {
        banners = (await BannerService.LayBannerHienThiAsync()).ToList();
    }
    catch { }

    // Lấy sản phẩm thật từ database nếu có, nếu chưa có thì dùng danh sách mẫu chuẩn theo Wireframe
    List<ProductCardVm> sanPhams = new();
    try
    {
        sanPhams = (await ProductService.SearchAsync(new ProductSearchVm())).Items.ToList();
    }
    catch { }

    // Đánh giá thật từ đơn đã hoàn tất cho khối "Người dùng nói gì"
    List<DanhGiaNoiBatVm> danhGiaNoiBat = new();
    try
    {
        danhGiaNoiBat = (await Reviews.LayDanhGiaNoiBatAsync(3)).ToList();
    }
    catch { }

    // Thẻ đánh giá theo wireframe chỉ tối đa 3 dòng.
    string TomTacDanhGia(string noiDung)
        => noiDung.Length <= 180 ? noiDung : noiDung.Substring(0, 180).TrimEnd() + "…";
}

<!-- 1. HERO SECTION (Ảnh 2) -->
<section class="landing-hero">
    <div>
        <div class="hero-sublabel">SECONDHAND - TÁI SỬ DỤNG</div>
        <h1 class="hero-heading">Món đồ cũ,<br />giá trị mới.</h1>
        <p class="hero-desc">
            Mua bán đồ đã qua sử dụng an toàn, tiết kiệm và thân thiện với môi trường. Mọi tin đăng đều được kiểm duyệt.
        </p>
        <div class="hero-actions">
            <a asp-controller="Products" asp-action="Index" class="btn-rm-primary">Khám phá ngay</a>
            <a asp-area="User" asp-controller="Products" asp-action="Index" class="btn-rm-secondary">Đăng bán sản phẩm</a>
        </div>
        <div class="hero-stats">
            <div class="hero-stat-item">
                <b>10.000+</b>
                <span>Sản phẩm</span>
            </div>
            <div class="hero-stat-item">
                <b>5.000+</b>
                <span>Người bán</span>
            </div>
            <div class="hero-stat-item">
                <b>100%</b>
                <span>Kiểm duyệt</span>
            </div>
        </div>
    </div>
    <div class="hero-image-box">
        <img src="~/images/hero-marketplace.jpg"
             alt="Đồ dùng secondhand được tái sử dụng: laptop, máy ảnh, tai nghe và quần áo"
             class="hero-image"
             asp-append-version="true" />
    </div>
</section>

@if (banners.Count > 0)
{
<!-- 1b. BANNER (B5) -->
<section class="landing-section" style="padding-top:0">
    <div id="rmBannerCarousel" class="carousel slide rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel">
        @if (banners.Count > 1)
        {
            <div class="carousel-indicators">
                @for (var i = 0; i < banners.Count; i++)
                {
                    <button type="button" data-bs-target="#rmBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : null)" aria-label="Banner @(i + 1)"></button>
                }
            </div>
        }
        <div class="carousel-inner">
            @for (var i = 0; i < banners.Count; i++)
            {
                var b = banners[i];
                <div class="carousel-item @(i == 0 ? "active" : null)">
                    @if (!string.IsNullOrWhiteSpace(b.LienKet))
                    {
                        <a href="@(SecondHandMarketplace.Web.Common.UrlAnToan.HopLe(b.LienKet) ? b.LienKet : "#")" class="d-block">
                            <img src="@b.DuongDanAnh" alt="@b.TieuDe" class="w-100 d-none d-md-block" style="aspect-ratio:10/3; object-fit:cover;" data-fallback />
                            <img src="@b.DuongDanAnh" alt="@b.TieuDe" class="w-100 d-md-none" style="aspect-ratio:16/9; object-fit:cover;" data-fallback />
                        </a>
                    }
                    else
                    {
                        <img src="@b.DuongDanAnh" alt="@b.TieuDe" class="w-100" style="aspect-ratio:10/3; object-fit:cover;" data-fallback />
                    }
                    @* Chỉ hiển thị caption HTML khi ảnh không phải là banner SVG (vì banner SVG đã có chữ thiết kế sẵn bên trong ảnh) *@
                    @if (!string.IsNullOrWhiteSpace(b.MoTa) && !b.DuongDanAnh.EndsWith(".svg", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="carousel-caption d-none d-md-block text-start" style="background:rgba(15,23,42,.75); backdrop-filter:blur(6px); border-radius:10px; padding:10px 16px; bottom:20px; left:30px; max-width:60%;">
                            <h5 class="mb-1 text-white fw-bold">@b.TieuDe</h5>
                            <p class="mb-0 small text-white-50">@b.MoTa</p>
                        </div>
                    }
                </div>
            }
        </div>
        @if (banners.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#rmBannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Trước</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#rmBannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Sau</span>
            </button>
        }
    </div>
</section>
}

<!-- 2. DANH MỤC (Ảnh 2) -->
<section class="landing-section">
    <div class="landing-section-header">
        <div>
            <div class="section-label">DANH MỤC</div>
            <h2 class="section-title">Tìm nhanh theo danh mục</h2>
        </div>
        <a asp-controller="Products" asp-action="Index" class="btn-rm-outline">Xem tất cả</a>
    </div>

    <div class="category-grid">
        @foreach (var c in danhMuc.Take(6))
        {
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@c.MaDanhMuc" class="category-card">
                <div class="cat-circle"></div>
                <span class="cat-name">@c.Ten</span>
            </a>
        }
    </div>
</section>

<!-- 3. SẢN PHẨM NỔI BẬT (Ảnh 2) -->
<section class="landing-section">
    <div class="landing-section-header">
        <div>
            <div class="section-label">SẢN PHẨM NỔI BẬT</div>
            <h2 class="section-title">Có thể bạn sẽ thích</h2>
        </div>
        <div class="d-flex gap-2 landing-header-actions">
            <span class="btn-rm-primary" style="padding: 6px 14px; font-size: 13px; border-radius: 999px;">Mới đăng</span>
            <a asp-controller="Products" asp-action="Index" asp-route-PriceRange="1" class="btn-rm-outline" style="padding: 6px 14px; font-size: 13px; border-radius: 999px;">Giá tốt</a>
            <a asp-controller="Products" asp-action="Index" class="btn-rm-outline" style="padding: 6px 14px; font-size: 13px; border-radius: 999px;">Được quan tâm</a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3 mb-4">
        @foreach (var p in sanPhams.Take(4))
        {
            <div class="col">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>

    <div class="text-center pt-2">
        <a asp-controller="Products" asp-action="Index" class="btn-rm-outline" style="padding: 10px 24px;">Xem thêm sản phẩm</a>
    </div>
</section>

<!-- 4. CÁCH THỨC HOẠT ĐỘNG (Ảnh 3) -->
<section class="landing-section">
    <div class="section-label">CÁCH THỨC HOẠT ĐỘNG</div>
    <h2 class="section-title">3 bước đơn giản</h2>

    <div class="steps-grid">
        <div class="step-card">
            <div class="step-num">1</div>
            <h3 class="step-title">Tìm sản phẩm</h3>
            <p class="step-desc">Duyệt danh mục hoặc dùng thanh tìm kiếm và bộ lọc.</p>
        </div>
        <div class="step-card">
            <div class="step-num">2</div>
            <h3 class="step-title">Liên hệ người bán</h3>
            <p class="step-desc">Trao đổi, hỏi thêm ảnh và tình trạng thực tế.</p>
        </div>
        <div class="step-card">
            <div class="step-num">3</div>
            <h3 class="step-title">Giao dịch</h3>
            <p class="step-desc">Gặp mặt hoặc vận chuyển, nhận hàng và đánh giá.</p>
        </div>
    </div>
    <div class="step-seller-note">
        Dành cho người bán: Đăng sản phẩm → Kiểm duyệt → Tiếp cận người mua
    </div>
</section>

<!-- 5. GIÁ TRỊ BỀN VỮNG (Ảnh 3) -->
<section class="landing-section">
    <div class="sustainability-row">
        <div class="sustainability-image-wrap">
            <img src="~/images/sustainable-reuse.jpg" alt="Trái đất xanh với biểu tượng tái chế, đại diện cho lối sống bền vững" class="sustainability-image" asp-append-version="true" />
        </div>
        <div>
            <div class="section-label">GIÁ TRỊ BỀN VỮNG</div>
            <h2 class="section-title" style="font-size: 26px; line-height: 1.25; margin-bottom: 12px;">
                Mỗi món đồ được dùng lại là một lần giảm lãng phí.
            </h2>
            <p style="color: var(--color-text-secondary); font-size: 14px; margin-bottom: 20px;">
                Tái sử dụng giúp tiết kiệm chi phí và giảm rác thải ra môi trường.
            </p>
            <div class="sustainability-stats">
                <div class="sust-stat-card">
                    <b>00 kg</b>
                    <span>Rác thải giảm</span>
                </div>
                <div class="sust-stat-card">
                    <b>00 triệu đ</b>
                    <span>Tiết kiệm</span>
                </div>
                <div class="sust-stat-card">
                    <b>0.000</b>
                    <span>Món đồ được dùng lại</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 6. ĐỘ TIN CẬY (Ảnh 3) -->
<section class="landing-section">
    <div class="section-label">ĐỘ TIN CẬY</div>
    <h2 class="section-title">Mua bán an tâm hơn</h2>

    <div class="trust-grid">
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">✓</div>
            <h4>Kiểm duyệt sản phẩm</h4>
            <p>Mọi tin đăng được duyệt trước khi hiển thị.</p>
        </div>
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">↔</div>
            <h4>Giao dịch an toàn</h4>
            <p>Hướng dẫn gặp mặt, thanh toán, kiểm hàng.</p>
        </div>
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">♡</div>
            <h4>Quy định cộng đồng</h4>
            <p>Nguyên tắc đăng bán và ứng xử rõ ràng.</p>
        </div>
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">!</div>
            <h4>Báo cáo vi phạm</h4>
            <p>Gửi báo cáo nhanh, có đội ngũ xử lý.</p>
        </div>
    </div>
</section>

<!-- 7. ĐÁNH GIÁ (Ảnh 3) -->
<section class="landing-section">
    <div class="section-label">ĐÁNH GIÁ</div>
    <h2 class="section-title">Người dùng nói gì</h2>
    <p style="color: var(--color-text-muted); font-size: 13px; margin: 4px 0 20px;">Chỉ hiển thị đánh giá thật từ giao dịch đã hoàn tất</p>

    @if (danhGiaNoiBat.Count == 0)
    {
        <p class="reviews-empty">Sàn chưa có đánh giá nào từ giao dịch đã hoàn tất. Đánh giá sẽ hiện ở đây ngay khi người mua xác nhận đơn.</p>
    }
    else
    {
        <div class="reviews-grid">
            @foreach (var dg in danhGiaNoiBat)
            {
                <div class="review-card">
                    <div class="review-stars" aria-label="@dg.SoSao/5 sao">
                        @for (byte s = 1; s <= 5; s++)
                        {
                            <span class="@(s <= dg.SoSao ? "star-on" : "star-off")">★</span>
                        }
                    </div>
                    <p class="review-text">@TomTacDanhGia(dg.NoiDung)</p>
                    <div class="review-author">
                        <img class="author-circle" src="@(string.IsNullOrWhiteSpace(dg.AnhDaiDienNguoiMua) ? Url.Content("~/images/avatar-default.png") : dg.AnhDaiDienNguoiMua)" alt="Ảnh đại diện @dg.TenNguoiMua" />
                        <div class="author-info">
                            <b>@dg.TenNguoiMua</b>
                            <span>
                                Đã mua:
                                @if (dg.MaSanPham.HasValue)
                                {
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@dg.MaSanPham.Value">@dg.TenSanPham</a>
                                }
                                else
                                {
                                    @dg.TenSanPham
                                }
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<!-- 8. BANNER CTA CUỐI TRANG (Ảnh 3) -->
<div class="landing-cta-banner">
    <div class="cta-banner-text">
        <h3>Có món đồ không còn dùng? Đăng bán ngay!</h3>
        <p>Đăng tin miễn phí, được kiểm duyệt trong thời gian ngắn.</p>
    </div>
    <a asp-area="User" asp-controller="Products" asp-action="Index" class="btn-cta-white">Đăng bán ngay</a>
</div>
