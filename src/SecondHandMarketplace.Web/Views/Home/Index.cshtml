@using SecondHandMarketplace.Web.Models.ViewModels.Reviews
@model SecondHandMarketplace.Web.Models.ViewModels.Home.HomeIndexVm
@{
    ViewData["Title"] = L["Nav_Home"];

    // Icon cho ô danh mục: bảng DanhMuc không có cột icon nên suy theo từ khóa trong tên.
    string LayIconDanhMuc(string tenDanhMuc)
    {
        var ten = (tenDanhMuc ?? string.Empty).ToLowerInvariant();
        if (ten.Contains("thời trang") || ten.Contains("áo") || ten.Contains("quần")) return "bi-handbag";
        if (ten.Contains("điện tử") || ten.Contains("máy tính") || ten.Contains("điện thoại")) return "bi-laptop";
        if (ten.Contains("gia dụng") || ten.Contains("bếp")) return "bi-house-door";
        if (ten.Contains("sách") || ten.Contains("truyện")) return "bi-book";
        if (ten.Contains("xe") || ten.Contains("xe cộ")) return "bi-bicycle";
        if (ten.Contains("chơi") || ten.Contains("mẹ bé") || ten.Contains("bé")) return "bi-controller";
        if (ten.Contains("thể thao") || ten.Contains("dã ngoại")) return "bi-trophy";
        if (ten.Contains("nội thất") || ten.Contains("bàn") || ten.Contains("ghế")) return "bi-lamp";
        if (ten.Contains("phụ kiện") || ten.Contains("đồng hồ")) return "bi-watch";
        return "bi-box-seam";
    }

    // Thẻ đánh giá theo wireframe chỉ tối đa 3 dòng.
    string TomTacDanhGia(string noiDung)
        => noiDung.Length <= 180 ? noiDung : noiDung.Substring(0, 180).TrimEnd() + "…";
}

<!-- 1. HERO SECTION (Ảnh 2) -->
<section class="landing-hero">
    <div data-rm-reveal="left">
        <div class="hero-sublabel">@L["Home_Sublabel"]</div>
        <h1 class="hero-heading">@L["Home_HeroLine1"]<br />@L["Home_HeroLine2"]</h1>
        <p class="hero-desc">
            @L["Home_HeroDesc"]
        </p>
        <div class="hero-actions">
            <a asp-controller="Products" asp-action="Index" class="btn-rm-primary rm-cta-pulse">@L["Home_CtaExplore"]</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("USER"))
                {
                    <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-rm-secondary">@L["Home_CtaSell"]</a>
                }
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/User/Products/Create" class="btn-rm-secondary">@L["Home_CtaSell"]</a>
            }
        </div>
        <div class="hero-stats">
            <div class="hero-stat-item">
                <b data-rm-count="@(Model.TongSanPham > 0 ? Model.TongSanPham : 100)" data-rm-suffix="+">@(Model.TongSanPham > 0 ? Model.TongSanPham.ToString("N0") + "+" : "100+")</b>
                <span>@L["Home_StatProducts"]</span>
            </div>
            <div class="hero-stat-item">
                <b data-rm-count="@(Model.TongNguoiBan > 0 ? Model.TongNguoiBan : 50)" data-rm-suffix="+">@(Model.TongNguoiBan > 0 ? Model.TongNguoiBan.ToString("N0") + "+" : "50+")</b>
                <span>@L["Home_StatSellers"]</span>
            </div>
            <div class="hero-stat-item">
                <b data-rm-count="100" data-rm-suffix="%">100%</b>
                <span>@L["Home_StatModerated"]</span>
            </div>
        </div>
    </div>
    <div class="hero-image-box" data-rm-reveal="pop" data-rm-media>
        <img src="~/images/hero-marketplace.jpg"
             alt="@L["Home_HeroImageAlt"]"
             class="hero-image"
             asp-append-version="true" />
    </div>
</section>

@if (Model.Banners.Count > 0)
{
<!-- 1b. BANNER (B5) -->
<section class="landing-section" style="padding-top:0">
    <div id="rmBannerCarousel" class="carousel slide rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel">
        @if (Model.Banners.Count > 1)
        {
            <div class="carousel-indicators">
                @for (var i = 0; i < Model.Banners.Count; i++)
                {
                    <button type="button" data-bs-target="#rmBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : null)" aria-label="@L["Home_BannerAria", i + 1]"></button>
                }
            </div>
        }
        <div class="carousel-inner">
            @for (var i = 0; i < Model.Banners.Count; i++)
            {
                var b = Model.Banners[i];
                <div class="carousel-item @(i == 0 ? "active" : null)">
                    @if (!string.IsNullOrWhiteSpace(b.LienKet))
                    {
                        <a href="@(SecondHandMarketplace.Web.Common.UrlAnToan.HopLe(b.LienKet) ? b.LienKet : "#")" class="d-block">
                            <img src="@b.DuongDanAnh" alt="@b.TieuDe" class="w-100 d-none d-md-block" style="aspect-ratio:10/3; object-fit:cover;" data-fallback />
                            <img src="@b.DuongDanAnh" alt="@b.TieuDe" class="w-100 d-md-none" style="aspect-ratio:16/9; object-fit:cover;" data-fallback />
                        </a>
                    }
                    else
                    {
                        <img src="@b.DuongDanAnh" alt="@b.TieuDe" class="w-100" style="aspect-ratio:10/3; object-fit:cover;" data-fallback />
                    }

                </div>
            }
        </div>
        @if (Model.Banners.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#rmBannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">@L["Btn_Prev"]</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#rmBannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">@L["Btn_Next"]</span>
            </button>
        }
    </div>
</section>
}

<!-- 2. DANH MỤC (Ảnh 2) -->
<section class="landing-section" data-rm-reveal>
    <div class="landing-section-header">
        <div>
            <div class="section-label">@L["Home_CatLabel"]</div>
            <h2 class="section-title">@L["Home_CatTitle"]</h2>
        </div>
        <a asp-controller="Products" asp-action="Index" class="btn-rm-outline">@L["Nav_ViewAll"]</a>
    </div>

    <div class="category-grid" data-rm-stagger>
        @foreach (var c in Model.DanhMucs.Take(6))
        {
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@c.MaDanhMuc" class="category-card">
                <div class="cat-circle cat-icon"><i class="bi @LayIconDanhMuc(c.Ten)"></i></div>
                <span class="cat-name">@HienThi.TenDanhMuc(c.Ten)</span>
            </a>
        }
    </div>
</section>

<!-- 3. CÓ THỂ BẠN SẼ THÍCH: lọc gợi ý ngay trên trang chủ, chỉ chuyển sang /Products khi bấm Xem chi tiết -->
<section class="landing-section rm-rec-section"
         id="rmHomeRecSection"
         data-rm-reveal
         data-endpoint="@Url.Action("SanPhamGoiY", "Home")"
         data-products-url="@Url.Action("Index", "Products")"
         data-label-base="@L["Home_ViewDetails"]">
    <div class="landing-section-header rm-rec-header">
        <div>
            <div class="section-label">@L["Home_FeatLabel"]</div>
            <h2 class="section-title">@L["Home_FeatTitle"]</h2>
        </div>

        <div class="rm-rec-modes" role="tablist" aria-label="@L["Home_FeatTitle"]">
            <button type="button"
                    class="rm-rec-mode-btn is-active"
                    role="tab"
                    aria-selected="true"
                    data-rm-mode="default"
                    data-rm-mode-label="">
                <span>@L["Home_RecDefault"]</span>
            </button>
            <button type="button"
                    class="rm-rec-mode-btn"
                    role="tab"
                    aria-selected="false"
                    data-rm-mode="newest"
                    data-rm-mode-label="@L["Nav_Newest"]">
                <span>@L["Nav_Newest"]</span>
            </button>
            <button type="button"
                    class="rm-rec-mode-btn"
                    role="tab"
                    aria-selected="false"
                    data-rm-mode="best_price"
                    data-rm-mode-label="@L["Nav_BestPrice"]">
                <span>@L["Nav_BestPrice"]</span>
            </button>
            <button type="button"
                    class="rm-rec-mode-btn"
                    role="tab"
                    aria-selected="false"
                    data-rm-mode="bargain"
                    data-rm-mode-label="@L["Home_BargainPrices"]">
                <span>@L["Home_BargainPrices"]</span>
            </button>
        </div>
    </div>

    <ul class="nav nav-pills rm-cat-tabs" role="tablist" aria-label="@L["Home_CatTitle"]">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    type="button"
                    role="tab"
                    aria-selected="true"
                    data-rm-cat=""
                    data-rm-cat-label="">
                @L["Home_RecAllCategories"]
            </button>
        </li>
        @foreach (var tab in Model.TabsDanhMuc)
        {
            var tenDm = HienThi.TenDanhMuc(tab.TenDanhMuc);
            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        type="button"
                        role="tab"
                        aria-selected="false"
                        data-rm-cat="@tab.MaDanhMuc"
                        data-rm-cat-label="@tenDm">
                    @tenDm
                </button>
            </li>
        }
    </ul>

    <div class="rm-cat-contents">
        <div id="rmHomeRecStage" class="rm-rec-stage" aria-live="polite">
            <partial name="_HomeRecGrid" model="Model.SanPhamNoiBat" />
        </div>

        <div class="rm-cat-more">
            <a id="rmHomeSeeMore" asp-controller="Products" asp-action="Index" class="btn-rm-rec-more">
                <span data-rm-more-text>@L["Home_ViewDetails"]</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>

<!-- 4. CÁCH THỨC HOẠT ĐỘNG (Ảnh 3) -->
<section class="landing-section" data-rm-reveal>
    <div class="section-label">@L["Home_HowLabel"]</div>
    <h2 class="section-title">@L["Home_HowTitle"]</h2>

    <div class="steps-grid" data-rm-stagger>
        <div class="step-card">
            <div class="step-num">1</div>
            <h3 class="step-title">@L["Home_Step1Title"]</h3>
            <p class="step-desc">@L["Home_Step1Desc"]</p>
        </div>
        <div class="step-card">
            <div class="step-num">2</div>
            <h3 class="step-title">@L["Home_Step2Title"]</h3>
            <p class="step-desc">@L["Home_Step2Desc"]</p>
        </div>
        <div class="step-card">
            <div class="step-num">3</div>
            <h3 class="step-title">@L["Home_Step3Title"]</h3>
            <p class="step-desc">@L["Home_Step3Desc"]</p>
        </div>
    </div>
    <div class="step-seller-note">
        @L["Home_SellerNote"]
    </div>
</section>

<!-- 5. GIÁ TRỊ BỀN VỮNG (Ảnh 3) -->
<section class="landing-section" data-rm-reveal>
    <div class="sustainability-row">
        <div class="sustainability-image-wrap" data-rm-media>
            <img src="~/images/sustainable-shopping.jpg" alt="@L["Home_ValueImageAlt"]" class="sustainability-image" style="object-fit: cover;" asp-append-version="true" />
        </div>
        <div>
            <div class="section-label">@L["Home_ValueLabel"]</div>
            <h2 class="section-title" style="font-size: 26px; line-height: 1.25; margin-bottom: 12px;">
                @L["Home_ValueTitle"]
            </h2>
            <p style="color: var(--color-text-secondary); font-size: 14px; margin-bottom: 20px;">
                @L["Home_ValueDesc"]
            </p>
            <div class="sustainability-stats" data-rm-stagger>
                <div class="sust-stat-card">
                    <b>@(Model.TongDonHoanTat > 0 ? (Model.TongDonHoanTat * 2).ToString("N0") + " kg" : "100+ kg")</b>
                    <span>@L["Home_SustWaste"]</span>
                </div>
                <div class="sust-stat-card">
                    <b>@(Model.TongDonHoanTat > 0 ? Model.TongDonHoanTat.ToString("N0") : "50+")</b>
                    <span>@L["Home_SustCycled"]</span>
                </div>
                <div class="sust-stat-card">
                    <b>@(Model.TongSanPham > 0 ? Model.TongSanPham.ToString("N0") : "100+")</b>
                    <span>@L["Home_SustActive"]</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 6. ĐỘ TIN CẬY (Ảnh 3) -->
<section class="landing-section" data-rm-reveal>
    <div class="section-label">@L["Home_TrustLabel"]</div>
    <h2 class="section-title">@L["Home_TrustTitle"]</h2>

    <div class="trust-grid" data-rm-stagger>
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">✓</div>
            <h4>@L["Home_Trust1Title"]</h4>
            <p>@L["Home_Trust1Desc"]</p>
        </div>
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">↔</div>
            <h4>@L["Home_Trust2Title"]</h4>
            <p>@L["Home_Trust2Desc"]</p>
        </div>
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">♡</div>
            <h4>@L["Home_Trust3Title"]</h4>
            <p>@L["Home_Trust3Desc"]</p>
        </div>
        <div class="trust-card">
            <div class="trust-dot" aria-hidden="true">!</div>
            <h4>@L["Home_Trust4Title"]</h4>
            <p>@L["Home_Trust4Desc"]</p>
        </div>
    </div>
</section>

<!-- 7. ĐÁNH GIÁ (Ảnh 3) -->
<section class="landing-section" data-rm-reveal>
    <div class="section-label">@L["Home_RevLabel"]</div>
    <h2 class="section-title">@L["Home_RevTitle"]</h2>
    <p style="color: var(--color-text-muted); font-size: 13px; margin: 4px 0 20px;">@L["Home_RevNote"]</p>

    @if (Model.DanhGiaNoiBat.Count == 0)
    {
        <p class="reviews-empty">@L["Home_RevEmpty"]</p>
    }
    else
    {
        <div class="reviews-grid" data-rm-stagger>
            @foreach (var dg in Model.DanhGiaNoiBat)
            {
                <div class="review-card">
                    <div class="review-stars" aria-label="@L["Home_StarOutOf", dg.SoSao]">
                        @for (byte s = 1; s <= 5; s++)
                        {
                            <span class="@(s <= dg.SoSao ? "star-on" : "star-off")">★</span>
                        }
                    </div>
                    <p class="review-text">@TomTacDanhGia(dg.NoiDung)</p>
                    <div class="review-author">
                        <img class="author-circle" src="@(string.IsNullOrWhiteSpace(dg.AnhDaiDienNguoiMua) ? Url.Content("~/images/avatar-default.png") : dg.AnhDaiDienNguoiMua)" alt="@L["Home_AvatarAlt", dg.TenNguoiMua]" />
                        <div class="author-info">
                            <b>@dg.TenNguoiMua</b>
                            <span>
                                @L["Home_BoughtLabel"]
                                @if (dg.MaSanPham.HasValue)
                                {
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@dg.MaSanPham.Value">@dg.TenSanPham</a>
                                }
                                else
                                {
                                    @dg.TenSanPham
                                }
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<!-- 8. BANNER CTA CUỐI TRANG (Ảnh 3) -->
<div class="landing-cta-banner">
    <div class="cta-banner-text">
        <h3>@L["Home_CtaTitle"]</h3>
        <p>@L["Home_CtaDesc"]</p>
    </div>
    <div class="cta-banner-actions">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-area="User" asp-controller="Products" asp-action="Create" class="btn-cta-white">@L["Home_CtaBtn"]</a>
    }
    else
    {
        <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/User/Products/Create" class="btn-cta-white">@L["Home_CtaBtn"]</a>
    }
    </div>
</div>

@section Scripts {
    <script src="~/js/home-recommendations.js" asp-append-version="true"></script>
}
