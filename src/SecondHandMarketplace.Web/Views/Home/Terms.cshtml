@{
    ViewData["Title"] = HienThi.Chon("Điều khoản sử dụng & Chính sách bảo mật - Re:Market", "Terms of Service & Privacy Policy - Re:Market");
}

<div class="container py-5" style="max-width: 960px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-size: 14px;">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">@L["Nav_Home"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@HienThi.Chon("Điều khoản & Chính sách", "Terms & Policies")</li>
        </ol>
    </nav>

    <!-- Section: Điều khoản -->
    <section id="dieu-khoan" class="mb-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h1 class="h2 fw-bold mb-3" style="color: var(--color-primary-dark, #1B4332);">@L["Footer_Terms"]</h1>
            <p class="text-muted">@HienThi.Chon("Cập nhật lần cuối: Tháng 11/2026. Bằng việc truy cập hoặc sử dụng Re:Market, bạn đồng ý tuân thủ các điều khoản sau:", "Last updated: November 2026. By accessing or using Re:Market, you agree to comply with the following terms:")</p>
            <div class="d-flex flex-column gap-3 text-secondary">
                <div>
                    <h6 class="fw-bold text-dark">@HienThi.Chon("1. Tài khoản người dùng", "1. User Accounts")</h6>
                    <p class="small mb-0">@HienThi.Chon("Người dùng chịu trách nhiệm bảo mật thông tin đăng nhập và mọi hoạt động diễn ra dưới tài khoản của mình. Không chia sẻ tài khoản cho người thứ ba sử dụng trái phép.", "Users are responsible for safeguarding their login credentials and all activities under their account. Do not share your account with unauthorized third parties.")</p>
                </div>
                <div>
                    <h6 class="fw-bold text-dark">@HienThi.Chon("2. Trách nhiệm người bán", "2. Seller Responsibilities")</h6>
                    <p class="small mb-0">@HienThi.Chon("Người bán phải cung cấp hình ảnh thật, mô tả trung thực về tình trạng sản phẩm (độ mới, lỗi nếu có) và chỉ đăng bán hàng hóa thuộc quyền sở hữu hợp pháp.", "Sellers must provide real photos, honest descriptions of item condition (wear, defects if any), and only list items they legally own.")</p>
                </div>
                <div>
                    <h6 class="fw-bold text-dark">@HienThi.Chon("3. Trách nhiệm người mua", "3. Buyer Responsibilities")</h6>
                    <p class="small mb-0">@HienThi.Chon("Người mua cam kết nhận hàng đúng hẹn theo thỏa thuận hoặc khung giờ đã chọn, kiểm tra sản phẩm cẩn thận khi giao nhận và thanh toán đầy đủ.", "Buyers agree to receive orders on time as scheduled, inspect items carefully upon delivery, and complete payment in full.")</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section: Chính sách bảo mật -->
    <section id="bao-mat" class="mb-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h2 class="h3 fw-bold mb-3" style="color: var(--color-primary-dark, #1B4332);">@L["Footer_Privacy"]</h2>
            <p class="text-muted">@HienThi.Chon("Re:Market cam kết bảo vệ sự riêng tư và thông tin cá nhân của bạn theo tiêu chuẩn an toàn cao nhất:", "Re:Market is committed to protecting your privacy and personal data under strict security standards:")</p>
            <div class="d-flex flex-column gap-3 text-secondary">
                <div>
                    <h6 class="fw-bold text-dark">@HienThi.Chon("1. Thu thập dữ liệu", "1. Data Collection")</h6>
                    <p class="small mb-0">@HienThi.Chon("Chúng tôi chỉ thu thập thông tin cần thiết phục vụ việc xác thực tài khoản, xử lý đơn hàng và giao nhận hàng (họ tên, số điện thoại, địa chỉ nhận hàng).", "We only collect information necessary for account verification, order processing, and delivery (full name, phone number, shipping address).")</p>
                </div>
                <div>
                    <h6 class="fw-bold text-dark">@HienThi.Chon("2. Bảo vệ thông tin", "2. Data Protection")</h6>
                    <p class="small mb-0">@HienThi.Chon("Mật khẩu được mã hóa băm an toàn (BCrypt). Mọi liên lạc trao đổi nhạy cảm đều được bảo vệ trong hạ tầng máy chủ bảo mật.", "Passwords are securely hashed using BCrypt. Sensitive communications are protected within our secure server infrastructure.")</p>
                </div>
                <div>
                    <h6 class="fw-bold text-dark">@HienThi.Chon("3. Quyền của người dùng", "3. User Rights")</h6>
                    <p class="small mb-0">@HienThi.Chon("Bạn có toàn quyền truy cập, chỉnh sửa thông tin cá nhân hoặc yêu cầu xóa dữ liệu bất kỳ lúc nào tại mục Hồ sơ cá nhân.", "You have full rights to access, update your personal profile, or request data deletion at any time in My Profile.")</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section: Quy định cộng đồng -->
    <section id="quy-dinh">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h2 class="h3 fw-bold mb-3 text-danger"><i class="bi bi-shield-slash-fill me-2"></i>@HienThi.Chon("Quy định cộng đồng & Danh mục cấm", "Community Guidelines & Prohibited Items")</h2>
            <p class="text-muted">@HienThi.Chon("Các hành vi và mặt hàng tuyệt đối bị nghiêm cấm trên nền tảng Re:Market:", "The following behaviors and items are strictly prohibited on Re:Market:")</p>
            <ul class="text-secondary small d-flex flex-column gap-2 mb-0">
                <li>@HienThi.Chon("Nghiêm cấm đăng bán hàng giả, hàng nhái, vũ khí, chất cháy nổ hoặc các mặt hàng bị pháp luật Việt Nam cấm lưu hành.", "Listing counterfeit goods, weapons, explosives, or items prohibited by law is strictly forbidden.")</li>
                <li>@HienThi.Chon("Nghiêm cấm sử dụng ngôn từ tục tĩu, xúc phạm, phân biệt đối xử hoặc quấy rối người dùng khác trong tin nhắn và bình luận đánh giá.", "Profanity, insults, discrimination, or harassment in chat messages and reviews are strictly prohibited.")</li>
                <li>@HienThi.Chon("Nghiêm cấm hành vi gian lận thanh toán, cố tình không giao hàng hoặc phá hoại uy tín của cửa hàng khác.", "Payment fraud, intentional non-delivery, or sabotaging other shops' reputation is prohibited.")</li>
                <li>@HienThi.Chon("Tài khoản vi phạm nghiêm trọng sẽ bị hệ thống tự động khóa và chuyển hồ sơ xử lý theo quy định.", "Accounts with severe violations will be automatically locked and handled according to platform rules.")</li>
            </ul>
        </div>
    </section>
</div>
