@{
    ViewData["Title"] = L["Footer_HelpCenter"].Value;
}

<nav class="rm-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">@L["Nav_Home"]</a>
    <span class="sep">/</span>
    <span>@L["Footer_HelpCenter"]</span>
</nav>

<header class="help-hero">
    <span class="help-eyebrow">@HienThi.Chon("RE:MARKET · TRUNG TÂM HỖ TRỢ", "RE:MARKET · HELP CENTER")</span>
    <h1>@Html.Raw(HienThi.Chon("Giao dịch rõ ràng,<br />mua bán an tâm hơn.", "Transparent trading,<br />peace of mind for every deal."))</h1>
    <p>@HienThi.Chon("Tìm hiểu trạng thái đơn hàng, cách xử lý khi có vấn đề và cách bảo vệ tài khoản của bạn.", "Learn about order statuses, how to resolve issues, and how to keep your account secure.")</p>
    <a class="btn-rm-primary" asp-area="User" asp-controller="Orders" asp-action="Index">@HienThi.Chon("Theo dõi đơn hàng", "Track My Orders")</a>
</header>

<div class="help-layout">
    <aside class="help-index" aria-label="Help Table of Contents">
        <strong>@HienThi.Chon("Nội dung", "Contents")</strong>
        <a href="#giao-dich">@HienThi.Chon("Giao dịch an toàn", "Safe Trading")</a>
        <a href="#trang-thai">@HienThi.Chon("Trạng thái đơn hàng", "Order Statuses")</a>
        <a href="#su-co">@HienThi.Chon("Khi có sự cố", "When Issues Arise")</a>
        <a href="#bao-mat">@HienThi.Chon("Bảo mật tài khoản", "Account Security")</a>
        <a href="#faq">@L["Footer_Faq"]</a>
    </aside>

    <main class="help-content">
        <section class="help-section" id="giao-dich">
            <span class="help-number">01</span>
            <div>
                <h2>@HienThi.Chon("Giao dịch an toàn", "Safe Trading")</h2>
                <p>@HienThi.Chon("Trao đổi trong trang đơn hàng và kiểm tra kỹ sản phẩm, người bán, số tiền trước khi thanh toán.", "Communicate on the platform and verify product details, seller reputation, and amount before paying.")</p>
                <div class="help-callout"><i class="bi bi-info-circle"></i><span>@HienThi.Chon("Chuyển khoản VietQR hiện được trả trực tiếp tới tài khoản do shop cung cấp; Re:Market không giữ tiền và không tự xác minh giao dịch ngân hàng. Chỉ chuyển đúng số tiền, nội dung và tài khoản trên chi tiết đơn. Nếu thông tin không khớp, hãy dừng giao dịch và liên hệ shop.", "VietQR bank transfers are sent directly to the bank account provided by the shop; Re:Market does not hold escrow or auto-verify bank transactions. Only transfer the exact amount, memo, and account shown on the order details.")</span></div>
                <ul>
                    <li>@HienThi.Chon("Ưu tiên gặp tại nơi công cộng nếu chọn hình thức nhận trực tiếp.", "Prefer public locations when choosing in-person meetup.")</li>
                    <li>@HienThi.Chon("Không gửi mật khẩu, mã OTP hoặc ảnh giấy tờ cho người bán.", "Never share your password, OTP code, or ID documents with sellers.")</li>
                    <li>@HienThi.Chon("Chỉ xác nhận đã nhận hàng sau khi đã kiểm tra sản phẩm.", "Only confirm receipt after inspecting the item.")</li>
                </ul>
            </div>
        </section>

        <section class="help-section" id="trang-thai">
            <span class="help-number">02</span>
            <div>
                <h2>@HienThi.Chon("Trạng thái đơn hàng", "Order Statuses")</h2>
                <div class="help-status-list">
                    <article><span class="help-status-dot pending"></span><div><strong>@HienThi.TrangThaiDon("PENDING")</strong><p>@HienThi.Chon("Shop đang xem đơn. Nếu không còn nhu cầu, bạn có thể hủy khi nút hủy vẫn khả dụng.", "The shop is reviewing your order. You may cancel while the cancel button is available.")</p></div></article>
                    <article><span class="help-status-dot confirmed"></span><div><strong>@HienThi.TrangThaiDon("CONFIRMED")</strong><p>@HienThi.Chon("Shop đã nhận đơn và chuẩn bị giao hàng hoặc thống nhất điểm hẹn.", "The shop confirmed the order and is preparing shipment or meetup.")</p></div></article>
                    <article><span class="help-status-dot shipping"></span><div><strong>@HienThi.TrangThaiDon("SHIPPING")</strong><p>@HienThi.Chon("Đơn đang trên đường giao hoặc hai bên đang thực hiện lịch hẹn.", "The order is on its way or scheduled for meetup.")</p></div></article>
                    <article><span class="help-status-dot delivered"></span><div><strong>@HienThi.TrangThaiDon("DELIVERED")</strong><p>@HienThi.Chon("Kiểm tra hàng trước. Chỉ chọn “Đã nhận được hàng” khi bạn đã thực sự nhận và đồng ý hoàn tất.", "Inspect the item first. Only click \"Confirm Receipt\" once you have received and verified it.")</p></div></article>
                    <article><span class="help-status-dot completed"></span><div><strong>@HienThi.TrangThaiDon("COMPLETED")</strong><p>@HienThi.Chon("Giao dịch đã kết thúc. Bạn có thể gửi đánh giá cho shop.", "Transaction completed. You can now leave a review for the shop.")</p></div></article>
                    <article><span class="help-status-dot cancelled"></span><div><strong>@HienThi.TrangThaiDon("CANCELLED")</strong><p>@HienThi.Chon("Đơn đã dừng. Mở chi tiết đơn để xem lý do và người thực hiện hủy.", "Order stopped. Open order details to see the cancellation reason and actor.")</p></div></article>
                </div>
                <p class="help-muted">@HienThi.Chon("Thanh toán có trạng thái riêng với đơn hàng: COD được trả khi nhận hàng; chuyển khoản chỉ được đánh dấu đã thanh toán sau khi shop xác nhận thủ công.", "Payment has its own status: COD is paid upon delivery; bank transfer is marked paid after manual confirmation by the shop.")</p>
            </div>
        </section>

        <section class="help-section" id="su-co">
            <span class="help-number">03</span>
            <div>
                <h2>@HienThi.Chon("Khi có sự cố", "When Issues Arise")</h2>
                <ol class="help-steps">
                    <li>@HienThi.Chon("Mở", "Open") <a asp-area="User" asp-controller="Orders" asp-action="Index">@L["Nav_MyOrders"]</a> @HienThi.Chon("và vào đúng đơn để xem trạng thái, thông tin shop và lịch sử cập nhật.", "and select the order to check its status, shop info, and timeline.")</li>
                    <li>@HienThi.Chon("Nếu hàng chưa nhận, sai mô tả hoặc giao dịch có vấn đề, dùng mục Khiếu nại / Tranh chấp trong chi tiết đơn kèm bằng chứng liên quan.", "If the item was not received or does not match the description, use the Dispute / Claim option in order details with supporting evidence.")</li>
                    <li>@HienThi.Chon("Nếu phát hiện tài khoản hoặc nội dung vi phạm, gửi báo cáo qua", "If you find a violating account or listing, submit a report via") <a asp-area="User" asp-controller="Reports" asp-action="Tao">@HienThi.Chon("biểu mẫu báo cáo", "the report form")</a>.</li>
                    <li>@HienThi.Chon("Giữ lại mã đơn, nội dung trao đổi và chứng từ thanh toán để đối chiếu.", "Keep your order ID, chat logs, and payment receipts for verification.")</li>
                </ol>
                <p class="help-muted">@HienThi.Chon("Đừng xác nhận hoàn tất hoặc chuyển thêm tiền để “mở khóa” đơn theo yêu cầu ngoài hệ thống.", "Never confirm order completion early or transfer extra money off-platform.")</p>
            </div>
        </section>

        <section class="help-section" id="bao-mat">
            <span class="help-number">04</span>
            <div>
                <h2>@HienThi.Chon("Bảo mật tài khoản", "Account Security")</h2>
                <div class="help-security-grid">
                    <article><i class="bi bi-key"></i><strong>@HienThi.Chon("Dùng mật khẩu riêng", "Use a Unique Password")</strong><p>@HienThi.Chon("Không dùng lại mật khẩu từ email, mạng xã hội hoặc dịch vụ khác.", "Do not reuse passwords from your email, social media, or other services.")</p></article>
                    <article><i class="bi bi-shield-lock"></i><strong>@HienThi.Chon("Giữ kín mã OTP", "Keep OTP Codes Private")</strong><p>@HienThi.Chon("Mã đặt lại mật khẩu chỉ dùng một lần, có hiệu lực 10 phút. Không chia sẻ mã với bất kỳ ai.", "One-time codes expire in 10 minutes. Never share your OTP with anyone.")</p></article>
                    <article><i class="bi bi-person-lock"></i><strong>@HienThi.Chon("Đăng xuất thiết bị lạ", "Sign Out on Shared Devices")</strong><p>@HienThi.Chon("Đăng xuất sau khi dùng máy công cộng. Nếu nghi ngờ lộ mật khẩu, đổi mật khẩu ngay và đăng nhập lại.", "Sign out after using public computers. Change your password immediately if you suspect a breach.")</p></article>
                </div>
                <p>@HienThi.Chon("Mật khẩu được lưu dưới dạng băm. Đăng nhập và yêu cầu đặt lại mật khẩu có giới hạn tần suất để giảm thử đoán tự động.", "Passwords are stored as secure cryptographic hashes. Sign-in and password reset endpoints are rate-limited against brute-force attacks.")</p>
                <a class="btn-rm-outline" asp-controller="Account" asp-action="ChangePassword">@L["Nav_ChangePassword"]</a>
            </div>
        </section>

        <section class="help-section" id="faq">
            <span class="help-number">05</span>
            <div>
                <h2>@L["Footer_Faq"]</h2>
                <details class="help-faq"><summary>@HienThi.Chon("Tôi chuyển khoản rồi nhưng đơn vẫn chưa được xác nhận?", "I transferred the money, why isn't my order confirmed yet?")</summary><p>@HienThi.Chon("Shop cần kiểm tra giao dịch trên tài khoản ngân hàng của họ và cập nhật thủ công. Nếu đã chuyển đúng thông tin mà trạng thái chưa đổi, liên hệ shop từ đơn hàng và giữ chứng từ giao dịch.", "The shop needs to verify the transfer in their bank account and confirm manually. You can click \"I have transferred\" on the order page to notify the seller immediately.")</p></details>
                <details class="help-faq"><summary>@HienThi.Chon("Tôi có thể hủy đơn ở trạng thái nào?", "When can I cancel an order?")</summary><p>@HienThi.Chon("Khả năng hủy phụ thuộc trạng thái hiện tại và quy tắc đơn hàng. Nếu nút hủy còn xuất hiện trong chi tiết đơn, bạn có thể gửi yêu cầu kèm lý do.", "Cancellation availability depends on the current order status. While the order is Pending Confirmation, you can cancel it with a reason.")</p></details>
                <details class="help-faq"><summary>@HienThi.Chon("Khi nào tôi được đánh giá shop?", "When can I review a shop?")</summary><p>@HienThi.Chon("Sau khi đơn hoàn tất. Mở chi tiết đơn để gửi đánh giá; mỗi đơn chỉ có một đánh giá.", "Once the order is Completed. Open the order details page to submit your rating and review (one review per completed order).")</p></details>
                <details class="help-faq"><summary>@HienThi.Chon("Tôi quên mật khẩu thì làm gì?", "What if I forget my password?")</summary><p>@HienThi.Chon("Chọn “Quên mật khẩu?” ở trang đăng nhập, nhận mã OTP qua email và đặt mật khẩu mới trong thời hạn của mã.", "Click \"Forgot password?\" on the Sign In page to receive an OTP via email and set a new password.")</p></details>
            </div>
        </section>
    </main>
</div>
